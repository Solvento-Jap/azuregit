{
	"name": "df_general_BuscToSyn",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_BUSC",
						"type": "DatasetReference"
					},
					"name": "BUSC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parameter1 as string",
				"}",
				"source(output(",
				"          CAC_ID as decimal(10,0),",
				"          CAC_UUID as string,",
				"          CAC_CLT_ID as decimal(10,0),",
				"          CAC_ACCOUNT_NUMBER as string,",
				"          CAC_BAT_ID as decimal(10,0),",
				"          CAC_STS_ID as decimal(10,0),",
				"          CAC_CREATED_BY as decimal(10,0),",
				"          CAC_CREATED_TS as timestamp,",
				"          CAC_UPDATED_BY as decimal(10,0),",
				"          CAC_UPDATED_TS as timestamp,",
				"          CAC_BRN_ID as decimal(10,0),",
				"          CAC_PRS_ID as decimal(10,0),",
				"          CAC_AUDIT_LOG as string,",
				"          CAC_INS_ID as decimal(10,0),",
				"          CAC_ACCOUNT_NUMBER_MASKED as string,",
				"          CAC_KEY_ROTATION_NUMBER as decimal(10,0),",
				"          isActive as integer,",
				"          isLatest as integer,",
				"          BNK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 2)) ~> BUSC",
				"filter1 derive(BANK_CODE = BNK_CODE,",
				"     partitionBy('roundRobin', 2)) ~> derivedColumn1",
				"BUSC filter(isLatest  == 1) ~> filter1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: (concat('dev/Error_Logs/SYN/', $parameter1)),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     partitionBy('roundRobin', 2)) ~> SYN"
			]
		}
	}
}