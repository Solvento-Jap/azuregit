{
	"name": "df_Log_Hash_lns_LIMITLIAB",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          LIMIT_B2KID as string,",
				"          ENTITY_CRE_FLG as string,",
				"          DEL_FLG as string,",
				"          PARENT_LIMIT_B2KID as string,",
				"          LIMIT_DESC as string,",
				"          ORIG_SANCT_LIM as string,",
				"          SANCT_LIM as string,",
				"          ACTIVE_DAYLIGHT_LIMIT as string,",
				"          UTILIZED_DAYLIGHT_LIMIT as string,",
				"          ACTIVE_TEMP_LIM as string,",
				"          DRWNG_POWER as string,",
				"          DRWNG_POWER_IND as string,",
				"          DRWNG_POWER_PCNT as string,",
				"          LIAB as string,",
				"          CONTINGENT_LIAB as string,",
				"          NUM_OF_ACCTS as string,",
				"          LC_SINGLE_TRAN_FLG as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          FXD_CRNCY_FLG as string,",
				"          CRNCY_CODE as string,",
				"          LIM_SANCT_DATE as string,",
				"          ORIG_LIM_EXP_DATE as string,",
				"          LIM_EXP_DATE as string,",
				"          EXTENSION_CNT as string,",
				"          SANCT_LEVL_CODE as string,",
				"          SANCT_AUTH_CODE as string,",
				"          FREE_TEXT as string,",
				"          FRUCTIFIED_LIAB as string,",
				"          SECURED_LIAB as string,",
				"          BG_EFFECTIVE_LIAB as string,",
				"          USER_MAINT_LIAB as string,",
				"          BASE_USER_MAINT_LIAB as string,",
				"          USER_MAINT_LIAB_FROM_CHILDREN as string,",
				"          CUST_ID as string,",
				"          UTIL_LIMIT_FUND_BASED as string,",
				"          UTIL_LIMIT_NON_FUND_BASED as string,",
				"          TS_CNT as string,",
				"          IMPLICIT_NODE_FLG as string,",
				"          LAST_PURGE_DATE as string,",
				"          SANCT_LIM_AS_ON_PURGE_DATE as string,",
				"          DRWNG_POWER_AS_ON_PURGE_DATE as string,",
				"          LIAB_AS_ON_PURGE_DATE as string,",
				"          CONT_LIAB_AS_ON_PURGE_DATE as string,",
				"          FRUCT_LIAB_AS_ON_PURGE_DATE as string,",
				"          SECD_LIAB_AS_ON_PURGE_DATE as string,",
				"          BG_EFF_LIAB_AS_ON_PURGE_DATE as string,",
				"          USR_MAINT_LIAB_ON_PURGE_DATE as string,",
				"          USR_MNT_LIAB_FRM_CHILD_PRG_DT as string,",
				"          UTIL_LIM_FUND_ON_PRG_DATE as string,",
				"          UTIL_LIM_NONFUND_ON_PRG_DATE as string,",
				"          LIMIT_PREFIX as string,",
				"          LIMIT_SUFFIX as string,",
				"          MIN_REQ_COLLATERAL_PCNT as string,",
				"          SANCT_LIM_OR_LIAB_FLG as string,",
				"          LIMIT_REVIEW_DATE as string,",
				"          LIMIT_TYPE as string,",
				"          LIM_EFF_DATE as string,",
				"          LIM_CONTRACT_DATE as string,",
				"          STATUS_CODE as string,",
				"          INT_TBL_CODE as string,",
				"          PATTERN_OF_FUNDING as string,",
				"          APPROVAL_REF_NO as string,",
				"          COMMITTED_FLG as string,",
				"          CONT_TRAN_RATE_CODE as string,",
				"          CONT_TRAN_RATE as string,",
				"          CONT_TRAN_CRNCY as string,",
				"          CONT_TRAN_AMT as string,",
				"          CONT_TRAN_AMT_IN_LCY as string,",
				"          MODIFY_DELETE_REASON_CODE as string,",
				"          LIMIT_MASTER_CODE as string,",
				"          OPER_DEBIT_ACID as string,",
				"          BANK_ID as string,",
				"          ALT1_LIMIT_DESC as string,",
				"          GLOBAL_LIMIT_FLG as string,",
				"          GLOBAL_PARENT_LIMIT_B2KID as string,",
				"          GLOBAL_PARENT_LIMIT_BANKID as string,",
				"          BANK_SET_ID as string,",
				"          TREASURY_LIAB as string,",
				"          TREASURY_LIAB_FROM_CHILDREN as string,",
				"          COND_PRECEDENT_FLG as string,",
				"          PRODUCT_TYPE as string,",
				"          AVAILABILITY_END_DATE as string,",
				"          LIMIT_CATEGORY as string,",
				"          LIMIT_STATE as string,",
				"          LIMIT_CLOSE_REASON_CODE as string,",
				"          FREEZE_FLG as string,",
				"          FREEZE_REMARKS as string,",
				"          FREEZE_UNFREEZE_REASON_CODE as string,",
				"          FREEZE_EXP_DATE as string,",
				"          GROUP_ID as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'%LIAB%')||like(name,'UTIL%')), concat($$, '_src') = $$),",
				"          ACTIVE_DAYLIGHT_LIMIT_src = ACTIVE_DAYLIGHT_LIMIT,",
				"          ACTIVE_TEMP_LIM_src = ACTIVE_TEMP_LIM,",
				"          CONT_TRAN_AMT_src = CONT_TRAN_AMT,",
				"          CONT_TRAN_AMT_IN_LCY_src = CONT_TRAN_AMT_IN_LCY,",
				"          DRWNG_POWER_src = DRWNG_POWER,",
				"          DRWNG_POWER_AS_ON_PURGE_DATE_src = DRWNG_POWER_AS_ON_PURGE_DATE,",
				"          ORIG_SANCT_LIM_src = ORIG_SANCT_LIM,",
				"          SANCT_LIM_src = SANCT_LIM,",
				"          SANCT_LIM_AS_ON_PURGE_DATE_src = SANCT_LIM_AS_ON_PURGE_DATE) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'%LIAB%')||like(name,'UTIL%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          ACTIVE_DAYLIGHT_LIMIT_tgt = toString(sum(toDouble(ACTIVE_DAYLIGHT_LIMIT))),",
				"          ACTIVE_TEMP_LIM_tgt = toString(sum(toDouble(ACTIVE_TEMP_LIM))),",
				"          CONT_TRAN_AMT_tgt = toString(sum(toDouble(CONT_TRAN_AMT))),",
				"          CONT_TRAN_AMT_IN_LCY_tgt = toString(sum(toDouble(CONT_TRAN_AMT_IN_LCY))),",
				"          DRWNG_POWER_tgt = toString(sum(toDouble(DRWNG_POWER))),",
				"          DRWNG_POWER_AS_ON_PURGE_DATE_tgt = toString(sum(toDouble(DRWNG_POWER_AS_ON_PURGE_DATE))),",
				"          ORIG_SANCT_LIM_tgt = toString(sum(toDouble(ORIG_SANCT_LIM))),",
				"          SANCT_LIM_tgt = toString(sum(toDouble(SANCT_LIM))),",
				"          SANCT_LIM_AS_ON_PURGE_DATE_tgt = toString(sum(toDouble(SANCT_LIM_AS_ON_PURGE_DATE)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}