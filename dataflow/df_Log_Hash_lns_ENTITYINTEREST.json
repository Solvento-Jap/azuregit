				"          INT_FREQ_WEEK_DAY_DR as string,",
				"          INT_FREQ_START_DD_DR as string,",
				"          INT_FREQ_HLDY_STAT_DR as string,",
				"          NEXT_INT_RUN_DATE_DR as string,",
				"          CRNCY_CODE as string,",
				"          TS_CNT as string,",
				"          TOT_INT_PAID_LAST_FY as string,",
				"          TOT_INT_COLL_LAST_FY as string,",
				"          TOT_DR_INT_ACC_LAST_FY as string,",
				"          TOT_CR_INT_ACC_LAST_FY as string,",
				"          INTEREST_RATE as string,",
				"          CHARGEOFF_RECALC_DATE as string,",
				"          LAST_IDT_PURGE_DATE as string,",
				"          MIN_RECALC_START_DATE_CR as string,",
				"          RECALC_REASON_IND_CR as string,",
				"          MIN_RECALC_START_DATE_DR as string,",
				"          RECALC_REASON_IND_DR as string,",
				"          COMPOUND_AMOUNT as string,",
				"          COMPOUND_DATE as string,",
				"          NRML_ACCRUED_AMOUNT_CR as string,",
				"          NRML_ACCRUED_AMOUNT_DR as string,",
				"          NRML_BOOKED_AMOUNT_CR as string,",
				"          NRML_BOOKED_AMOUNT_DR as string,",
				"          NRML_INTEREST_AMOUNT_CR as string,",
				"          NRML_INTEREST_AMOUNT_DR as string,",
				"          NRML_ADV_INT_AMOUNT_CR as string,",
				"          NRML_ADV_INT_AMOUNT_DR as string,",
				"          NRML_AMORTIZED_AMOUNT_CR as string,",
				"          NRML_AMORTIZED_AMOUNT_DR as string,",
				"          NRML_INT_SUSPENSE_AMT_DR as string,",
				"          PENAL_ACCRUED_AMOUNT_DR as string,",
				"          PENAL_BOOKED_AMOUNT_DR as string,",
				"          PENAL_INTEREST_AMOUNT_DR as string,",
				"          PENAL_ADV_INT_AMOUNT_DR as string,",
				"          PENAL_AMORTIZED_AMOUNT_DR as string,",
				"          PENAL_INT_SUSPENSE_AMT_DR as string,",
				"          ADDNL_ACCRUED_AMOUNT_DR as string,",
				"          ADDNL_BOOKED_AMOUNT_DR as string,",
				"          ADDNL_INTEREST_AMOUNT_DR as string,",
				"          QIS_ACCRUED_AMOUNT_DR as string,",
				"          QIS_BOOKED_AMOUNT_DR as string,",
				"          QIS_INTEREST_AMOUNT_DR as string,",
				"          STOCK_ACCRUED_AMOUNT_DR as string,",
				"          STOCK_BOOKED_AMOUNT_DR as string,",
				"          STOCK_INTEREST_AMOUNT_DR as string,",
				"          OVDU_ACCRUED_AMOUNT_DR as string,",
				"          OVDU_BOOKED_AMOUNT_DR as string,",
				"          OVDU_INTEREST_AMOUNT_DR as string,",
				"          ADV_INT_COLL_UPTO_DATE as string,",
				"          MAX_IDT_SRL_NUM_NRML_CR as string,",
				"          MAX_IDT_SRL_NUM_NRML_DR as string,",
				"          MAX_IDT_SRL_NUM_PENAL as string,",
				"          MAX_IDT_SRL_NUM_ADDNL as string,",
				"          MAX_IDT_SRL_NUM_QIS as string,",
				"          MAX_IDT_SRL_NUM_STOCK as string,",
				"          MAX_IDT_SRL_NUM_OVDU as string,",
				"          ACCOUNT_PEGGED_FLG as string,",
				"          REFER_IDT_FOR_INTCALC as string,",
				"          INTCALC_FROM_DAY_ONE as string,",
				"          NEXT_DMD_ADJ_AMT as string,",
				"          NO_RECALC_BEFORE_DATE as string,",
				"          LINKED_ACCT_FLG as string,",
				"          LINK_DELINK_DATE as string,",
				"          CURR_ADV_INT_AMT as string,",
				"          INT_DAILY_FACTOR as string,",
				"          NEW_FACTOR_DATE as string,",
				"          NEXT_PIDMD_ADJ_AMT as string,",
				"          BANK_ID as string,",
				"          NEXT_PEG_REVIEW_DATE as string,",
				"          PEG_REVIEW_ITC_SRL_NUM as string,",
				"          INT_FREQ_CAL_BASE_CR as string,",
				"          INT_FREQ_CAL_BASE_DR as string,",
				"          COMPINT_ACCRUED_AMOUNT_DR as string,",
				"          COMPINT_BOOKED_AMOUNT_DR as string,",
				"          COMPINT_INTEREST_AMOUNT_DR as string,",
				"          PENALINT_ACCRUED_AMOUNT_DR as string,",
				"          PENALINT_BOOKED_AMOUNT_DR as string,",
				"          PENALINT_INTEREST_AMOUNT_DR as string,",
				"          PENALPRNC_ACCRUED_AMOUNT_DR as string,",
				"          PENALPRNC_BOOKED_AMOUNT_DR as string,",
				"          PENALPRNC_INTEREST_AMOUNT_DR as string,",
				"          MAX_IDT_SRL_NUM_COMPINT as string,",
				"          MAX_IDT_SRL_NUM_PENALINT as string,",
				"          MAX_IDT_SRL_NUM_PENALPRNC as string,",
				"          COMPPRNC_ACCRUED_AMOUNT_DR as string,",
				"          COMPPRNC_BOOKED_AMOUNT_DR as string,",
				"          COMPPRNC_INTEREST_AMOUNT_DR as string,",
				"          MAX_IDT_SRL_NUM_COMPPRNC as string,",
				"          PEG_REVIEW_REF_DATE as string,",
				"          UNPAID_NRML_INT_AMOUNT_CR as string,",
				"          NEXT_INT_RUN_REF_DATE_DR as string,",
				"          LAST_NRML_BOOKED_AMOUNT_CR as string,",
				"          LAST_NRML_BOOKED_AMOUNT_DR as string,",
				"          LAST_PENAL_BOOKED_AMOUNT_DR as string,",
				"          LAST_ADDNL_BOOKED_AMOUNT_DR as string,",
				"          LAST_QIS_BOOKED_AMOUNT_DR as string,",
				"          LAST_STOCK_BOOKED_AMOUNT_DR as string,",
				"          LAST_OVDU_BOOKED_AMOUNT_DR as string,",
				"          LAST_COMPINT_BOOKED_AMOUNT_DR as string,",
				"          LAST_PENALINT_BOOKED_AMOUNT_DR as string,",
				"          LAST_PENPRNC_BOOKED_AMOUNT_DR as string,",
				"          LAST_COMPPRNC_BOOKED_AMOUNT_DR as string,",
				"          NEXT_INT_RUN_REF_DATE_CR as string,",
				"          COMPOUND_AMOUNT_CR as string,",
				"          COMPOUND_DATE_CR as string,",
				"          LAST_NRML_ACCRUED_AMT_CR as string,",
				"          LAST_NRML_ACCRUED_AMT_DR as string,",
				"          LAST_PENAL_ACCRUED_AMT_DR as string,",
				"          LAST_ADDNL_ACCRUED_AMT_DR as string,",
				"          LAST_QIS_ACCRUED_AMT_DR as string,",
				"          LAST_STOCK_ACCRUED_AMT_DR as string,",
				"          LAST_OVDU_ACCRUED_AMT_DR as string,",
				"          LAST_COMPINT_ACCRUED_AMT_DR as string,",
				"          LAST_PENALINT_ACCRUED_AMT_DR as string,",
				"          LAST_PENALPRNC_ACCRUED_AMT_DR as string,",
				"          LAST_COMPPRNC_ACCRUED_AMT_DR as string,",
				"          ACCRUED_BOD_DATE_CR as string,",
				"          ACCRUED_BOD_DATE_DR as string,",
				"          NRML_WAIVED_AMT_DR as string,",
				"          PENAL_WAIVED_AMT_DR as string,",
				"          ADDNL_WAIVED_AMT_DR as string,",
				"          REFUND_AMOUNT_DR as string,",
				"          OUTSTAND_PRENOTE_AMOUNT_DR as string,",
				"          PRENOTE_WAIVED_AMT_DR_FY as string,",
				"          PRENOTE_REFUND_AMOUNT_DR_FY as string,",
				"          INT_FREQ_MONTHS_DR as string,",
				"          INT_FREQ_DAYS_DR as string,",
				"          IS_FIRST_REPRICING as string,",
				"          CUMBAL_FOR_AVGCALC_CR as string,",
				"          MIGR_CUMBAL_FOR_AVGCALC_CR as string,",
				"          MIGR_CUMBAL_DATE as string,",
				"          ACCR_AMT_TIL_INT_CALC_DATE_CR as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'%AMOUNT%')||like(name,'%AMT%')), concat($$,'_src') = $$),",
				"          each(match(like(name,'TOT_%')), concat($$,'_src') = $$),",
				"          CUMBAL_FOR_AVGCALC_CR_src = CUMBAL_FOR_AVGCALC_CR,",
				"          INT_DAILY_FACTOR_src = INT_DAILY_FACTOR,",
				"          MIGR_CUMBAL_FOR_AVGCALC_CR_src = MIGR_CUMBAL_FOR_AVGCALC_CR,",
				"          XFER_MIN_BAL_src = XFER_MIN_BAL) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'%AMOUNT%')||like(name,'%AMT%')), concat($$,'_tgt') = toString(sum(toDouble($$)))),",
				"          CUMBAL_FOR_AVGCALC_CR_tgt = toString(sum(toDouble(CUMBAL_FOR_AVGCALC_CR))),",
				"          INT_DAILY_FACTOR_tgt = toString(sum(toDouble(INT_DAILY_FACTOR))),",
				"          MIGR_CUMBAL_FOR_AVGCALC_CR_tgt = toString(sum(toDouble(MIGR_CUMBAL_FOR_AVGCALC_CR))),",
				"          XFER_MIN_BAL_tgt = toString(sum(toDouble(XFER_MIN_BAL))),",
				"          each(match(like(name,'TOT_%')), concat($$, '_tgt') = toString(sum(toDouble(XFER_MIN_BAL))))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}