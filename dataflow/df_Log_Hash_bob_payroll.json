{
	"name": "df_Log_Hash_bob_payroll",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ID as string,",
				"          VERSION as string,",
				"          DEL as string,",
				"          CORP_ID as string,",
				"          ACCT_ID as string,",
				"          FILE_NM as string,",
				"          PAYROLL_TYPE as string,",
				"          REF_NO as string,",
				"          AMOUNT as string,",
				"          CREATED_BY as string,",
				"          CREATED_DT as string,",
				"          UPDATED_DT as string,",
				"          TXN_DT as string,",
				"          REMARKS as string,",
				"          TXN_TYPE as string,",
				"          FREQUENCY as string,",
				"          FROM_DT as string,",
				"          TO_DT as string,",
				"          DAY_WEEK as string,",
				"          DAY_MONTH as string,",
				"          CURR_CD as string,",
				"          ERROR_MSG as string,",
				"          STATUS as string,",
				"          WF_STATUS as string,",
				"          COUNT_A as string,",
				"          COUNT_B as string,",
				"          COUNT_C as string,",
				"          COUNT_D as string,",
				"          COUNT_E as string,",
				"          COUNT_F as string,",
				"          COUNT_G as string,",
				"          COUNT_H as string,",
				"          COUNT_I as string,",
				"          COUNT_J as string,",
				"          COUNT_K as string,",
				"          COUNT_L as string,",
				"          COUNT_M as string,",
				"          COUNT_N as string,",
				"          COUNT_O as string,",
				"          COUNT_P as string,",
				"          COUNT_Q as string,",
				"          COUNT_R as string,",
				"          COUNT_S as string,",
				"          COUNT_T as string,",
				"          COUNT_U as string,",
				"          COUNT_V as string,",
				"          COUNT_W as string,",
				"          COUNT_X as string,",
				"          COUNT_Y as string,",
				"          COUNT_Z as string,",
				"          WF_CLOB as string,",
				"          DAY_OF_MONTH as string,",
				"          DAY_OF_WEEK as string,",
				"          TOTAL_COUNT as string,",
				"          GATE_NO as string,",
				"          HINGE_ACCT as string,",
				"          EMAIL_FLAG as string,",
				"          TXN_TIME as string,",
				"          INTERNAL_REMARKS as string,",
				"          UPLOAD_OR_MANUAL as string,",
				"          FILE_FORMAT_ID as string,",
				"          CREDIT_FILENM as string,",
				"          DEBIT_FILENM as string,",
				"          GRP_FILENM as string,",
				"          EMAIL as string,",
				"          EMPLOYEE_NAME as string,",
				"          MOBILE_NO as string,",
				"          IS_H2H as string,",
				"          IS_BO as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          AMOUNT_src = AMOUNT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          AMOUNT_tgt = toString(sum(toDouble(AMOUNT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}