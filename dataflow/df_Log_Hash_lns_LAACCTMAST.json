				"          RESHDL_OVERDUE_PRIN_src = RESHDL_OVERDUE_PRIN,",
				"          VALUE_OF_ASSET_src = VALUE_OF_ASSET) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'%AMT%')&&notEquals(name,'NEGATIVE_AMT_THRSHLD_PCNT')&&notEquals(name,'RSHDL_AMT_FLG')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          ACCR_PENAL_DMD_OS_tgt = toString(sum(toDouble(ACCR_PENAL_DMD_OS))),",
				"          BCHG_DMD_OS_tgt = toString(sum(toDouble(BCHG_DMD_OS))),",
				"          CUM_CAPITALIZE_FEES_tgt = toString(sum(toDouble(CUM_CAPITALIZE_FEES))),",
				"          EMICAP_DEFERRED_INT_tgt = toString(sum(toDouble(EMICAP_DEFERRED_INT))),",
				"          FIXED_PYMT_tgt = toString(sum(toDouble(FIXED_PYMT))),",
				"          INT_DMD_OS_tgt = toString(sum(toDouble(INT_DMD_OS))),",
				"          LIAB_AS_ON_XFER_EFF_DATE_tgt = toString(sum(toDouble(LIAB_AS_ON_XFER_EFF_DATE))),",
				"          OCHG_DMD_OS_tgt = toString(sum(toDouble(OCHG_DMD_OS))),",
				"          PRE_PROCESS_FEE_tgt = toString(sum(toDouble(PRE_PROCESS_FEE))),",
				"          PRIN_DMD_OS_tgt = toString(sum(toDouble(PRIN_DMD_OS))),",
				"          REPHASEMENT_PRINCIPAL_tgt = toString(sum(toDouble(REPHASEMENT_PRINCIPAL))),",
				"          RESHDL_OVERDUE_INT_tgt = toString(sum(toDouble(RESHDL_OVERDUE_INT))),",
				"          RESHDL_OVERDUE_PRIN_tgt = toString(sum(toDouble(RESHDL_OVERDUE_PRIN))),",
				"          VALUE_OF_ASSET_tgt = toString(sum(toDouble(VALUE_OF_ASSET)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
