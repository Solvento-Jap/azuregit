{
	"name": "df_Log_Hash_lns_CUSTGENCUSTACMASTER",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ACID as string,",
				"          SCHM_TYPE as string,",
				"          RES_FLG as string,",
				"          RES_BY_CAPT_INT as string,",
				"          REFUND_INT_PDC_PREPAY as string,",
				"          CWT_APPLICABLE_FLG as string,",
				"          CWT_RATE_TYPE as string,",
				"          CWT_SPL_RATE as string,",
				"          CWT_LAST_MOD_DATE as string,",
				"          ENTITY_CRE_FLG as string,",
				"          DEL_FLG as string,",
				"          RCRE_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          LCHG_USER_ID as string,",
				"          BANK_ID as string,",
				"          TS_CNT as string,",
				"          CLEARING_FLG as string,",
				"          RISK_FLG as string,",
				"          GUAR_AMT as string,",
				"          WHT_APPLICABLE_FLG as string,",
				"          WHT_FLG as string,",
				"          CORPORATE_BUYER_ID as string,",
				"          PSIC as string,",
				"          OLD_PN_NUMBER as string,",
				"          NUMBER_OF_RENEWAL as string,",
				"          OCCUPANCY_INDICATOR as string,",
				"          COLLATERAL_DESC as string,",
				"          DATE_CONTRACT_SELL as string,",
				"          TITLE_NO as string,",
				"          LAND_AREA as string,",
				"          FLOOR_AREA as string,",
				"          FORMER_OWNER as string,",
				"          NET_BOOK_VALUE as string,",
				"          AGENCYIND as string,",
				"          BENEFICIARY_DET as string,",
				"          PERIOD_COVERED_FROM_DATE as string,",
				"          PERIOD_COVERED_TO_DATE as string,",
				"          COST_RATE as string,",
				"          SPREAD_ON_ACCT as string,",
				"          RENEWED_ACCNT as string,",
				"          FIRE_PREMIUM as string,",
				"          MRI_INSURANCE as string,",
				"          MRI_FACTOR as string,",
				"          MRI_PREMIUM as string,",
				"          LRR_ID as string,",
				"          AVAILCASHBACK as string,",
				"          SAKTOPANALO as string,",
				"          REFDEPUNIT as string,",
				"          DISALESAGENT as string,",
				"          MRINAME_INSU as string,",
				"          MRIAMT_INSU as string,",
				"          CREDITSCORE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          CWT_SPL_RATE_src = CWT_SPL_RATE,",
				"          FIRE_PREMIUM_src = FIRE_PREMIUM,",
				"          MRI_FACTOR_src = MRI_FACTOR,",
				"          MRI_PREMIUM_src = MRI_PREMIUM,",
				"          NET_BOOK_VALUE_src = NET_BOOK_VALUE,",
				"          SPREAD_ON_ACCT_src = SPREAD_ON_ACCT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          CWT_SPL_RATE_tgt = toString(sum(toDouble(CWT_SPL_RATE))),",
				"          FIRE_PREMIUM_tgt = toString(sum(toDouble(FIRE_PREMIUM))),",
				"          MRI_FACTOR_tgt = toString(sum(toDouble(MRI_FACTOR))),",
				"          MRI_PREMIUM_tgt = toString(sum(toDouble(MRI_PREMIUM))),",
				"          NET_BOOK_VALUE_tgt = toString(sum(toDouble(NET_BOOK_VALUE))),",
				"          SPREAD_ON_ACCT_tgt = toString(sum(toDouble(SPREAD_ON_ACCT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}