{
	"name": "df_Log_Hash_dep_CASAMASTER",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ACID as string,",
				"          ACCT_STATUS as string,",
				"          LF_CHRG_PEND_LINES as string,",
				"          SBCA_ACCT_TYPE as string,",
				"          ACCT_INSTNT_CR_FACIL_FLG as string,",
				"          LAST_LF_CALC_DATE as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          ACCT_STATUS_DATE as string,",
				"          MAX_ALWD_ADVN_LIM as string,",
				"          ACCT_CRFILE_REF_ID as string,",
				"          LAST_AOD_AOS_DATE as string,",
				"          HEALTH_CODE as string,",
				"          TS_CNT as string,",
				"          BANK_ID as string,",
				"          NEXT_INACT_CHRG_CALC_DATE as string,",
				"          NEXT_DORM_CHRG_CALC_DATE as string,",
				"          ACCT_CLS_REASON_CODE as string,",
				"          ACCT_MIN_BALANCE as string,",
				"          ACCT_MIN_BAL_IND as string,",
				"          PRODUCT_TYPE as string,",
				"          MATURITY_PERD_MTHS as string,",
				"          MATURITY_PERD_DAYS as string,",
				"          NS_PERD_WD_MTHS as string,",
				"          NS_PERD_WD_DAYS as string,",
				"          LAST_NON_FIN_TRAN_DATE as string,",
				"          MATURITY_DATE as string,",
				"          DR_FREQ_START_DATE as string,",
				"          CR_FREQ_START_DATE as string,",
				"          LAST_OD_PROT_FEE_CALC_DATE as string,",
				"          NS_PERD_CLS_MTHS as string,",
				"          NS_PERD_CLS_DAYS as string,",
				"          CHRG_FREQ_TYPE as string,",
				"          CHRG_FREQ_START_DD as string,",
				"          CAP_FREQ_TYPE as string,",
				"          CAP_FREQ_START_DD as string,",
				"          PRENOTIFICATION_PERD as string,",
				"          CHRG_CAP_FLG as string,",
				"          BASE_DATE as string,",
				"          ENTITY_CAP_AMT as string,",
				"          CHRG_GROUP_ID1 as string,",
				"          CHRG_GROUP_ID2 as string,",
				"          CHRG_GROUP_ID3 as string,",
				"          NS_PERD_XFER_OUT_MTHS as string,",
				"          NS_PERD_XFER_OUT_DAYS as string,",
				"          NS_PERD_XFER_OUT_CLS_MTHS as string,",
				"          NS_PERD_XFER_OUT_CLS_DAYS as string,",
				"          NS_PERD_GRACE_MTHS as string,",
				"          NS_PERD_GRACE_DAYS as string,",
				"          LM_STRUCT_ID as string,",
				"          ACTIVE_DAYLIGHT_LIMIT as string,",
				"          UTILIZED_DAYLIGHT_LIMIT as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          ACCT_MIN_BALANCE_src = ACCT_MIN_BALANCE,",
				"          ACTIVE_DAYLIGHT_LIMIT_src = ACTIVE_DAYLIGHT_LIMIT,",
				"          CAP_FREQ_START_DD_src = CAP_FREQ_START_DD,",
				"          CHRG_FREQ_START_DD_src = CHRG_FREQ_START_DD,",
				"          each(match(like(name,'NS_PERD%')), concat($$, '_src') = $$),",
				"          ENTITY_CAP_AMT_src = ENTITY_CAP_AMT,",
				"          LF_CHRG_PEND_LINES_src = LF_CHRG_PEND_LINES,",
				"          MATURITY_PERD_DAYS_src = MATURITY_PERD_DAYS,",
				"          MATURITY_PERD_MTHS_src = MATURITY_PERD_MTHS,",
				"          MAX_ALWD_ADVN_LIM_src = MAX_ALWD_ADVN_LIM,",
				"          PRENOTIFICATION_PERD_src = PRENOTIFICATION_PERD,",
				"          TS_CNT_src = TS_CNT,",
				"          UTILIZED_DAYLIGHT_LIMIT_src = UTILIZED_DAYLIGHT_LIMIT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          ACCT_MIN_BALANCE_tgt = toString(sum(toDouble(ACCT_MIN_BALANCE))),",
				"          ACTIVE_DAYLIGHT_LIMIT_tgt = toString(sum(toDouble(ACTIVE_DAYLIGHT_LIMIT))),",
				"          CAP_FREQ_START_DD_tgt = toString(sum(toDouble(CAP_FREQ_START_DD))),",
				"          CHRG_FREQ_START_DD_tgt = toString(sum(toDouble(CHRG_FREQ_START_DD))),",
				"          ENTITY_CAP_AMT_tgt = toString(sum(toDouble(ENTITY_CAP_AMT))),",
				"          LF_CHRG_PEND_LINES_tgt = toString(sum(toDouble(LF_CHRG_PEND_LINES))),",
				"          MATURITY_PERD_DAYS_tgt = toString(sum(toDouble(MATURITY_PERD_DAYS))),",
				"          MATURITY_PERD_MTHS_tgt = toString(sum(toDouble(MATURITY_PERD_MTHS))),",
				"          MAX_ALWD_ADVN_LIM_tgt = toString(sum(toDouble(MAX_ALWD_ADVN_LIM))),",
				"          each(match(like(name,'NS_PERD%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          PRENOTIFICATION_PERD_tgt = toString(sum(toDouble(PRENOTIFICATION_PERD))),",
				"          TS_CNT_tgt = toString(sum(toDouble(TS_CNT))),",
				"          UTILIZED_DAYLIGHT_LIMIT_tgt = toString(sum(toDouble(UTILIZED_DAYLIGHT_LIMIT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', ''))) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}