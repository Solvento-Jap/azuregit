{
	"name": "df_Log_Hash_crm_FINANCIALDETAILS",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          FINANCIAL_DETAILS_ID as string,",
				"          BANK_ID as string,",
				"          FREQUENCY as string,",
				"          ATTACHMENTID as string,",
				"          ATTACHMENTNAME as string,",
				"          STR4_ALT1 as string,",
				"          FINANCIAL_ID as string,",
				"          FINANCEDETAIL_TYPE as string,",
				"          STR1 as string,",
				"          STR2 as string,",
				"          STR3 as string,",
				"          STR4 as string,",
				"          STR5 as string,",
				"          STR6 as string,",
				"          STR7 as string,",
				"          STR8 as string,",
				"          STR9 as string,",
				"          STR10 as string,",
				"          STR11 as string,",
				"          STR12 as string,",
				"          STR13 as string,",
				"          STR14 as string,",
				"          STR15 as string,",
				"          STR16 as string,",
				"          STR17 as string,",
				"          STR18 as string,",
				"          STR19 as string,",
				"          STR20 as string,",
				"          STR21 as string,",
				"          STR22 as string,",
				"          STR23 as string,",
				"          STR24 as string,",
				"          STR25 as string,",
				"          STR26 as string,",
				"          STR27 as string,",
				"          STR28 as string,",
				"          STR29 as string,",
				"          STR30 as string,",
				"          DATE1 as string,",
				"          DATE2 as string,",
				"          DATE3 as string,",
				"          DATE4 as string,",
				"          DATE5 as string,",
				"          DATE6 as string,",
				"          DATE7 as string,",
				"          DATE8 as string,",
				"          DATE9 as string,",
				"          DATE10 as string,",
				"          AMOUNT1 as string,",
				"          AMOUNT2 as string,",
				"          AMOUNT3 as string,",
				"          AMOUNT4 as string,",
				"          AMOUNT5 as string,",
				"          AMOUNT6 as string,",
				"          AMOUNT7 as string,",
				"          AMOUNT8 as string,",
				"          AMOUNT9 as string,",
				"          AMOUNT10 as string,",
				"          AMOUNT11 as string,",
				"          AMOUNT12 as string,",
				"          AMOUNT13 as string,",
				"          AMOUNT14 as string,",
				"          AMOUNT15 as string,",
				"          AMOUNT16 as string,",
				"          AMOUNT17 as string,",
				"          AMOUNT18 as string,",
				"          AMOUNT19 as string,",
				"          AMOUNT20 as string,",
				"          AMOUNT21 as string,",
				"          AMOUNT22 as string,",
				"          AMOUNT23 as string,",
				"          AMOUNT24 as string,",
				"          AMOUNT25 as string,",
				"          AMOUNT26 as string,",
				"          AMOUNT27 as string,",
				"          AMOUNT28 as string,",
				"          AMOUNT29 as string,",
				"          AMOUNT30 as string,",
				"          FLAG1 as string,",
				"          FLAG2 as string,",
				"          FLAG3 as string,",
				"          FLAG4 as string,",
				"          FLAG5 as string,",
				"          INT1 as string,",
				"          INT2 as string,",
				"          INT3 as string,",
				"          INT4 as string,",
				"          INT5 as string,",
				"          INT6 as string,",
				"          INT7 as string,",
				"          INT8 as string,",
				"          INT9 as string,",
				"          INT10 as string,",
				"          INT11 as string,",
				"          INT12 as string,",
				"          INT13 as string,",
				"          INT14 as string,",
				"          INT15 as string,",
				"          MLUSERFIELD1 as string,",
				"          MLUSERFIELD2 as string,",
				"          MLUSERFIELD3 as string,",
				"          MLUSERFIELD4 as string,",
				"          MLUSERFIELD5 as string,",
				"          ENTITYID as string,",
				"          ENTITYKEY as string,",
				"          CIFTYPE as string,",
				"          ENTITYTYPE as string,",
				"          ORGKEY as string,",
				"          FINYEAR as string,",
				"          FINMONTH as string,",
				"          AUDITSTATUS as string,",
				"          TANG_FIX_ASSETS as string,",
				"          SG_RECEIPTS as string,",
				"          GROSS_PROFIT as string,",
				"          PROFIT_INT_DEP_TAXES as string,",
				"          NET_PROFIT_RATIO as string,",
				"          GROSS_GEARING_RATIO as string,",
				"          NET_GEARING_RATIO as string,",
				"          TMDATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_src') = $$),",
				"          GROSS_GEARING_RATIO_src = GROSS_GEARING_RATIO,",
				"          GROSS_PROFIT_src = GROSS_PROFIT,",
				"          NET_GEARING_RATIO_src = NET_GEARING_RATIO,",
				"          NET_PROFIT_RATIO_src = NET_PROFIT_RATIO,",
				"          PROFIT_INT_DEP_TAXES_src = PROFIT_INT_DEP_TAXES,",
				"          SG_RECEIPTS_src = SG_RECEIPTS,",
				"          TANG_FIX_ASSETS_src = TANG_FIX_ASSETS) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          GROSS_GEARING_RATIO_tgt = toString(sum(toDouble(GROSS_GEARING_RATIO))),",
				"          GROSS_PROFIT_tgt = toString(sum(toDouble(GROSS_PROFIT))),",
				"          NET_GEARING_RATIO_tgt = toString(sum(toDouble(NET_GEARING_RATIO))),",
				"          NET_PROFIT_RATIO_tgt = toString(sum(toDouble(NET_PROFIT_RATIO))),",
				"          PROFIT_INT_DEP_TAXES_tgt = toString(sum(toDouble(PROFIT_INT_DEP_TAXES))),",
				"          SG_RECEIPTS_tgt = toString(sum(toDouble(SG_RECEIPTS))),",
				"          TANG_FIX_ASSETS_tgt = toString(sum(toDouble(TANG_FIX_ASSETS)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}