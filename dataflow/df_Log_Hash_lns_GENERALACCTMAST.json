				"          DRWNG_POWER_IND as string,",
				"          DRWNG_POWER_PCNT as string,",
				"          MICR_CHQ_CHRG_COLL_FLG as string,",
				"          LAST_TURNOVER_DATE as string,",
				"          NOTIONAL_RATE as string,",
				"          NOTIONAL_RATE_CODE as string,",
				"          FX_CLR_BAL_AMT as string,",
				"          FX_BAL_ON_PURGE_DATE as string,",
				"          FD_REF_NUM as string,",
				"          FX_CUM_CR_AMT as string,",
				"          FX_CUM_DR_AMT as string,",
				"          CRNCY_CODE as string,",
				"          SOURCE_OF_FUND as string,",
				"          ANW_NON_CUST_ALWD_FLG as string,",
				"          ACCT_CRNCY_CODE as string,",
				"          LIEN_AMT as string,",
				"          ACCT_CLASSIFICATION_FLG as string,",
				"          SYSTEM_ONLY_ACCT_FLG as string,",
				"          SINGLE_TRAN_FLG as string,",
				"          UTILISED_AMT as string,",
				"          INTER_SOL_ACCESS_FLG as string,",
				"          PURGE_ALLOWED_FLG as string,",
				"          PURGE_TEXT as string,",
				"          MIN_VALUE_DATE as string,",
				"          ACCT_MGR_USER_ID as string,",
				"          SCHM_TYPE as string,",
				"          LAST_FREZ_DATE as string,",
				"          LAST_UNFREZ_DATE as string,",
				"          BAL_ON_FREZ_DATE as string,",
				"          SWIFT_ALLOWED_FLG as string,",
				"          DACC_LIM_PCNT as string,",
				"          DACC_LIM_ABS as string,",
				"          CHRG_LEVEL_CODE as string,",
				"          ACCT_CLS_CHRG_PEND_VERF as string,",
				"          PARTITIONED_FLG as string,",
				"          PARTITIONED_TYPE as string,",
				"          PBF_DOWNLOAD_FLG as string,",
				"          PBF_DELINK_DATE as string,",
				"          WTAX_FLG as string,",
				"          WTAX_AMOUNT_SCOPE_FLG as string,",
				"          INT_ADJ_FOR_DEDUCTION_FLG as string,",
				"          OPERATIVE_ACID as string,",
				"          PHONE_NUM as string,",
				"          NATIVE_LANG_NAME as string,",
				"          NAT_LANG_TITLE_CODE as string,",
				"          LANG_CODE as string,",
				"          TS_CNT as string,",
				"          POOL_ID as string,",
				"          ALLOW_SWEEPS as string,",
				"          ORDER_OF_UTILISATION as string,",
				"          WTAX_PCNT as string,",
				"          WTAX_FLOOR_LIMIT as string,",
				"          DSA_PENAL_FLG as string,",
				"          PRODUCT_GROUP as string,",
				"          SOURCE_DEAL_CODE as string,",
				"          DISBURSE_DEAL_CODE as string,",
				"          SWEEP_IN_MIN_BAL as string,",
				"          USED_SINGLE_TRAN_LIM as string,",
				"          USED_CLEAN_SINGLE_TRAN_LIM as string,",
				"          USED_UN_CLR_OVER_DACC_AMT as string,",
				"          FFD_CONTRIB_TO_ACCT as string,",
				"          ACCT_CREATION_MODE as string,",
				"          WTAX_LEVEL_FLG as string,",
				"          LAST_MODIFIED_DATE as string,",
				"          CIF_ID as string,",
				"          FUTURE_BAL_AMT as string,",
				"          UTIL_FUTURE_BAL_AMT as string,",
				"          DAFA_LIM as string,",
				"          DAFA_LIM_ABS as string,",
				"          DAFA_LIM_PCNT as string,",
				"          FUTURE_OC_TOD_AMT as string,",
				"          USED_OC_CLN_SINGLE_TRAN_LIM as string,",
				"          IBAN_NUMBER as string,",
				"          CHANNEL_LEVEL_CODE as string,",
				"          CHANNEL_ID as string,",
				"          FUTURE_CLR_BAL_AMT as string,",
				"          FUTURE_UN_CLR_BAL_AMT as string,",
				"          MASTER_B2K_ID as string,",
				"          BANK_ID as string,",
				"          FREZ_REASON_CODE_2 as string,",
				"          FREZ_REASON_CODE_3 as string,",
				"          FREZ_REASON_CODE_4 as string,",
				"          FREZ_REASON_CODE_5 as string,",
				"          IS_LOAN_AGNST_CLTRL_FLG as string,",
				"          PREFERRED_CAL_BASE as string,",
				"          ADDITIONAL_CAL_BASE as string,",
				"          MUD_POOL_ACCT_FLG as string,",
				"          ALT1_ACCT_SHORT_NAME as string,",
				"          ALT1_ACCT_NAME as string,",
				"          PACKAGE_ACCT_ID as string,",
				"          EXTERNAL_PRICING_FLG as string,",
				"          ACCT_MOD_FLG as string,",
				"          WTAX_FLOOR_LIMIT_FREQ as string,",
				"          CHQ_PROV_BY_BANK_FLG as string,",
				"          CHQ_VAL_PRD_MNTH as string,",
				"          CHQ_VAL_PRD_DAY as string,",
				"          WTAX_WAIVER_LEVEL as string,",
				"          WTAX_APPLICABLE_LEVEL as string,",
				"          WTAX_NOTICE_RCV_DATE as string,",
				"          WTAX_WAIVER_START_DATE as string,",
				"          WTAX_WAIVER_END_DATE as string,",
				"          TAX_CERT_NUM as string,",
				"          TAX_FORM_PARTICULARS as string,",
				"          TAX_CERT_SUBMISSION_DATE as string,",
				"          ACCT_OWNERSHIP_XFER_AGE as string,",
				"          OD_PROT_ALWD as string,",
				"          PYMNT_REF_NUM as string,",
				"          RA_REF_NUM as string,",
				"          REQ_MIN_DIS_AMT as string,",
				"          REQ_MIN_DIS_TENOR as string,",
				"          DISP_BLOCK_AMT as string,",
				"          CONS_BAL_FLG as string,",
				"          TAX_EVENT as string,",
				"          REQUESTED_BY as string,",
				"          TAX_EVENT_REASON_CODE as string,",
				"          DR_INT_PRENOTE_REQ_FLG as string,",
				"          DR_INT_PRENOTE_PERIOD as string,",
				"          CHRG_PRENOTIFICATION_FLG as string,",
				"          TARGET_BAL_FOR_SWEEPS as string,",
				"          CHECK_FUNDS_AVAIL_SET as string,",
				"          RULE_SET_ID as string,",
				"          CHQ_REORDER_ALWD_FLG as string,",
				"          DR_INT_METHOD as string,",
				"          COLL_CHRG_FOR_SWP_REG as string,",
				"          SWP_CHRG_COLL_ACCT_FLG as string,",
				"          SSA_PLAN_ID as string,",
				"          ESCH_CR_BACID as string,",
				"          LAST6_ACCT_NUM as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'%AMT%')), concat($$, '_src') = $$),",
				"          BAL_ON_FREZ_DATE_src = BAL_ON_FREZ_DATE,",
				"          BAL_ON_PURGE_DATE_src = BAL_ON_PURGE_DATE,",
				"          CLEAN_ADHOC_LIM_src = CLEAN_ADHOC_LIM,",
				"          CLEAN_EMER_ADVN_src = CLEAN_EMER_ADVN,",
				"          CLEAN_SINGLE_TRAN_LIM_src = CLEAN_SINGLE_TRAN_LIM,",
				"          DACC_LIM_src = DACC_LIM,",
				"          DACC_LIM_ABS_src = DACC_LIM_ABS,",
				"          DAFA_LIM_src = DAFA_LIM,",
				"          DAFA_LIM_ABS_src = DAFA_LIM_ABS,",
				"          DRWNG_POWER_src = DRWNG_POWER,",
				"          EMER_ADVN_src = EMER_ADVN,",
				"          FFD_CONTRIB_TO_ACCT_src = FFD_CONTRIB_TO_ACCT,",
				"          FX_BAL_ON_PURGE_DATE_src = FX_BAL_ON_PURGE_DATE,",
				"          SANCT_LIM_src = SANCT_LIM,",
				"          SINGLE_TRAN_LIM_src = SINGLE_TRAN_LIM,",
				"          SYSTEM_GEN_LIM_src = SYSTEM_GEN_LIM,",
				"          TARGET_BAL_FOR_SWEEPS_src = TARGET_BAL_FOR_SWEEPS,",
				"          USED_CLEAN_SINGLE_TRAN_LIM_src = USED_CLEAN_SINGLE_TRAN_LIM,",
				"          USED_OC_CLN_SINGLE_TRAN_LIM_src = USED_OC_CLN_SINGLE_TRAN_LIM,",
				"          USED_SINGLE_TRAN_LIM_src = USED_SINGLE_TRAN_LIM,",
				"          WTAX_FLOOR_LIMIT_src = WTAX_FLOOR_LIMIT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'%AMT%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          ADHOC_LIM_tgt = toString(sum(toDouble(ADHOC_LIM))),",
				"          BAL_ON_FREZ_DATE_tgt = toString(sum(toDouble(BAL_ON_FREZ_DATE))),",
				"          BAL_ON_PURGE_DATE_tgt = toString(sum(toDouble(BAL_ON_PURGE_DATE))),",
				"          CLEAN_ADHOC_LIM_tgt = toString(sum(toDouble(CLEAN_ADHOC_LIM))),",
				"          CLEAN_EMER_ADVN_tgt = toString(sum(toDouble(CLEAN_EMER_ADVN))),",
				"          CLEAN_SINGLE_TRAN_LIM_tgt = toString(sum(toDouble(CLEAN_SINGLE_TRAN_LIM))),",
				"          DACC_LIM_tgt = toString(sum(toDouble(DACC_LIM))),",
				"          DACC_LIM_ABS_tgt = toString(sum(toDouble(DACC_LIM_ABS))),",
				"          DAFA_LIM_tgt = toString(sum(toDouble(DAFA_LIM))),",
				"          DAFA_LIM_ABS_tgt = toString(sum(toDouble(DAFA_LIM_ABS))),",
				"          DR_BAL_LIM_tgt = toString(sum(toDouble(DR_BAL_LIM))),",
				"          DRWNG_POWER_tgt = toString(sum(toDouble(DRWNG_POWER))),",
				"          EMER_ADVN_tgt = toString(sum(toDouble(EMER_ADVN))),",
				"          FFD_CONTRIB_TO_ACCT_tgt = toString(sum(toDouble(FFD_CONTRIB_TO_ACCT))),",
				"          FX_BAL_ON_PURGE_DATE_tgt = toString(sum(toDouble(FX_BAL_ON_PURGE_DATE))),",
				"          SANCT_LIM_tgt = toString(sum(toDouble(SANCT_LIM))),",
				"          SINGLE_TRAN_LIM_tgt = toString(sum(toDouble(SINGLE_TRAN_LIM))),",
				"          SYSTEM_GEN_LIM_tgt = toString(sum(toDouble(SYSTEM_GEN_LIM))),",
				"          TARGET_BAL_FOR_SWEEPS_tgt = toString(sum(toDouble(TARGET_BAL_FOR_SWEEPS))),",
				"          USED_CLEAN_SINGLE_TRAN_LIM_tgt = toString(sum(toDouble(USED_CLEAN_SINGLE_TRAN_LIM))),",
				"          USED_OC_CLN_SINGLE_TRAN_LIM_tgt = toString(sum(toDouble(USED_OC_CLN_SINGLE_TRAN_LIM))),",
				"          USED_SINGLE_TRAN_LIM_tgt = toString(sum(toDouble(USED_SINGLE_TRAN_LIM))),",
				"          WTAX_FLOOR_LIMIT_tgt = toString(sum(toDouble(WTAX_FLOOR_LIMIT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}