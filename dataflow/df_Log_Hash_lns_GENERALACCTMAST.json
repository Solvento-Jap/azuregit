				"          CHQ_ALWD_FLG as string,",
				"          CASH_EXCP_AMT_LIM as string,",
				"          CLG_EXCP_AMT_LIM as string,",
				"          XFER_EXCP_AMT_LIM as string,",
				"          CASH_CR_EXCP_AMT_LIM as string,",
				"          CLG_CR_EXCP_AMT_LIM as string,",
				"          XFER_CR_EXCP_AMT_LIM as string,",
				"          CASH_ABNRML_AMT_LIM as string,",
				"          CLG_ABNRML_AMT_LIM as string,",
				"          XFER_ABNRML_AMT_LIM as string,",
