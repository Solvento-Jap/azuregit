				"          CUSTINVESTMENTS as string,",
				"          CU_CUSTINVESTMENTS as string,",
				"          CUSTNETWORTH as string,",
				"          CU_CUSTNETWORTH as string,",
				"          CUSTASSETSASONDATE as string,",
				"          CU_CUSTASSETSASONDATE as string,",
				"          CUSTFINYEARENDMONTH as string,",
				"          EMPLOYERSNAME as string,",
				"          TOTALFUNDBASE as string,",
				"          CU_TOTALFUNDBASE as string,",
				"          TOTALNONFUNDBASE as string,",
				"          CU_TOTALNONFUNDBASE as string,",
				"          ADVANCEASONDATE as string,",
				"          OTHERLIMITS as string,",
				"          CU_OTHERLIMITS as string,",
				"          CUSTCASTE as string,",
				"          CUSTCASTE_CODE as string,",
				"          TDSTABLECODE as string,",
				"          SOURCEOFINCOME as string,",
				"          TDSTABLE as string,",
				"          TDSCUSTID as string,",
				"          TDSEXCEMPTENDDATE as string,",
				"          TDSEXCEMPTSUBMITDATE as string,",
				"          TDSEXCEMPTREFNO as string,",
				"          TDSEXCEMPTREMARKS as string,",
				"          EMPLOYERID as string,",
				"          NRERELATIVENAME as string,",
				"          NRECOUNTRYTYPE as string,",
				"          NRERELATIVECODE as string,",
				"          NRERELATIVE as string,",
				"          MARITAL_STATUS_CODE as string,",
				"          RESIDENCECOUNTRY_CODE as string,",
				"          NATIONALITY_CODE as string,",
				"          EMPLOYERID_CODE as string,",
				"          CHANNELSACCESSED as string,",
				"          CHECKSUM as string,",
				"          OUTSTANDING_MORTAGE as string,",
				"          CU_OUTSTANDING_MORTGAGE as string,",
				"          INCOME_FROM as string,",
				"          INCOME_TO as string,",
				"          INCOME_FREQ as string,",
				"          CU_INCOME_FROM as string,",
				"          CU_INCOME_TO as string,",
				"          ORGKEY as string,",
				"          IMMIGRATION_STATUS as string,",
				"          TILLDATE as string,",
				"          TMDATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_src') = $$),",
				"          each(match(like(name,'ANNUAL_%')&&notEquals(name,'ANNUAL_STOCK_BOND_INCOME')), concat($$, '_src') = $$),",
				"          each(match(like(name,'SAL%')), concat($$, '_src') = $$),",
				"          each(match(like(name,'SELFEMP%')&&notEquals(name,'SELFEMPTAXRETURNFIELD')), concat($$, '_src') = $$),",
				"          each(match(like(name,'TOTAL%')), concat($$, '_src') = $$),",
				"          BONUSCOMMISSIONSINCENTIVES_src = BONUSCOMMISSIONSINCENTIVES,",
				"          CUSTBUSINESSASSETS_src = CUSTBUSINESSASSETS,",
				"          CUSTDEPOSITSINOTHERBANKS_src = CUSTDEPOSITSINOTHERBANKS,",
				"          CUSTINVESTMENTS_src = CUSTINVESTMENTS,",
				"          CUSTNETWORTH_src = CUSTNETWORTH,",
				"          CUSTPROPERTYASSETS_src = CUSTPROPERTYASSETS,",
				"          INCOME_FROM_src = INCOME_FROM,",
				"          LOANREPAYMENTEXPENSES_src = LOANREPAYMENTEXPENSES,",
				"          NET_HOUSEHOLD_INCOME_src = NET_HOUSEHOLD_INCOME,",
				"          NET_SAVINGS_src = NET_SAVINGS,",
				"          OTHERLIMITS_src = OTHERLIMITS,",
				"          OUTSTANDING_MORTAGE_src = OUTSTANDING_MORTAGE,",
				"          VACANCYFACTOR_src = VACANCYFACTOR,",
				"          OVERTIMEINCOME_src = OVERTIMEINCOME,",
				"          INCOME_TO_src = INCOME_TO) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          each(match(like(name,'ANNUAL_%')&&notEquals(name,'ANNUAL_STOCK_BOND_INCOME')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          BONUSCOMMISSIONSINCENTIVES_tgt = toString(sum(toDouble(BONUSCOMMISSIONSINCENTIVES))),",
				"          CUSTBUSINESSASSETS_tgt = toString(sum(toDouble(CUSTBUSINESSASSETS))),",
				"          CUSTDEPOSITSINOTHERBANKS_tgt = toString(sum(toDouble(CUSTDEPOSITSINOTHERBANKS))),",
				"          CUSTINVESTMENTS_tgt = toString(sum(toDouble(CUSTINVESTMENTS))),",
				"          CUSTNETWORTH_tgt = toString(sum(toDouble(CUSTNETWORTH))),",
				"          CUSTPROPERTYASSETS_tgt = toString(sum(toDouble(CUSTPROPERTYASSETS))),",
				"          INCOME_FROM_tgt = toString(sum(toDouble(INCOME_FROM))),",
				"          INCOME_TO_tgt = toString(sum(toDouble(INCOME_TO))),",
				"          LOANREPAYMENTEXPENSES_tgt = toString(sum(toDouble(LOANREPAYMENTEXPENSES))),",
				"          NET_HOUSEHOLD_INCOME_tgt = toString(sum(toDouble(NET_HOUSEHOLD_INCOME))),",
				"          NET_SAVINGS_tgt = toString(sum(toDouble(NET_SAVINGS))),",
				"          OTHERLIMITS_tgt = toString(sum(toDouble(OTHERLIMITS))),",
				"          OUTSTANDING_MORTAGE_tgt = toString(sum(toDouble(OUTSTANDING_MORTAGE))),",
				"          each(match(like(name,'SAL%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          each(match(like(name,'SELFEMP%')&&notEquals(name,'SELFEMPTAXRETURNFIELD')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          each(match(like(name,'TOTAL%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          VACANCYFACTOR_tgt = toString(sum(toDouble(VACANCYFACTOR))),",
				"          OVERTIMEINCOME_tgt = toString(sum(toDouble(OVERTIMEINCOME)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
