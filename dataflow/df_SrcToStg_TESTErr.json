{
	"name": "df_SrcToStg_TESTErr",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "decrypt_csv",
						"type": "DatasetReference"
					},
					"name": "SRC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedfields2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string (FILE_NAME)",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     rowUrlColumn: 'FILE_NAME') ~> SRC",
				"SRC derive(TABLE_NAME = 'DEP_GENERALACCOUNTMASTER_TestingError',",
				"          BANK_CODE = 'CBC01',",
				"          SOURCE_CODE = 'DEP',",
				"          insert_dttm = currentTimestamp(),",
				"          FILE_NAME = 'CBC01_DEP_GENERALACCOUNTMASTER_005_20220816.CSV') ~> derivedfields2",
				"derivedfields2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: ('dev/Error_Logs'),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> STG"
			]
		}
	}
}