{
	"name": "df_Log_Hash_crm_MISCELLANEOUSINFO",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          MISCELLANEOUSID as string,",
				"          BANK_ID as string,",
				"          AML_KYC_ID as string,",
				"          STRTEXT31 as string,",
				"          STRTEXT32 as string,",
				"          AMOUNT1 as string,",
				"          CU_AMOUNT1 as string,",
				"          NONCUSTOMERID as string,",
				"          STRTEXT29 as string,",
				"          STRTEXT30 as string,",
				"          STRTEXT2_ALT1 as string,",
				"          STRTEXT3_ALT1 as string,",
				"          STRTEXT4_ALT1 as string,",
				"          ACCOUNTID as string,",
				"          DEMOGRAPHICID as string,",
				"          PSYCHOGRAPHICID as string,",
				"          ENTITYRELATIONSHIPID as string,",
				"          CONTACTID as string,",
				"          SUSPECTID as string,",
				"          TYPE as string,",
				"          EXTENSIONID as string,",
				"          STRTEXT1 as string,",
				"          STRTEXT2 as string,",
				"          STRTEXT3 as string,",
				"          STRTEXT4 as string,",
				"          STRTEXT5 as string,",
				"          STRTEXT6 as string,",
				"          STRTEXT7 as string,",
				"          STRTEXT8 as string,",
				"          STRTEXT9 as string,",
				"          STRTEXT10 as string,",
				"          INTINTEGER1 as string,",
				"          INTINTEGER2 as string,",
				"          INTINTEGER3 as string,",
				"          INTINTEGER4 as string,",
				"          INTINTEGER5 as string,",
				"          INTINTEGER6 as string,",
				"          INTINTEGER7 as string,",
				"          INTINTEGER8 as string,",
				"          INTINTEGER9 as string,",
				"          INTINTEGER10 as string,",
				"          INTINTEGER11 as string,",
				"          INTINTEGER12 as string,",
				"          INTINTEGER13 as string,",
				"          INTINTEGER14 as string,",
				"          INTINTEGER15 as string,",
				"          DTDATE1 as string,",
				"          DTDATE2 as string,",
				"          DTDATE3 as string,",
				"          DTDATE4 as string,",
				"          DTDATE5 as string,",
				"          DBFLOAT1 as string,",
				"          DBFLOAT2 as string,",
				"          DBFLOAT3 as string,",
				"          DBFLOAT4 as string,",
				"          DBFLOAT5 as string,",
				"          STRTEXT11 as string,",
				"          STRTEXT12 as string,",
				"          STRTEXT13 as string,",
				"          STRTEXT14 as string,",
				"          STRTEXT15 as string,",
				"          STRTEXT16 as string,",
				"          STRTEXT17 as string,",
				"          STRTEXT18 as string,",
				"          STRTEXT19 as string,",
				"          STRTEXT20 as string,",
				"          STRTEXT21 as string,",
				"          STRTEXT22 as string,",
				"          STRTEXT23 as string,",
				"          STRTEXT24 as string,",
				"          STRTEXT25 as string,",
				"          STRTEXT26 as string,",
				"          STRTEXT27 as string,",
				"          EMPLOYERID as string,",
				"          EMPLOYEEID as string,",
				"          CUSTOMERCURRENCY as string,",
				"          CREDITDISCOUNTPERCENT as string,",
				"          DEBITDISCOUNTPERCENT as string,",
				"          WITHHOLDTAXPCNT as string,",
				"          WITHHOLDTAXFLOORLMT as string,",
				"          COUNTRYOFISSUE as string,",
				"          CORE_CUST_ID as string,",
				"          TYPE_CODE as string,",
				"          STRTEXT1_CODE as string,",
				"          STRTEXT2_CODE as string,",
				"          COUNTRYOFISSUE_CODE as string,",
				"          ENTITY_CRE_FLG as string,",
				"          ORGKEY as string,",
				"          STRTEXT28 as string,",
				"          ENROLMENT_STATUS as string,",
				"          ENROL_START_DATE as string,",
				"          ENROL_CERT_DATE as string,",
				"          ENROL_SOURCE as string,",
				"          ENROL_SCHOOL_CODE as string,",
				"          CAMPUS_CODE as string,",
				"          TMDATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_src') = $$),",
				"          CREDITDISCOUNTPERCENT_src = CREDITDISCOUNTPERCENT,",
				"          DEBITDISCOUNTPERCENT_src = DEBITDISCOUNTPERCENT,",
				"          WITHHOLDTAXFLOORLMT_src = WITHHOLDTAXFLOORLMT,",
				"          WITHHOLDTAXPCNT_src = WITHHOLDTAXPCNT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          CREDITDISCOUNTPERCENT_tgt = toString(sum(toDouble(CREDITDISCOUNTPERCENT))),",
				"          DEBITDISCOUNTPERCENT_tgt = toString(sum(toDouble(DEBITDISCOUNTPERCENT))),",
				"          WITHHOLDTAXFLOORLMT_tgt = toString(sum(toDouble(WITHHOLDTAXFLOORLMT))),",
				"          WITHHOLDTAXPCNT_tgt = toString(sum(toDouble(WITHHOLDTAXPCNT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}