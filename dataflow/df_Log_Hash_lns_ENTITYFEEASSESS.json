{
	"name": "df_Log_Hash_lns_ENTITYFEEASSESS",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ENTITY_ID as string,",
				"          ENTITY_TYPE as string,",
				"          FEE_TYPE as string,",
				"          PTTM_EVENT_ID as string,",
				"          CRNCY_CODE as string,",
				"          ENTITY_CRE_FLG as string,",
				"          DEL_FLG as string,",
				"          SYS_CALC_FEE_AMT as string,",
				"          USER_CALC_FEE_AMT as string,",
				"          FEE_AMT_COLLECTED as string,",
				"          FEE_WAIVED as string,",
				"          SOL_ID as string,",
				"          FEE_DISTRIBUTABLE as string,",
				"          DEDUCTIBLE_FLG as string,",
				"          AMORTIZE_FLG as string,",
				"          AMORTIZE_METHOD as string,",
				"          AMORT_SCRIPT as string,",
				"          AMORT_TENOR_MONTHS as string,",
				"          LAST_AMORTIZE_DATE as string,",
				"          AMORTIZE_AMT as string,",
				"          CURR_AMORT_AMT as string,",
				"          PEND_AMORT_TENOR as string,",
				"          MULTIPLE_ASSESSMENT_FLG as string,",
				"          MAX_NO_OF_ASSESSMENTS as string,",
				"          NUMBER_OF_TIMES_ASSESSED as string,",
				"          ASSESS_FREQ_TYPE as string,",
				"          ASSESS_FREQ_WEEK_NUM as string,",
				"          ASSESS_FREQ_WEEK_DAY as string,",
				"          ASSESS_FREQ_START_DD as string,",
				"          ASSESS_FREQ_HLDY_STAT as string,",
				"          NEXT_ASSESSMENT_DATE as string,",
				"          LAST_ASSESSMENT_DATE as string,",
				"          TENOR_EFF_DATE as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          TS_CNT as string,",
				"          BANK_ID as string,",
				"          ASSESS_FREQ_CAL_BASE as string,",
				"          VAR_CHRGE_AMT as string,",
				"          TRAN_DATE as string,",
				"          TRAN_ID as string,",
				"          REVERSAL_DATE as string,",
				"          ASSESS_DMD_FLG as string,",
				"          RECOVERABLE_FLG as string,",
				"          NOTES as string,",
				"          FREE_TEXT as string,",
				"          FREE_CODE1 as string,",
				"          FREE_CODE2 as string,",
				"          AMORT_AMT_RECOGNIZED as string,",
				"          MTD_AMORT_AMT as string,",
				"          YTD_AMORT_AMT as string,",
				"          TRACKING_FEE_FLG as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          AMORT_AMT_RECOGNIZED_src = AMORT_AMT_RECOGNIZED,",
				"          AMORTIZE_AMT_src = AMORTIZE_AMT,",
				"          CURR_AMORT_AMT_src = CURR_AMORT_AMT,",
				"          FEE_AMT_COLLECTED_src = FEE_AMT_COLLECTED,",
				"          FEE_WAIVED_src = FEE_WAIVED,",
				"          MTD_AMORT_AMT_src = MTD_AMORT_AMT,",
				"          SYS_CALC_FEE_AMT_src = SYS_CALC_FEE_AMT,",
				"          USER_CALC_FEE_AMT_src = USER_CALC_FEE_AMT,",
				"          VAR_CHRGE_AMT_src = VAR_CHRGE_AMT,",
				"          YTD_AMORT_AMT_src = YTD_AMORT_AMT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          AMORT_AMT_RECOGNIZED_tgt = toString(sum(toDouble(AMORT_AMT_RECOGNIZED))),",
				"          AMORTIZE_AMT_tgt = toString(sum(toDouble(AMORTIZE_AMT))),",
				"          CURR_AMORT_AMT_tgt = toString(sum(toDouble(CURR_AMORT_AMT))),",
				"          FEE_AMT_COLLECTED_tgt = toString(sum(toDouble(FEE_AMT_COLLECTED))),",
				"          FEE_WAIVED_tgt = toString(sum(toDouble(FEE_WAIVED))),",
				"          MTD_AMORT_AMT_tgt = toString(sum(toDouble(MTD_AMORT_AMT))),",
				"          SYS_CALC_FEE_AMT_tgt = toString(sum(toDouble(SYS_CALC_FEE_AMT))),",
				"          USER_CALC_FEE_AMT_tgt = toString(sum(toDouble(USER_CALC_FEE_AMT))),",
				"          VAR_CHRGE_AMT_tgt = toString(sum(toDouble(VAR_CHRGE_AMT))),",
				"          YTD_AMORT_AMT_tgt = toString(sum(toDouble(YTD_AMORT_AMT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}