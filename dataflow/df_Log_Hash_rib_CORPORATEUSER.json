{
	"name": "df_Log_Hash_rib_CORPORATEUSER",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          AC_MIN_BAL as string,",
				"          AC_OPN_DT as string,",
				"          ACC_FMT as string,",
				"          ACC_VIEW_IND as string,",
				"          ADM_ID as string,",
				"          ALERT_CUST_ID as string,",
				"          ALERT_USER_CATEGORY as string,",
				"          AMT_FMT_CD as string,",
				"          ANNIVERSARY_DATE as string,",
				"          AUTH_USER as string,",
				"          AUTHENTICATION_MODE as string,",
				"          AUTHORIZATION_MODE as string,",
				"          AVAIL_LANG as string,",
				"          BANK_ID as string,",
				"          BAY_USER_ID as string,",
				"          BRAND_ID as string,",
				"          C_ADDR1 as string,",
				"          C_ADDR2 as string,",
				"          C_ADDR3 as string,",
				"          C_CITY as string,",
				"          C_CNTRY as string,",
				"          C_EMAIL_ID as string,",
				"          C_F_NAME as string,",
				"          C_FAX_NO as string,",
				"          C_GENDER as string,",
				"          C_L_NAME as string,",
				"          C_M_NAME as string,",
				"          C_M_PHONE_NO as string,",
				"          C_PHONE_NO as string,",
				"          C_RES_STATUS as string,",
				"          C_STATE as string,",
				"          C_ZIP as string,",
				"          CAL_TYPE as string,",
				"          CATEGORY_CODE as string,",
				"          CONCUR_ACCESS_FLG as string,",
				"          CORP_USER as string,",
				"          CORP_USER_TYPE as string,",
				"          CORRESPONDENCE_ADDRESS as string,",
				"          CP_ENTITY_COUNTER as string,",
				"          CUST_ASST_MENU_PRF as string,",
				"          CUST_ID as string,",
				"          CUST_STATUS as string,",
				"          DATE_OF_BIRTH as string,",
				"          DB_TS as string,",
				"          DDT_FROM as string,",
				"          DDT_TO as string,",
				"          DEFAULT_APPROVER as string,",
				"          DEL_FLG as string,",
				"          DIG_SIGN_ENABLED_FLG as string,",
				"          DIG_SIGN_NO_OF_ATMPTS as string,",
				"          DIV_ACC_IND as string,",
				"          DT_FMT as string,",
				"          EDUCATIONAL_LEVEL as string,",
				"          EXT_ALERT as string,",
				"          FORCE_PWD_CHANGE_FLG as string,",
				"          FORCE_QNA_CHANGE_FLG as string,",
				"          FORCE_TERMS_FLAG as string,",
				"          FORCE_TXN_PASSWORD_CHANGE_FLG as string,",
				"          FREE_TEXT_1 as string,",
				"          FREE_TEXT_2 as string,",
				"          FREE_TEXT_3 as string,",
				"          FREE_TEXT_4 as string,",
				"          INC_RNG_CD as string,",
				"          INDIVIDUAL_ID as string,",
				"          LANG_C_ADDR1 as string,",
				"          LANG_C_ADDR2 as string,",
				"          LANG_C_ADDR3 as string,",
				"          LANG_C_CITY as string,",
				"          LANG_C_F_NAME as string,",
				"          LANG_C_L_NAME as string,",
				"          LANG_C_M_NAME as string,",
				"          LANG_ID as string,",
				"          LAST_TXN_DATE as string,",
				"          LAST_UNSUCCESSFUL_LOGIN_TIME as string,",
				"          LIMIT_SCHEME as string,",
				"          LOC_ACC_IND as string,",
				"          LOGIN_ALLOWED as string,",
				"          LOGIN_CERT_MATCH_REQD as string,",
				"          LOGIN_DATE as string,",
				"          LOGOFF_DATE as string,",
				"          MARITAL_STATUS as string,",
				"          MENU_PRF as string,",
				"          MULTI_CRN_TXN_ALLOWED as string,",
				"          NICK_NAME as string,",
				"          NO_OF_ATMPTS as string,",
				"          NO_OF_TXN_ATMPTS as string,",
				"          NUM_HOUSEHOLD as string,",
				"          OCCUPATION as string,",
				"          ONLINE_REG_PWD as string,",
				"          OOF_FLG as string,",
				"          P_BRANCH_ID as string,",
				"          P_DIV_ID as string,",
				"          PAGE_SCHEME as string,",
				"          PAN_NATIONAL_ID as string,",
				"          PASSPORT_DETAILS as string,",
				"          PASSPORT_EXPIRY_DATE as string,",
				"          PASSPORT_ISSUE_DATE as string,",
				"          PASSPORT_NUMBER as string,",
				"          PRIM_ACID as string,",
				"          PWD as string,",
				"          PWD_ENABLED_FLAG as string,",
				"          PWD_EXP_DATE as string,",
				"          PWD_RESET_DATE as string,",
				"          R_CRE_ID as string,",
				"          R_CRE_TIME as string,",
				"          R_MOD_ID as string,",
				"          R_MOD_TIME as string,",
				"          RANGE_LIMIT_SCHEME as string,",
				"          RET_AUTH_MODE_PREC as string,",
				"          SALUTATION as string,",
				"          SCHEME_ID as string,",
				"          SESSION_ID as string,",
				"          SMS_ALERT as string,",
				"          SMS_NO_OF_ATMPTS as string,",
				"          SMS_PWD as string,",
				"          TOT_NUM_LOGIN as string,",
				"          TRAN_AUTH_SCHEME as string,",
				"          TRANSACTION_ALLOWED as string,",
				"          TXN_CERT_MATCH_REQD as string,",
				"          TXN_LIMIT as string,",
				"          TXN_LMT_CURRENCY as string,",
				"          TXN_PWD as string,",
				"          TXN_PWD_ENABLED_FLG as string,",
				"          TXN_PWD_EXP_DATE as string,",
				"          TXN_PWD_RESET_DATE as string,",
				"          USER_ALERT_REGISTRATION_FLAG as string,",
				"          USER_ENCRYPTION_KEY as string,",
				"          USER_TXN_TYPES as string,",
				"          USER_TYPE as string,",
				"          USR_INT_CD as string,",
				"          VIRTUAL_USER_FLG as string,",
				"          WF_RULE_SELECT_AUTH as string,",
				"          LAST6_ACCT_NUM as string,",
				"          LAST6_FREE_TEXT_2 as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          AC_MIN_BAL_src = AC_MIN_BAL) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          AC_MIN_BAL_tgt = toString(sum(toDouble(AC_MIN_BAL)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toInteger(Source)),",
				"          Target = sum(toInteger(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}