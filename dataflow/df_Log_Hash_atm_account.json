{
	"name": "df_Log_Hash_atm_account",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ACN_ID as string,",
				"          ACN_ATP_ID as string,",
				"          ACN_ACCOUNT_NUMBER as string,",
				"          ACN_ACCOUNT_NUMBER_MASKED as string,",
				"          ACN_APD_ID as string,",
				"          ACN_STATUS as string,",
				"          ACN_STATUS_DATE as string,",
				"          ACN_DELINQUENCY as string,",
				"          ACN_DELINQUENCY_DATE as string,",
				"          ACN_CUR_ID as string,",
				"          ACN_AMT_CODE_1 as string,",
				"          ACN_BALANCE_1 as string,",
				"          ACN_AMT_CODE_2 as string,",
				"          ACN_BALANCE_2 as string,",
				"          ACN_AMT_CODE_3 as string,",
				"          ACN_BALANCE_3 as string,",
				"          ACN_LAST_BATCH_UPDATE_DATE as string,",
				"          ACN_CREDIT_LIMIT as string,",
				"          ACN_TEMP_CREDIT_LIMIT as string,",
				"          ACN_TEMP_CREDIT_LIMIT_DATE as string,",
				"          ACN_GUARANTEE_AMOUNT as string,",
				"          ACN_GUARANTEE_TYPE as string,",
				"          ACN_GUARANTEE_EXPIRY_DATE as string,",
				"          ACN_LAST_FEP_HOST_TRACE_NBR as string,",
				"          ACN_LAST_HOST_FEP_TRACE_NBR as string,",
				"          ACN_SPECIFIC_DATA as string,",
				"          ACN_PART_NO as string,",
				"          ACN_CUSTOM_DATA as string,",
				"          ACN_STATUS_2 as string,",
				"          ACN_STATUS_2_DATE as string,",
				"          ACN_LAST_SOURCE as string,",
				"          ACN_LAST_TERMINAL_ID as string,",
				"          ACN_FEP_HOST_SUM as string,",
				"          ACN_HOST_FEP_SUM as string,",
				"          ACN_PAN as string,",
				"          ACN_LAST_BATCH_SESSION as string,",
				"          ACN_FUNCTIONS as string,",
				"          ACN_OVERRIDE_PERMISSION as string,",
				"          ACN_ISS_ID as string,",
				"          ACN_LIMIT_CONFIG as string,",
				"          ACN_LAST_UPDATE_TS as string,",
				"          ACN_ACCOUNT_NUMBER_EKY_ID as string,",
				"          ACN_PAN_EKY_ID as string,",
				"          FileName as string,",
				"          TABLE_NAME as string,",
				"          FILE_NAME as string,",
				"          BANK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          ACN_BALANCE_1_src = ACN_BALANCE_1,",
				"          ACN_BALANCE_2_src = ACN_BALANCE_2,",
				"          ACN_BALANCE_3_src = ACN_BALANCE_3) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          ACN_BALANCE_1_tgt = toString(sum(toDouble(ACN_BALANCE_1))),",
				"          ACN_BALANCE_2_tgt = toString(sum(toDouble(ACN_BALANCE_2))),",
				"          ACN_BALANCE_3_tgt = toString(sum(toDouble(ACN_BALANCE_3)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', ''))) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toDouble(Source)),",
				"          Target = sum(toDouble(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}