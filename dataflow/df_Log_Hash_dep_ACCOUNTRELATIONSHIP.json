{
	"name": "df_Log_Hash_dep_ACCOUNTRELATIONSHIP",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ACID as string,",
				"          ACCT_POA_AS_SRL_NUM as string,",
				"          ACCT_POA_AS_REC_TYPE as string,",
				"          ACCT_POA_AS_NAME as string,",
				"          ACCT_POA_AS_DESIG as string,",
				"          ACCT_POA_AS_RMKS as string,",
				"          ACCT_POA_AS_AMT_ALWD as string,",
				"          START_DATE as string,",
				"          END_DATE as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          CUST_ID as string,",
				"          CUST_RELTN_CODE as string,",
				"          PASS_SHEET_FLG as string,",
				"          SI_FLG as string,",
				"          TD_MATRTY_FLG as string,",
				"          LOAN_OVRDUE_FLG as string,",
				"          NMA_KEY_TYPE as string,",
				"          NMA_KEY_ID as string,",
				"          DEL_FLG as string,",
				"          MODE_OF_DESPATCH as string,",
				"          TS_CNT as string,",
				"          SCHM_TYPE as string,",
				"          XCLUDE_FOR_COMB_STMT as string,",
				"          STMT_CUST_ID as string,",
				"          INT_ADV_FLG as string,",
				"          INTCERT_PRINT_FLG as string,",
				"          GUARANTOR_LIAB_PCNT as string,",
				"          GUARANTOR_LIAB_SEQ as string,",
				"          INTRADAY_STMNT_REQD as string,",
				"          BANK_ID as string,",
				"          CUST_PHONE_TYPE as string,",
				"          CUST_EMAIL_TYPE as string,",
				"          RELATED_PARTY_TYPE as string,",
				"          PROFIT_CERT_FLG as string,",
				"          PREF_LANG_CODE as string,",
				"          PREF_LANG_ACCT_POA_AS_RMKS as string,",
				"          ALT1_ACCT_POA_AS_NAME as string,",
				"          RPARTY_STMT_PRNT_CHRG_FLG as string,",
				"          RPARTY_RGLR_STMT_CHRG_ID as string,",
				"          RPARTY_DUP_STMT_CHRG_ID as string,",
				"          WTAX_NOTICE_RCV_DATE as string,",
				"          WTAX_WAIVER_START_DATE as string,",
				"          WTAX_WAIVER_END_DATE as string,",
				"          TAX_CERT_NUM as string,",
				"          TAX_FORM_PARTICULARS as string,",
				"          TAX_CERT_SUBMISSION_DATE as string,",
				"          ENTITY_CRE_FLG as string,",
				"          TAX_EVENT as string,",
				"          REQUESTED_BY as string,",
				"          TAX_EVENT_REASON_CODE as string,",
				"          TAX_MARKER as string,",
				"          CORP_REP_CIF_ID as string,",
				"          MINOR_MAJOR_LET_GEN_FLG as string,",
				"          CHNGD_DUE_TO_ASSUMPTN_FLG as string,",
				"          REASON_FOR_RELEASE as string,",
				"          FileName as string,",
				"          TABLE_NAME as string,",
				"          FILE_NAME as string,",
				"          BANK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          ACCT_POA_AS_AMT_ALWD_src = ACCT_POA_AS_AMT_ALWD,",
				"          GUARANTOR_LIAB_PCNT_src = GUARANTOR_LIAB_PCNT,",
				"          TS_CNT_src = TS_CNT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          ACCT_POA_AS_AMT_ALWD_tgt = toString(sum(toDouble(ACCT_POA_AS_AMT_ALWD))),",
				"          GUARANTOR_LIAB_PCNT_tgt = toString(sum(toDouble(GUARANTOR_LIAB_PCNT))),",
				"          TS_CNT_tgt = toString(sum(toDouble(TS_CNT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', ''))) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}