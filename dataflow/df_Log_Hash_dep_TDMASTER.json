{
	"name": "df_Log_Hash_dep_TDMASTER",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ACID as string,",
				"          DEPOSIT_PERIOD_MTHS as string,",
				"          DEPOSIT_PERIOD_DAYS as string,",
				"          OPEN_EFFECTIVE_DATE as string,",
				"          MATURITY_DATE as string,",
				"          DEPOSIT_AMOUNT as string,",
				"          MATURITY_AMOUNT as string,",
				"          ADJUSTED_COMM_AMT as string,",
				"          DEPOSIT_STATUS as string,",
				"          ACCT_SEGMENT as string,",
				"          SAFE_CUSTODY_FLG as string,",
				"          NOMINEE_PRINT_FLG as string,",
				"          PRINTING_FLG as string,",
				"          SPL_CATG_IND as string,",
				"          XFER_IN_IND as string,",
				"          LAST_INT_PROVISION_DATE as string,",
				"          LAST_REPAYMENT_DATE as string,",
				"          CUMULATIVE_PRINCIPAL as string,",
				"          CUMULATIVE_INSTL_PAID as string,",
				"          CUMULATIVE_REPAYMENT_PAID as string,",
				"          CUMULATIVE_INT_PAID as string,",
				"          CUMULATIVE_INT_CREDITED as string,",
				"          INT_ACCRUAL_FLG as string,",
				"          RELATED_ACID as string,",
				"          PENAL_PCNT as string,",
				"          REPAYMENT_ACID as string,",
				"          LOAN_ACID as string,",
				"          PENALTY_AMOUNT as string,",
				"          PENALTY_RECOVERED as string,",
				"          PENALTY_WAIVED as string,",
				"          AGENT_EMP_IND as string,",
				"          AGENT_CODE as string,",
				"          MATURITY_NOTICE_DATE as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          TDS_AMT as string,",
				"          INT_CR_RATE_CODE as string,",
				"          NOSTRO_VALUE_DATE as string,",
				"          OVERDUE_INT_AMT as string,",
				"          CLS_VALUE_DATE as string,",
				"          AUTO_RENEWAL_FLG as string,",
				"          PERD_MTHS_FOR_AUTO_RENEW as string,",
				"          PERD_DAYS_FOR_AUTO_RENEW as string,",
				"          MAX_AUTO_RENEWAL_ALLOWED as string,",
				"          AUTO_RENEWED_COUNTER as string,",
				"          CLOSE_ON_MATURITY_FLG as string,",
				"          AUTO_RENEWAL_SCHM_CODE as string,",
				"          AUTO_RENEWAL_INT_TBL_CODE as string,",
				"          AUTO_RENWL_GL_SUBHEAD_CODE as string,",
				"          RENEWAL_CRNCY as string,",
				"          RENEWAL_RATE_CODE as string,",
				"          RENEWAL_RATE as string,",
				"          TS_CNT as string,",
				"          SOL_ID as string,",
				"          ORIGINAL_DEPOSIT_AMOUNT as string,",
				"          NOTICE_PERIOD_MNTHS as string,",
				"          NOTICE_PERIOD_DAYS as string,",
				"          NOTICE_DATE as string,",
				"          ACCT_CLOSE_INTEREST_RATE as string,",
				"          TRAN_ID as string,",
				"          TXOD_REGL_OVERDRAFT as string,",
				"          ORIGINAL_MATURITY_AMOUNT as string,",
				"          REN_SRL_NUM as string,",
				"          DEPOSIT_TYPE as string,",
				"          LINK_OPER_ACCOUNT as string,",
				"          OUTFLOW_MULTIPLE_AMT as string,",
				"          AVAIL_DEPOSIT_AMT as string,",
				"          CUST_INST_TYPE as string,",
				"          TDS_TOTAL_FROM_SELF_ACCT as string,",
				"          INT_FLOW_FREQ_MTHS as string,",
				"          INT_FLOW_FREQ_DAYS as string,",
				"          TAM_CRNCY_CODE as string,",
				"          MASTER_B2K_ID as string,",
				"          ACCT_STATUS as string,",
				"          ACCT_STATUS_DATE as string,",
				"          FIXED_INSTALLMENT_AMT as string,",
				"          NRML_INSTALLMENT_PCNT as string,",
				"          INSTALLMENT_BASIS as string,",
				"          MAX_MISS_CONTRIB_ALLOW as string,",
				"          AUTO_CLOSURE_OF_IRREGULAR_ACCT as string,",
				"          TOTAL_NO_OF_MISS_CONTRIB as string,",
				"          ACCT_IRREGULAR_STATUS as string,",
				"          ACCT_IRREGULAR_STATUS_DATE as string,",
				"          CUMULATIVE_NRML_INSTL_PAID as string,",
				"          CUMULATIVE_INITIAL_DEP_PAID as string,",
				"          CUMULATIVE_TOP_UP_PAID as string,",
				"          AUTO_CLOSURE_OF_ZERO_BAL_MNTHS as string,",
				"          AUTO_CLOSURE_OF_ZERO_BAL_DAYS as string,",
				"          BANK_ID as string,",
				"          PENALTY_CHARGE_EVENT_ID as string,",
				"          NUM_OF_GRACE_DAYS_UTIL as string,",
				"          ABSOLUTE_PENAL_INT_AMT as string,",
				"          LAST_BONUS_RUN_DATE as string,",
				"          LAST_CALC_BONUS_AMOUNT as string,",
				"          BONUS_UPTO_DATE as string,",
				"          NEXT_BONUS_RUN_DATE as string,",
				"          NRML_INT_PAID_TIL_LST_BONUS as string,",
				"          BONUS_CYCLE as string,",
				"          LAST_CALC_BONUS_PCNT as string,",
				"          ACCT_CLS_REASON_CODE as string,",
				"          LAST_LOCAL_CAL_UPDATE as string,",
				"          LOC_DEPOSIT_PERIOD_MTHS as string,",
				"          LOC_DEPOSIT_PERIOD_DAYS as string,",
				"          ACCT_CLOSE_FWC_NUM as string,",
				"          ACCT_CLOSE_FWC_SOL_ID as string,",
				"          LAST_NON_FIN_TRAN_DATE as string,",
				"          COMMITMENT_AMT as string,",
				"          DEPOSIT_WINDOW_END_DATE as string,",
				"          INT_RATE_BASED_ON as string,",
				"          CUMULATIVE_PART_CLOSE_AMT as string,",
				"          CUMULATIVE_INT_WITHDRAWN as string,",
				"          LOSS_OF_INT as string,",
				"          LAST_RENEWAL_INST_MOD_DATE as string,",
				"          LAST_RENEWAL_INST_MOD_INT_VER as string,",
				"          FLOW_CODE as string,",
				"          FLOW_FREQ_MTHS as string,",
				"          FLOW_FREQ_DAYS as string,",
				"          CUMULATIVE_BONUS_PAID as string,",
				"          FIRST_INT_FLOW_DATE as string,",
				"          OUTFLOW_TDS_AMOUNT as string,",
				"          ORIG_OPEN_EFFECTIVE_DATE as string,",
				"          TRAN_REASON_CODE_DR1 as string,",
				"          TRAN_REASON_CODE_DR2 as string,",
				"          FLOW_CODE_DR as string,",
				"          TRAN_REASON_CODE_CR as string,",
				"          FLOW_CODE_CR as string,",
				"          CURR_YR_CONTRI as string,",
				"          PREV_YR_CONTRI as string,",
				"          NO_OF_BUMP_UP_UTLZD as string,",
				"          ORIGINAL_MATURITY_DATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match((like(name,'%AMT%')||like(name,'%AMOUNT%'))&&notEquals(name,'CUMULATIVE_PART_CLOSE_AMT')), concat($$, '_src') = $$),",
				"          each(match(like(name,'CUMULATIVE%')), concat($$, '_src') = $$),",
				"          ACCT_CLOSE_INTEREST_RATE_src = ACCT_CLOSE_INTEREST_RATE,",
				"          AUTO_CLOSURE_OF_ZERO_BAL_DAYS_src = AUTO_CLOSURE_OF_ZERO_BAL_DAYS,",
				"          AUTO_CLOSURE_OF_ZERO_BAL_MNTHS_src = AUTO_CLOSURE_OF_ZERO_BAL_MNTHS,",
				"          AUTO_RENEWED_COUNTER_src = AUTO_RENEWED_COUNTER,",
				"          BONUS_CYCLE_src = BONUS_CYCLE,",
				"          BONUS_UPTO_DATE_src = BONUS_UPTO_DATE,",
				"          CURR_YR_CONTRI_src = CURR_YR_CONTRI,",
				"          DEPOSIT_PERIOD_DAYS_src = DEPOSIT_PERIOD_DAYS,",
				"          DEPOSIT_PERIOD_MTHS_src = DEPOSIT_PERIOD_MTHS,",
				"          FLOW_FREQ_DAYS_src = FLOW_FREQ_DAYS,",
				"          FLOW_FREQ_MTHS_src = FLOW_FREQ_MTHS,",
				"          INT_FLOW_FREQ_DAYS_src = INT_FLOW_FREQ_DAYS,",
				"          INT_FLOW_FREQ_MTHS_src = INT_FLOW_FREQ_MTHS,",
				"          LAST_CALC_BONUS_PCNT_src = LAST_CALC_BONUS_PCNT,",
				"          LOC_DEPOSIT_PERIOD_DAYS_src = LOC_DEPOSIT_PERIOD_DAYS,",
				"          LOC_DEPOSIT_PERIOD_MTHS_src = LOC_DEPOSIT_PERIOD_MTHS,",
				"          LOSS_OF_INT_src = LOSS_OF_INT,",
				"          MAX_AUTO_RENEWAL_ALLOWED_src = MAX_AUTO_RENEWAL_ALLOWED,",
				"          MAX_MISS_CONTRIB_ALLOW_src = MAX_MISS_CONTRIB_ALLOW,",
				"          NO_OF_BUMP_UP_UTLZD_src = NO_OF_BUMP_UP_UTLZD,",
				"          NOTICE_PERIOD_DAYS_src = NOTICE_PERIOD_DAYS,",
				"          NOTICE_PERIOD_MNTHS_src = NOTICE_PERIOD_MNTHS,",
				"          NRML_INSTALLMENT_PCNT_src = NRML_INSTALLMENT_PCNT,",
				"          NRML_INT_PAID_TIL_LST_BONUS_src = NRML_INT_PAID_TIL_LST_BONUS,",
				"          NUM_OF_GRACE_DAYS_UTIL_src = NUM_OF_GRACE_DAYS_UTIL,",
				"          PENAL_PCNT_src = PENAL_PCNT,",
				"          PENALTY_RECOVERED_src = PENALTY_RECOVERED,",
				"          PENALTY_WAIVED_src = PENALTY_WAIVED,",
				"          PERD_DAYS_FOR_AUTO_RENEW_src = PERD_DAYS_FOR_AUTO_RENEW,",
				"          PERD_MTHS_FOR_AUTO_RENEW_src = PERD_MTHS_FOR_AUTO_RENEW,",
				"          PREV_YR_CONTRI_src = PREV_YR_CONTRI,",
				"          RENEWAL_RATE_src = RENEWAL_RATE,",
				"          TDS_TOTAL_FROM_SELF_ACCT_src = TDS_TOTAL_FROM_SELF_ACCT,",
				"          TOTAL_NO_OF_MISS_CONTRIB_src = TOTAL_NO_OF_MISS_CONTRIB,",
				"          TS_CNT_src = TS_CNT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match((like(name,'%AMT%')||like(name,'%AMOUNT%'))&&notEquals(name,'CUMULATIVE_PART_CLOSE_AMT')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          ACCT_CLOSE_INTEREST_RATE_tgt = toString(sum(toDouble(ACCT_CLOSE_INTEREST_RATE))),",
				"          AUTO_CLOSURE_OF_ZERO_BAL_DAYS_tgt = toString(sum(toDouble(AUTO_CLOSURE_OF_ZERO_BAL_DAYS))),",
				"          AUTO_CLOSURE_OF_ZERO_BAL_MNTHS_tgt = toString(sum(toDouble(AUTO_CLOSURE_OF_ZERO_BAL_MNTHS))),",
				"          AUTO_RENEWED_COUNTER_tgt = toString(sum(toDouble(AUTO_RENEWED_COUNTER))),",
				"          BONUS_CYCLE_tgt = toString(sum(toDouble(BONUS_CYCLE))),",
				"          BONUS_UPTO_DATE_tgt = toString(sum(toDouble(BONUS_UPTO_DATE))),",
				"          CURR_YR_CONTRI_tgt = toString(sum(toDouble(CURR_YR_CONTRI))),",
				"          each(match(like(name,'CUMULATIVE%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          DEPOSIT_PERIOD_DAYS_tgt = toString(sum(toDouble(DEPOSIT_PERIOD_DAYS))),",
				"          DEPOSIT_PERIOD_MTHS_tgt = toString(sum(toDouble(DEPOSIT_PERIOD_MTHS))),",
				"          FLOW_FREQ_DAYS_tgt = toString(sum(toDouble(FLOW_FREQ_DAYS))),",
				"          FLOW_FREQ_MTHS_tgt = toString(sum(toDouble(FLOW_FREQ_MTHS))),",
				"          INT_FLOW_FREQ_DAYS_tgt = toString(sum(toDouble(INT_FLOW_FREQ_DAYS))),",
				"          INT_FLOW_FREQ_MTHS_tgt = toString(sum(toDouble(INT_FLOW_FREQ_MTHS))),",
				"          LAST_CALC_BONUS_PCNT_tgt = toString(sum(toDouble(LAST_CALC_BONUS_PCNT))),",
				"          LOC_DEPOSIT_PERIOD_DAYS_tgt = toString(sum(toDouble(LOC_DEPOSIT_PERIOD_DAYS))),",
				"          LOC_DEPOSIT_PERIOD_MTHS_tgt = toString(sum(toDouble(LOC_DEPOSIT_PERIOD_MTHS))),",
				"          LOSS_OF_INT_tgt = toString(sum(toDouble(LOSS_OF_INT))),",
				"          MAX_AUTO_RENEWAL_ALLOWED_tgt = toString(sum(toDouble(MAX_AUTO_RENEWAL_ALLOWED))),",
				"          MAX_MISS_CONTRIB_ALLOW_tgt = toString(sum(toDouble(MAX_MISS_CONTRIB_ALLOW))),",
				"          NO_OF_BUMP_UP_UTLZD_tgt = toString(sum(toDouble(NO_OF_BUMP_UP_UTLZD))),",
				"          NOTICE_PERIOD_DAYS_tgt = toString(sum(toDouble(NOTICE_PERIOD_DAYS))),",
				"          NOTICE_PERIOD_MNTHS_tgt = toString(sum(toDouble(NOTICE_PERIOD_MNTHS))),",
				"          NRML_INSTALLMENT_PCNT_tgt = toString(sum(toDouble(NRML_INSTALLMENT_PCNT))),",
				"          NRML_INT_PAID_TIL_LST_BONUS_tgt = toString(sum(toDouble(NRML_INT_PAID_TIL_LST_BONUS))),",
				"          NUM_OF_GRACE_DAYS_UTIL_tgt = toString(sum(toDouble(NUM_OF_GRACE_DAYS_UTIL))),",
				"          PENAL_PCNT_tgt = toString(sum(toDouble(PENAL_PCNT))),",
				"          PENALTY_RECOVERED_tgt = toString(sum(toDouble(PENALTY_RECOVERED))),",
				"          PERD_DAYS_FOR_AUTO_RENEW_tgt = toString(sum(toDouble(PERD_DAYS_FOR_AUTO_RENEW))),",
				"          PERD_MTHS_FOR_AUTO_RENEW_tgt = toString(sum(toDouble(PERD_MTHS_FOR_AUTO_RENEW))),",
				"          PREV_YR_CONTRI_tgt = toString(sum(toDouble(PREV_YR_CONTRI))),",
				"          RENEWAL_RATE_tgt = toString(sum(toDouble(RENEWAL_RATE))),",
				"          TDS_TOTAL_FROM_SELF_ACCT_tgt = toString(sum(toDouble(TDS_TOTAL_FROM_SELF_ACCT))),",
				"          TOTAL_NO_OF_MISS_CONTRIB_tgt = toString(sum(toDouble(TOTAL_NO_OF_MISS_CONTRIB))),",
				"          TS_CNT_tgt = toString(sum(toDouble(TS_CNT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', ''))) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}