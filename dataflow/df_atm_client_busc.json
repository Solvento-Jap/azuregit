{
	"name": "df_atm_client_busc",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_BUSC",
						"type": "DatasetReference"
					},
					"name": "BUSC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parameter1 as string",
				"}",
				"source(output(",
				"          CLT_ID as decimal(38,0),",
				"          CLT_UUID as string,",
				"          CLT_INS_ID as decimal(38,0),",
				"          CLT_BRN_ID as decimal(38,0),",
				"          CLT_CIF_NUMBER as string,",
				"          CLT_PARENT_CLT_ID as decimal(38,0),",
				"          CLT_TITLE as string,",
				"          CLT_FIRST_NAME as string,",
				"          CLT_LAST_NAME as string,",
				"          CLT_GENDER as string,",
				"          CLT_DOB as string,",
				"          CLT_EMBOSSING_NAME as string,",
				"          CLT_MOBILE_NUMBER as string,",
				"          CLT_OTHER_NUMBER as string,",
				"          CLT_EMAIL_ADDRESS as string,",
				"          CLT_MARITAL_STATUS as string,",
				"          CLT_MOTHER_MAIDEN_NAME as string,",
				"          CLT_DOC_ID as decimal(38,0),",
				"          CLT_ID_PROOF as string,",
				"          CLT_STS_ID as decimal(38,0),",
				"          CLT_CREATED_BY as decimal(38,0),",
				"          CLT_CREATED_TS as timestamp,",
				"          CLT_UPDATED_BY as decimal(38,0),",
				"          CLT_UPDATED_TS as timestamp,",
				"          CLT_AUDIT_LOG as string,",
				"          CLT_CCL_ID as decimal(32,0),",
				"          CLT_NATIONALITY as string,",
				"          CLT_ID_PROOF_DOC as string,",
				"          CLT_MIDDLE_NAME as string,",
				"          CLT_WORK_PHONE_NO as string,",
				"          CLT_KEY_ROTATION_NO as decimal(10,0),",
				"          CLT_CAF_UPDATE as decimal(1,0),",
				"          isActive as integer,",
				"          isLatest as integer,",
				"          BNK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> BUSC",
				"filter1 derive(CLT_DOB = left(toString(CLT_DOB), 6),",
				"          BANK_CODE = BNK_CODE) ~> derivedColumn1",
				"BUSC filter(isLatest  == 1) ~> filter1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: (concat('dev/Error_Logs/SYN/', $parameter1)),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> SYN"
			]
		}
	}
}