				"          AVAILABLECRLIMIT_src = AVAILABLECRLIMIT,",
				"          CURRENTCREXPOSURE_src = CURRENTCREXPOSURE,",
				"          CUSTOMERPROFITABILITY_src = CUSTOMERPROFITABILITY,",
				"          OFFLINE_CUM_DEBIT_LIMIT_src = OFFLINE_CUM_DEBIT_LIMIT,",
				"          POTENTIALCRLINE_src = POTENTIALCRLINE,",
				"          TOTALCREXPOSURE_src = TOTALCREXPOSURE) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          AMOUNT1_tgt = toString(sum(toDouble(AMOUNT1))),",
				"          AMOUNT2_tgt = toString(sum(toDouble(AMOUNT2))),",
				"          AMOUNT3_tgt = toString(sum(toDouble(AMOUNT3))),",
				"          AMOUNT4_tgt = toString(sum(toDouble(AMOUNT4))),",
				"          AMOUNT5_tgt = toString(sum(toDouble(AMOUNT5))),",
				"          AMOUNT6_tgt = toString(sum(toDouble(AMOUNT6))),",
				"          AMOUNT7_tgt = toString(sum(toDouble(AMOUNT7))),",
				"          AMOUNT8_tgt = toString(sum(toDouble(AMOUNT8))),",
				"          AMOUNT9_tgt = toString(sum(toDouble(AMOUNT9))),",
				"          AMOUNT10_tgt = toString(sum(toDouble(AMOUNT10))),",
				"          AMOUNT11_tgt = toString(sum(toDouble(AMOUNT11))),",
				"          AMOUNT12_tgt = toString(sum(toDouble(AMOUNT12))),",
				"          ANNUALREVENUE_tgt = toString(sum(toDouble(ANNUALREVENUE))),",
				"          AVAILABLECRLIMIT_tgt = toString(sum(toDouble(AVAILABLECRLIMIT))),",
				"          CURRENTCREXPOSURE_tgt = toString(sum(toDouble(CURRENTCREXPOSURE))),",
				"          CUSTOMERPROFITABILITY_tgt = toString(sum(toDouble(CUSTOMERPROFITABILITY))),",
				"          OFFLINE_CUM_DEBIT_LIMIT_tgt = toString(sum(toDouble(OFFLINE_CUM_DEBIT_LIMIT))),",
				"          POTENTIALCRLINE_tgt = toString(sum(toDouble(POTENTIALCRLINE))),",
				"          TOTALCREXPOSURE_tgt = toString(sum(toDouble(TOTALCREXPOSURE)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}