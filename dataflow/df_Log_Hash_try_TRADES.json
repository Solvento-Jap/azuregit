{
	"name": "df_Log_Hash_try_TRADES",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          TradeStatus as string,",
				"          Trade_Id as string,",
				"          External_Reference as string,",
				"          Product_Type as string,",
				"          Bundle_Type as string,",
				"          Bundle_Name as string,",
				"          Bundle_Id as string,",
				"          Book as string,",
				"          Product_Description as string,",
				"          Entered_Date as string,",
				"          Trade_Date as string,",
				"          Trade_Settle_Date as string,",
				"          Maturity_Date as string,",
				"          FXNDF_Reset_Date as string,",
				"          CounterParty_ID as string,",
				"          CounterParty_Short_Name as string,",
				"          TRADE_KEYWORD_ClientName_Full_Name as string,",
				"          CounterParty_Full_Name as string,",
				"          TRADE_KEYWORD_TrustRole as string,",
				"          TRADE_KEYWORD_TrustAccount as string,",
				"          CBCAttribute_TrustAccountSixDigits as string,",
				"          CounterParty_Attribute_CLASSIFICATION as string,",
				"          Trade_Type as string,",
				"          Trade_Currency as string,",
				"          Name as string,",
				"          PRODUCT_CODE_ISIN as string,",
				"          PRODUCT_CODE_CBC_BondType as string,",
				"          Issuer as string,",
				"          Issuer_Attr_Industry_Type as string,",
				"          Issued_Date as string,",
				"          Next_Coupon_Date as string,",
				"          Coupon as string,",
				"          Coupon_Frequency as string,",
				"          Nominal as string,",
				"          Trade_Price as string,",
				"          SettlementAmount as string,",
				"          Fee_FI_TBC_COMM_FEE_Amount as string,",
				"          Fee_FI_ODB_FEE_Amount as string,",
				"          Fee_FI_CUST_MAIN_FEE_Amount as string,",
				"          TRADE_KEYWORD_ClientName_ID as string,",
				"          TRADE_KEYWORD_ClientAccount_Account_Name as string,",
				"          CBCAttribute_ClientAccount_AccountNameSixDigits as string,",
				"          TRADE_KEYWORD_CouponReceivingAcct_Account_Name as string,",
				"          CBCAttribute_CouponReceivingAcct_AccountNameSixDigits as string,",
				"          Principal_Currency as string,",
				"          Principal_Amount as string,",
				"          Fixed_Rate as string,",
				"          Accrual_Method as string,",
				"          Payment_DayCount as string,",
				"          Payment_Freq as string,",
				"          Coupon_Holidays as string,",
				"          TRADE_KEYWORD_1_MM_TradeType as string,",
				"          CounterParty_Attribute_CBC_MM_TAXExempt as string,",
				"          Pricer_WITHHOLDINGTAX_AM as string,",
				"          Pricer_PRICE as string,",
				"          Fee_MM_DST_INT_FEE_Amount as string,",
				"          Currency_Pair as string,",
				"          Prim_Cur as string,",
				"          Prim_Amt as string,",
				"          FX_Near_Margin as string,",
				"          FX_Near_AllIn_Rate as string,",
				"          Sec_Cur as string,",
				"          Sec_Amt as string,",
				"          FX_Far_Prim_Amount as string,",
				"          FX_Far_Margin as string,",
				"          FX_Far_AllIn_Rate as string,",
				"          FX_Far_Sec_Amount as string,",
				"          Pay_Leg_Principal_Ccy as string,",
				"          Pay_Leg_Type as string,",
				"          Pay_Leg_Principal as string,",
				"          Pay_Leg_Start_Date as string,",
				"          Pay_Leg_Maturity_Date as string,",
				"          Pay_Leg_Fixed_Rate as string,",
				"          Pay_Leg_Floating_Rate as string,",
				"          Pay_Leg_Index_Factor as string,",
				"          Pay_Leg_Rate_Index_Spread as string,",
				"          Pay_Leg_Has_Prin_Exch_Amort as string,",
				"          Pay_Leg_Has_Prin_Exch_Final as string,",
				"          Pay_Leg_Has_Prin_Exch_Intial as string,",
				"          Pay_Leg_DayCount as string,",
				"          Pay_Leg_Payment_Frequency as string,",
				"          Pay_Leg_Amortization_Frequency as string,",
				"          Pay_Leg_Accrual_Bus_Day_Calendar as string,",
				"          Pay_Leg_Accrual_Bus_Day_Convention as string,",
				"          Pay_Leg_Fixing_Business_Day_Convention as string,",
				"          Pay_Leg_Fixing_Days as string,",
				"          Pay_Leg_Reset_Business_Day_Convention as string,",
				"          Pay_Leg_Reset_Frequency as string,",
				"          CCS_Pay_Interest_Stub as string,",
				"          Pay_Schedule_Period_Rule as string,",
				"          Prin_Sched_Type as string,",
				"          Rcv_Leg_Principal_Ccy as string,",
				"          Rcv_Leg_Type as string,",
				"          Rcv_Leg_Principal as string,",
				"          Rcv_Leg_Start_Date as string,",
				"          Rcv_Leg_Maturity_Date as string,",
				"          Rcv_Leg_Fixed_Rate as string,",
				"          Rcv_Leg_Floating_Rate as string,",
				"          Rec_Leg_Index_Factor as string,",
				"          Rcv_Leg_Rate_Index_Spread as string,",
				"          Rec_Leg_Has_Prin_Exch_Amort as string,",
				"          Rec_Leg_Has_Prin_Exch_Final as string,",
				"          Rec_Leg_Has_Prin_Exch_Intial as string,",
				"          Rcv_Leg_DayCount as string,",
				"          Rcv_Leg_Payment_Frequency as string,",
				"          Rec_Leg_Amortization_Frequency as string,",
				"          Rcv_Leg_Accrual_Bus_Day_Calendar as string,",
				"          Rcv_Leg_Accrual_Bus_Day_Convention as string,",
				"          Rcv_Leg_Fixing_Business_Day_Convention as string,",
				"          Rcv_Leg_Fixing_Days as string,",
				"          Rcv_Leg_Reset_Business_Day_Convention as string,",
				"          Rcv_Leg_Reset_Frequency as string,",
				"          CCS_Rec_Interest_Stub as string,",
				"          Rec_Schedule_Period_Rule as string,",
				"          TRADE_KEYWORD_SalesMargin as string,",
				"          TRADE_KEYWORD_FinalMatDate_Columns as string,",
				"          Trade_Comment as string,",
				"          Pay_Leg_Outstanding_Notional as string,",
				"          Pay_Leg_Settle_Currency as string,",
				"          Rcv_Leg_Outstanding_Notional as string,",
				"          Receive_Leg_Settle_Currency as string,",
				"          Settle_Cur_ as string,",
				"          TRADE_KEYWORD_OrigTrade as string,",
				"          TRADE_KEYWORD_OrigTradeDt as string,",
				"          TRADE_KEYWORD_RolledBackTo as string,",
				"          TRADE_KEYWORD_Status_of_Securities as string,",
				"          TRADE_KEYWORD_TerminationDate_Columns as string,",
				"          TRADE_KEYWORD_TerminationTradeDate_Columns as string,",
				"          Updated_Date as string,",
				"          Entered_User as string,",
				"          Trader as string,",
				"          Sales_Person as string,",
				"          Book_Attr_ProfitCenter as string,",
				"          TRADE_KEYWORD_BookingBranch as string,",
				"          TRADE_KEYWORD_Wealth_Cluster as string,",
				"          TRADE_KEYWORD_Wealth_RM as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          Nominal_src = Nominal,",
				"          Fee_FI_TBC_COMM_FEE_Amount_src = Fee_FI_TBC_COMM_FEE_Amount,",
				"          Fee_FI_ODB_FEE_Amount_src = Fee_FI_ODB_FEE_Amount,",
				"          Fee_FI_CUST_MAIN_FEE_Amount_src = Fee_FI_CUST_MAIN_FEE_Amount,",
				"          Principal_Amount_src = Principal_Amount,",
				"          Pricer_WITHHOLDINGTAX_AM_src = Pricer_WITHHOLDINGTAX_AM,",
				"          Fee_MM_DST_INT_FEE_Amount_src = Fee_MM_DST_INT_FEE_Amount,",
				"          SettlementAmount_src = SettlementAmount) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          Nominal_tgt = toString(sum(toDouble(Nominal))),",
				"          SettlementAmount_tgt = toString(sum(toDouble(SettlementAmount))),",
				"          Fee_FI_TBC_COMM_FEE_Amount_tgt = toString(sum(toDouble(Fee_FI_TBC_COMM_FEE_Amount))),",
				"          Fee_FI_ODB_FEE_Amount_tgt = toString(sum(toDouble(Fee_FI_ODB_FEE_Amount))),",
				"          Fee_FI_CUST_MAIN_FEE_Amount_tgt = toString(sum(toDouble(Fee_FI_CUST_MAIN_FEE_Amount))),",
				"          Principal_Amount_tgt = toString(sum(toDouble(Principal_Amount))),",
				"          Pricer_WITHHOLDINGTAX_AM_tgt = toString(sum(toDouble(Pricer_WITHHOLDINGTAX_AM))),",
				"          Fee_MM_DST_INT_FEE_Amount_tgt = toString(sum(toDouble(Fee_MM_DST_INT_FEE_Amount)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}