{
	"name": "df_deplns_aas_busc",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_BUSC",
						"type": "DatasetReference"
					},
					"name": "BUSC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parameter1 as string",
				"}",
				"source(output(",
				"          ACID as string,",
				"          ACCT_POA_AS_SRL_NUM as string,",
				"          ACCT_POA_AS_REC_TYPE as string,",
				"          ACCT_POA_AS_NAME as string,",
				"          ACCT_POA_AS_DESIG as string,",
				"          ACCT_POA_AS_RMKS as string,",
				"          ACCT_POA_AS_AMT_ALWD as decimal(20,4),",
				"          START_DATE as timestamp,",
				"          END_DATE as timestamp,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as timestamp,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as timestamp,",
				"          CUST_ID as string,",
				"          CUST_RELTN_CODE as string,",
				"          PASS_SHEET_FLG as string,",
				"          SI_FLG as string,",
				"          TD_MATRTY_FLG as string,",
				"          LOAN_OVRDUE_FLG as string,",
				"          NMA_KEY_TYPE as string,",
				"          NMA_KEY_ID as string,",
				"          DEL_FLG as string,",
				"          MODE_OF_DESPATCH as string,",
				"          TS_CNT as decimal(5,0),",
				"          SCHM_TYPE as string,",
				"          XCLUDE_FOR_COMB_STMT as string,",
				"          STMT_CUST_ID as string,",
				"          INT_ADV_FLG as string,",
				"          INTCERT_PRINT_FLG as string,",
				"          GUARANTOR_LIAB_PCNT as decimal(9,6),",
				"          GUARANTOR_LIAB_SEQ as string,",
				"          INTRADAY_STMNT_REQD as string,",
				"          BANK_ID as string,",
				"          CUST_PHONE_TYPE as string,",
				"          CUST_EMAIL_TYPE as string,",
				"          RELATED_PARTY_TYPE as string,",
				"          PROFIT_CERT_FLG as string,",
				"          PREF_LANG_CODE as string,",
				"          PREF_LANG_ACCT_POA_AS_RMKS as string,",
				"          ALT1_ACCT_POA_AS_NAME as string,",
				"          RPARTY_STMT_PRNT_CHRG_FLG as string,",
				"          RPARTY_RGLR_STMT_CHRG_ID as string,",
				"          RPARTY_DUP_STMT_CHRG_ID as string,",
				"          WTAX_NOTICE_RCV_DATE as timestamp,",
				"          WTAX_WAIVER_START_DATE as timestamp,",
				"          WTAX_WAIVER_END_DATE as timestamp,",
				"          TAX_CERT_NUM as string,",
				"          TAX_FORM_PARTICULARS as string,",
				"          TAX_CERT_SUBMISSION_DATE as timestamp,",
				"          ENTITY_CRE_FLG as string,",
				"          TAX_EVENT as string,",
				"          REQUESTED_BY as string,",
				"          TAX_EVENT_REASON_CODE as string,",
				"          TAX_MARKER as string,",
				"          CORP_REP_CIF_ID as string,",
				"          MINOR_MAJOR_LET_GEN_FLG as string,",
				"          CHNGD_DUE_TO_ASSUMPTN_FLG as string,",
				"          REASON_FOR_RELEASE as string,",
				"          isActive as integer,",
				"          isLatest as integer,",
				"          BNK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> BUSC",
				"filter1 derive(SOURCE_CODE = 'CORE',",
				"          BANK_CODE = BNK_CODE) ~> derivedColumn1",
				"BUSC filter(isLatest == 1) ~> filter1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'd360',",
				"     rejectedData_folderPath: (concat('dev/Error_Logs/SYN/', $parameter1)),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> SYN"
			]
		}
	}
}