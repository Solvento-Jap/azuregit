{
	"name": "df_DEP_Address_BuscToSyn",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_BUSC",
						"type": "DatasetReference"
					},
					"name": "BUSC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "CustomerTypeSplit"
				},
				{
					"name": "RetailFilter"
				},
				{
					"name": "CorporateFilter"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parameter1 as string",
				"}",
				"source(output(",
				"          ADDRESSID as decimal(38,0),",
				"          BANK_ID as string,",
				"          ADDRESSKEY as string,",
				"          SEASONAL_FLAG as string,",
				"          SUBZIP as string,",
				"          ISADDRESSVERIFIED as string,",
				"          SWIFT_NAME as string,",
				"          NAME_ALT1 as string,",
				"          CORP_REP_ID as decimal(38,0),",
				"          CORP_ID as decimal(38,0),",
				"          SWIFT_CODE as string,",
				"          TEMPLATEID as decimal(38,0),",
				"          PERSONID as decimal(38,0),",
				"          ORGID as decimal(38,0),",
				"          ACCOUNTID as decimal(38,0),",
				"          CONTACTID as decimal(38,0),",
				"          SUSPECTID as decimal(38,0),",
				"          PARTNERID as decimal(38,0),",
				"          ADDRESSCATEGORY as string,",
				"          ADDRESS_LINE1 as string,",
				"          ADDRESS_LINE2 as string,",
				"          ADDRESS_LINE3 as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          ZIP as string,",
				"          MAILSTOP as string,",
				"          COUNTRY as string,",
				"          START_DATE as timestamp,",
				"          END_DATE as timestamp,",
				"          RESIDENTIALSTATUS as string,",
				"          USERFIELD1 as string,",
				"          USERFIELD2 as string,",
				"          USERFIELD3 as string,",
				"          USERFIELD4 as string,",
				"          USERFIELD5 as string,",
				"          USERDATEFIELD1 as timestamp,",
				"          USERDATEFIELD2 as timestamp,",
				"          USERFIELD6 as string,",
				"          USERFIELD7 as string,",
				"          EXTENSIONID as decimal(38,0),",
				"          NAME as string,",
				"          SALUTATION_CODE as string,",
				"          ADDRESS_PROOF_DOC_ID as string,",
				"          PHONENO1 as string,",
				"          PHONENO1LOCALCODE as string,",
				"          PHONENO1CITYCODE as string,",
				"          PHONENO1COUNTRYCODE as string,",
				"          PHONENO2 as string,",
				"          PHONENO2LOCALCODE as string,",
				"          PHONENO2CITYCODE as string,",
				"          PHONENO2COUNTRYCODE as string,",
				"          WORKEXTENSION as string,",
				"          CELLNO as string,",
				"          CELLNOLOCALCODE as string,",
				"          CELLNOCITYCODE as string,",
				"          CELLNOCOUNTRYCODE as string,",
				"          FAXNO as string,",
				"          FAXNOLOCALCODE as string,",
				"          FAXNOCITYCODE as string,",
				"          FAXNOCOUNTRYCODE as string,",
				"          FAXNO2 as string,",
				"          FAXNOLOCALCODE2 as string,",
				"          FAXNOCITYCODE2 as string,",
				"          FAXNOCOUNTRYCODE2 as string,",
				"          EMAIL as string,",
				"          PAGERNO as string,",
				"          PAGERNOLOCALCODE as string,",
				"          PAGERNOCITYCODE as string,",
				"          PAGERNOCOUNTRYCODE as string,",
				"          EMAILPALM as string,",
				"          URL as string,",
				"          HOUSE_NO as string,",
				"          PREMISE_NAME as string,",
				"          BUILDING_LEVEL as string,",
				"          STREET_NO as string,",
				"          STREET_NAME as string,",
				"          SUBURB as string,",
				"          LOCALITY_NAME as string,",
				"          TOWN as string,",
				"          DOMICILE as string,",
				"          TELEX as string,",
				"          TELEXLOCALCODE as string,",
				"          TELEXCITYCODE as string,",
				"          TELEXCOUNTRYCODE as string,",
				"          MLUSERFIELD1 as string,",
				"          MLUSERFIELD2 as string,",
				"          MLUSERFIELD3 as string,",
				"          MLUSERFIELD4 as string,",
				"          MLUSERFIELD5 as string,",
				"          MLUSERFIELD6 as string,",
				"          MLUSERFIELD7 as string,",
				"          MLUSERFIELD8 as string,",
				"          MLUSERFIELD9 as string,",
				"          MLUSERFIELD10 as string,",
				"          MLUSERFIELD11 as string,",
				"          MLUSERFIELD12 as string,",
				"          MLUSERFIELD13 as string,",
				"          MLUSERFIELD14 as string,",
				"          MLUSERFIELD15 as string,",
				"          MLUSERFIELD16 as string,",
				"          MLUSERFIELD17 as string,",
				"          MLUSERFIELD18 as string,",
				"          MLUSERFIELD19 as string,",
				"          MLUSERFIELD20 as string,",
				"          MLUSERFIELD21 as string,",
				"          MLUSERFIELD22 as string,",
				"          MLUSERFIELD23 as string,",
				"          MLUSERFIELD24 as string,",
				"          MLUSERFIELD25 as string,",
				"          MLUSERFIELD26 as string,",
				"          MLUSERFIELD27 as string,",
				"          MLUSERFIELD28 as string,",
				"          MLUSERFIELD29 as string,",
				"          MLUSERFIELD30 as string,",
				"          CITY_CODE as string,",
				"          STATE_CODE as string,",
				"          COUNTRY_CODE as string,",
				"          CORE_CUST_ID as string,",
				"          CONCURDETECT_X as decimal(38,0),",
				"          PREFERREDADDRESS as string,",
				"          HOLDMAILINITIATEDBY as string,",
				"          HOLDMAILFLAG as string,",
				"          BUSINESSCENTER as string,",
				"          HOLDMAILREASON as string,",
				"          PREFERREDFORMAT as string,",
				"          FREETEXTADDRESS as string,",
				"          FREETEXTLABEL as string,",
				"          NONCUSTOMERID as decimal(38,0),",
				"          IS_ADDRESS_PROOF_RCVD as string,",
				"          LASTUPDATE_DATE as timestamp,",
				"          ORGKEY as string,",
				"          SALUTATION as string,",
				"          TMDATE as timestamp,",
				"          isActive as integer,",
				"          isLatest as integer,",
				"          BNK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 2)) ~> BUSC",
				"filter1 derive(BANK_CODE = BNK_CODE,",
				"     partitionBy('roundRobin', 2)) ~> derivedColumn1",
				"BUSC filter(isLatest  == 1) ~> filter1",
				"derivedColumn1 split(or(like(ORGKEY,'R%'),like(ORGKEY,'P%')),",
				"     or(like(ORGKEY,'C%'),like(ORGKEY,'B%')),",
				"     disjoint: true) ~> CustomerTypeSplit@(Retail, Corporate, Default)",
				"CustomerTypeSplit@Retail filter(PREFERREDADDRESS == 'Y' && ACCOUNTID != 0 && toString(toDate(END_DATE)) == '2099-12-31') ~> RetailFilter",
				"CustomerTypeSplit@Corporate filter(PREFERREDADDRESS == 'Y' && CORP_ID != 0 && toString(toDate(END_DATE)) == '2099-12-31') ~> CorporateFilter",
				"RetailFilter, CorporateFilter union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: (concat('dev/Error_Logs/SYN/', $parameter1)),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     partitionBy('roundRobin', 2)) ~> SYN"
			]
		}
	}
}