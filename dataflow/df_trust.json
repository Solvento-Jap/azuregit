{
	"name": "df_trust",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          BR_CD as string,",
				"          SUB_BR_CD as string,",
				"          BASE_NAME as string,",
				"          BASE_STATUS as string,",
				"          CUST_NO as string,",
				"          LAST6_CUST_NO as string,",
				"          NO_HLDRS as string,",
				"          HOLD_PATTERN as string,",
				"          SIGN_COND as string,",
				"          HHLD_NO as string,",
				"          RM_ID as string,",
				"          RES_STATUS as string,",
				"          CUST_STATUS as string,",
				"          REFERENCE_CCY as string,",
				"          PHONE_FAX_INDEMINITY as string,",
				"          DOMICILE as string,",
				"          REMARKS as string,",
				"          STATUS as string,",
				"          MAKER_ID as string,",
				"          MAKER_DATE as string,",
				"          AUTH_ID as string,",
				"          AUTH_DATE as string,",
				"          SERVICE_UNIT as string,",
				"          CIF_NO as string,",
				"          CLOSURE_REMARKS as string,",
				"          REJECT_REASON as string,",
				"          OPEN_DT as string,",
				"          CLOSE_DT as string,",
				"          FNA_ID as string,",
				"          RISK_PROFILE as string,",
				"          RISK_PROFILE_DESC as string,",
				"          FNA_EXPIRY_DATE as string,",
				"          CLOSURE_REASON as string,",
				"          QI_FLAG as string,",
				"          FP_FLAG as string,",
				"          EXTERNAL_IDENTIFIER as string,",
				"          OTHER_CD1 as string,",
				"          OTHER_CD2 as string,",
				"          OTHER_CD3 as string,",
				"          CHNG_COUNT as string,",
				"          RELIEF_METHOD as string,",
				"          KYC_APPLICABLE as string,",
				"          KYC_APP_DT as string,",
				"          KYC_REASON as string,",
				"          KYC_NXT_REV_DT as string,",
				"          KYC_DOC_PATH as string,",
				"          KYC_REF_NO as string,",
				"          VERSION as string,",
				"          RM_ID_2 as string,",
				"          NUMBERED_ACCOUNT as string,",
				"          RISK_RATING as string,",
				"          FileName as string,",
				"          TABLE_NAME as string,",
				"          FILE_NAME as string,",
				"          BANK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> STG",
				"STG filter(H == 'D') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SYN"
			]
		}
	}
}