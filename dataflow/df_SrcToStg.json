{
	"name": "df_SrcToStg",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "decrypt_csv",
						"type": "DatasetReference"
					},
					"name": "SRC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedfields"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parameter1 as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     rowUrlColumn: 'FileName',",
				"     dateFormats: ['yyyyMMdd'],",
				"     timestampFormats: ['yyyyMMddHHmmss']) ~> SRC",
				"SRC derive(FILE_NAME = dropLeft(FileName,19),",
				"          insert_dttm = currentTimestamp(),",
				"     partitionBy('hash', 1)) ~> derivedfields",
				"derivedfields sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: (concat('dev/Error_Logs/', $parameter1)),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     partitionBy('hash', 1)) ~> STG"
			]
		}
	}
}