{
	"name": "df_general",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parameter1 as string",
				"}",
				"source(output(",
				"          H as string,",
				"          CLT_ID as string,",
				"          CLT_UUID as string,",
				"          CLT_INS_ID as string,",
				"          CLT_BRN_ID as string,",
				"          CLT_CIF_NUMBER as string,",
				"          CLT_PARENT_CLT_ID as string,",
				"          CLT_TITLE as string,",
				"          CLT_FIRST_NAME as string,",
				"          CLT_LAST_NAME as string,",
				"          CLT_GENDER as string,",
				"          CLT_DOB as string,",
				"          CLT_EMBOSSING_NAME as string,",
				"          CLT_MOBILE_NUMBER as string,",
				"          CLT_OTHER_NUMBER as string,",
				"          CLT_EMAIL_ADDRESS as string,",
				"          CLT_MARITAL_STATUS as string,",
				"          CLT_MOTHER_MAIDEN_NAME as string,",
				"          CLT_DOC_ID as string,",
				"          CLT_ID_PROOF as string,",
				"          CLT_STS_ID as string,",
				"          CLT_CREATED_BY as string,",
				"          CLT_CREATED_TS as string,",
				"          CLT_UPDATED_BY as string,",
				"          CLT_UPDATED_TS as string,",
				"          CLT_AUDIT_LOG as string,",
				"          CLT_CCL_ID as string,",
				"          CLT_NATIONALITY as string,",
				"          CLT_ID_PROOF_DOC as string,",
				"          CLT_MIDDLE_NAME as string,",
				"          CLT_WORK_PHONE_NO as string,",
				"          CLT_KEY_ROTATION_NO as string,",
				"          CLT_CAF_UPDATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 2)) ~> STG",
				"STG filter(H == 'D') ~> filter1",
				"filter1 derive(SOURCE_CODE = dropLeft(dropRight(FILE_NAME,instr(reverse(FILE_NAME),'CBC')-7),6),",
				"          BANK_CODE = left(FILE_NAME, 5),",
				"          insert_dttm = toTimestamp(insert_dttm, 'yyyy-MM-dd\\'T\\'HH:mm:ss'),",
				"     partitionBy('roundRobin', 2)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: (concat('dev/Error_Logs/SYN/', $parameter1)),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     partitionBy('roundRobin', 2)) ~> SYN"
			]
		}
	}
}