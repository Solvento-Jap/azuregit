{
	"name": "df_Log_Hash_crm_FINANCIAL",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          FINANCIAL_ID as string,",
				"          BANK_ID as string,",
				"          CORP_ID as string,",
				"          AVG_GROWTH_RATE as string,",
				"          ENTITY_TYPE as string,",
				"          ANNUAL_BUDGET as string,",
				"          TYPE_OF_STATEMENT as string,",
				"          AS_ON_DATE as string,",
				"          FINANCIAL_YEAR_END as string,",
				"          PERIOD as string,",
				"          FINANCIAL_YEAR as string,",
				"          NUMBEROF_EMPLOYEES as string,",
				"          DEPOSITS_OTHER_BANK as string,",
				"          INVEST_SHARES_UNITS as string,",
				"          TOT_SHARE_INVESTMENT as string,",
				"          BUSINESS_ASSETS as string,",
				"          PROPERTY as string,",
				"          LEGAL_STATUS as string,",
				"          LEGAL_DETAILS as string,",
				"          OCB_SINCE as string,",
				"          COUNTRY as string,",
				"          CUST_NET_WORTH as string,",
				"          CRNCY_CODE as string,",
				"          CUST_ASSETS_AS_ON_DATE as string,",
				"          CUST_FIN_YEAR_END_MNTH as string,",
				"          TOTAL_AMOUNT_HELD as string,",
				"          CORE_CUST_ID as string,",
				"          STR1 as string,",
				"          STR2 as string,",
				"          STR3 as string,",
				"          STR4 as string,",
				"          STR5 as string,",
				"          STR6 as string,",
				"          STR7 as string,",
				"          STR8 as string,",
				"          STR9 as string,",
				"          STR10 as string,",
				"          STR11 as string,",
				"          STR12 as string,",
				"          STR13 as string,",
				"          STR14 as string,",
				"          STR15 as string,",
				"          DATE1 as string,",
				"          DATE2 as string,",
				"          DATE3 as string,",
				"          DATE4 as string,",
				"          DATE5 as string,",
				"          AMOUNT1 as string,",
				"          AMOUNT2 as string,",
				"          AMOUNT3 as string,",
				"          AMOUNT4 as string,",
				"          AMOUNT5 as string,",
				"          FLAG1 as string,",
				"          FLAG2 as string,",
				"          FLAG3 as string,",
				"          FLAG4 as string,",
				"          FLAG5 as string,",
				"          INT1 as string,",
				"          INT2 as string,",
				"          INT3 as string,",
				"          INT4 as string,",
				"          INT5 as string,",
				"          MLUSERFIELD1 as string,",
				"          MLUSERFIELD2 as string,",
				"          MLUSERFIELD3 as string,",
				"          MLUSERFIELD4 as string,",
				"          MLUSERFIELD5 as string,",
				"          MLUSERFIELD6 as string,",
				"          MLUSERFIELD7 as string,",
				"          MLUSERFIELD8 as string,",
				"          MLUSERFIELD9 as string,",
				"          MLUSERFIELD10 as string,",
				"          BODATECREATED as string,",
				"          BOCREATEDBY as string,",
				"          BODATEMODIFIED as string,",
				"          BOMODIFIEDBY as string,",
				"          CONCURDETECT_X as string,",
				"          BOACLID as string,",
				"          XMLDATA as string,",
				"          EXTENSIONID as string,",
				"          SECURITYILHINT as string,",
				"          SECURITYIUHINT as string,",
				"          SECURITYGLHINT as string,",
				"          SECURITYGUHINT as string,",
				"          CREATED_FROM as string,",
				"          ENTITY_TYPE_CODE as string,",
				"          ENTITY_CREATE_FLG as string,",
				"          SHAREHLD_FLG as string,",
				"          CHECKSUM as string,",
				"          OUTSTANDING_MORTAGE as string,",
				"          NATURE_OF_ACT as string,",
				"          ORGKEY as string,",
				"          INDUSTRY as string,",
				"          GRPID as string,",
				"          FIN_CRNCY_CODE as string,",
				"          TMDATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_src') = $$),",
				"          ANNUAL_BUDGET_src = ANNUAL_BUDGET,",
				"          BUSINESS_ASSETS_src = BUSINESS_ASSETS,",
				"          CUST_NET_WORTH_src = CUST_NET_WORTH,",
				"          DEPOSITS_OTHER_BANK_src = DEPOSITS_OTHER_BANK,",
				"          INVEST_SHARES_UNITS_src = INVEST_SHARES_UNITS,",
				"          OUTSTANDING_MORTAGE_src = OUTSTANDING_MORTAGE,",
				"          PROPERTY_src = PROPERTY,",
				"          TOT_SHARE_INVESTMENT_src = TOT_SHARE_INVESTMENT,",
				"          TOTAL_AMOUNT_HELD_src = TOTAL_AMOUNT_HELD) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          ANNUAL_BUDGET_tgt = toString(sum(toDouble(ANNUAL_BUDGET))),",
				"          BUSINESS_ASSETS_tgt = toString(sum(toDouble(BUSINESS_ASSETS))),",
				"          CUST_NET_WORTH_tgt = toString(sum(toDouble(CUST_NET_WORTH))),",
				"          DEPOSITS_OTHER_BANK_tgt = toString(sum(toDouble(DEPOSITS_OTHER_BANK))),",
				"          INVEST_SHARES_UNITS_tgt = toString(sum(toDouble(INVEST_SHARES_UNITS))),",
				"          OUTSTANDING_MORTAGE_tgt = toString(sum(toDouble(OUTSTANDING_MORTAGE))),",
				"          PROPERTY_tgt = toString(sum(toDouble(PROPERTY))),",
				"          TOT_SHARE_INVESTMENT_tgt = toString(sum(toDouble(TOT_SHARE_INVESTMENT))),",
				"          TOTAL_AMOUNT_HELD_tgt = toString(sum(toDouble(TOTAL_AMOUNT_HELD)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}