{
	"name": "df_SrcToStgCCD",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "decrypt_csv",
						"type": "DatasetReference"
					},
					"name": "SRC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG"
				}
			],
			"transformations": [
				{
					"name": "derivedfields2"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     rowUrlColumn: 'FILE_NAME') ~> SRC",
				"SRC derive(TABLE_NAME = 'CCD_DCUSTOMER',",
				"          BANK_CODE = 'CBC01',",
				"          SOURCE_CODE = 'CCD',",
				"          insert_dttm = currentTimestamp(),",
				"          FILE_NAME = 'CBC01_CCD_CBCEXCUSTP_001_20220815.csv') ~> derivedfields2",
				"derivedfields2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> STG"
			]
		}
	}
}