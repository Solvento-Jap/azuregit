{
	"name": "df_Log_Hash_lns_STANDALONECOLLMNT",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          SECU_LINKAGE_TYPE as string,",
				"          ACID as string,",
				"          LIMIT_B2KID as string,",
				"          SECU_SRL_NUM as string,",
				"          DEL_FLG as string,",
				"          SECU_CODE as string,",
				"          SECU_TYPE_IND as string,",
				"          SECU_GROUP_CODE as string,",
				"          SECU_CLASS_CODE as string,",
				"          USE_FOR_INT_FLG as string,",
				"          USE_FOR_DP_IND as string,",
				"          LIEN_ACID as string,",
				"          UNIT_VALUE as string,",
				"          NUM_OF_UNITS as string,",
				"          SECU_VALUE as string,",
				"          RETAIN_MARGIN_PCNT as string,",
				"          MAX_CEILING_LIM as string,",
				"          ITEM_FREQ_TYPE as string,",
				"          ITEM_FREQ_WEEK_NUM as string,",
				"          ITEM_FREQ_WEEK_DAY as string,",
				"          ITEM_FREQ_START_DD as string,",
				"          ITEM_FREQ_HLDY_STAT as string,",
				"          ITEM_DUE_DATE as string,",
				"          ITEM_RENEW_DATE as string,",
				"          SECU_FROM_SRL_NUM as string,",
				"          SECU_TO_SRL_NUM as string,",
				"          BANK_CODE as string,",
				"          BRANCH_CODE as string,",
				"          CHRG_CODE as string,",
				"          SECU_ID as string,",
				"          SECU_DESC as string,",
				"          DEF_VALUE_OVERRIDE_FLG as string,",
				"          FREE_TEXT as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          CRNCY_CODE as string,",
				"          TS_CNT as string,",
				"          LIEN_ACID_SRL_NUM as string,",
				"          DR_ACID_FOR_FEES as string,",
				"          DERIVE_VALUE_FROM_IND as string,",
				"          THIRD_PARTY_LIEN_AMT as string,",
				"          ASSESSED_VALUE as string,",
				"          INVOICE_VALUE as string,",
				"          MARKET_VALUE as string,",
				"          WRITTEN_DOWN_VALUE as string,",
				"          APPORTIONED_VALUE as string,",
				"          PURCHASE_DATE as string,",
				"          YEAR_OF_CREATION as string,",
				"          RECEIVED_DATE as string,",
				"          WITHDRAW_FLG as string,",
				"          NET_VAL_REMARKS1 as string,",
				"          NET_VAL_REMARKS2 as string,",
				"          NET_VAL_REMARKS3 as string,",
				"          NET_VAL_REMARKS4 as string,",
				"          NET_VAL_AMT1 as string,",
				"          NET_VAL_AMT2 as string,",
				"          NET_VAL_AMT3 as string,",
				"          NET_VAL_AMT4 as string,",
				"          NET_VAL_ADD_SUB_FLG1 as string,",
				"          NET_VAL_ADD_SUB_FLG2 as string,",
				"          NET_VAL_ADD_SUB_FLG3 as string,",
				"          NET_VAL_ADD_SUB_FLG4 as string,",
				"          FULL_BENEFIT_FLG as string,",
				"          LODGE_DATE as string,",
				"          WITHDRAW_DATE as string,",
				"          ENTITY_CRE_FLG as string,",
				"          GROSS_VALUE as string,",
				"          CUST_ID as string,",
				"          LAST_VALUATION_DATE as string,",
				"          WITHDRAWAL_REASON_CODE as string,",
				"          BANK_ID as string,",
				"          APPORTIONED_UNITS as string,",
				"          TOLERANCE_THRESHOLD_RATIO as string,",
				"          ALT1_SECU_DESC as string,",
				"          EXPIRY_DATE as string,",
				"          EXPIRED_FLG as string,",
				"          OLD_APP_VALUE as string,",
				"          PROJ_VALUE as string,",
				"          PROJ_VALUE_PERIOD_YRS as string,",
				"          PROJ_VALUE_PERIOD_MONTHS as string,",
				"          SECU_RELEASED as string,",
				"          RELEASE_DATE as string,",
				"          COLLATERAL_HELD_DETAILS as string,",
				"          FORM_NUMBER as string,",
				"          NOTES as string,",
				"          SIGNING_DATE as string,",
				"          EXECUTION_DATE as string,",
				"          SECU_VALUE_WITH_LIEN as string,",
				"          DETAILED_NOTES as string,",
				"          TOTAL_PRIOR_CHRG as string,",
				"          TOTAL_SUB_CHRG as string,",
				"          APPORTIONING_METHOD as string,",
				"          APPORTIONED_PCNT as string,",
				"          CALCULATED_LTV_PCNT as string,",
				"          FR_FLAG as string,",
				"          FR_TYPE as string,",
				"          FR_CASE_NO as string,",
				"          FR_DATE as string,",
				"          FR_FREZ_REASON_CODE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          APPORTIONED_VALUE_src = APPORTIONED_VALUE,",
				"          ASSESSED_VALUE_src = ASSESSED_VALUE,",
				"          GROSS_VALUE_src = GROSS_VALUE,",
				"          INVOICE_VALUE_src = INVOICE_VALUE,",
				"          MARKET_VALUE_src = MARKET_VALUE,",
				"          MAX_CEILING_LIM_src = MAX_CEILING_LIM,",
				"          each(match(like(name,'%AMT%')), concat($$,'_src ') = $$),",
				"          OLD_APP_VALUE_src = OLD_APP_VALUE,",
				"          PROJ_VALUE_src = PROJ_VALUE,",
				"          SECU_VALUE_src = SECU_VALUE,",
				"          SECU_VALUE_WITH_LIEN_src = SECU_VALUE_WITH_LIEN,",
				"          TOTAL_PRIOR_CHRG_src = TOTAL_PRIOR_CHRG,",
				"          TOTAL_SUB_CHRG_src = TOTAL_SUB_CHRG,",
				"          UNIT_VALUE_src = UNIT_VALUE,",
				"          WRITTEN_DOWN_VALUE_src = WRITTEN_DOWN_VALUE) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          APPORTIONED_VALUE_tgt = toString(sum(toDouble(APPORTIONED_VALUE))),",
				"          ASSESSED_VALUE_tgt = toString(sum(toDouble(ASSESSED_VALUE))),",
				"          GROSS_VALUE_tgt = toString(sum(toDouble(GROSS_VALUE))),",
				"          INVOICE_VALUE_tgt = toString(sum(toDouble(INVOICE_VALUE))),",
				"          MARKET_VALUE_tgt = toString(sum(toDouble(MARKET_VALUE))),",
				"          MAX_CEILING_LIM_tgt = toString(sum(toDouble(MAX_CEILING_LIM))),",
				"          each(match(like(name,'%AMT%')), $$ = toString(sum(toDouble($$)))),",
				"          OLD_APP_VALUE_tgt = toString(sum(toDouble(OLD_APP_VALUE))),",
				"          PROJ_VALUE_tgt = toString(sum(toDouble(PROJ_VALUE))),",
				"          SECU_VALUE_tgt = toString(sum(toDouble(SECU_VALUE))),",
				"          SECU_VALUE_WITH_LIEN_tgt = toString(sum(toDouble(SECU_VALUE_WITH_LIEN))),",
				"          TOTAL_PRIOR_CHRG_tgt = toString(sum(toDouble(TOTAL_PRIOR_CHRG))),",
				"          TOTAL_SUB_CHRG_tgt = toString(sum(toDouble(TOTAL_SUB_CHRG))),",
				"          UNIT_VALUE_tgt = toString(sum(toDouble(UNIT_VALUE))),",
				"          WRITTEN_DOWN_VALUE_tgt = toString(sum(toDouble(WRITTEN_DOWN_VALUE)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}