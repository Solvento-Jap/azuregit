				"          DATE_PREF_AFFILIATES as string,",
				"          COUNTRY_SECONDCITIZENSHIP as string,",
				"          HIGHRISKCOUNTRY as string,",
				"          COUNTRYOFINCORPORATION as string,",
				"          COUNTRYOFPRINCIPALOPERATION as string,",
				"          KYC_DATE as string,",
				"          KYC_RECERTDATE as string,",
				"          SUBMITFORKYC as string,",
				"          KYC_STATUS as string,",
				"          BUSINESS_HIGHRISK as string,",
				"          INDUSTRY_HIGHRISK as string,",
				"          MAJORCUST as string,",
				"          RELATIVE as string,",
				"          ASSOCIATE as string,",
				"          BUSINESSACCT as string,",
				"          BUSINESSNAME as string,",
				"          ADDTRANS as string,",
				"          AFFBUSINESS as string,",
				"          BUSINESS_RELATIONSHIP as string,",
				"          LIST_NAME_ACC as string,",
				"          OTHER_BANKS as string,",
