				"          DEP_SOURCE as string,",
				"          USERFIELD1 as string,",
				"          USERFIELD2 as string,",
				"          USERFIELD3 as string,",
				"          USERFIELD4 as string,",
				"          USERFIELD5 as string,",
				"          USERFIELD6 as string,",
				"          USERFIELD7 as string,",
				"          USERFIELD8 as string,",
				"          USERFIELD9 as string,",
				"          USERFIELD10 as string,",
				"          USERFIELD11 as string,",
				"          USERFIELD12 as string,",
				"          USERFIELD13 as string,",
				"          USERFIELD14 as string,",
				"          USERFIELD15 as string,",
				"          USERFIELD16 as string,",
				"          USERFIELD17 as string,",
				"          USERFIELD18 as string,",
				"          DATE1 as string,",
				"          DATE2 as string,",
				"          DATE3 as string,",
				"          DATE4 as string,",
				"          DATE5 as string,",
				"          DATE6 as string,",
				"          DATE7 as string,",
				"          DATE8 as string,",
				"          CU_DEP_AMT as string,",
				"          ACCROLE as string,",
				"          PEP_RESULTSUMMARY as string,",
				"          REVIEW_CUST_ACT as string,",
				"          BAD_PRESS_OFAC as string,",
				"          CUSTOMER_SUBTYPE as string,",
				"          REASON_RISK_RATING as string,",
				"          BRANCH_LINE_NAME as string,",
				"          BRANCH_LINE_NO as string,",
				"          BUSLINE_AMLO_SRO as string,",
				"          SR_OR_REG_MANAGER as string,",
				"          BUSINESS_OPERATION as string,",
				"          MAJOR_SUPPLIERS as string,",
				"          LIST_BOARD_MEMBERS as string,",
				"          AUDIT_FINANCIAL as string,",
				"          AUDITED_FINANCIAL_STATS as string,",
				"          DONOR_BASE as string,",
				"          VOLUNTEER_BASE as string,",
				"          VERIFIED_OWNERS as string,",
				"          COUNTRY as string,",
				"          RISK as string,",
				"          TRUE_CLIENT as string,",
				"          CLIENT_VISITATION as string,",
				"          CTR_EXEMPT as string,",
				"          ANTICIPATED_CHANGES as string,",
				"          ACTIVE_SRC_WEALTH as string,",
				"          LIST_INDUSTRIES as string,",
				"          BUSINESS_START_YR as string,",
				"          OFFER_IDENT_SERVICES as string,",
				"          OPER_OWN_ATM as string,",
				"          OUT_OF_STATE_CORP as string,",
				"          GEO_MARKET as string,",
				"          VERIFIED_CAL_ATTORNEY as string,",
				"          OTHER_AFFILIATION as string,",
				"          NGO_CHARITY_COMP as string,",
				"          BUSINESS_DONE_INT as string,",
				"          RISK_COUNT_INT as string,",
				"          SOLICIT_DONATION as string,",
				"          CLIENT_REFERRED as string,",
				"          PROVIDE_REFERENCES as string,",
				"          REFERRED_BY as string,",
				"          REFERRAL_TYPE as string,",
				"          CREDIT_REL_EXIST as string,",
				"          BORROWER as string,",
				"          OBLIGATION_NO as string,",
				"          OBLIGATION_TYPE as string,",
				"          CLASS as string,",
				"          COMMITMENT_MATURITY as string,",
				"          FACILITY_CODE_DESC as string,",
				"          FACILITY_DATE as string,",
				"          COMP_TRANS_EXP as string,",
				"          TYPE_TRANSACTION as string,",
				"          REASON_TRANSACTION as string,",
				"          FREQUENCY as string,",
				"          TRANS_CLOSE_AFF as string,",
				"          TRANS_ACT_DETER as string,",
				"          EXPECTED_AVG_BALANCE as string,",
				"          CUST_CASH_CHECKS as string,",
				"          SOURCES_DEPOSIT as string,",
				"          FREQ_DEPOSIT as string,",
				"          AVG_DEPOSIT_AMOUNT as string,",
				"          FUTURE_DEP_CONSISTS as string,",
				"          DWA_EXPECTED as string,",
				"          FWA_EXPECTED as string,",
				"          FWA_EXPECTED_TYPE as string,",
				"          FWA_EXPECTED_COUNTRY as string,",
				"          FWA_EXPECTED_RISK as string,",
				"          FWA_EXPECTED_AVG as string,",
				"          FWA_EXPECTED_FREQ as string,",
				"          FWA_ACTUAL_COUNTRY as string,",
				"          FWA_ACTUAL_AVG as string,",
				"          FWA_ACTUAL_RISK as string,",
				"          FWA_NO_OF_WIRES as string,",
				"          BCKGRND_CHECK as string,",
				"          WEBSITES_USED as string,",
				"          DEROGATORY_INFO as string,",
				"          OFAC_SCREENING as string,",
				"          OFAC_RESULTSUMMARY as string,",
				"          PEP_SCREENING as string,",
				"          RDC_THIRD_SRC as string,",
				"          DATE_PERFORMED as string,",
				"          REFERRED_FOR_CASE as string,",
				"          DATE_REFERRED as string,",
				"          DISPOSITION as string,",
				"          PATRIOT_CERT_OBTAINED as string,",
				"          SRC_CLIENT_WEALTH as string,",
				"          CUST_PRIM_TRAN_AREA as string,",
				"          COUNTRY_CITIZENSHIP as string,",
				"          ACCOUNTID as string,",
				"          CORP_ID as string,",
				"          CORE_CUST_ID as string,",
				"          CORP_KEY as string,",
				"          ORGKEY as string,",
				"          SUSPECTSKEY as string,",
				"          SUSPECTID as string,",
				"          CONTACTSKEY as string,",
				"          CONTACTID as string,",
				"          BANK_ID as string,",
				"          CONCURDETECT_X as string,",
				"          BOACLID as string,",
				"          SECURITYGLHINT as string,",
				"          SECURITYGUHINT as string,",
				"          SECURITYILHINT as string,",
				"          SECURITYIUHINT as string,",
				"          EXTENSIONID as string,",
				"          BOCREATEDBY as string,",
				"          BODATECREATED as string,",
				"          BODATEMODIFIED as string,",
				"          BOMODIFIEDBY as string,",
				"          CHECKSUM as string,",
				"          STRFIELD1 as string,",
				"          STRFIELD2 as string,",
				"          STRFIELD3 as string,",
				"          STRFIELD4 as string,",
				"          STRFIELD5 as string,",
				"          INTFIELD1 as string,",
				"          INTFIELD2 as string,",
				"          INTFIELD3 as string,",
				"          INTFIELD4 as string,",
				"          INTFIELD5 as string,",
				"          DATEFIELD1 as string,",
				"          DATEFIELD2 as string,",
				"          DATEFIELD3 as string,",
				"          DATEFIELD4 as string,",
				"          DATEFIELD5 as string,",
				"          IDENTITY_THEFT_REPORTED as string,",
				"          IDENTITY_THEFT_REMARKS as string,",
				"          IDENTITY_THEFT_DATE as string,",
				"          LASTEDITEDPAGE as string,",
				"          AVG_DEPOSIT_AMOUNT_CU as string,",
				"          EXPECTED_AVG_BALANCE_CU as string,",
				"          THIRD_PARTY_CHK as string,",
				"          NONCUSTOMERID as string,",
				"          TMDATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          AVG_DEPOSIT_AMOUNT_src = AVG_DEPOSIT_AMOUNT,",
				"          DEP_AMT_src = DEP_AMT,",
				"          EXPECTED_AVG_BALANCE_src = EXPECTED_AVG_BALANCE) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          AVG_DEPOSIT_AMOUNT_tgt = toString(sum(toDouble(AVG_DEPOSIT_AMOUNT))),",
				"          DEP_AMT_tgt = toString(sum(toDouble(DEP_AMT))),",
				"          EXPECTED_AVG_BALANCE_tgt = toString(sum(toDouble(EXPECTED_AVG_BALANCE)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}