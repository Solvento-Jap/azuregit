				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          CORP_MISC_ID as string,",
				"          BANK_ID as string,",
				"          WIRE_TYPE as string,",
				"          WIRE_COUNTRY as string,",
				"          WIRE_FREQ as string,",
				"          STR4_ALT1 as string,",
				"          STR5_ALT1 as string,",
				"          STR1_ALT1 as string,",
				"          CORP_REP_ID as string,",
				"          CORP_ID as string,",
				"          BENEFICIAL_OWNER_ID as string,",
				"          PREFERENCE_ID as string,",
				"          TRADE_FINANCE_ID as string,",
				"          TYPE as string,",
				"          STR1 as string,",
				"          STR2 as string,",
				"          STR3 as string,",
				"          STR4 as string,",
				"          STR5 as string,",
				"          STR6 as string,",
				"          STR7 as string,",
				"          STR8 as string,",
				"          STR9 as string,",
				"          STR10 as string,",
				"          STR11 as string,",
				"          STR12 as string,",
				"          STR13 as string,",
				"          STR14 as string,",
				"          STR15 as string,",
				"          STR16 as string,",
				"          STR17 as string,",
				"          STR18 as string,",
				"          STR19 as string,",
				"          STR20 as string,",
				"          STR21 as string,",
				"          STR22 as string,",
				"          STR23 as string,",
				"          STR24 as string,",
				"          STR25 as string,",
				"          STR26 as string,",
				"          STR27 as string,",
				"          STR28 as string,",
				"          STR29 as string,",
				"          STR30 as string,",
				"          STR31 as string,",
				"          STR32 as string,",
				"          STR33 as string,",
				"          STR34 as string,",
				"          STR35 as string,",
				"          STR36 as string,",
				"          STR37 as string,",
				"          STR38 as string,",
				"          STR39 as string,",
				"          STR40 as string,",
				"          STR41 as string,",
				"          STR42 as string,",
				"          DATE1 as string,",
				"          DATE2 as string,",
				"          DATE3 as string,",
				"          DATE4 as string,",
				"          DATE5 as string,",
				"          DBFLOAT1 as string,",
				"          DBFLOAT2 as string,",
				"          DBFLOAT3 as string,",
				"          DBFLOAT4 as string,",
				"          DBFLOAT5 as string,",
				"          AMOUNT1 as string,",
				"          AMOUNT2 as string,",
				"          AMOUNT3 as string,",
				"          AMOUNT4 as string,",
				"          AMOUNT5 as string,",
				"          FLAG1 as string,",
				"          FLAG2 as string,",
				"          FLAG3 as string,",
				"          FLAG4 as string,",
				"          FLAG5 as string,",
				"          INT1 as string,",
				"          INT2 as string,",
				"          INT3 as string,",
				"          INT4 as string,",
				"          INT5 as string,",
				"          INT6 as string,",
				"          INT7 as string,",
				"          INT8 as string,",
				"          INT9 as string,",
				"          INT10 as string,",
				"          INT11 as string,",
				"          INT12 as string,",
				"          INT13 as string,",
				"          INT14 as string,",
				"          INT15 as string,",
				"          MLUSERFIELD1 as string,",
				"          MLUSERFIELD2 as string,",
				"          MLUSERFIELD3 as string,",
				"          MLUSERFIELD4 as string,",
				"          MLUSERFIELD5 as string,",
				"          EXTENSIONID as string,",
				"          EMPLOYERID as string,",
				"          EMPLOYEEID as string,",
				"          STR1_CODE as string,",
				"          STR2_CODE as string,",
				"          STR3_CODE as string,",
				"          STR4_CODE as string,",
				"          STR5_CODE as string,",
				"          CORE_CUST_ID as string,",
				"          CORE_CHILD_CUST_ID as string,",
				"          PERCENTAGE1 as string,",
				"          PERCENTAGE2 as string,",
				"          PERCENTAGE3 as string,",
				"          PERCENTAGE4 as string,",
				"          PERCENTAGE5 as string,",
				"          ENTITYID as string,",
				"          ENTITYTYPE as string,",
				"          STR43 as string,",
				"          STR44 as string,",
				"          STR45 as string,",
				"          STR46 as string,",
				"          STR47 as string,",
				"          STR48 as string,",
				"          STR49 as string,",
				"          STR50 as string,",
				"          ORGKEY as string,",
				"          TMDATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_src') = $$),",
				"          each(match(like(name,'PERCENTAGE%')), concat($$, '_src') = $$)) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          each(match(like(name,'AMOUNT%')), concat($$, '_tgt') = toString(sum(toDouble($$)))),",
				"          each(match(like(name,'PERCENTAGE%')), concat($$, '_tgt') = toString(sum(toDouble($$))))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}