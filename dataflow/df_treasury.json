{
	"name": "df_treasury",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          Id as string,",
				"          Beneficiary_Id as string,",
				"          Beneficiary as string,",
				"          CBCGLAcctEncryted as string,",
				"          CBCGLAcctSixDigits as string,",
				"          Direct as string,",
				"          Roles as string,",
				"          ProcessingOrg as string,",
				"          Currencies as string,",
				"          Products as string,",
				"          Pay_Receive as string,",
				"          Method as string,",
				"          FileName as string,",
				"          TABLE_NAME as string,",
				"          FILE_NAME as string,",
				"          BANK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> STG",
				"STG filter(H == 'D') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SYN"
			]
		}
	}
}