{
	"name": "df_Log_Hash_dep_GAC",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ACID as string,",
				"          SECTOR_CODE as string,",
				"          SUB_SECTOR_CODE as string,",
				"          GUAR_COVER_CODE as string,",
				"          NATURE_OF_ADVN as string,",
				"          TYPE_OF_ADVN as string,",
				"          MODE_OF_ADVN as string,",
				"          PURPOSE_OF_ADVN as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          FREE_CODE_1 as string,",
				"          FREE_CODE_2 as string,",
				"          FREE_CODE_3 as string,",
				"          FREE_CODE_4 as string,",
				"          INDUSTRY_TYPE as string,",
				"          ACCT_OCCP_CODE as string,",
				"          BORROWER_CATEGORY_CODE as string,",
				"          FREE_CODE_5 as string,",
				"          FREE_CODE_6 as string,",
				"          FREE_CODE_7 as string,",
				"          FREE_CODE_8 as string,",
				"          FREE_CODE_9 as string,",
				"          FREE_CODE_10 as string,",
				"          INT_DR_ACID as string,",
				"          INT_CR_ACID as string,",
				"          INT_DR_ACCT_FLG as string,",
				"          INT_CR_ACCT_FLG as string,",
				"          PD_FLG as string,",
				"          PD_XFER_DATE as string,",
				"          PD_RE_XFER_DATE as string,",
				"          PRV_TO_PD_GL_SUB_HEAD_CODE as string,",
				"          TS_CNT as string,",
				"          DPD_CNTR as string,",
				"          DPD_ASON_DATE as string,",
				"          CHRGE_OFF_FLG as string,",
				"          DAILY_COMP_INT_FLG as string,",
				"          FREE_TEXT_1 as string,",
				"          FREE_TEXT_2 as string,",
				"          FREE_TEXT_3 as string,",
				"          FREE_TEXT_4 as string,",
				"          FREE_TEXT_5 as string,",
				"          FREE_TEXT_6 as string,",
				"          FREE_TEXT_7 as string,",
				"          FREE_TEXT_8 as string,",
				"          FREE_TEXT_9 as string,",
				"          FREE_TEXT_10 as string,",
				"          FREE_TEXT_11 as string,",
				"          FREE_TEXT_12 as string,",
				"          FREE_TEXT_13 as string,",
				"          FREE_TEXT_14 as string,",
				"          FREE_TEXT_15 as string,",
				"          MATCH_OPP_RATE as string,",
				"          FREEZE_RMKS as string,",
				"          FREEZE_RMKS2 as string,",
				"          FREEZE_RMKS3 as string,",
				"          FREEZE_RMKS4 as string,",
				"          FREEZE_RMKS5 as string,",
				"          ECS_FLAG as string,",
				"          COMP_DATE_FLG as string,",
				"          DISC_RATE_FLG as string,",
				"          LAST_TURNOVER_DATE as string,",
				"          IAS_CODE as string,",
				"          PENAL_PROD_MTHD_FLG as string,",
				"          PENAL_RATE_MTHD_FLG as string,",
				"          WAIVE_MIN_COLL_INT as string,",
				"          RULE_CODE as string,",
				"          SECURED_FLG as string,",
				"          BANK_ID as string,",
				"          REQUEST_SOL_ID as string,",
				"          REQUEST_DEPARTMENT as string,",
				"          REF_NUM as string,",
				"          MARKUP_INT_RATE_APPL_FLG as string,",
				"          ALT1_FREEZE_RMKS as string,",
				"          APY_PCNT as string,",
				"          HEDGED_ACCT_FLG as string,",
				"          USED_FOR_NET_OFF_FLG as string,",
				"          INT_COMPOUNDING_FRQ_CR as string,",
				"          INT_COMPOUNDING_REST_FLG_CR as string,",
				"          DISC_RATE_FLG_CR as string,",
				"          KONFORMNA_FLG as string,",
				"          TRAN_REASON_CODE_DR1 as string,",
				"          TRAN_REASON_CODE_DR2 as string,",
				"          FLOW_CODE_DR as string,",
				"          AUTO_CLS_OF_ZERO_BAL_AC_FLG as string,",
				"          SIG_MANDATE_FREE_CODE_1 as string,",
				"          SIG_MANDATE_FREE_CODE_2 as string,",
				"          SIG_MANDATE_FREE_CODE_3 as string,",
				"          SIG_MANDATE_FREE_CODE_4 as string,",
				"          SIG_MANDATE_FREE_TEXT_1 as string,",
				"          SIG_MANDATE_FREE_TEXT_2 as string,",
				"          SIG_MANDATE_FREE_TEXT_3 as string,",
				"          SIG_MANDATE_FREE_TEXT_4 as string,",
				"          SIG_MANDATE_FREE_TEXT_5 as string,",
				"          ALLOW_ONLY_CORP_REP_SIG_FLG as string,",
				"          SECURITY_INDICATOR as string,",
				"          DEBT_SENIORITY as string,",
				"          SECURITY_CODE as string,",
				"          LAST6_FREE_TEXT_1 as string,",
				"          LAST6_FREE_TEXT_2 as string,",
				"          LAST6_FREE_TEXT_3 as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          APY_PCNT_src = APY_PCNT,",
				"          DPD_CNTR_src = DPD_CNTR,",
				"          TS_CNT_src = TS_CNT,",
				"          MATCH_OPP_RATE_src = MATCH_OPP_RATE,",
				"          SECURITY_INDICATOR_src = SECURITY_INDICATOR) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          APY_PCNT_tgt = toString(sum(toDouble(APY_PCNT))),",
				"          DPD_CNTR_tgt = toString(sum(toDouble(DPD_CNTR))),",
				"          MATCH_OPP_RATE_tgt = toString(sum(toDouble(MATCH_OPP_RATE))),",
				"          SECURITY_INDICATOR_tgt = toString(sum(toDouble(SECURITY_INDICATOR))),",
				"          TS_CNT_tgt = toString(sum(toDouble(TS_CNT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', ''))) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}