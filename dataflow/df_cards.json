{
	"name": "df_cards",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_SYN",
						"type": "DatasetReference"
					},
					"name": "SYN",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parameter1 as string",
				"}",
				"source(output(",
				"          H as string,",
				"          CUST_BANK_NBR as string,",
				"          CUST_NBR as string,",
				"          CUST_STATUS as string,",
				"          CUST_BRANCH_NBR as string,",
				"          CUST_OPER_CODE as string,",
				"          CUST_TYPE as string,",
				"          CUST_LOCAL_NAME as string,",
				"          CUST_ENG_NAME as string,",
				"          CUST_ADDR1 as string,",
				"          CUST_ADDR2 as string,",
				"          CUST_ADD_CITY as string,",
				"          CUST_ADD_PROVINCE as string,",
				"          CUST_ADD_ZIPCODE as string,",
				"          CUST_PHONE as string,",
				"          CUST_RES_TYPE as string,",
				"          CUST_RES_PERIOD as string,",
				"          CUST_SEX as string,",
				"          CUST_MARITAL_ST as string,",
				"          CUST_QUALIFICATION as string,",
				"          CUST_ID_NBR as string,",
				"          CUST_DTE_BIRTH as string,",
				"          CUST_MOM_NAME as string,",
				"          CUST_WORK_ID as string,",
				"          CUST_NATIONALITY as string,",
				"          CUST_SUPP_RLNSHIP as string,",
				"          CUST_EMP_NAME as string,",
				"          CUST_EMP_ADDR1 as string,",
				"          CUST_EMP_ADDR2 as string,",
				"          CUST_EMP_ZIP as string,",
				"          CUST_OCC_CODE as string,",
				"          CUST_OCC_PER as string,",
				"          CUST_EMP_PHONE as string,",
				"          CUST_ANN_SALARY as string,",
				"          CUST_GRLNSHIP as string,",
				"          CUST_GLOCAL_NAME as string,",
				"          CUST_GENG_NAME as string,",
				"          CUST_GADDR1 as string,",
				"          CUST_GADDR2 as string,",
				"          CUST_GADD_CITY as string,",
				"          CUST_GADD_PROVINCE as string,",
				"          CUST_GADD_ZIPCODE as string,",
				"          CUST_GPHONE as string,",
				"          CUST_GSEX as string,",
				"          CUST_GMARITAL_ST as string,",
				"          CUST_GQUALIFICATION as string,",
				"          CUST_GID_NBR as string,",
				"          CUST_GDTE_BIRTH as string,",
				"          CUST_GWORK_ID as string,",
				"          CUST_GEMP_NAME as string,",
				"          CUST_GEMP_ADDR1 as string,",
				"          CUST_GEMP_ADDR2 as string,",
				"          CUST_GEMP_ZIP as string,",
				"          CUST_GOCC_CODE as string,",
				"          CUST_GOCC_PER as string,",
				"          CUST_GEMP_PHONE as string,",
				"          CUST_GANN_SALARY as string,",
				"          CUST_MADDR1 as string,",
				"          CUST_MADDR2 as string,",
				"          CUST_MADD_CITY as string,",
				"          CUST_MADD_PROVINCE as string,",
				"          CUST_MADD_ZIPCODE as string,",
				"          CUST_CNAME as string,",
				"          CUST_CPHONE as string,",
				"          CUST_CREG_DATE as string,",
				"          CUST_CREG_NBR as string,",
				"          CUST_CBUSINESS as string,",
				"          CUST_CBANK as string,",
				"          CUST_CBANK_ACCT as string,",
				"          CUST_CCONTACT as string,",
				"          CUST_COLLECTOR as string,",
				"          CUST_MEMO as string,",
				"          FLAG_CUST_CRLIMIT as string,",
				"          CUST_CRLIMIT as string,",
				"          FLAG_CUST_AVAIL_CREDIT as string,",
				"          CUST_AVAIL_CREDIT as string,",
				"          FLAG_CUST_CASH_LIMIT as string,",
				"          CUST_CASH_LIMIT as string,",
				"          FLAG_CUST_AVAIL_CASH as string,",
				"          CUST_AVAIL_CASH as string,",
				"          FLAG_CUST_TEMP_CRLIMIT as string,",
				"          CUST_TEMP_CRLIMIT as string,",
				"          FLAG_CUST_PERM_CRLIMIT as string,",
				"          CUST_PERM_CRLIMIT as string,",
				"          CUST_DATE_TEMP_CRLIMIT_EFF as string,",
				"          CUST_DATE_TEMP_CRLIMIT_EXP as string,",
				"          CUST_CURR_CODE as string,",
				"          CUST_ADDR3 as string,",
				"          CUST_ADDR4 as string,",
				"          CUST_MADDR3 as string,",
				"          CUST_MADDR4 as string,",
				"          CUST_EMAIL_ADDR as string,",
				"          CUST_MOBILE_PHONE as string,",
				"          CUST_ADDR_CODE as string,",
				"          CUST_FILE_BUFFER as string,",
				"          FLAG_CUST_INSTL_LIMIT as string,",
				"          CUST_INSTL_LIMIT as string,",
				"          FLAG_CUST_AVAIL_INSTL as string,",
				"          CUST_AVAIL_INSTL as string,",
				"          FLAG_CUST_STDALN_INSTL as string,",
				"          CUST_STDALN_INSTL as string,",
				"          FLAG_CUST_AVAIL_STDALN_INS as string,",
				"          CUST_AVAIL_STDALN_INS as string,",
				"          CUST_NODE_ID as string,",
				"          CUST_SOCIAL_ID as string,",
				"          CUST_GS_ID as string,",
				"          CUST_DRIVE_LICENSE as string,",
				"          CUST_TAX_ID as string,",
				"          CUST_UM_ID as string,",
				"          CUST_OTHER_ID as string,",
				"          CUST_CIF_NBR as string,",
				"          CUST_FIRST_NAME as string,",
				"          CUST_MIDDLE_NAME as string,",
				"          CUST_LAST_NAME as string,",
				"          CUST_EMAIL_ADDR2 as string,",
				"          CUST_EMAIL_ADDR3 as string,",
				"          CUST_EMP_ADDR3 as string,",
				"          CUST_EMP_ADDR4 as string,",
				"          CUST_EMP_CITY as string,",
				"          CUST_EMP_PROVINCE as string,",
				"          CUST_PHONE_CTY as string,",
				"          CUST_PHONE_AREA as string,",
				"          CUST_MOBILE_CTY as string,",
				"          CUST_MOBILE_AREA as string,",
				"          CUST_OFFICE_CTY as string,",
				"          CUST_OFFICE_AREA as string,",
				"          CUST_NATIONALITY_CDE as string,",
				"          CUST_BORROW_TYPE as string,",
				"          CUST_RELATION as string,",
				"          CUST_EMP_TYPE as string,",
				"          CUST_EMP_CODE as string,",
				"          CUST_BIRTH_PLACE as string,",
				"          CUST_EMP_NATURE as string,",
				"          CUST_FUND_SRC as string,",
				"          CUST_FUND_SRC_OTHER as string,",
				"          CUST_DELTA_DATE as string,",
				"          CUST_CLASS_CODE as string,",
				"          CUST_TITLE as string,",
				"          CUST_STAFF_ID as string,",
				"          CUST_DATE_MAINT as string,",
				"          CUST_USER_MAINT as string,",
				"          CUST_TIME_MAINT as string,",
				"          CUST_FILE_DATE as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true) ~> STG",
				"STG filter(H == 'D') ~> filter1",
				"filter1 derive(CUST_DTE_BIRTH = left(toString(CUST_DTE_BIRTH),6),",
				"          SOURCE_CODE = dropLeft(dropRight(FILE_NAME,instr(reverse(FILE_NAME),'CBC')-7),6),",
				"          BANK_CODE = left(FILE_NAME, 5),",
				"          insert_dttm = toTimestamp(insert_dttm, 'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: (concat('dev/Error_Logs/SYN/', $parameter1)),",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> SYN"
			]
		}
	}
}