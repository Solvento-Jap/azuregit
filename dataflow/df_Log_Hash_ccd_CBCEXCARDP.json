{
	"name": "df_Log_Hash_ccd_CBCEXCARDP",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          CARD_NBR as string,",
				"          CARD_BANK_NBR as string,",
				"          CARD_PDT_NBR as string,",
				"          CARD_ACCT_NBR as string,",
				"          CARD_STATUS as string,",
				"          CARD_SHORT_NAME as string,",
				"          CARD_CUST_NBR as string,",
				"          CARD_SUP_REL as string,",
				"          CARD_COM_BIL as string,",
				"          CARD_CHGOFF_IND as string,",
				"          CARD_USR_DTA as string,",
				"          CARD_DTE_OPEN as string,",
				"          CARD_DTE_CLOSE as string,",
				"          CARD_DTE_WARN as string,",
				"          CARD_DTE_MEMB as string,",
				"          CARD_DTE_WRTO as string,",
				"          CARD_DTE_USER1 as string,",
				"          CARD_DTE_USER2 as string,",
				"          CARD_DTE_USER3 as string,",
				"          CARD_DTE_LAST_ST_CHG as string,",
				"          CARD_EMB_NAME1 as string,",
				"          CARD_EMB_REQ1 as string,",
				"          CARD_NBR_OUT1 as string,",
				"          CARD_EMB_USRC1 as string,",
				"          CARD_DTE_LSTREQ1 as string,",
				"          CARD_LSTREQ1 as string,",
				"          CARD_EMB_NAME2 as string,",
				"          CARD_EMB_REQ2 as string,",
				"          CARD_NBR_OUT2 as string,",
				"          CARD_EMB_USRC2 as string,",
				"          CARD_DTE_LSTREQ2 as string,",
				"          CARD_LSTREQ2 as string,",
				"          CARD_EMB_NAME3 as string,",
				"          CARD_EMB_REQ3 as string,",
				"          CARD_NBR_OUT3 as string,",
				"          CARD_EMB_USRC3 as string,",
				"          CARD_DTE_LSTREQ3 as string,",
				"          CARD_LSTREQ3 as string,",
				"          CARD_EMB_NAME4 as string,",
				"          CARD_EMB_REQ4 as string,",
				"          CARD_NBR_OUT4 as string,",
				"          CARD_EMB_USRC4 as string,",
				"          CARD_DTE_LSTREQ4 as string,",
				"          CARD_LSTREQ4 as string,",
				"          CARD_TERM as string,",
				"          CARD_EXP_DATE as string,",
				"          CARD_LAST_EXP_DATE as string,",
				"          CARD_MEMB_FEE_DATE as string,",
				"          CARD_JOIN_FEE_DATE as string,",
				"          CARD_LST_ACT_DATE as string,",
				"          CARD_BLK_CODE as string,",
				"          CARD_DTE_BLK_CODE as string,",
				"          CARD_PRV_BLK_CODE as string,",
				"          CARD_DTE_PRVBLK_CODE as string,",
				"          CARD_DTE_PRVBLK_CODE_END as string,",
				"          CARD_AUTH_USG_LMTCDE as string,",
				"          CARD_WAIVE_MEMB_FEE as string,",
				"          CARD_WAIVE_JOIN_FEE as string,",
				"          CARD_WAIVE_SVC_FEE as string,",
				"          CARD_NEW_NBR as string,",
				"          CARD_NEW_NBR_EFFDTE as string,",
				"          CARD_ORG_NBR as string,",
				"          CARD_ORG_NBR_EFFDTE as string,",
				"          CARD_DTE_BPS as string,",
				"          CARD_SEQ_NBR as string,",
				"          CARD_FORMAT_ID as string,",
				"          CARD_BANK_ACCOUNT_1 as string,",
				"          CARD_BANK_ACCOUNT_2 as string,",
				"          CARD_ATM_LANGUAGE as string,",
				"          CARD_PHOTO_IND as string,",
				"          CARD_SPRT_LIMIT as string,",
				"          FLAG_CARD_SUPP_PERM_CRLIMIT as string,",
				"          CARD_SUPP_PERM_CRLIMIT as string,",
				"          FLAG_CARD_SUPP_PERM_CSHLIMIT as string,",
				"          CARD_SUPP_PERM_CSHLIMIT as string,",
				"          FLAG_CARD_SUPP_TEMP_CRLIMIT as string,",
				"          CARD_SUPP_TEMP_CRLIMIT as string,",
				"          CARD_SUPP_TEMP_CRLIMIT_EFF as string,",
				"          CARD_SUPP_TEMP_CRLIMIT_EXP as string,",
				"          CARD_NODE_ID as string,",
				"          CARD_CLOSE_REASON as string,",
				"          CARD_FILE_BUFFER as string,",
				"          CARD_ACTIVATION_DATE as string,",
				"          CARD_LST_DATE_ACTIVE as string,",
				"          CARD_ACTIVATED_BY as string,",
				"          CARD_MEMBER_SINCE as string,",
				"          CARD_LST_RENEW_DATE as string,",
				"          CARD_LOYALTY_CRD1 as string,",
				"          CARD_LOYALTY_CRD2 as string,",
				"          CARD_LOYALTY_CRD3 as string,",
				"          CARD_LOYALTY_CRD4 as string,",
				"          CARD_LOYALTY_CRD5 as string,",
				"          CARD_LOYALTY_CRD6 as string,",
				"          CARD_LOYALTY_CRD7 as string,",
				"          CARD_LOYALTY_CRD8 as string,",
				"          CARD_LOYALTY_CRD9 as string,",
				"          CARD_LOYALTY_CRD10 as string,",
				"          CARD_REPLACE_WAIVE_IND as string,",
				"          CARD_DELIVERY as string,",
				"          CARD_CBC_BUFFER as string,",
				"          CARD_DELTA_DATE as string,",
				"          CARD_CONV_FLD as string,",
				"          CARD_ARCHIVED_IND as string,",
				"          CARD_DTE_ARCHIVED as string,",
				"          CARD_DATE_MAINT as string,",
				"          CARD_USER_MAINT as string,",
				"          CARD_TIME_MAINT as string,",
				"          CARD_FILE_DATE as string,",
				"          LAST6_CARD_ACCT_NBR as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          CARD_SUPP_PERM_CRLIMIT_src = CARD_SUPP_PERM_CRLIMIT,",
				"          CARD_SUPP_PERM_CSHLIMIT_src = CARD_SUPP_PERM_CSHLIMIT,",
				"          CARD_SUPP_TEMP_CRLIMIT_src = CARD_SUPP_TEMP_CRLIMIT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          CARD_SUPP_PERM_CRLIMIT_tgt = toString(sum(toFloat(CARD_SUPP_PERM_CRLIMIT))),",
				"          CARD_SUPP_PERM_CSHLIMIT_tgt = toString(sum(toFloat(CARD_SUPP_PERM_CSHLIMIT))),",
				"          CARD_SUPP_TEMP_CRLIMIT_tgt = toString(sum(toFloat(CARD_SUPP_TEMP_CRLIMIT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toDouble(Source)),",
				"          Target = sum(toDouble(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: 'dev/Copy_logs/LOGS',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}