{
	"name": "txtsrc",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ft_dimcustomertxt",
						"type": "DatasetReference"
					},
					"name": "txtsrc"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "stg_dimCustomer",
						"type": "DatasetReference"
					},
					"name": "staging"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          empid as string,",
				"          empname as string,",
				"          gender as string,",
				"          country as string,",
				"          remarks as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> txtsrc",
				"txtsrc sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          empid as integer,",
				"          empname as string,",
				"          gender as string,",
				"          country as string,",
				"          remarks as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     preSQLs:['truncate table dbo.stg_CBC_CCD_DimCustomer'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          empid,",
				"          empname,",
				"          gender,",
				"          country,",
				"          remarks",
				"     ),",
				"     partitionBy('hash', 1)) ~> staging"
			]
		}
	}
}