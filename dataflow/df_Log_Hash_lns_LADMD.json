{
	"name": "df_Log_Hash_lns_LADMD",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_tgt_Logstable",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unpivot1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          H as string,",
				"          ACID as string,",
				"          SHDL_NUM as string,",
				"          DMD_FLOW_ID as string,",
				"          DMD_DATE as string,",
				"          DMD_SRL_NUM as string,",
				"          DEL_FLG as string,",
				"          LD_FREQ_TYPE as string,",
				"          DMD_EFF_DATE as string,",
				"          DMD_OVDU_DATE as string,",
				"          DMD_AMT as string,",
				"          LAST_ADJ_DATE as string,",
				"          TOT_ADJ_AMT as string,",
				"          LCHG_USER_ID as string,",
				"          LCHG_TIME as string,",
				"          RCRE_USER_ID as string,",
				"          RCRE_TIME as string,",
				"          EI_AMT as string,",
				"          TS_CNT as string,",
				"          LATEFEE_STATUS_FLG as string,",
				"          DEMAND_IND as string,",
				"          LDT_CRNCY_CODE as string,",
				"          CRYSTALLISED_AMT as string,",
				"          BANK_ID as string,",
				"          WAIVED_AMT as string,",
				"          LAST_WAIVER_ADJ_DATE as string,",
				"          TOT_INST_ADJ_AMT as string,",
				"          FEE_TYPE as string,",
				"          ASSOCIATION_ID as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Count_src = dropLeft(H,2),",
				"          CRYSTALLISED_AMT_src = CRYSTALLISED_AMT,",
				"          DMD_AMT_src = DMD_AMT,",
				"          EI_AMT_tgt = EI_AMT,",
				"          TOT_ADJ_AMT_tgt = TOT_ADJ_AMT,",
				"          TOT_INST_ADJ_AMT_tgt = TOT_INST_ADJ_AMT,",
				"          WAIVED_AMT_tgt = WAIVED_AMT) ~> derivedColumn1",
				"join1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(source1@FILE_NAME,",
				"          insert_dttm,",
				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          CRYSTALLISED_AMT_tgt = toString(sum(toDouble(CRYSTALLISED_AMT))),",
				"          DMD_AMT_tgt = toString(sum(toDouble(DMD_AMT))),",
				"          EI_AMT_tgt = toString(sum(toDouble(EI_AMT))),",
				"          TOT_ADJ_AMT_tgt = toString(sum(toDouble(TOT_ADJ_AMT))),",
				"          TOT_INST_ADJ_AMT_tgt = toString(sum(toDouble(TOT_INST_ADJ_AMT))),",
				"          WAIVED_AMT_tgt = toString(sum(toDouble(WAIVED_AMT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toFloat(Source)),",
				"          Target = sum(toFloat(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}