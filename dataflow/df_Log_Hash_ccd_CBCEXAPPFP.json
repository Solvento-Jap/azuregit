				"          Date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"source1 filter(H == 'D') ~> filter3",
				"filter3 aggregate(groupBy(FILE_NAME),",
				"     Count_tgt = toString(count(H)),",
				"          APPM_ANN_SALARY_tgt = toString(sum(toFloat(APPM_ANN_SALARY))),",
				"          APPM_GANN_SALARY_tgt = toString(sum(toFloat(APPM_GANN_SALARY))),",
				"          APPM_CUST_CRLIMIT_tgt = toString(sum(toFloat(APPM_CUST_CRLIMIT))),",
				"          APPM_CUST_CASHLIMIT_tgt = toString(sum(toFloat(APPM_CUST_CASHLIMIT))),",
				"          APPM_ACCT_CRLIMIT_tgt = toString(sum(toFloat(APPM_ACCT_CRLIMIT))),",
				"          APPM_ACCT_CASHLIMIT_tgt = toString(sum(toFloat(APPM_ACCT_CASHLIMIT))),",
				"          APPM_RCUST_CRLIMIT_tgt = toString(sum(toFloat(APPM_RCUST_CRLIMIT))),",
				"          APPM_RACCT_CRLIMIT_tgt = toString(sum(toFloat(APPM_RCUST_CRLIMIT))),",
				"          APPM_SUPP_CRLIMIT_AMT_tgt = toString(sum(toFloat(APPM_SUPP_CRLIMIT_AMT))),",
				"          APPM_SUPP_CSHLIMIT_AMT_tgt = toString(sum(toFloat(APPM_SUPP_CSHLIMIT_AMT))),",
				"          APPM_CUST_INSTL_LMT_tgt = toString(sum(toFloat(APPM_CUST_INSTL_LMT))),",
				"          APPM_CUST_STDALN_INST_tgt = toString(sum(toFloat(APPM_CUST_STDALN_INST))),",
				"          APPM_ACCT_INSTL_LMT_tgt = toString(sum(toFloat(APPM_ACCT_INSTL_LMT))),",
				"          APPM_ACCT_STDALN_INST_tgt = toString(sum(toFloat(APPM_ACCT_STDALN_INST))),",
				"          APPM_INCOME_tgt = toString(sum(toFloat(APPM_INCOME))),",
				"          APPM_PRE_CRED_LMT_tgt = toString(sum(toFloat(APPM_PRE_CRED_LMT))),",
				"          APPM_BAP_AMT_tgt = toString(sum(toFloat(APPM_BAP_AMT))),",
				"          APPM_TOT_CRED_LIM_tgt = toString(sum(toFloat(APPM_TOT_CRED_LIM))),",
				"          APPM_USED_CL_tgt = toString(sum(toFloat(APPM_USED_CL))),",
				"          APPM_EXT_CRED_LIM1_tgt = toString(sum(toFloat(APPM_EXT_CRED_LIM1))),",
				"          APPM_EXT_CRED_LIM2_tgt = toString(sum(toFloat(APPM_EXT_CRED_LIM2))),",
				"          APPM_EXT_CRED_LIM3_tgt = toString(sum(toFloat(APPM_EXT_CRED_LIM3))),",
				"          APPM_HOLD_AMT_tgt = toString(sum(toFloat(APPM_HOLD_AMT))),",
				"          APPM_MCUST_CRLIMIT_tgt = toString(sum(toFloat(APPM_MCUST_CRLIMIT)))) ~> aggregate1",
				"derivedColumn1, aggregate1 join(source1@FILE_NAME == aggregate1@FILE_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"unpivot1 derive(Source = case(like(Metrics, '%src%')  , Source, ''),",
				"          Target = case(like(Metrics, '%tgt%')  , Source, '')) ~> derivedColumn2",
				"derivedColumn2 derive(Metrics = case(like(Metrics,'%src%'), replace(Metrics, '_src', ''), replace(Metrics, '_tgt', '')),",
				"          insert_dttm = toTimestamp(insert_dttm,'yyyy-MM-dd\\'T\\'HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(FILE_NAME,",
				"          Date,",
				"          Metrics,",
				"          insert_dttm),",
				"     Source = sum(toDouble(Source)),",
				"          Target = sum(toDouble(Target))) ~> aggregate2",
				"aggregate2 filter(Metrics!= 'H' && Metrics!='SOURCE_CODE' && Metrics!='BANK_CODE' && Metrics!='FileName' && Metrics!= 'TABLE_NAME') ~> filter4",
				"filter4 sort(asc(Date, true),",
				"     asc(FILE_NAME, true),",
				"     asc(Metrics, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     outputRejectedData: true,",
				"     rejectedData_fileSystem: 'data360',",
				"     rejectedData_folderPath: 'dev/Copy_logs/LOGS',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}