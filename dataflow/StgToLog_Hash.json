				"          SCHM_TYPE as string,",
				"          LAST_FREZ_DATE as date,",
				"          LAST_UNFREZ_DATE as date,",
				"          BAL_ON_FREZ_DATE as decimal(20,4),",
				"          SWIFT_ALLOWED_FLG as string,",
				"          DACC_LIM_PCNT as decimal(9,6),",
				"          DACC_LIM_ABS as decimal(20,4),",
				"          CHRG_LEVEL_CODE as string,",
				"          ACCT_CLS_CHRG_PEND_VERF as string,",
				"          PARTITIONED_FLG as string,",
				"          PARTITIONED_TYPE as string,",
				"          PBF_DOWNLOAD_FLG as string,",
				"          PBF_DELINK_DATE as date,",
				"          WTAX_FLG as string,",
				"          WTAX_AMOUNT_SCOPE_FLG as string,",
