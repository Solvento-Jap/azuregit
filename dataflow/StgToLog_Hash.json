				"          IS_LOAN_AGNST_CLTRL_FLG as string,",
				"          PREFERRED_CAL_BASE as string,",
				"          ADDITIONAL_CAL_BASE as string,",
				"          MUD_POOL_ACCT_FLG as string,",
				"          ALT1_ACCT_SHORT_NAME as string,",
				"          ALT1_ACCT_NAME as string,",
				"          PACKAGE_ACCT_ID as string,",
				"          EXTERNAL_PRICING_FLG as string,",
				"          ACCT_MOD_FLG as string,",
				"          WTAX_FLOOR_LIMIT_FREQ as string,",
				"          CHQ_PROV_BY_BANK_FLG as string,",
				"          CHQ_VAL_PRD_MNTH as decimal(2,0),",
				"          CHQ_VAL_PRD_DAY as decimal(2,0),",
				"          WTAX_WAIVER_LEVEL as string,",
				"          WTAX_APPLICABLE_LEVEL as string,",
				"          WTAX_NOTICE_RCV_DATE as date,",
				"          WTAX_WAIVER_START_DATE as date,",
				"          WTAX_WAIVER_END_DATE as date,",
				"          TAX_CERT_NUM as string,",
				"          TAX_FORM_PARTICULARS as string,",
				"          TAX_CERT_SUBMISSION_DATE as date,",
				"          ACCT_OWNERSHIP_XFER_AGE as decimal(3,0),",
				"          OD_PROT_ALWD as string,",
				"          PYMNT_REF_NUM as string,",
				"          RA_REF_NUM as string,",
				"          REQ_MIN_DIS_AMT as decimal(20,4),",
				"          REQ_MIN_DIS_TENOR as decimal(3,0),",
				"          DISP_BLOCK_AMT as decimal(20,4),",
				"          CONS_BAL_FLG as string,",
				"          TAX_EVENT as string,",
				"          REQUESTED_BY as string,",
				"          TAX_EVENT_REASON_CODE as string,",
				"          DR_INT_PRENOTE_REQ_FLG as string,",
				"          DR_INT_PRENOTE_PERIOD as decimal(3,0),",
				"          CHRG_PRENOTIFICATION_FLG as string,",
				"          TARGET_BAL_FOR_SWEEPS as decimal(20,4),",
				"          CHECK_FUNDS_AVAIL_SET as string,",
				"          RULE_SET_ID as string,",
				"          CHQ_REORDER_ALWD_FLG as string,",
				"          DR_INT_METHOD as string,",
				"          COLL_CHRG_FOR_SWP_REG as string,",
				"          SWP_CHRG_COLL_ACCT_FLG as string,",
				"          SSA_PLAN_ID as string,",
				"          ESCH_CR_BACID as string,",
				"          LAST6_ACC_NUM as string,",
				"          BANK_CODE as string,",
				"          SOURCE_CODE as string,",
				"          TABLE_NAME as string,",
				"          FILE_NAME as string,",
				"          insert_dttm as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('roundRobin', 3)) ~> source1",
				"source1 filter(H !='D') ~> filter1",
				"filter1 derive(each(match(startsWith(type,'decimal')), concat($$,'_src') = toString($$)),",
				"          each(match(startsWith(type,'decimal')), $$ = toString($$)),",
				"          File_name = FILE_NAME,",
				"          Date = toDate(left(right(FILE_NAME, 12),8),'yyyyMMdd'),",
				"          Load_date = insert_dttm,",
				"          each(match(type=='date'), $$ = replace(toString($$),'1900-01-01',toString(null()))),",
				"          each(match(type=='timestamp'), $$ = replace(toString($$),'1900-01-01',toString(null())))) ~> derivedColumn1",
				"derivedColumn1 unpivot(output(",
				"          Metrics as string,",
				"          Source as string,",
				"          Target as string",
				"     ),",
				"     ungroupBy(derivedColumn1@File_name,",
				"          source1@FILE_NAME,",
				"          BANK_CODE,",
				"          SOURCE_CODE,",
				"          insert_dttm,",
				"          Date,",
				"          Load_date),",
				"     lateral: true,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"unpivot1 filter(and(Metrics != 'H', like(Metrics,'%_src'))) ~> filter2",
				"sort1 keyGenerate(output(ID as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(Source = toDouble(Source),",
				"          Target = toDouble(Target),",
				"          Metrics = replace(Metrics,'_src','')) ~> derivedColumn2",
				"filter2 sort(asc(BANK_CODE, true),",
				"     asc(Date, true),",
				"     asc(SOURCE_CODE, true),",
				"     asc(Metrics, true)) ~> sort1",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          File_name as string,",
				"          Date as date,",
				"          Load_date as timestamp,",
				"          Metrics as string,",
				"          Source as decimal(16,4),",
				"          Target as decimal(16,4)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     staged: true,",
				"     allowCopyCommand: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('roundRobin', 3)) ~> sink1"
			]
		}
	}
}