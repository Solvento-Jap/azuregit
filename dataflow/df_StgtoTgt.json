						"referenceName": "SQLPool_STG",
						"type": "DatasetReference"
					},
					"name": "STG"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQLPool_TGT",
						"type": "DatasetReference"
					},
					"name": "TGT",
