				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     staged: true,",
				"     partitionBy('hash', 1)) ~> STG",
				"STG filter(H == 'D',",
				"     partitionBy('hash', 1)) ~> filter1",
				"filter1 derive(BANK_CODE = left(FILE_NAME, 5),",
				"          SOURCE_CODE = dropLeft(dropRight(FILE_NAME,instr(reverse(FILE_NAME),'CBC')-7),6),",
				"     partitionBy('hash', 1)) ~> derivedColumn1",
