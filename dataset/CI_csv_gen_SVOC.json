{
	"name": "CI_csv_gen_SVOC",
	"properties": {
		"linkedServiceName": {
			"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Table": {
				"type": "string"
			},
			"Source": {
				"type": "string"
			},
			"Types": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().Table,'.csv')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('dev/D360-CI/EntityData-',dataset().Types,'(',dataset().Source,')','/',dataset().Table,'/FullData')",
					"type": "Expression"
				},
				"fileSystem": "data360"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.Synapse/workspaces/datasets"
}