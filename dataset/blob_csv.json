{
	"name": "blob_csv",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureBlobStorageParquet",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Sourcecode": {
				"type": "string"
			},
			"Filename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().Filename",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().Sourcecode",
					"type": "Expression"
				},
				"container": "d360"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.Synapse/workspaces/datasets"
}