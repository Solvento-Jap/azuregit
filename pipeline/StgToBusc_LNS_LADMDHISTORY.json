				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n    STG.ACID\n    ,ASSOCIATION_ID\n    ,STG.BANK_ID\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([CRYSTALLISED_AMT],' ',''),''),0)) as CRYSTALLISED_AMT\n    ,STG.DEL_FLG\n    ,DEMAND_IND\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([DMD_AMT],' ',''),''),0)) as DMD_AMT\n    ,CONVERT(DATE,STG.[DMD_DATE]) AS DMD_DATE\n    ,convert(date,[DMD_EFF_DATE]) AS DMD_EFF_DATE\n    ,STG.DMD_FLOW_ID\n    ,convert(date,[DMD_OVDU_DATE]) AS DMD_OVDU_DATE\n    ,STG.DMD_SRL_NUM\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([EI_AMT],' ',''),''),0)) as EI_AMT\n    ,FEE_TYPE\n    ,convert(date,[LAST_ADJ_DATE]) AS LAST_ADJ_DATE\n    ,convert(date,[LAST_WAIVER_ADJ_DATE]) AS LAST_WAIVER_ADJ_DATE\n    ,LATEFEE_STATUS_FLG\n    ,convert(datetime2, stuff(stuff(stuff(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n    ,LCHG_USER_ID\n    ,LDT_CRNCY_CODE\n    ,LD_FREQ_TYPE\n    ,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n    ,RCRE_USER_ID\n    ,STG.SHDL_NUM\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TOT_ADJ_AMT],' ',''),''),0)) as TOT_ADJ_AMT\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TOT_INST_ADJ_AMT],' ',''),''),0)) as TOT_INST_ADJ_AMT\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([WAIVED_AMT],' ',''),''),0)) as WAIVED_AMT\n    ,1 AS isActive\n    ,1 AS isLatest,left(FILE_NAME, 5) as [BNK_CODE]\n    ,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n    ,[FILE_NAME]\n    ,convert(date,[insert_dttm]) as insert_dttm\nFROM [BUSC].[LNS_LADMDHISTORY_DELTA] DELTA\nLEFT JOIN [d360].[STG_LNS_LADMDHISTORY] STG\n    ON DELTA.ACID = STG.ACID\n    AND DELTA.BANK_ID = STG.BANK_ID\n    AND DELTA.DMD_DATE = STG.DMD_DATE\n    AND DELTA.DMD_FLOW_ID = STG.DMD_FLOW_ID\n    AND DELTA.DMD_SRL_NUM = STG.DMD_SRL_NUM\n    AND DELTA.SHDL_NUM = STG.SHDL_NUM\nWHERE H = 'D'\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
