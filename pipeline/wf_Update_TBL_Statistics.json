{
	"name": "wf_Update_TBL_Statistics",
	"properties": {
		"activities": [
			{
				"name": "Update_Stats",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testsqlpool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "SQL",
									"type": "String",
									"value": {
										"value": "@replace(replace(pipeline().parameters.SQL,'${table}',pipeline().parameters.table),'${schema}',pipeline().parameters.schema)",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "NonQuery",
							"text": {
								"value": "EXEC sp_executesql @SQL;\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table": {
				"type": "string",
				"defaultValue": " DEPOSIT_FACT"
			},
			"schema": {
				"type": "string",
				"defaultValue": "EDS"
			},
			"SQL": {
				"type": "string",
				"defaultValue": "DECLARE @sql NVARCHAR(MAX); SELECT @sql = STRING_AGG( CAST('UPDATE STATISTICS ' + QUOTENAME(s.name) + '.' + QUOTENAME(t.name) + ';' AS NVARCHAR(MAX)), CHAR(13) + CHAR(10) ) FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id WHERE t.type = 'U' AND s.name='${schema}' AND t.name = '${table}' ; EXEC sp_executesql @sql; "
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-02-13T00:10:00Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}