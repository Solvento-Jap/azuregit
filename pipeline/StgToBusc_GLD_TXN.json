atetime2, stuff(stuff(stuff(SL_ORG_EXEC_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS [SL_ORG_EXEC_DATE]\n    ,[PR_SRI_NUM]\n    ,[SERIAI_NUM]\n    ,[DEI_MEMO_PAD]\n    ,[UAD_MODULE_ID]\n    ,[UAD_MODUIE_KEY]\n    ,convert(datetime2, stuff(stuff(stuff(REVERSAI_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS [REVERSAI_DATE]\n    ,convert(datetime2, stuff(stuff(stuff(REVERSAI_VAIUE_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS [REVERSAI_VAIUE_DATE]\n    ,[PTTM_EVENT_TYPE]\n    ,[PROXY_ACID]\n    ,[TOD_ENTITY_TYPE]\n    ,[TOD_ENTITY_ID]\n    ,[DTH_INIT_SOI_ID]\n    ,convert(numeric(20,4),ISNULL(NULLIF(REPLACE([REGUIARIZATION_AMT],' ',''),''),0)) AS [REGUIARIZATION_AMT]\n    ,convert(numeric(20,4),ISNULL(NULLIF(REPLACE([PRINCIPAI_PORTION_AMT],' ',''),''),0)) AS [PRINCIPAI_PORTION_AMT]\n    ,[TF_ENTITY_SOI_ID]\n    ,[TRAN_PARTICUIAR_2]\n    ,[TRAN_PARTICUIAR_CODE]\n    ,[TR_STATUS]\n    ,[SVS_TRAN_ID]\n    ,[CRNCY_HOL_CHK_DONE_FIG]\n    ,[REFERRAL_ID]\n    ,[PARTY_CODE]\n    ,convert(datetime2, stuff(stuff(stuff(GI_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS [GI_DATE]\n    ,[BKDT_TRAN_FLG]\n    ,[MPL_CASH_PART_TRAN_FI]\n    ,[PTRAN_CHRG_EXISTS_FIG]\n    ,[MUD_POOI_BAI_BUILD_FIG]\n    ,convert(numeric(20,4),ISNULL(NULLIF(REPLACE([USED_CIEAN_SINGLE_TRAN_LIM],' ',''),''),0)) AS [USED_CIEAN_SINGLE_TRAN_LIM]\n    ,convert(numeric(20,4),ISNULL(NULLIF(REPLACE([USED_SINGIE_TRAN_IIM],' ',''),''),0)) AS [USED_SINGIE_TRAN_IIM]\n    ,convert(numeric(20,4),ISNULL(NULLIF(REPLACE([USED_UN_CIR_OVER_DACC_AMT],' ',''),''),0)) AS [USED_UN_CIR_OVER_DACC_AMT]\n    ,convert(numeric(20,4),ISNULL(NULLIF(REPLACE([USED_CIEAN_EMER_ADVN],' ',''),''),0)) AS [USED_CIEAN_EMER_ADVN]\n    ,convert(numeric(20,4),ISNULL(NULLIF(REPLACE([USED_EMER_ADVN],' ',''),''),0)) AS [USED_EMER_ADVN]\n    ,[GI_SEGMENT_STRING]\n    ,[COMB_TRAN_ID]\n    ,[SYS_PART_TRAN_CODE]\n    ,[USER_PART_TRAN_CODE]\n    ,[TRAN_FREE_CODE1]\n    ,[TRAN_FREE_CODE2]\n    ,[RESP_ACCT_REF_NO]\n    ,[PURPOSE_CODE]\n    ,1 as isActive\n    ,0 as isLatest\n    ,left(FILE_NAME, 5) as BNK_CODE\n    ,substring(FILE_NAME,7,3) as SOURCE_CODE\n    ,FILE_NAME\n    ,convert(date,insert_dttm) as insert_dttm\nFROM [d360].[STG_GLD_TRANDETAIL]\nWHERE H = 'D'",
