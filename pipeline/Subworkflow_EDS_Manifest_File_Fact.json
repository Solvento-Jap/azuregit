			{
				"name": "CHECK PROCESS DATE PARAM",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(pipeline().parameters.startDate,'9999-12-31'),equals(pipeline().parameters.endDate,'9999-12-31'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FALSE",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "SET_START_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "SET_END_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						},
						{
							"name": "SET_START_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
