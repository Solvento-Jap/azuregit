										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
											"type": "LinkedServiceReference",
											"parameters": {
												"DBName": "testSQLPool"
											}
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": "DELETE FROM EDS.DEP_CPYBPDET WHERE AS_OF_DATE = (SELECT TOP 1 CONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) FROM D360.STG_EDS_DEP_CPYBPDET);\r\n\r\nINSERT INTO EDS.DEP_CPYBPDET\r\n(\r\nAS_OF_DATE\r\n,BILLER_ID\r\n,BILLER_SERVICE_ID\r\n,PAYMENT_ID\r\n,PAYMENT_DATE\r\n,PAYMENT_AMT\r\n,BILL_CCY\r\n,PAYMENT_TYPE\r\n,ACCT_NO\r\n,CHECK_NO\r\n,CHECK_TYPE\r\n,BANK_CODE\r\n,BRSTN\r\n,MC_DD_NO\r\n,BARCODE\r\n,SUBSCRIBER_NO\r\n,PHONE_NO\r\n,CARD_NO\r\n,CARD_TYPE\r\n,MERALCO_REF_NO\r\n,POLICY_NO\r\n,POLICY_TYPE\r\n,AREA\r\n,INSURANCE_TYPE\r\n,INVOICE_NO\r\n,NAME_OF_INSURED\r\n,STUDENT_ID\r\n,CAMPUS\r\n,STUDENT_NAME\r\n,PRODUCT_CODE\r\n,INSTITUTION_CODE\r\n,CORPORATE_NAME\r\n,TRANSACTION_CODE\r\n,COUNTRY_CODE\r\n,REMITTER\r\n,BENEFICIARY\r\n,BENEFICIARY_TIN\r\n,REF_TRANSMITTAL_NO\r\n,REPRESENTATIVE_NAME\r\n,AMLA_CODE\r\n,BANK_MNEMONIC\r\n,COMB_STRING\r\n,LATE_CHECK_PAYMENT_FLG\r\n,TRAN_ID_BY_PUB\r\n,TRAN_DATE_BY_PUB\r\n,BILLER_PAYMENT_TRAN_ID\r\n,BILLER_PAYMENT_TRAN_DATE\r\n,REVERSE_FLG\r\n,REVERSE_CRE_TIME\r\n,REVERSE_CRE_USER_ID\r\n,REVERSAL_TRAN_ID\r\n,REVERSAL_TRAN_DATE\r\n,RCRE_USER_ID\r\n,RCRE_TIME\r\n,LCHG_USER_ID\r\n,LCHG_TIME\r\n,DEL_FLG\r\n,ENTITY_CRE_FLG\r\n,SOL_ID\r\n,BANK_ID\r\n,SET_NUM\r\n,ZONE_DATE\r\n,ZONE_CODE\r\n,BNK_CODE\r\n,SOURCE_CODE\r\n,FILE_NAME\r\n,insert_dttm\r\n)\r\n\r\n\r\nSELECT \r\n\t\t\t\t CONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) AS AS_OF_DATE\r\n\t\t\t\t,[BILLER_ID]\r\n\t\t\t\t,[BILLER_SERVICE_ID]\r\n\t\t\t\t,[PAYMENT_ID]\r\n\t\t\t\t,[PAYMENT_DATE]\r\n\t\t\t\t,[PAYMENT_AMT]\r\n\t\t\t\t,[BILL_CCY]\r\n\t\t\t\t,[PAYMENT_TYPE]\r\n\t\t\t\t,[ACCT_NO]\r\n\t\t\t\t,[CHECK_NO]\r\n\t\t\t\t,[CHECK_TYPE]\r\n\t\t\t\t,[BANK_CODE]\r\n\t\t\t\t,[BRSTN]\r\n\t\t\t\t,[MC_DD_NO]\r\n\t\t\t\t,[BARCODE]\r\n\t\t\t\t,[SUBSCRIBER_NO]\r\n\t\t\t\t,[PHONE_NO]\r\n\t\t\t\t,[CARD_NO]\r\n\t\t\t\t,[CARD_TYPE]\r\n\t\t\t\t,[MERALCO_REF_NO]\r\n\t\t\t\t,[POLICY_NO]\r\n\t\t\t\t,[POLICY_TYPE]\r\n\t\t\t\t,[AREA]\r\n\t\t\t\t,[INSURANCE_TYPE]\r\n\t\t\t\t,[INVOICE_NO]\r\n\t\t\t\t,[NAME_OF_INSURED]\r\n\t\t\t\t,[STUDENT_ID]\r\n\t\t\t\t,[CAMPUS]\r\n\t\t\t\t,[STUDENT_NAME]\r\n\t\t\t\t,[PRODUCT_CODE]\r\n\t\t\t\t,[INSTITUTION_CODE]\r\n\t\t\t\t,[CORPORATE_NAME]\r\n\t\t\t\t,[TRANSACTION_CODE]\r\n\t\t\t\t,[COUNTRY_CODE]\r\n\t\t\t\t,[REMITTER]\r\n\t\t\t\t,[BENEFICIARY]\r\n\t\t\t\t,[BENEFICIARY_TIN]\r\n\t\t\t\t,[REF_TRANSMITTAL_NO]\r\n\t\t\t\t,[REPRESENTATIVE_NAME]\r\n\t\t\t\t,[AMLA_CODE]\r\n\t\t\t\t,[BANK_MNEMONIC]\r\n\t\t\t\t,[COMB_STRING]\r\n\t\t\t\t,[LATE_CHECK_PAYMENT_FLG]\r\n\t\t\t\t,[TRAN_ID_BY_PUB]\r\n\t\t\t\t,[TRAN_DATE_BY_PUB]\r\n\t\t\t\t,[BILLER_PAYMENT_TRAN_ID]\r\n\t\t\t\t,[BILLER_PAYMENT_TRAN_DATE]\r\n\t\t\t\t,[REVERSE_FLG]\r\n\t\t\t\t,[REVERSE_CRE_TIME]\r\n\t\t\t\t,[REVERSE_CRE_USER_ID]\r\n\t\t\t\t,[REVERSAL_TRAN_ID]\r\n\t\t\t\t,[REVERSAL_TRAN_DATE]\r\n\t\t\t\t,[RCRE_USER_ID]\r\n\t\t\t\t,[RCRE_TIME]\r\n\t\t\t\t,[LCHG_USER_ID]\r\n\t\t\t\t,[LCHG_TIME]\r\n\t\t\t\t,[DEL_FLG]\r\n\t\t\t\t,[ENTITY_CRE_FLG]\r\n\t\t\t\t,[SOL_ID]\r\n\t\t\t\t,[BANK_ID]\r\n\t\t\t\t,[SET_NUM]\r\n\t\t\t\t,[ZONE_DATE]\r\n\t\t\t\t,[ZONE_CODE]\r\n\t\t\t\t,LEFT(FILE_NAME, 5) AS BNK_CODE\r\n\t\t\t\t,SUBSTRING(FILE_NAME,7,3) AS SOURCE_CODE\r\n\t\t\t\t,FILE_NAME\r\n\t\t\t\t,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS DATETIME) as insert_dttm\r\nFROM D360.STG_EDS_DEP_CPYBPDET\r\nWHERE H = 'D'\r\nAND CAST(LEFT(RIGHT(FILE_NAME , 12), 8) AS DATE)>=CAST(RCRE_TIME AS DATE);\r\n\r\n"
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
