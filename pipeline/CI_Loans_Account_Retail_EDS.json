					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat(   'SELECT \n\t\t B.FORACID\tAS\tAccountID\n\t\t,C.ORGKEY\tAS\tCustomerID\n\t\t,NULL\tAS\tEntityCIF\n\t\t,C.ORGKEY\tAS\tFCBSCIF\n\t\t,A.BANK_ID\tAS\tBankCode\n\t\t,B.SOL_ID\tAS\tBranchCode\n\t\t,D.SOL_DESC\tAS\tBranchName\n\t\t,D.AREA\tAS\tArea\n\t\t,D.REGION\tAS\tRegion\n\t\t,A.SOURCE_CODE\tAS\tSource\n\t\t,PROD.PRODUCT_GROUP\tAS\tProductGrouping\n\t\t,PROD.PRODUCT_DESCRIPTION\tAS\tProductType\n\t\t,CONCAT(PROD.PRODUCT_GROUP,''-'',PROD.PRODUCT_DESCRIPTION)\tAS\tProductDetails\n\t\t,B.ACCT_OPN_DATE\tAS\tOpenedDate\n\t\t,B.RELATIONSHIP_EXPOSURE_PHP\tAS\tRelationshipExposure_Full\n\t\t,NULL\tAS\tRelationshipExposure_Prorated\n\t\t,B.BILLED_AMOUNT_PHP\tAS\tDueForTheMonth_Full\n\t\t,NULL\tAS\tDueForTheMonth_Prorated\n\t\t,B.CREDIT_LIMIT_PHP\tAS\tCreditLimit_Full\n\t\t,NULL\tAS\tCreditLimit_Prorated\n\t\t,CAST(''',variables('v_date'),''' AS DATE)\tAS\tBusinessDate\n\t\t,CAST(''',variables('v_date'),''' AS DATE)\tAS\tLastUpdatedDate\n\t\t,ROW_NUMBER() OVER (ORDER BY B.FORACID)\tAS\tAccountKey\n\t\t,B.LNS_ACCOUNT_STATUS AS ACCOUNT_STATUS\n\tFROM EDS.LNS_ACCTAUTHSIGN A\n\tLEFT JOIN EDS.LOAN_FACT B\n\t\tON A.AS_OF_DATE = B.AS_OF_DATE\n\t\tAND A.ACID = B.GAM_ACID\n\t\tAND A.BANK_ID = B.GAM_BANK_ID\n\tLEFT JOIN EDS.CUSTOMER_DIM C\n\t\tON A.AS_OF_DATE BETWEEN C.SCD_START_DATE AND C.SCD_END_DATE\n\t\tAND A.CUST_ID = C.CORE_CUST_ID\n\t\tAND A.BANK_ID = C.BANK_ID\n\tLEFT JOIN EDS.BRANCH_DIM D\n\t\tON B.SOL_ID = D.SOL_ID\n\t\tAND B.GAM_BANK_ID = D.BANK_ID\n\t\tAND A.AS_OF_DATE BETWEEN D.SCD_START_DATE AND D.SCD_END_DATE\n\tLEFT JOIN EDS.DID_PRODUCTGROUPING PROD\n        ON B.GAM_SCHM_CODE = PROD.PRODUCT_TYPE\n        AND B.GAM_BANK_ID = PROD.BANK_CODE\n        AND A.AS_OF_DATE BETWEEN PROD.SCD_START_DATE AND PROD.SCD_END_DATE\n    WHERE A.DEL_FLG = ''N''\n\t\tAND B.DEL_FLG = ''N''\n\t\tAND B.ENTITY_CRE_FLG = ''Y''\n        AND B.GAM_ACID IS NOT NULL\n        AND A.BANK_ID = ''CBC01''\n\t\tAND A.AS_OF_DATE = CAST(''',variables('v_date'),''' AS DATE)\n\t\tAND C.CUSTOMER_TYPE = ''Retail'''\n\t\t)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
