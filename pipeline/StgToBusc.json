									"type": "String",
									"value": {
										"value": "@variables('vSTREAM_NAME')",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "Query",
							"text": "SET IDENTITY_INSERT  [OM].[OM_STREAM_QUEUE] ON;\nINSERT INTO [OM].[OM_STREAM_QUEUE] (STREAM_QUEUE_ID,STREAM_ID,PIPELINE_RUNID,DATA_LAYER,STATUS_ID,STREAM_DTTM,INSERT_DTTM,END_DTTM)\nSELECT  ROW_NUMBER() OVER(ORDER BY (SELECT NULL))+ (SELECT ISNULL(MAX(STREAM_ID),0) FROM [OM].[OM_STREAM_QUEUE]),(SELECT STREAM_ID FROM OM.OM_STREAMS WHERE STREAM_NAME=@stream_name ) ,@pipeline_runid,(SELECT DATA_LAYER FROM OM.OM_STREAMS WHERE STREAM_NAME=@stream_name ),(SELECT STATUS_ID FROM OM.OM_STATUS WHERE STATUS = 'RUNNING'), NULL,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime),NULL\nSET IDENTITY_INSERT  [OM].[OM_STREAM_QUEUE] OFF;"
						}
					]
				}
			},
