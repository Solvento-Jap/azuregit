										"text": "DELETE FROM EDS.RIB_MONITORINGLOGINHISTORYTABLE WHERE AS_OF_DATE = CAST(@DatetoProcessed AS DATE);\r\n\r\nINSERT INTO EDS.RIB_MONITORINGLOGINHISTORYTABLE(\r\nAS_OF_DATE\r\n,ACTUAL_USER_ID\r\n,BANK_ID\r\n,CHANNEL_ID\r\n,DB_TS\r\n,IPADDRESS\r\n,LOGIN_TIME\r\n,LOGOFF_TIME\r\n,MSG_CODE\r\n,MSG_DESC\r\n,R_CRE_ID\r\n,R_CRE_TIME\r\n,R_MOD_ID\r\n,R_MOD_TIME\r\n,SESSION_ID\r\n,STATUS\r\n,USER_ID\r\n,USER_TYPE\r\n,isActive\r\n,isLatest\r\n,BNK_CODE\r\n,SOURCE_CODE\r\n,FILE_NAME\r\n,insert_dttm\r\n)\r\nSELECT \r\n@DatetoProcessed AS AS_OF_DATE\r\n,ACTUAL_USER_ID\r\n,BANK_ID\r\n,CHANNEL_ID\r\n,DB_TS\r\n,IPADDRESS\r\n,LOGIN_TIME\r\n,LOGOFF_TIME\r\n,MSG_CODE\r\n,MSG_DESC\r\n,R_CRE_ID\r\n,R_CRE_TIME\r\n,R_MOD_ID\r\n,R_MOD_TIME\r\n,SESSION_ID\r\n,STATUS\r\n,USER_ID\r\n,USER_TYPE\r\n,1\r\n,1\r\n,left(FILE_NAME, 5) as BNK_CODE\r\n,substring(FILE_NAME,7,3) as SOURCE_CODE\r\n,FILE_NAME\r\n,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS DATETIME) as insert_dttm\r\nFROM D360.STG_EDS_RIB_MONITORINGLOGINHISTORYTABLE\r\nWHERE H = 'D'\r\n"
