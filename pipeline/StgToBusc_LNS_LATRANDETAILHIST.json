ERDUE_INTEREST_AMT],' ',''),''),0)) as OVERDUE_INTEREST_AMT\n,PART_TRAN_SRL_NUM\n,PAYMENT_MODE\n,PAY_AHEAD_FLG\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PENAL_INTEREST_AMT],' ',''),''),0)) as PENAL_INTEREST_AMT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PEN_ON_INT_AMT],' ',''),''),0)) as PEN_ON_INT_AMT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PEN_ON_PRIN_AMT],' ',''),''),0)) as PEN_ON_PRIN_AMT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PLANNED_PREPAY_AMT],' ',''),''),0)) as PLANNED_PREPAY_AMT\n,PREPAYMENT_TYPE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PRINCIPAL_AMT],' ',''),''),0)) as PRINCIPAL_AMT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PRINCIPAL_OVERDUE_AMT],' ',''),''),0)) as PRINCIPAL_OVERDUE_AMT\n,RAISE_DMD_FLG\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([RAISE_DMD_FOR_AMT],' ',''),''),0)) as RAISE_DMD_FOR_AMT\n,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n,RCRE_USER_ID\n,REMITTER_NAME\n,REVERSAL_FLG\n,REVERSAL_REF_ID\n,REVERSED_FLG\n,SHDL_NUM\n,TOP_DISB_FLG\n,TRANSFER_TYPE\n,convert(date,[TRAN_DATE]) AS TRAN_DATE\n,TRAN_ID\n,convert(date,[TRAN_VALUE_DATE]) AS TRAN_VALUE_DATE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n,TYPE_OF_DMDS\n,convert(date,[VALUE_DATE]) AS  VALUE_DATE\n,WAIVER_RECORD\n\n\n,1 AS isActive\n,1 AS isLatest\n\n\n\n,left(FILE_NAME, 5) as [BNK_CODE]\n\n,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n\n,[FILE_NAME]\n\n,convert(date,[insert_dttm]) as insert_dttm\nFROM [D360].[STG_LNS_LATRANDETAILHIST]\nWHERE H = 'D'\n\n",
