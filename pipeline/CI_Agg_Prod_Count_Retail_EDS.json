			{
				"name": "Aggregated Prod Count Retail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('WITH DEP AS\n(\n    SELECT\n     EDA.AS_OF_DATE AS AS_OF_DATE\n    ,ORGKEY AS CUSTOMER_ID\n    ,COUNT(FORACID) AS DEP_ACCT_CNT\n\tFROM EDS.DEP_ACCOUNTRELATIONSHIP EDA\n\tINNER JOIN EDS.DEPOSIT_FACT EDF\n\t\tON EDA.ACID = EDF.GAM_ACID\n\t\tAND EDA.BANK_ID = EDF.GAM_BANK_ID\n\t\tAND EDA.AS_OF_DATE = EDF.AS_OF_DATE\n\tINNER JOIN EDS.CUSTOMER_DIM ECD\n\t\tON EDA.CUST_ID = ECD.CORE_CUST_ID\n\t\tAND EDA.BANK_ID = ECD.BANK_ID\n\t\tAND EDA.AS_OF_DATE BETWEEN ECD.SCD_START_DATE AND ECD.SCD_END_DATE\n\tWHERE \n\t\tEDA.DEL_FLG <> ''Y''\n\t\tAND EDA.ENTITY_CRE_FLG = ''Y''\n\t\tAND GAM_ACID IS NOT NULL\n\t\tAND EDA.BANK_ID = ''CBC01''\n\t\tAND (DEP_ACCOUNT_STATUS <> ''C'')\n\t\tAND EDA.AS_OF_DATE = CAST(''',variables('v_date'),''' AS DATE)\n\t\tAND LEFT(ECD.ORGKEY,1) = ''R''\n\tGROUP BY \n\t\tEDA.AS_OF_DATE\n\t\t,ORGKEY\n)\n\n\n, LNS AS \n(\n    SELECT\n    A.AS_OF_DATE AS AS_OF_DATE\n    ,C.ORGKEY AS CUSTOMER_ID\n\t,COUNT(B.FORACID) AS LNS_ACCT_CNT\n    FROM EDS.LNS_ACCTAUTHSIGN A\n\tINNER JOIN EDS.LOAN_FACT B\n\t\tON A.AS_OF_DATE = B.AS_OF_DATE\n\t\tAND A.ACID = B.GAM_ACID\n\t\tAND A.BANK_ID = B.GAM_BANK_ID\n\tINNER JOIN EDS.CUSTOMER_DIM C\n\t\tON A.AS_OF_DATE BETWEEN C.SCD_START_DATE AND C.SCD_END_DATE\n\t\tAND A.CUST_ID = C.CORE_CUST_ID\n\t\tAND A.BANK_ID = C.BANK_ID\n    WHERE A.DEL_FLG <> ''Y''\n        AND A.ENTITY_CRE_FLG = ''Y''\n        AND B.GAM_ACID IS NOT NULL\n        AND (LNS_ACCOUNT_STATUS <> ''C'')\n        AND A.BANK_ID = ''CBC01''\n\t\tAND A.AS_OF_DATE = CAST(''',variables('v_date'),''' AS DATE)\n\t\tAND LEFT(C.ORGKEY,1) = ''R''\n\tGROUP BY \n\t    A.AS_OF_DATE\n\t\t,C.ORGKEY\n)\n, CCD AS \n(\n    SELECT\n    AS_OF_DATE\n    ,CUST_CIF_NBR AS CUSTOMER_ID\n\t,COUNT(CRDACCT_NBR) AS CCD_ACCT_CNT\n    FROM EDS.CCD_CREDIT_CARDS_FACT A\n\tWHERE\n\tA.AS_OF_DATE = CAST(''',variables('v_date'),''' AS DATE)\n\tAND A.CRDACCT_STATUS <> 8\n\tAND LEFT(CUST_CIF_NBR,1) = ''R''\n\tGROUP BY\n\t AS_OF_DATE\n    ,CUST_CIF_NBR\n)\n, TRU AS\n(\n\tSELECT\n\t\tCAST(''',variables('v_date'),''' AS DATE) AS AS_OF_DATE\n\t   ,CUST.UNIQUE_ID AS CUSTOMER_ID\n\t   ,COUNT(PORTFOLIO_NO) AS TRU_ACCT_CNT\n\tFROM\n\tEDS.TRU_CUST CUST\n\tINNER JOIN EDS.TRU_BASELINK BASE\n\t\tON CUST.CUST_NO = BASE.CIF_NO\n\t\tAND CAST(''',variables('v_date'),''' AS DATE) BETWEEN BASE.SCD_START_DATE AND BASE.SCD_END_DATE\n\tINNER JOIN EDS.TRU_PORTFOLIO PORT\n\t\tON BASE.CUST_NO = PORT.BASE_NO\n\t\tAND PORT.STATUS = ''A''\n\t\tAND CAST(''',variables('v_date'),''' AS DATE) BETWEEN PORT.SCD_START_DATE AND PORT.SCD_END_DATE\n\tINNER JOIN EDS.TRU_PFSUBSCRIPTION PFSUB\n\t\tON PORT.SUBSCRIPTION_ID = PFSUB.SUBSCRIPTION_ID\n\t\tAND PORT.BASE_NO = PFSUB.BASE_NO\n\t\tAND CAST(''',variables('v_date'),''' AS DATE) BETWEEN PFSUB.SCD_START_DATE AND PFSUB.SCD_END_DATE\n\t\t\n\tWHERE\n\t\tCAST(''',variables('v_date'),''' AS DATE) BETWEEN CUST.SCD_START_DATE AND CUST.SCD_END_DATE\n\t\tAND LEFT(CUST.UNIQUE_ID,1) = ''R''\n\tGROUP BY \n\t   CUST.UNIQUE_ID\n)\n\n, TRY AS\n(\n\tSELECT\n\t\tCAST(''',variables('v_date'),''' AS DATE) AS AS_OF_DATE,\n\t\tvalue AS CUSTOMER_ID,\n\t\tCOUNT( LE.ID) AS TRY_ACCT_CNT\n    FROM EDS.TRY_LEGALENTITY AS LE\n\tCROSS APPLY STRING_SPLIT(LE.EXTERNAL_REF, ''|'')\n    WHERE \n\t\tLE.STATUS = ''ENABLED'' AND LE.BNK_CODE = ''CBC01''\n\t\tAND CAST(''',variables('v_date'),''' AS DATE) BETWEEN LE.SCD_START_DATE AND LE.SCD_END_DATE\n\t\tAND LEFT(LE.EXTERNAL_REF,1)=''R''\n\tGROUP BY \n\t\tvalue\n)\nSELECT AS_OF_DATE, CUSTOMER_ID, SUM(DEP_ACCT_CNT) DEP_COUNT,  SUM(LNS_ACCT_CNT) LNS_COUNT,  SUM(CCD_ACCT_CNT) CCD_COUNT, \nSUM(TRU_ACCT_CNT) TRU_COUNT, SUM(TRY_ACCT_CNT) TRY_COUNT\nFROM \n(\n    SELECT AS_OF_DATE, CUSTOMER_ID, DEP_ACCT_CNT, 0 LNS_ACCT_CNT, 0 CCD_ACCT_CNT, 0 TRU_ACCT_CNT, 0 TRY_ACCT_CNT FROM DEP\n    UNION ALL\n    SELECT AS_OF_DATE, CUSTOMER_ID, 0 DEP_ACCT_CNT, LNS_ACCT_CNT, 0 CCD_ACCT_CNT, 0 TRU_ACCT_CNT, 0 TRY_ACCT_CNT FROM LNS\n    UNION ALL\n    SELECT AS_OF_DATE, CUSTOMER_ID, 0 DEP_ACCT_CNT, 0 LNS_ACCT_CNT, CCD_ACCT_CNT, 0 TRU_ACCT_CNT, 0 TRY_ACCT_CNT FROM CCD\n    UNION ALL\n    SELECT AS_OF_DATE, CUSTOMER_ID, 0 DEP_ACCT_CNT, 0 LNS_ACCT_CNT, 0 CCD_ACCT_CNT, TRU_ACCT_CNT, 0 TRY_ACCT_CNT  FROM TRU\n    UNION ALL\n    SELECT AS_OF_DATE, CUSTOMER_ID, 0 DEP_ACCT_CNT, 0 LNS_ACCT_CNT, 0 CCD_ACCT_CNT, 0 TRU_ACCT_CNT, TRY_ACCT_CNT FROM TRY ) A\nINNER JOIN EDS.CUSTOMER_DIM ECD\n\tON A.CUSTOMER_ID = ECD.ORGKEY\n\tAND ECD.BANK_ID = ''CBC01''\n\tAND CAST(''',variables('v_date'),''' AS DATE) BETWEEN ECD.SCD_START_DATE AND ECD.SCD_END_DATE\nGROUP BY AS_OF_DATE, CUSTOMER_ID')\n\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
