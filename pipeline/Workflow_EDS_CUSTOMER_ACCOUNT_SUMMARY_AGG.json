								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "IF NOT EXISTS(select * FROM EDS.DATE_DIM EDD WHERE EDD.FULLDATE = DATEADD(MM,1,(SELECT MAX(DATE_ID) DATE_ID FROM EDS.CUSTOMER_ACCOUNT_SUMMARY_AGG)))\n    BEGIN\n        SELECT '2023-01-01' start_date\n    END\nELSE\n    BEGIN\n        SELECT CASE WHEN ISNULL(CURRENT_MONTH_END,'') = '' THEN '2023-01-01' ELSE CURRENT_MONTH_END END start_date FROM EDS.DATE_DIM EDD \n\t    WHERE EDD.FULLDATE = DATEADD(MM,1,(SELECT MAX(DATE_ID) DATE_ID FROM EDS.CUSTOMER_ACCOUNT_SUMMARY_AGG))\n    END\n\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
