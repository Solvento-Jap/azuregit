{
	"name": "CI_Deposits_Account_Retail_EDS",
	"properties": {
		"description": "Sources data from EDS tables",
		"activities": [
			{
				"name": "Deposits Retail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT \n\t\t\t\t EDF.FORACID\tAS\tAccountID\n\t\t\t\t,ECD.ORGKEY\tAS\tCustomerID\n\t\t\t\t,NULL\tAS\tEntityCIF\n\t\t\t\t,ECD.ORGKEY\tAS\tFCBSCIF\n\t\t\t\t,EDA.BANK_ID AS\tBankCode\n\t\t\t\t,EDF.SOL_ID\tAS\tBranchCode\n\t\t\t\t,EBD.SOL_DESC\tAS\tBranchName\n\t\t\t\t,EBD.AREA\tAS\tArea\n\t\t\t\t,EBD.REGION\tAS\tRegion\n\t\t\t\t,EDA.SOURCE_CODE\tAS\tSource\n\t\t\t\t,EDP.PRODUCT_GROUP\tAS\tProductGrouping\n\t\t\t\t,CONCAT(EDP.PRODUCT_GROUP,''-'',EDP.PRODUCT_DESCRIPTION)\tAS\tProductDetails\n\t\t\t\t,EDP.PRODUCT_DESCRIPTION\tAS\tProductType\n\t\t\t\t,EDF.ACCT_OPN_DATE\tAS\tOpenedDate\n\t\t\t\t,(\n\t\t\t\t\tCASE \n\t\t\t\t\tWHEN EDA.ACCT_POA_AS_REC_TYPE IN (''M'', ''J'') \n\t\t\t\t\tTHEN ''Y'' ELSE ''N'' \n\t\t\t\t\tEND\n\t\t\t\t)\tAS\tShareIndicator \n\t\t\t\t,NULL\tAS\tMonthToDateAverageDailyBalance_Full\n\t\t\t\t,NULL\tAS\tMonthToDateAverageDailyBalance_Prorated\n\t\t\t\t,(\n\t\t\t\t\tCASE \n\t\t\t\t\tWHEN EDF.ACCT_CRNCY_CODE = ''PHP'' \n\t\t\t\t\tTHEN \n\t\t\t\t\tISNULL(EDF.YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP,0) \n\t\t\t\t\tELSE \n\t\t\t\t\t0\n\t\t\t\t\tEND\n\t\t\t\t ) AS YearToDateAverageDailyBalance_Full\n\t\t\t\t,NULL\tAS\tYearToDateAverageDailyBalance_Prorated\n\t\t\t\t,EDF.OUTSTANDING_BALANCE_PHP\tAS\tOutstandingBalance_Full\n\t\t\t\t,NULL\tAS\tOutstandingBalance_Prorated\n\t\t\t\t,CAST(''',variables('V_date'),''' AS DATE) AS\tBusinessDate\n\t\t\t\t,CAST(''',variables('V_date'),''' AS DATE) AS\tLastUpdatedDate\n\t\t\t\t,ROW_NUMBER() OVER (ORDER BY EDF.FORACID)\tAS\tAccountKey \n\t\t\t\t,EDF.DEP_ACCOUNT_STATUS AS ACCOUNT_STATUS\n\t\t\tFROM EDS.DEP_ACCOUNTRELATIONSHIP EDA\n\t\t\tLEFT JOIN EDS.DEPOSIT_FACT EDF\n\t\t\t\tON EDA.ACID = EDF.GAM_ACID\n\t\t\t\tAND EDA.BANK_ID = EDF.GAM_BANK_ID\n\t\t\t\tAND EDA.AS_OF_DATE = EDF.AS_OF_DATE\n\t\t\tLEFT JOIN EDS.BRANCH_DIM EBD\n\t\t\t    ON EDF.SOL_ID = EBD.SOL_ID\n\t\t\t    AND EDF.GAM_BANK_ID = EBD.BANK_ID\n\t\t\t    AND EDA.AS_OF_DATE BETWEEN EBD.SCD_START_DATE AND EBD.SCD_END_DATE\n\t\t\tLEFT JOIN EDS.CUSTOMER_DIM ECD\n\t\t\t\tON EDA.CUST_ID = ECD.CORE_CUST_ID\n\t\t\t\tAND EDA.BANK_ID = ECD.BANK_ID\n\t\t\t\tAND EDA.AS_OF_DATE BETWEEN ECD.SCD_START_DATE AND ECD.SCD_END_DATE\n\t\t\tLEFT JOIN EDS.DID_PRODUCTGROUPING EDP\n\t\t\t    ON EDF.GAM_SCHM_CODE = EDP.PRODUCT_TYPE\n\t\t\t    AND EDF.GAM_BANK_ID = EDP.BANK_CODE\n\t\t\t    AND EDA.AS_OF_DATE BETWEEN EDP.SCD_START_DATE AND EDP.SCD_END_DATE\n\t\t\t--LEFT JOIN EDS.DEPOSIT_MTD_YTD_UAT NONPHP\n\t\t\t--\tON EDF.GAM_ACID = NONPHP.GAM_ACID\n\t\t\t--\tAND EDF.GAM_BANK_ID = NONPHP.GAM_BANK_ID\n\t\t\t--\tAND EDA.AS_OF_DATE = NONPHP.FULLDATE\n\t\t\t--\tAND NONPHP.ACCT_CRNCY_CODE <> ''PHP''\n\t\t\tWHERE \n\t\t\t\tEDA.AS_OF_DATE = CAST(''',variables('V_date'),''' AS DATE) \n\t\t\t\tAND EDF.GAM_ACID IS NOT NULL \n\t\t\t\tAND EDA.DEL_FLG = ''N''\n\t\t\t\tAND EDF.DEL_FLG = ''N''\n\t\t\t\tAND EDF.ENTITY_CRE_FLG = ''Y''\n\t\t\t\tAND EDA.BANK_ID = ''CBC01''\n\t\t\t\tAND ECD.CUSTOMER_TYPE = ''Retail''\n\t\t\t\tAND EDF.DEP_ACCOUNT_STATUS <> ''C''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
