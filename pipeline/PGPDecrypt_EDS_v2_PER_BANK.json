{
	"name": "PGPDecrypt_EDS_v2_PER_BANK",
	"properties": {
		"description": "GAM_EAB_YTD",
		"activities": [
			{
				"name": "List All Encrypted Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "adls_src_encrypt_sourcecode",
						"type": "DatasetReference",
						"parameters": {
							"sourcecode": {
								"value": "@concat('*',pipeline().parameters.Bank_Id,'_',pipeline().parameters.tables,'_*')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Decrypt Multiple Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "List All Encrypted Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List All Encrypted Files').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "PGP Decrypt",
							"type": "AzureFunctionActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 300,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"functionName": "PGPDecrypt",
								"body": {
									"value": "{\nfilePath: \"data360/dev/encrypt/@{item().name}\",\noutputPath: \"data360/dev/decrypted/@{pipeline().parameters.src_sys}/@{replace(item().name,'.gpg','')}\",\nkvsecpass: \"cbcpassp\",\nkvsecpriv: \"cbcprivkey\"\n}",
									"type": "Expression"
								},
								"method": "POST"
							},
							"linkedServiceName": {
								"referenceName": "PGPFunction",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_LOG_TASK_ERROR_DTL_DECRYPT",
							"type": "SqlPoolStoredProcedure",
							"dependsOn": [
								{
									"activity": "Set v_error_desc_decrypt",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"sqlPool": {
								"referenceName": "testSQLpool",
								"type": "SqlPoolReference"
							},
							"typeProperties": {
								"storedProcedureName": "[OM].[SP_LOG_TASK_ERROR_DTL]",
								"storedProcedureParameters": {
									"task_name": {
										"value": {
											"value": "@concat('TSK_STG_EDS_',pipeline().parameters.Bank_Id,'_',replace(pipeline().parameters.tables,'''',''))",
											"type": "Expression"
										},
										"type": "String"
									},
									"pipeline_runid": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"data_layer": {
										"value": "EDS_STG",
										"type": "String"
									},
									"process_date": {
										"value": {
											"value": "@split(split(item().name,'_')[4],'.')[0]",
											"type": "Expression"
										},
										"type": "String"
									},
									"error_desc": {
										"value": {
											"value": "@variables('v_error_desc')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							}
						},
						{
							"name": "Set v_error_desc_decrypt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "PGP Decrypt",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_error_desc",
								"value": {
									"value": "@activity('PGP Decrypt').Error.message",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SUCCESS PIPELINE",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "PGP Decrypt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						},
						{
							"name": "Fail1",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "SP_LOG_TASK_ERROR_DTL_DECRYPT",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "PGPDecrypt Failed",
								"errorCode": "501"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"tables": {
				"type": "string"
			},
			"src_sys": {
				"type": "string"
			},
			"Bank_Id": {
				"type": "string"
			}
		},
		"variables": {
			"v_error_desc": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-11-04T06:22:36Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}