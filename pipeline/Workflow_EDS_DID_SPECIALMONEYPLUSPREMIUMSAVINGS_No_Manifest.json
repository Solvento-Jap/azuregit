			"HashLog_SQL": {
				"type": "string",
				"defaultValue": "WITH CTE1 AS ( \tSELECT TRY_CAST(COUNT(*) AS NUMERIC(25, 5)) COUNT_tgt \t\t,isnull(sum(OUTSTANDING_BALANCE),0) OUTSTANDING_BALANCE_tgt \t\t,FILE_NAME \t\t,INSERT_DTTM \tFROM d360.STG_EDS_DID_SPECIALMONEYPLUSPREMIUMSAVINGS \tWHERE H = 'D' \tGROUP BY FILE_NAME \t\t,INSERT_DTTM \t) \t,CTE2 AS ( \tSELECT TRY_CAST(REPLACE(H, 'F-', '') AS NUMERIC(25, 5)) COUNT_src \t\t,TRY_CAST(OUTSTANDING_BALANCE AS NUMERIC(25,5))OUTSTANDING_BALANCE_src \t\t,FILE_NAME \t\t,INSERT_DTTM \tFROM d360.STG_EDS_DID_SPECIALMONEYPLUSPREMIUMSAVINGS \tWHERE H <> 'D' \t)   \t,CTE12 AS ( \tSELECT COUNT_SRC \t\t,COUNT_TGT \t\t,OUTSTANDING_BALANCE_tgt \t\t,OUTSTANDING_BALANCE_src \t\t,A.FILE_NAME \t\t,A.INSERT_DTTM \t\t,TRY_CAST((left(right(A.FILE_NAME, 12), 8)) AS DATE) DATE \tFROM CTE1 A \tJOIN CTE2 B ON A.FILE_NAME = B.FILE_NAME \t\tAND A.INSERT_DTTM = B.INSERT_DTTM \t)  INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT FILE_NAME \t,DATE \t,insert_dttm \t,REPLACE(METRICS, '_SRC', '') METRICS \t,SRC \t,TGT FROM ( \tSELECT TRY_CAST(COUNT_SRC AS NUMERIC(25, 5)) COUNT_SRC \t\t,TRY_CAST(COUNT_TGT AS NUMERIC(25, 5)) COUNT_TGT \t\t,TRY_CAST(OUTSTANDING_BALANCE_tgt AS NUMERIC(25,5))OUTSTANDING_BALANCE_tgt \t\t,TRY_CAST(OUTSTANDING_BALANCE_src AS NUMERIC(25,5))OUTSTANDING_BALANCE_src \t\t,FILE_NAME \t\t,INSERT_DTTM \t\t,[DATE] \tFROM CTE12 \t) pvt UNPIVOT(SRC FOR METRICS IN ( \t\tCOUNT_SRC \t\t,OUTSTANDING_BALANCE_src \t\t\t)) pvt1 UNPIVOT(TGT FOR METRICS2 IN ( \t\tCOUNT_TGT \t\t,OUTSTANDING_BALANCE_tgt \t\t\t)) pvt2 WHERE REPLACE(METRICS, '_SRC', '') = REPLACE(METRICS2, '_TGT', '');"
			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "DELETE FROM EDS.DID_SPECIALMONEYPLUSPREMIUMSAVINGS WHERE AS_OF_DATE IN (SELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) FROM D360.STG_EDS_DID_SPECIALMONEYPLUSPREMIUMSAVINGS)  INSERT INTO EDS.DID_SPECIALMONEYPLUSPREMIUMSAVINGS (     AS_OF_DATE     ,SCHM_CODE     ,BOOKING_BRANCH     ,SOL_ID     ,SOL_DESC     ,OPENING_DATE     ,MATURITY_DATE     ,OUTSTANDING_BALANCE     ,FORACID     ,FORACID_UNMASKED     ,BNK_CODE     ,SOURCE_CODE     ,FILE_NAME     ,insert_dttm ) SELECT     CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) AS AS_OF_DATE     ,SCHM_CODE     ,BOOKING_BRANCH     ,SOL_ID     ,SOL_DESC     ,OPENING_DATE     ,MATURITY_DATE     ,OUTSTANDING_BALANCE     ,FORACID     ,FORACID_UNMASKED     ,LEFT(FILE_NAME,5) AS BNK_CODE     ,'DID' AS SOURCE_CODE     ,FILE_NAME     ,insert_dttm FROM D360.STG_EDS_DID_SPECIALMONEYPLUSPREMIUMSAVINGS WHERE H = 'D';"
			}
