				"name": "Cards Retail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('WITH CAH AS\n(\n    SELECT\n     AS_OF_DATE\n    ,CRDACCT_NBR\n    ,CRDACCT_CUST_NBR\n    ,CUST_CIF_NBR\n    ,CRDACCT_BNK_CODE\n    ,CRDACCT_SOURCE_CODE\n    ,CRDACCT_PDT_NBR\n    ,CRDACCT_DTE_OPEN\n    ,CRDACCT_OUTSTD_BAL\n    ,CRDACCT_OUTSTD_INSTL\n    ,CRDACCT_STMT_BAL_RTL\n    ,CRDACCT_STMT_BAL_CASH\n    ,CRDACCT_CRLIMIT\n\t,CRDACCT_STATUS\n    FROM eds.CCD_CREDIT_CARDS_FACT\n    WHERE \n\t\tAS_OF_DATE = CAST(''',variables('v_date'),''' AS DATE)\n        AND CRDACCT_NBR IS NOT NULL\n\t\tAND LEFT(CUST_CIF_NBR,1)=''R''\n    GROUP BY \n     AS_OF_DATE\n    ,CRDACCT_NBR\n    ,CRDACCT_CUST_NBR\n    ,CUST_CIF_NBR\n    ,CRDACCT_BNK_CODE\n    ,CRDACCT_SOURCE_CODE\n    ,CRDACCT_PDT_NBR\n    ,CRDACCT_DTE_OPEN\n    ,CRDACCT_OUTSTD_BAL\n    ,CRDACCT_OUTSTD_INSTL\n    ,CRDACCT_STMT_BAL_RTL\n    ,CRDACCT_STMT_BAL_CASH\n    ,CRDACCT_CRLIMIT\n\t,CRDACCT_STATUS\n)\n\n, CCD_BRANCH AS\n(\n    SELECT *\n        ,ROW_NUMBER() OVER (PARTITION BY APPM_ACCT_NBR ORDER BY BD DESC) AS RN\n    FROM\n    (\n    SELECT APPM_ACCT_NBR, SUBSTRING(APPM_SOURCE,7,4) AS BRANCH_CODE, LEFT(RIGHT(FILE_NAME,12),8) AS BD FROM EDS.CCD_CBCEXAPPMP WHERE CAST(''',variables('V_date'),''' AS DATE) BETWEEN SCD_START_DATE AND SCD_END_DATE GROUP BY APPM_ACCT_NBR, SUBSTRING(APPM_SOURCE,7,4), LEFT(RIGHT(FILE_NAME,12),8)\n    UNION ALL\n    SELECT APPM_ACCT_NBR, SUBSTRING(APPM_SOURCE,7,4) AS BRANCH_CODE, LEFT(RIGHT(FILE_NAME,12),8) AS BD FROM EDS.CCD_CBCEXAPPFP WHERE CAST(''',variables('V_date'),''' AS DATE) BETWEEN SCD_START_DATE AND SCD_END_DATE GROUP BY APPM_ACCT_NBR, SUBSTRING(APPM_SOURCE,7,4), LEFT(RIGHT(FILE_NAME,12),8)\n    ) A\n)\n\nSELECT\nCAH.CRDACCT_NBR\tAS\tAccountID\n,CAH.CRDACCT_CUST_NBR\tAS\tCustomerID\n,NULL\tAS\tEntityCIF\n,CAH.CUST_CIF_NBR\tAS\tFCBSCIF\n,CAH.CRDACCT_BNK_CODE\tAS\tBankCode\n,CCD_BRANCH.BRANCH_CODE\tAS\tBranchCode\n,BR.SOL_DESC\tAS\tBranchName\n,BR.AREA\tAS\tArea\n,BR.REGION\tAS\tRegion\n,CAH.CRDACCT_SOURCE_CODE\tAS\tSource\n,PROD.PRODUCT_GROUP\tAS\tProductGrouping\n,PROD.PRODUCT_DESCRIPTION\tAS\tProductType\n,CONCAT(PROD.PRODUCT_GROUP,''-'',PROD.PRODUCT_DESCRIPTION)\tAS\tProductDetails\n,CAST(CAST(CAH.CRDACCT_DTE_OPEN AS VARCHAR) AS DATE) AS\tOpenedDate\n,CASE WHEN CAH.CRDACCT_OUTSTD_BAL > 0 AND CAH.CRDACCT_OUTSTD_INSTL > 0 THEN CAH.CRDACCT_OUTSTD_BAL + CAH.CRDACCT_OUTSTD_INSTL\n    WHEN CAH.CRDACCT_OUTSTD_BAL <= 0 AND CAH.CRDACCT_OUTSTD_INSTL <= 0 THEN 0\n    WHEN CAH.CRDACCT_OUTSTD_BAL > 0 AND CAH.CRDACCT_OUTSTD_INSTL <= 0  THEN CAH.CRDACCT_OUTSTD_BAL\n    WHEN CAH.CRDACCT_OUTSTD_BAL <= 0 AND CAH.CRDACCT_OUTSTD_INSTL > 0  THEN CAH.CRDACCT_OUTSTD_INSTL END AS\tRelationshipExposure_Full\n,NULL AS RelationshipExposure_Prorated\n,CAH.CRDACCT_STMT_BAL_RTL + CAH.CRDACCT_STMT_BAL_CASH AS\tDueForTheMonth_Full\n,NULL\tAS\tDueForTheMonth_Prorated\n,CAH.CRDACCT_CRLIMIT\tAS\tCreditLimit_Full\n,NULL\tAS\tCreditLimit_Prorated\n,CAST(CAST(CAH.AS_OF_DATE AS VARCHAR) AS DATE)\tAS\tBusinessDate\n,CAST(CAST(CAH.AS_OF_DATE AS VARCHAR) AS DATE)\tAS\tLastUpdatedDate\n,ROW_NUMBER() OVER (ORDER BY CAH.CRDACCT_NBR)\tAS\tAccountKey\n,CAH.CRDACCT_STATUS AS ACCOUNT_STATUS\nFROM CAH\n    LEFT JOIN eds.DID_PRODUCTGROUPING PROD\n        ON CAST(CAH.CRDACCT_PDT_NBR AS varchar(8)) = PROD.PRODUCT_TYPE\n        AND CAH.CRDACCT_BNK_CODE = PROD.BANK_CODE\n        AND CAH.AS_OF_DATE BETWEEN PROD.SCD_START_DATE AND PROD.SCD_END_DATE\n    LEFT JOIN CCD_BRANCH\n        ON CAH.CRDACCT_NBR = CCD_BRANCH.APPM_ACCT_NBR\n        AND RN = 1\n    LEFT JOIN eds.BRANCH_DIM BR\n        ON CCD_BRANCH.BRANCH_CODE = BR.SOL_ID\n        AND CAH.AS_OF_DATE BETWEEN BR.SCD_START_DATE AND BR.SCD_END_DATE\n        AND BR.BANK_ID = ''CBC01''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
