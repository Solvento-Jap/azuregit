{
	"name": "Workflow_SYN",
	"properties": {
		"description": "Load to all SYN tables from EDS",
		"activities": [
			{
				"name": "Get Success Count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT  * FROM [OM].[FUNC_CHECK_STATUS](''TSK_STG_EDS_',variables('tables'),''',''SYN_EDS'',''',substring(variables('sys_date'),0,10),''')')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLPool_OM",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "TASK_RUN"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Condition Success Count",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get Success Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Get Success Count').output.firstrow.CNT_SUCCESSFUL,0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "END_TASK_STG_EDS_SUCCESSFUL",
							"type": "SqlPoolStoredProcedure",
							"dependsOn": [
								{
									"activity": "EDS_to_SYN",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"sqlPool": {
								"referenceName": "testSQLpool",
								"type": "SqlPoolReference"
							},
							"typeProperties": {
								"storedProcedureName": "[OM].[SP_TASK_END]",
								"storedProcedureParameters": {
									"task_name": {
										"value": {
											"value": "@concat('TSK_SYN_EDS_',variables('tables'))",
											"type": "Expression"
										},
										"type": "String"
									},
									"pipeline_runid": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"data_layer": {
										"value": "SYN_EDS",
										"type": "String"
									},
									"status": {
										"value": "SUCCESSFUL",
										"type": "String"
									}
								}
							}
						},
						{
							"name": "END_TASK_STG_EDS_FAILED",
							"type": "SqlPoolStoredProcedure",
							"dependsOn": [
								{
									"activity": "EDS_to_SYN",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"sqlPool": {
								"referenceName": "testSQLpool",
								"type": "SqlPoolReference"
							},
							"typeProperties": {
								"storedProcedureName": "[OM].[SP_TASK_END]",
								"storedProcedureParameters": {
									"task_name": {
										"value": {
											"value": "@concat('TSK_SYN_EDS_',variables('tables'))",
											"type": "Expression"
										},
										"type": "String"
									},
									"pipeline_runid": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"data_layer": {
										"value": "SYN_EDS",
										"type": "String"
									},
									"status": {
										"value": "FAILED",
										"type": "String"
									}
								}
							}
						},
						{
							"name": "START_TASK_STG_EDS",
							"type": "SqlPoolStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"sqlPool": {
								"referenceName": "testSQLpool",
								"type": "SqlPoolReference"
							},
							"typeProperties": {
								"storedProcedureName": "[OM].[SP_TASK_START]",
								"storedProcedureParameters": {
									"task_name": {
										"value": {
											"value": "@concat('TSK_SYN_EDS_',variables('tables'))",
											"type": "Expression"
										},
										"type": "String"
									},
									"pipeline_runid": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"data_layer": {
										"value": "SYN_EDS",
										"type": "String"
									},
									"process_date": {
										"value": {
											"value": "@replace(substring(variables('sys_date'),0,10),'-','')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							}
						},
						{
							"name": "EDS_to_SYN",
							"type": "SqlPoolStoredProcedure",
							"dependsOn": [
								{
									"activity": "START_TASK_STG_EDS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"sqlPool": {
								"referenceName": "testSQLpool",
								"type": "SqlPoolReference"
							},
							"typeProperties": {
								"storedProcedureName": "[syn].[SP_EDS_TO_SYN]",
								"storedProcedureParameters": {
									"Datetoprocess": {
										"value": {
											"value": "@pipeline().parameters.process_date",
											"type": "Expression"
										},
										"type": "Datetime"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"process_date": {
				"type": "string",
				"defaultValue": "9999-12-31"
			}
		},
		"variables": {
			"schema": {
				"type": "String",
				"defaultValue": "SYN_EDS"
			},
			"sys_date": {
				"type": "String",
				"defaultValue": "@addhours(pipeline().TriggerTime,8)"
			},
			"tables": {
				"type": "String",
				"defaultValue": "SYN_STG_TBL"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-08-30T06:49:35Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}