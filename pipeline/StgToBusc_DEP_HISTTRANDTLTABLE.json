				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "UPDATE TGT\nSET ISLATEST = 0\nFROM BUSC.DEP_HISTTRANDTLTABLE TGT\nWHERE  ISLATEST = 1\n--AND EXISTS (\n--SELECT * FROM D360.STG_DEP_HISTTRANDTLTABLE SRC where  H = 'D'\n--AND CONVERT(DATE, LEFT(SRC.TRAN_DATE, 8)) = TGT.TRAN_DATE\n--AND SRC.TRAN_ID=TGT.TRAN_ID\n--AND SRC.PART_TRAN_SRL_NUM=TGT.PART_TRAN_SRL_NUM\n--AND SRC.BANK_ID=TGT.BANK_ID\n--AND BINARY_CHECKSUM(SRC.TRAN_DATE,SRC.TRAN_ID,SRC.PART_TRAN_SRL_NUM,SRC.DEL_FLG,SRC.TRAN_TYPE,SRC.TRAN_SUB_TYPE,SRC.PART_TRAN_TYPE,SRC.GL_SUB_HEAD_CODE,SRC.ACID,SRC.VALUE_DATE,SRC.TRAN_AMT,SRC.TRAN_PARTICULAR,SRC.ENTRY_USER_ID,SRC.PSTD_USER_ID,SRC.VFD_USER_ID,SRC.ENTRY_DATE,SRC.PSTD_DATE,SRC.VFD_DATE,SRC.RPT_CODE,SRC.REF_NUM,SRC.INSTRMNT_TYPE,SRC.INSTRMNT_DATE,SRC.INSTRMNT_NUM,SRC.INSTRMNT_ALPHA,SRC.TRAN_RMKS,SRC.PSTD_FLG,SRC.PRNT_ADVC_IND,SRC.AMT_RESERVATION_IND,SRC.RESERVATION_AMT,SRC.RESTRICT_MODIFY_IND,SRC.LCHG_USER_ID,SRC.LCHG_TIME,SRC.RCRE_USER_ID,SRC.RCRE_TIME,SRC.CUST_ID,SRC.VOUCHER_PRINT_FLG,SRC.MODULE_ID,SRC.BR_CODE,SRC.FX_TRAN_AMT,SRC.RATE_CODE,SRC.RATE,SRC.CRNCY_CODE,SRC.NAVIGATION_FLG,SRC.TRAN_CRNCY_CODE,SRC.REF_CRNCY_CODE,SRC.REF_AMT,SRC.SOL_ID,SRC.BANK_CODE,SRC.TREA_REF_NUM,SRC.TREA_RATE,SRC.TS_CNT,SRC.GST_UPD_FLG,SRC.ISO_FLG,SRC.EABFAB_UPD_FLG,SRC.LIFT_LIEN_FLG,SRC.PROXY_POST_IND,SRC.SI_SRL_NUM,SRC.SI_ORG_EXEC_DATE,SRC.PR_SRL_NUM,SRC.SERIAL_NUM,SRC.DEL_MEMO_PAD,SRC.UAD_MODULE_ID,SRC.UAD_MODULE_KEY,SRC.REVERSAL_DATE,SRC.REVERSAL_VALUE_DATE,SRC.PTTM_EVENT_TYPE,SRC.PROXY_ACID,SRC.TOD_ENTITY_TYPE,SRC.TOD_ENTITY_ID,SRC.DTH_INIT_SOL_ID,SRC.REGULARIZATION_AMT,SRC.PRINCIPAL_PORTION_AMT,SRC.TF_ENTITY_SOL_ID,SRC.TRAN_PARTICULAR_2,SRC.TRAN_PARTICULAR_CODE,SRC.TR_STATUS,SRC.SVS_TRAN_ID,SRC.CRNCY_HOL_CHK_DONE_FLG,SRC.REFERRAL_ID,SRC.PARTY_CODE,SRC.GL_DATE,SRC.BKDT_TRAN_FLG,SRC.BANK_ID,SRC.IMPL_CASH_PART_TRAN_FLG,SRC.PTRAN_CHRG_EXISTS_FLG,SRC.MUD_POOL_BAL_BUILD_FLG,SRC.USED_CLEAN_SINGLE_TRAN_LIM,SRC.USED_SINGLE_TRAN_LIM,SRC.USED_UN_CLR_OVER_DACC_AMT,SRC.USED_CLEAN_EMER_ADVN,SRC.USED_EMER_ADVN,SRC.GL_SEGMENT_STRING,SRC.COMB_TRAN_ID,SRC.SYS_PART_TRAN_CODE,SRC.USER_PART_TRAN_CODE,SRC.TRAN_FREE_CODE1,SRC.TRAN_FREE_CODE2,SRC.RESP_ACCT_REF_NO,SRC.PURPOSE_CODE)\n--= BINARY_CHECKSUM(TGT.TRAN_DATE,TGT.TRAN_ID,TGT.PART_TRAN_SRL_NUM,TGT.DEL_FLG,TGT.TRAN_TYPE,TGT.TRAN_SUB_TYPE,TGT.PART_TRAN_TYPE,TGT.GL_SUB_HEAD_CODE,TGT.ACID,TGT.VALUE_DATE,TGT.TRAN_AMT,TGT.TRAN_PARTICULAR,TGT.ENTRY_USER_ID,TGT.PSTD_USER_ID,TGT.VFD_USER_ID,TGT.ENTRY_DATE,TGT.PSTD_DATE,TGT.VFD_DATE,TGT.RPT_CODE,TGT.REF_NUM,TGT.INSTRMNT_TYPE,TGT.INSTRMNT_DATE,TGT.INSTRMNT_NUM,TGT.INSTRMNT_ALPHA,TGT.TRAN_RMKS,TGT.PSTD_FLG,TGT.PRNT_ADVC_IND,TGT.AMT_RESERVATION_IND,TGT.RESERVATION_AMT,TGT.RESTRICT_MODIFY_IND,TGT.LCHG_USER_ID,TGT.LCHG_TIME,TGT.RCRE_USER_ID,TGT.RCRE_TIME,TGT.CUST_ID,TGT.VOUCHER_PRINT_FLG,TGT.MODULE_ID,TGT.BR_CODE,TGT.FX_TRAN_AMT,TGT.RATE_CODE,TGT.RATE,TGT.CRNCY_CODE,TGT.NAVIGATION_FLG,TGT.TRAN_CRNCY_CODE,TGT.REF_CRNCY_CODE,TGT.REF_AMT,TGT.SOL_ID,TGT.BANK_CODE,TGT.TREA_REF_NUM,TGT.TREA_RATE,TGT.TS_CNT,TGT.GST_UPD_FLG,TGT.ISO_FLG,TGT.EABFAB_UPD_FLG,TGT.LIFT_LIEN_FLG,TGT.PROXY_POST_IND,TGT.SI_SRL_NUM,TGT.SI_ORG_EXEC_DATE,TGT.PR_SRL_NUM,TGT.SERIAL_NUM,TGT.DEL_MEMO_PAD,TGT.UAD_MODULE_ID,TGT.UAD_MODULE_KEY,TGT.REVERSAL_DATE,TGT.REVERSAL_VALUE_DATE,TGT.PTTM_EVENT_TYPE,TGT.PROXY_ACID,TGT.TOD_ENTITY_TYPE,TGT.TOD_ENTITY_ID,TGT.DTH_INIT_SOL_ID,TGT.REGULARIZATION_AMT,TGT.PRINCIPAL_PORTION_AMT,TGT.TF_ENTITY_SOL_ID,TGT.TRAN_PARTICULAR_2,TGT.TRAN_PARTICULAR_CODE,TGT.TR_STATUS,TGT.SVS_TRAN_ID,TGT.CRNCY_HOL_CHK_DONE_FLG,TGT.REFERRAL_ID,TGT.PARTY_CODE,TGT.GL_DATE,TGT.BKDT_TRAN_FLG,TGT.BANK_ID,TGT.IMPL_CASH_PART_TRAN_FLG,TGT.PTRAN_CHRG_EXISTS_FLG,TGT.MUD_POOL_BAL_BUILD_FLG,TGT.USED_CLEAN_SINGLE_TRAN_LIM,TGT.USED_SINGLE_TRAN_LIM,TGT.USED_UN_CLR_OVER_DACC_AMT,TGT.USED_CLEAN_EMER_ADVN,TGT.USED_EMER_ADVN,TGT.GL_SEGMENT_STRING,TGT.COMB_TRAN_ID,TGT.SYS_PART_TRAN_CODE,TGT.USER_PART_TRAN_CODE,TGT.TRAN_FREE_CODE1,TGT.TRAN_FREE_CODE2,TGT.RESP_ACCT_REF_NO,TGT.PURPOSE_CODE)\n--);\n\n\nSELECT\n\tCONVERT(DATE, LEFT(TRAN_DATE, 8)) AS TRAN_DATE\n\t,TRAN_ID\n\t,PART_TRAN_SRL_NUM\n\t,DEL_FLG\n\t,TRAN_TYPE\n\t,TRAN_SUB_TYPE\n\t,PART_TRAN_TYPE\n\t,GL_SUB_HEAD_CODE\n\t,ACID\n\t,CONVERT(DATE,VALUE_DATE) AS VALUE_DATE\n\t,isnull(TRAN_AMT,0) AS TRAN_AMT\n\t,TRAN_PARTICULAR\n\t,ENTRY_USER_ID\n\t,PSTD_USER_ID\n\t,VFD_USER_ID\n\t,CONVERT(DATETIME2, STUFF(STUFF(STUFF(ENTRY_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS ENTRY_DATE\n\t,CONVERT(DATETIME2, STUFF(STUFF(STUFF(PSTD_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS PSTD_DATE\n\t,CONVERT(DATETIME2, STUFF(STUFF(STUFF(VFD_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS VFD_DATE\n\t,RPT_CODE\n\t,REF_NUM\n\t,INSTRMNT_TYPE\n    ,CONVERT(DATE,INSTRMNT_DATE) AS INSTRMNT_DATE\n\t,INSTRMNT_NUM\n\t,INSTRMNT_ALPHA\n\t,TRAN_RMKS\n\t,PSTD_FLG\n\t,PRNT_ADVC_IND\n\t,AMT_RESERVATION_IND\n\t,isnull(RESERVATION_AMT,0) AS RESERVATION_AMT\n\t,RESTRICT_MODIFY_IND\n\t,LCHG_USER_ID\n\t,CONVERT(DATETIME2, STUFF(STUFF(STUFF(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS LCHG_TIME\n\t,RCRE_USER_ID\n\t,CONVERT(DATETIME2, STUFF(STUFF(STUFF(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS RCRE_TIME\n\t,CUST_ID\n\t,VOUCHER_PRINT_FLG\n\t,MODULE_ID\n\t,BR_CODE\n\t,isnull(FX_TRAN_AMT,0) AS FX_TRAN_AMT\n\t,RATE_CODE\n\t,isnull(RATE,0) AS RATE\n\t,CRNCY_CODE\n\t,NAVIGATION_FLG\n\t,TRAN_CRNCY_CODE\n\t,REF_CRNCY_CODE\n\t,isnull(REF_AMT,0) AS REF_AMT\n\t,SOL_ID\n\t,BANK_CODE\n\t,TREA_REF_NUM\n\t,isnull(TREA_RATE,0) AS TREA_RATE\n\t,CONVERT(numeric(5,0),TS_CNT) AS TS_CNT\n\t,GST_UPD_FLG\n\t,ISO_FLG\n\t,EABFAB_UPD_FLG\n\t,LIFT_LIEN_FLG\n\t,PROXY_POST_IND\n\t,SI_SRL_NUM\n\t,CONVERT(DATE,SI_ORG_EXEC_DATE) AS SI_ORG_EXEC_DATE\n\t,PR_SRL_NUM\n\t,SERIAL_NUM\n\t,DEL_MEMO_PAD\n\t,UAD_MODULE_ID\n\t,UAD_MODULE_KEY\n\t,CONVERT(DATE,REVERSAL_DATE) AS REVERSAL_DATE\n\t,CONVERT(DATE,REVERSAL_VALUE_DATE) AS REVERSAL_VALUE_DATE\n\t,PTTM_EVENT_TYPE\n\t,PROXY_ACID\n\t,TOD_ENTITY_TYPE\n\t,TOD_ENTITY_ID\n\t,DTH_INIT_SOL_ID\n\t,isnull(REGULARIZATION_AMT,0) AS REGULARIZATION_AMT\n\t,isnull(PRINCIPAL_PORTION_AMT,0) AS PRINCIPAL_PORTION_AMT\n\t,TF_ENTITY_SOL_ID\n\t,TRAN_PARTICULAR_2\n\t,TRAN_PARTICULAR_CODE\n\t,TR_STATUS\n\t,SVS_TRAN_ID\n\t,CRNCY_HOL_CHK_DONE_FLG\n\t,REFERRAL_ID\n\t,PARTY_CODE\n\t,CONVERT(DATE,GL_DATE) AS GL_DATE\n\t,BKDT_TRAN_FLG\n\t,BANK_ID\n\t,IMPL_CASH_PART_TRAN_FLG\n\t,PTRAN_CHRG_EXISTS_FLG\n\t,MUD_POOL_BAL_BUILD_FLG\n\t,isnull(USED_CLEAN_SINGLE_TRAN_LIM,0) AS USED_CLEAN_SINGLE_TRAN_LIM\n\t,isnull(USED_SINGLE_TRAN_LIM,0) AS USED_SINGLE_TRAN_LIM\n\t,isnull(USED_UN_CLR_OVER_DACC_AMT,0) AS USED_UN_CLR_OVER_DACC_AMT\n\t,isnull(USED_CLEAN_EMER_ADVN,0) AS USED_CLEAN_EMER_ADVN\n\t,isnull(USED_EMER_ADVN,0) AS USED_EMER_ADVN\n\t,GL_SEGMENT_STRING\n\t,COMB_TRAN_ID\n\t,SYS_PART_TRAN_CODE\n\t,USER_PART_TRAN_CODE\n\t,TRAN_FREE_CODE1\n\t,TRAN_FREE_CODE2\n\t,RESP_ACCT_REF_NO\n\t,PURPOSE_CODE\n\t,1 AS ISACTIVE\n\t,1 AS ISLATEST\n\t,LEFT(FILE_NAME, 5) AS BNK_CODE\n\t,SUBSTRING(FILE_NAME,7,3) AS SOURCE_CODE\n\t,FILE_NAME\n\t--,CONVERT(DATETIME2, STUFF(STUFF(STUFF(INSERT_DTTM, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS INSERT_DTTM\n    ,CONVERT(DATE,INSERT_DTTM) AS INSERT_DTTM\n\t,CONVERT(INT, LEFT(RIGHT(FILE_NAME,12),8)) AS BUSINESSDATE\nFROM D360.STG_DEP_HISTTRANDTLTABLE SRC\nWHERE H = 'D' \n\n--AND NOT EXISTS (\n--SELECT * FROM BUSC.DEP_HISTTRANDTLTABLE TGT where ISLATEST = 1\n--AND CONVERT(DATE, LEFT(SRC.TRAN_DATE, 8)) = TGT.TRAN_DATE\n--AND SRC.TRAN_ID=TGT.TRAN_ID\n--AND SRC.PART_TRAN_SRL_NUM=TGT.PART_TRAN_SRL_NUM\n--AND SRC.BANK_ID=TGT.BANK_ID\n--);",
						"queryTimeout": "02:00:00",
