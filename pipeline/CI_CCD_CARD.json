Y_CRD3\r\n,CARD_LOYALTY_CRD4\r\n,CARD_LOYALTY_CRD5\r\n,CARD_LOYALTY_CRD6\r\n,CARD_LOYALTY_CRD7\r\n,CARD_LOYALTY_CRD8\r\n,CARD_LOYALTY_CRD9\r\n,CARD_LOYALTY_CRD10\r\n,CARD_REPLACE_WAIVE_IND\r\n,CARD_DELIVERY\r\n,CARD_CBC_BUFFER\r\n,CARD_DELTA_DATE\r\n,CARD_CONV_FLD\r\n,CARD_ARCHIVED_IND\r\n,CARD_DTE_ARCHIVED\r\n,CARD_DATE_MAINT\r\n,CARD_USER_MAINT\r\n,CARD_TIME_MAINT\r\n,CARD_FILE_DATE\r\nFROM EDS.CCD_CARDS\r\nWHERE AS_OF_DATE = @LATEST_DATE",
