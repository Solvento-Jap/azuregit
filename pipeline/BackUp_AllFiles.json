{
	"name": "BackUp_AllFiles",
	"properties": {
		"activities": [
			{
				"name": "CopyFile",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "SftpReadSettings",
							"recursive": true,
							"wildcardFolderPath": "data360/uat/CBC*",
							"wildcardFileName": {
								"value": "@concat('*',pipeline().parameters.Month,'*')",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false,
							"disableChunking": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "SFTP_OnPrem",
						"type": "DatasetReference",
						"parameters": {
							"Filepath": " ",
							"Filename": " "
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ADLS_prodbackupall",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"Month": {
				"type": "string",
				"defaultValue": "202403"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-04-04T07:47:33Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}