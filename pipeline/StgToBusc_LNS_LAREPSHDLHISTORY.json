					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n    STG.ACID\n    ,STG.BANK_ID\n    ,CURRENT_INT_REC_FLG\n    ,STG.DEL_FLG\n    ,ENTITY_CRE_FLG\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([FLOW_AMT],' ',''),''),0)) as FLOW_AMT\n    ,STG.FLOW_ID\n    ,convert(date,STG.[FLOW_START_DATE]) AS FLOW_START_DATE\n    ,INSTLMNT_IND\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([INSTLMNT_PCNT],' ',''),''),0)) as INSTLMNT_PCNT\n    ,LAST_REC_FLG\n    ,convert(datetime2, stuff(stuff(stuff(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n    ,LCHG_USER_ID\n    ,LR_FREQ_CAL_BASE\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_FREQ_DAYS],' ',''),''),0)) as LR_FREQ_DAYS\n    ,LR_FREQ_HLDY_STAT\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_FREQ_MONTHS],' ',''),''),0)) as LR_FREQ_MONTHS\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_FREQ_START_DD],' ',''),''),0)) as LR_FREQ_START_DD\n    ,LR_FREQ_TYPE\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_FREQ_WEEK_DAY],' ',''),''),0)) as LR_FREQ_WEEK_DAY\n    ,LR_FREQ_WEEK_NUM\n    ,LR_INT_FREQ_CAL_BASE\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_INT_FREQ_DAYS],' ',''),''),0)) as LR_INT_FREQ_DAYS\n    ,LR_INT_FREQ_HLDY_STAT\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_INT_FREQ_MONTHS],' ',''),''),0)) as LR_INT_FREQ_MONTHS\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_INT_FREQ_START_DD],' ',''),''),0)) as LR_INT_FREQ_START_DD\n    ,LR_INT_FREQ_TYPE\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LR_INT_FREQ_WEEK_DAY],' ',''),''),0)) as LR_INT_FREQ_WEEK_DAY\n    ,LR_INT_FREQ_WEEK_NUM\n    ,MIN_PYMT_REC_FLG\n    ,convert(date,[NEXT_DMD_DATE]) AS NEXT_DMD_DATE\n    ,convert(date,[NEXT_DMD_REF_DATE]) AS NEXT_DMD_REF_DATE\n    ,convert(date,[NEXT_INT_DMD_DATE]) AS NEXT_INT_DMD_DATE\n    ,convert(date,[NEXT_INT_DMD_REF_DATE]) AS NEXT_INT_DMD_REF_DATE\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([NUM_OF_DMDS],' ',''),''),0)) as NUM_OF_DMDS\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([NUM_OF_FLOWS],' ',''),''),0)) as NUM_OF_FLOWS\n    ,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n    ,RCRE_USER_ID\n    ,STG.SHDL_NUM\n    ,SOL_ID\n    ,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n    ,TS_CNT\n    ,1 AS isActive\n    ,1 AS isLatest,left(FILE_NAME, 5) as [BNK_CODE]\n    ,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n    ,[FILE_NAME]\n    ,convert(date,[insert_dttm]) as insert_dttm\nFROM [BUSC].[LNS_LAREPSHDLHISTORY_DELTA] DELTA\nLEFT JOIN [d360].[stg_lns_LAREPSHDLHISTORY] STG\n    ON DELTA.ACID = STG.ACID\n    AND DELTA.BANK_ID = STG.BANK_ID\n    AND DELTA.FLOW_ID = STG.FLOW_ID\n    AND DELTA.FLOW_START_DATE = STG.FLOW_START_DATE\n    AND DELTA.SHDL_NUM = STG.SHDL_NUM\nWHERE H = 'D'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
