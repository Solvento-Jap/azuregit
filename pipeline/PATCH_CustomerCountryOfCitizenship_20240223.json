				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "WITH TEMP_TBL AS (\r\nSELECT * FROM BNKM.CUSTOMERCOUNTRYOFCITIZENSHIP\r\n)\r\n \r\nUPDATE A\r\nSET A.SourceSystemCode = B.FinancialInstitutionId\r\nFROM BNKM.CUSTOMERCOUNTRYOFCITIZENSHIP A\r\nJOIN TEMP_TBL B\r\nON A.CustomerId = B.CustomerId\r\nAND A.CountryId = B.CountryId\r\nAND A.PeriodStartDate = B.PeriodStartDate\r\n \r\nUPDATE A\r\nSET A.FinancialInstitutionId = B.SourceSystemCode\r\nFROM BNKM.CUSTOMERCOUNTRYOFCITIZENSHIP A\r\nJOIN TEMP_TBL B\r\nON A.CustomerId = B.CustomerId\r\nAND A.CountryId = B.CountryId\r\nAND A.PeriodStartDate = B.PeriodStartDate"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "EndDate_Patch",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "UPDATE_SSC_FII",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "TestSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "WITH TEMP_CUSTOMERCOUNTRYOFCITIZENSHIP AS (\r\nselect CustomerId,CountryId,FinancialInstitutionId,SourceSystemCode\r\n,PeriodStartDate\r\n,PeriodEndDate as PeriodEndDate_Orig\r\n,dateadd(dd,-1,LEAD(PeriodStartDate, 1 ,'2100-01-01') OVER (PARTITION BY CustomerId,CountryId,FinancialInstitutionId,SourceSystemCode ORDER BY PeriodStartDate)) as PeriodEndDate_Patch\r\nFROM BNKM.CUSTOMERCOUNTRYOFCITIZENSHIP\r\n)\r\n\r\nUPDATE A\r\nSET A.PeriodEndDate = CASE WHEN B.PeriodEndDate_Patch = '2099-12-31' THEN '9999-12-31' ELSE B.PeriodEndDate_Patch END\r\nFROM BNKM.CUSTOMERCOUNTRYOFCITIZENSHIP A \r\nLEFT JOIN TEMP_CUSTOMERCOUNTRYOFCITIZENSHIP B\r\nON A.CustomerId = B.CustomerId\r\nAND A.CountryId = B.CountryId\r\nAND A.FinancialInstitutionId = B.FinancialInstitutionId\r\nAND A.SourceSystemCode = B.SourceSystemCode"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
