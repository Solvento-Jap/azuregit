{
	"name": "PGPDecrypt_AML_FCBS_MCGCDETAILS",
	"properties": {
		"description": "AML exact source/date decryptor for CUSTOM.C_CSALMCGC -> STG_EDS_DEP_MCGCDETAILS (CBC-RDP-AML-003 Phase 1); uses the existing PGPDecrypt Function App without modifying PGPDecrypt_EDS.",
