			{
				"name": "Require_Approved_Execution",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.ExecutionMode, 'ApprovedDateSliceReload')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Unapproved_Execution",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "ExecutionMode must be ApprovedDateSliceReload.",
								"errorCode": "AML_EXECUTION_NOT_APPROVED"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Execution_Approved",
							"type": "Wait",
