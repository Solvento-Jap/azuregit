				"typeProperties": {
					"expression": {
						"value": "@or(and(equals(pipeline().parameters.kvsecpass, 'cbcpassp'), equals(pipeline().parameters.kvsecpriv, 'cbcprivkeyaml')), and(not(equals(pipeline().parameters.kvsecpass, '')), not(equals(pipeline().parameters.kvsecpriv, '')), not(equals(pipeline().parameters.kvsecpass, 'cbcpassp')), not(equals(pipeline().parameters.kvsecpriv, 'cbcprivkeyaml'))))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Incomplete_KeyPair",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "kvsecpass and kvsecpriv must be supplied together or both omitted for the defaults.",
