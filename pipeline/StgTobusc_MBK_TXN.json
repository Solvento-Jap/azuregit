				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n    [BANK_ID]\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([VERSION],' ',''),''),0)) as VERSION\n    ,[BANK_CD]\n    ,[BANK_NM]\n    ,[MEMBER_TYPE]\n    ,convert(numeric(2,0),ISNULL(NULLIF(REPLACE([DISPLAY_SEQ],' ',''),''),0)) as DISPLAY_SEQ\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([INTER_INTRA_STATUS],' ',''),''),0)) as INTER_INTRA_STATUS\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([STATUS],' ',''),''),0)) as STATUS\n    ,[SECONDARY_FIELD1]\n    ,[SECONDARY_FIELD2]\n    ,[SECONDARY_FIELD3]\n    ,[SECONDARY_FIELD4]\n    ,[CREATED_BY]\n    ,[UPDATED_BY]\n    ,convert(date,[CREATED_DATE]) as CREATED_DATE\n    ,convert(date,[UPDATED_DATE]) as UPDATED_DATE\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([FLAGS],' ',''),''),0)) as FLAGS\n    ,[BANK_SHORT_NM]\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([IS_CC_ISSUER],' ',''),''),0)) as IS_CC_ISSUER\n    ,[BANK_BIC]\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([PESONET],' ',''),''),0)) as PESONET\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([INSTAPAY],' ',''),''),0)) as INSTAPAY\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([P2M],' ',''),''),0)) as P2M\n    ,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([QR],' ',''),''),0)) as QR\n    ,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([EWALLET],' ',''),''),0)) as EWALLET\n    ,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([EWALLETSEQ],' ',''),''),0)) as EWALLETSEQ\n    ,1 AS isActive\n    ,1 AS isLatest\n    ,left(FILE_NAME, 5) as [BNK_CODE]\n    ,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n    ,[FILE_NAME]\n    ,convert(date,[insert_dttm]) as insert_dttm\nFROM [d360].[STG_MBK_RTBKBANKSTB]\nWHERE H = 'D'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
