				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT\n\tTXN_KEY\n\t,TXN_ID\n\t,MBX_APP_ID\n\t,TXN_TYPE\n\t,CONVERT(DATETIME2, stuff(stuff(stuff(TXN_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as TXN_DATE\n\t,CONVERT(NUMERIC(20,8),ISNULL(NULLIF(REPLACE([TXN_AMT],' ',''),''),0)) as TXN_AMT\n\t,CUST_ID\n\t,FROM_ACCT_LINK_ID\n\t,FROM_ACCT_NO\n\t,FROM_ACCT_CCY\n\t,FROM_ACCT_ALIAS\n\t,FROM_BANK_ID\n\t,FROM_BANK_CODE\n\t,FROM_BANK_NAME\n\t,TO_ACCT_PAYEE_TYPE\n\t,TO_ACCT_LINK_ID\n\t,TO_ACCT_NO\n\t,TO_ACCT_CCY\n\t,TO_ACCT_ALIAS\n\t,TO_BANK_ID\n\t,TO_BANK_CODE\n\t,TO_BANK_NAME\n\t,TO_ACCT_REF1\n\t,TO_ACCT_REF2\n\t,TO_ACCT_REF3\n\t,TO_ACCT_REF4\n\t,TXN_FIELD1\n\t,TXN_FIELD2\n\t,TXN_FIELD3\n\t,TXN_DETAIL_REF_ID\n\t,SCHEDULED_TXN_REF_KEY\n\t,STATUS\n\t,CONVERT(DATETIME2, stuff(stuff(stuff(STATUS_CHANGE_DATE, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as STATUS_CHANGE_DATE\n\t,REMARKS\n\t,CONVERT(NUMERIC(12,8),ISNULL(NULLIF(REPLACE([XRATE],' ',''),''),0)) as XRATE\n\t,CONVERT(NUMERIC(20,8),ISNULL(NULLIF(REPLACE([XRATE_EQUIV_AMT],' ',''),''),0)) as XRATE_EQUIV_AMT\n\t,TXN_FAILURE_CODE\n\t,TXN_FAILURE_TEXT\n\t,FLAGS\n\t,HOST_REF_NO\n\t,LOCATION\n\t,TXN_CHANNEL\n\t,PURPOSE\n\t,PCHCSEQ\n\t,1 AS ISACTIVE\n\t,1 AS ISLATEST\n\t,LEFT(FILE_NAME, 5) AS BNK_CODE\n\t,SUBSTRING(FILE_NAME,7,3) AS SOURCE_CODE\n\t,FILE_NAME\n\t,INSERT_DTTM\nFROM d360.STG_MBK_RTBK_TRANSACTION_MTB\nWHERE H = 'd'",
