					{
						"referenceName": "ExecutionLogTable",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ListOfFailedFile",
						"type": "DatasetReference",
						"parameters": {
							"folderpath": "dev/SUCCESS/CRM",
							"filelist": {
								"value": "@concat('SUMMARY_OF_SUCCESS_CRM_FILES_',substring(replace(replace(replace(addHours(utcnow(),+8),'-',''),'T','_'),':',''),0,15),'.csv')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "List of File with Error - CRM",
				"type": "Copy",
				"dependsOn": [
