	"properties": {
		"description": "Sources data from EDS tables",
		"activities": [
			{
				"name": "TreasuryRetail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT\n     CAST(LE.ID AS varchar(100)) AS ACCOUNT_NUMBER\n\t,[value] as CUSTOMER_ID\n    ,concat(''Entity_CIF_CRM_'', [value]) as EntityCIF\n    ,[value] as FCBSCIF\n    ,LE.BNK_CODE BankCode\n    ,NULL as BranchCode\n    ,NULL as BranchName\n    ,NULL as Area\n    ,NULL as Region\n\t,''TRY'' SourceSystemCode\n    ,NULL as ProductGrouping\n    ,NULL as ProductType\n    ,NULL as ProductDetails\n\t,NULL as OpenedDate\n\t,COALESCE(SUM(\n\t\t\t\t\t(CASE \n\t\t\t\t\tWHEN TRADES.product_type LIKE ''Bond%''\n\t\t\t\t\t\tAND TRADES.book = ''Client''\n\t\t\t\t\t\tAND TRADES.bundle_type <> ''ASSET SWAP''\n\t\t\t\t\t\tAND TRADES.tradestatus = ''VERIFIED''\n\t\t\t\t\t\tAND TRADES.maturity_date > CAST(''',variables('V_date'),''' AS DATE)\n\t\t\t\t\t\tTHEN TRADES.NOMINAL\n\t\t\t\t\tWHEN TRADES.PRODUCT_TYPE = ''StructuredFlows''\n\t\t\t\t\t\tAND TRADES.BOOK IN (\n\t\t\t\t\t\t\t''F_Intl_MM_Team1''\n\t\t\t\t\t\t\t,''F_Intl_MM_Team2''\n\t\t\t\t\t\t\t,''R_Dom_MM_Team1''\n\t\t\t\t\t\t\t,''R_Dom_MM_Team2''\n\t\t\t\t\t\t\t,''R_Dom_MM_Borrowing''\n\t\t\t\t\t\t\t)\n\t\t\t\t\t\tAND TRADES.bundle_type <> ''PYA''\n\t\t\t\t\t\tAND TRADES.TRADESTATUS = ''VERIFIED''\n\t\t\t\t\t\tTHEN TRADES.PRINCIPAL_AMOUNT\n\t\t\t\t\tWHEN TRADES.PRODUCT_TYPE = ''StructuredFlows''\n\t\t\t\t\t\tAND TRADES.BUNDLE_TYPE = ''PYA''\n\t\t\t\t\t\tAND TRADES.TRADESTATUS = ''VERIFIED''\n\t\t\t\t\t\tTHEN TRADES.PRINCIPAL_AMOUNT\n\t\t\t\t\tWHEN TRADES.PRODUCT_TYPE = ''StructuredFlows''\n\t\t\t\t\t\tAND TRADES.EXTERNAL_REFERENCE LIKE ''PYA%''\n\t\t\t\t\t\tAND TRADES.TRADESTATUS = ''VERIFIED''\n\t\t\t\t\t\tTHEN TRADES.PRINCIPAL_AMOUNT\n\t\t\t\t\tWHEN TRADES.PRODUCT_TYPE LIKE ''BOND%''\n\t\t\t\t\t\tAND TRADES.BUNDLE_TYPE = ''ASSET SWAP''\n\t\t\t\t\t\tAND TRADES.TRADESTATUS = ''VERIFIED''\n\t\t\t\t\t\tAND TRADES.MATURITY_DATE > CAST(''',variables('V_date'),''' AS DATE)\n\t\t\t\t\t\tTHEN TRADES.NOMINAL\n\t\t\t\t\tEND)\n\t\t\t\t\t* Rate.ConversionRate\n\t\t\t\t)\n\t\t ,0) as OutstandingInvestmentFull\n    ,NULL as OutstandingInvestmentProrated\n    ,CAST(''',variables('V_date'),''' AS DATE) as BusinessDate\n    ,CAST(''',variables('V_date'),''' AS DATE) as LastUpdatedDate\n    ,concat(CAST(LE.ID AS varchar(100)), [value], LE.BNK_CODE, ''TRY'') as AccountKey\nFROM eds.TRY_LEGALENTITY AS LE --58328\nCROSS APPLY STRING_SPLIT(LE.EXTERNAL_REF, ''|'')\nLEFT JOIN eds.TRY_TRADES TRADES --36403\n\tON LE.ID = TRADES.COUNTERPARTY_ID\n\tAND CAST(''',variables('V_date'),''' AS DATE) BETWEEN TRADES.SCD_START_DATE\n\t\tAND TRADES.SCD_END_DATE\nLEFT JOIN (SELECT * FROM bnkm.CurrencyConversion WHERE ConvertToCurrencyId = ''PHP'' AND FinancialInstitutionId = ''CBC01'') Rate\n\tON CAST(''',variables('V_date'),''' AS DATE) = CAST(Rate.CurrencyConversionTimestamp AS DATE) AND TRADES.TRADE_CURRENCY = Rate.ConvertFromCurrencyId\nWHERE TRADES.CounterParty_ID IS NOT NULL\n\tAND CAST(''',variables('V_date'),''' AS DATE) BETWEEN LE.SCD_START_DATE AND LE.SCD_END_DATE\n\tAND LE.STATUS = ''ENABLED''\n\tAND LE.BNK_CODE = ''CBC01''\n    AND left([value], 1) = ''R''\nGROUP BY\n     CAST(LE.ID AS varchar(100))\n\t,[value]\n    ,LE.BNK_CODE\n')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
