				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "--\tPrevious Week\r\n\r\nUPDATE EDS.Date_Dim\r\nSET Previous_Week = CAST(CAST(Business_Day.Previous_Business_Week AS VARCHAR(8)) AS DATE)\r\nFROM \r\n   (\r\n\t\tSELECT DateSK\r\n\t\t\t, Business_Day_Flag\r\n\t\t\t, Max(CASE WHEN Business_Day_Flag = 'Y' THEN DateSK ELSE NULL END)\r\n\t\t\t\t\t\tOver (PARTITION BY 1 ORDER BY DateSK ROWS BETWEEN Unbounded Preceding AND 7 Preceding) Previous_Business_Week                     \r\n\t\tFROM EDS.Date_Dim\r\n\t\tWHERE DateSK BETWEEN 20221231 AND 20241231\r\n   ) AS Business_Day\r\nWHERE Date_Dim.DateSK = Business_Day.DateSK;\r\n\r\n--\tPrevious Month\r\n\r\nUPDATE EDS.Date_Dim\r\nSET Previous_Month = DATEADD(month, -1, fulldate)\r\nWHERE Business_Day_Flag = 'Y';\r\n               \r\nUPDATE EDS.Date_Dim\r\nSET Previous_Month = CAST(CAST(Business_Day.Latest_Business_Day AS VARCHAR(8)) AS DATE)\r\nFROM \r\n\t(\r\n\t\tSELECT DateSK\r\n\t\t\t, fulldate\r\n\t\t\t, Max(CASE WHEN Business_Day_Flag = 'Y' THEN DateSK ELSE NULL END)\r\n\t\t\t\t\t\tOver (PARTITION BY 1 ORDER BY DateSK ROWS BETWEEN Unbounded Preceding AND CURRENT ROW) Latest_Business_Day\r\n\t\tFROM EDS.Date_Dim\r\n\t\tWHERE DateSK BETWEEN 20221201 AND 20241231\r\n\t) AS Business_Day\r\nWHERE Date_Dim.Previous_Month = Business_Day.fulldate;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "PREV_MONTH",
				"type": "Script",
				"dependsOn": [
