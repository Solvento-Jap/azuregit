				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "update EDS.DATE_DIM set Business_Day_Flag = 'Y';\r\n\r\nupdate EDS.DATE_DIM set Business_Day_Flag = 'N' where weekday in (1,7);\r\n\r\nupdate EDS.DATE_DIM set Business_Day_Flag = 'N' \r\nwhere fulldate in (\r\n'2023-01-01', '2023-02-24', '2023-04-10', '2023-04-06', '2023-04-07', '2023-04-21'\r\n, '2023-05-01', '2023-06-12', '2023-08-01', '2023-08-28', '2023-10-30', '2023-11-01'\r\n, '2023-11-02', '2023-11-27', '2023-12-08', '2023-12-25', '2023-12-26', '2023-12-30'\r\n, '2024-01-01', '2024-02-09', '2024-03-28', '2024-03-29', '2024-04-09', '2024-05-01'\r\n, '2024-06-12'\r\n, '2024-06-17'\r\n, '2024-08-26', '2024-08-23', '2024-11-30', '2024-11-01'\r\n, '2024-12-24', '2024-12-25', '2024-12-30', '2024-12-31'\r\n);\r\n"
