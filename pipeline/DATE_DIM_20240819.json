				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "--\tPrevious Business Day\r\n\r\nUPDATE EDS.DATE_DIM\r\nSET Previous_Business_Day = CAST(CAST(Business_Day.Previous_Business_Date AS VARCHAR(8)) AS DATE)\r\nFROM (\r\n\t\tSELECT DateSK\r\n\t\t\t, Business_Day_Flag\r\n\t\t\t, Max(CASE WHEN Business_Day_Flag = 'Y' THEN DateSK ELSE NULL END)\r\n\t\t\t\tOver (PARTITION BY 1 ORDER BY DateSK ROWS BETWEEN Unbounded Preceding AND 1 Preceding) Previous_Business_Date                     \r\n\t\tFROM EDS.DATE_DIM\r\n\t\tWHERE DateSK BETWEEN 20221231 AND 20241231\r\n    ) AS Business_Day\r\nWHERE DATE_DIM.DateSK = Business_Day.DateSK;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
