{
	"name": "Load_XLS_to_CSV",
	"properties": {
		"activities": [
			{
				"name": "Load_XLS_to_CSV",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "adls_xls",
						"type": "DatasetReference",
						"parameters": {
							"FilePath": {
								"value": "@pipeline().parameters.SrcFilePath",
								"type": "Expression"
							},
							"FileName": {
								"value": "@pipeline().parameters.SrcFileName",
								"type": "Expression"
							},
							"SheetIndex": {
								"value": "@pipeline().parameters.SrcSheetIndex",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "decrypt_csv_pipe_delimited",
						"type": "DatasetReference",
						"parameters": {
							"Filename": {
								"value": "@concat(pipeline().parameters.csvFileName,'.csv')",
								"type": "Expression"
							},
							"Filepath": {
								"value": "@concat(variables('Filepath'),pipeline().parameters.FolderPath)",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"FolderPath": {
				"type": "string",
				"defaultValue": "EXTERNAL/DID"
			},
			"SrcFileName": {
				"type": "string",
				"defaultValue": "Top_1000_Corporations_xls.xls"
			},
			"SrcFilePath": {
				"type": "string",
				"defaultValue": "dev/decrypted/EXTERNAL/DID"
			},
			"SrcSheetIndex": {
				"type": "int",
				"defaultValue": 0
			},
			"csvFileName": {
				"type": "string",
				"defaultValue": "Top_1000_Corporations"
			}
		},
		"variables": {
			"Filepath": {
				"type": "String",
				"defaultValue": "dev/decrypted/"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-08-15T08:23:33Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}