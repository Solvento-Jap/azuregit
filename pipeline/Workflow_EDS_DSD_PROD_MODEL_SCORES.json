							"name": "FALSE",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "SET_START_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "SET_END_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						},
						{
							"name": "SET_START_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_startDate",
								"value": {
									"value": "@pipeline().parameters.startDate",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
