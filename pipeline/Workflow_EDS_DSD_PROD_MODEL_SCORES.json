					"ifTrueActivities": [
						{
							"name": "GET_PROCESS_DATE",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "SELECT\n\tPREVIOUS_MONTH_LAST_BUS_DAY fulldate\nFROM\n    EDS.DATE_DIM DD\nWHERE \n\tDD.DATESK=convert(varchar(8),GETDATE(),112)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLPool_EDS",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "EDS_CTL"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "SET_START_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_startDate",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE",
							"type": "SetVariable",
							"dependsOn": [
