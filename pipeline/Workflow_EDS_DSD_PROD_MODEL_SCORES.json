			{
				"name": "CHECK PROCESS DATE PARAM",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.startDate,'9999-12-31')",
