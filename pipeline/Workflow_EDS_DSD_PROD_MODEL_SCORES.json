									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "DaysToIterate",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "CHECK PROCESS DATE PARAM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
