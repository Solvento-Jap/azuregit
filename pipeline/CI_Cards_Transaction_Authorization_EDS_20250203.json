{
	"name": "CI_Cards_Transaction_Authorization_EDS_20250203",
	"properties": {
		"description": "Sources data from EDS tables",
		"activities": [
			{
				"name": "Card Transaction Authorization Retail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI_EDS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "/*\r\n    Daily Authorization\r\n    Inclusion of CUST_CIF_NBR (CIF) -> This will be used to JOIN in CI_DEMOGRAPHIC\r\n*/\r\nSELECT\r\n    TXN.*\r\n    ,CCD.CUST_CIF_NBR AS FCBSCIF\r\n/*\r\n    Remove the duplicates using ROW_NUMBER() window function\r\n*/\r\nFROM (\r\nSELECT \r\n    *\r\n    ,ROW_NUMBER() OVER(PARTITION BY RETR_KEY, MESSAGE_TYPE, TRAN_END_TIME, AUTH_NBR, CARD_NBR, INTERNAL_RESP_CODE, BANKNET_REF_NBR, RECV_ID\r\n        ORDER BY LEFT(RIGHT(FILE_NAME,12),8) DESC) RN\r\n    FROM eds.CCD_CBCEXTXLGP TXN WHERE CAST(CAST(TRAN_DATE AS char(8)) AS date) >= '2024-04-01'\r\n) TXN\r\n/*\r\n    Link all customers associated to the account of the transaction using AAS\r\n    Fetch the ORGKEY in CUSTOMER_DIM\r\n*/\r\nINNER JOIN\r\n    (SELECT AS_OF_DATE, CUST_CIF_NBR, CRDACCT_NBR, CARD_NBR FROM eds.CCD_CREDIT_CARDS_FACT WHERE AS_OF_DATE >= '2024-04-01' \r\n    GROUP BY AS_OF_DATE, CUST_CIF_NBR, CRDACCT_NBR, CARD_NBR) CCD\r\n    ON TXN.CARD_ACCT_NBR = CCD.CRDACCT_NBR\r\n    AND TXN.CARD_NBR = CCD.CARD_NBR\r\n    AND CAST(CAST(TXN.TRAN_DATE AS char(8)) AS date) = CAST(CCD.AS_OF_DATE AS DATE)\r\nWHERE RN = 1 AND CCD.CUST_CIF_NBR IS NOT NULL",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
