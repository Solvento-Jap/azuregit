				"userProperties": [],
				"typeProperties": {
					"variableName": "SQL",
					"value": {
						"value": "@concat('BEGIN TRY\n              \n              UPDATE ', pipeline().parameters.TargetSchema, '.', pipeline().parameters.TargetTable, '\n              SET ', pipeline().parameters.IsCurrentColumn, ' = 0,\n                  ', pipeline().parameters.ExpiryDateColumn, ' = (SELECT PREVIOUS_BUSINESS_DAY FROM EDS.DATE_DIM \nINNER JOIN (SELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS INTEGER) MX_DT FROM ', pipeline().parameters.SourceSchema, '.', pipeline().parameters.SourceTable, ') MX_DT_TBL\nON DATESK = MX_DT)\n            FROM ', pipeline().parameters.TargetSchema, '.', pipeline().parameters.TargetTable, ' tgt\n                        JOIN ', pipeline().parameters.SourceSchema, '.', pipeline().parameters.SourceTable, ' src\n                            ON ', variables('V_NaturalKeyColoumns_JOIN') , '\n                            AND CAST(LEFT(RIGHT(src.FILE_NAME, 12), 8) AS DATE) >= CAST(STUFF(STUFF(STUFF(src.RCRE_TIME, 13, 0, '':''), 11, 0, '':''), 9, 0, '' '') AS DATE)\n                            and  src.[H] = ''D''\n              WHERE tgt.', pipeline().parameters.IsCurrentColumn, ' = 1 \n                AND tgt.[BANK_ID] = ''',pipeline().parameters.BankId,'''\n                AND HASHBYTES(''SHA2_256'', CONCAT_WS(N''|'', ',variables('V_HashColumns_SRC_STR'), ')) <> HASHBYTES(''SHA2_256'', CONCAT_WS(N''|'', ',variables('V_HashColumns_TGT_STR'), '));\n\n                 INSERT INTO ', pipeline().parameters.TargetSchema, '.', pipeline().parameters.TargetTable, ' (', variables('V_NaturalKeyColumns_STR'), ' ,', join(pipeline().parameters.HashColumns,','), ', ', pipeline().parameters.StartDateColumn, ', ', pipeline().parameters.ExpiryDateColumn, ', ISACTIVE, ', pipeline().parameters.IsCurrentColumn, ' ,BNK_CODE ,SOURCE_CODE ,FILE_NAME  ,INSERT_DTTM)\n              SELECT DISTINCT', variables('V_NaturalKeyColumns_STR'), ' ,',replace(replace(join(pipeline().parameters.HashColumns,','),'[RCRE_TIME]','CAST(STUFF(STUFF(STUFF([RCRE_TIME], 13, 0, '':''), 11, 0, '':''), 9, 0, '' '') AS DATETIME) AS [RCRE_TIME]'),'[LCHG_TIME]','CAST(STUFF(STUFF(STUFF([LCHG_TIME], 13, 0, '':''), 11, 0, '':''), 9, 0, '' '') AS DATETIME) AS [LCHG_TIME]'), ', CAST(LEFT(RIGHT(FILE_NAME , 12), 8) AS DATE), CAST(', pipeline().parameters.ActiveDateValue, ' AS DATE), 1,1,LEFT(FILE_NAME,5) ,''', pipeline().parameters.SourceCode, ''' ,FILE_NAME ,CURRENT_TIMESTAMP\n              FROM ', pipeline().parameters.SourceSchema, '.', pipeline().parameters.SourceTable, ' src\n              WHERE src.[H] = ''D'' \n              AND CAST(LEFT(RIGHT(src.FILE_NAME, 12), 8) AS DATE) >= CAST(STUFF(STUFF(STUFF(src.RCRE_TIME, 13, 0, '':''), 11, 0, '':''), 9, 0, '' '') AS DATE)\n              and NOT EXISTS (\n                SELECT 1 FROM ', pipeline().parameters.TargetSchema, '.', pipeline().parameters.TargetTable, ' tgt\n                WHERE ',  variables('V_NaturalKeyColoumns_JOIN')  , '\n                  AND HASHBYTES(''SHA2_256'', CONCAT_WS(N''|'', ',variables('V_HashColumns_TGT_STR'), ')) = HASHBYTES(''SHA2_256'', CONCAT_WS(N''|'', ',variables('V_HashColumns_SRC_STR'), '))\n                  AND tgt.', pipeline().parameters.IsCurrentColumn, ' = 1\n              );\n     END TRY\n     BEGIN CATCH\n\t\t    DECLARE msg NVARCHAR(2048) = ERROR_MESSAGE();\n\t\t    THROW 51000, msg, 1;\n     END CATCH\n      ')",
						"type": "Expression"
					}
				}
