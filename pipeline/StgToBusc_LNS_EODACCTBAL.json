								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": "SELECT STG.[ACID]\n,convert(date,STG.[EOD_DATE]) as EOD_DATE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TRAN_DATE_BAL],' ',''),''),0)) as TRAN_DATE_BAL\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TRAN_DATE_TOT_TRAN],' ',''),''),0)) as TRAN_DATE_TOT_TRAN\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([VALUE_DATE_BAL],' ',''),''),0)) as VALUE_DATE_BAL\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([VALUE_DATE_TOT_TRAN],' ',''),''),0)) as VALUE_DATE_TOT_TRAN\n,convert(date,STG.[END_EOD_DATE]) as END_EOD_DATE\n,[LCHG_USER_ID]\n,convert(datetime2, stuff(stuff(stuff(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n,[RCRE_USER_ID]\n,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n,[EAB_CRNCY_CODE]\n,STG.[BANK_ID]\n,1 as isActive\n,CASE WHEN STG.[END_EOD_DATE] = 20991231 THEN 1 ELSE 0 END as isLatest\n,left(FILE_NAME, 5) as [BNK_CODE]\n,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n,[FILE_NAME]\n,convert(date,[insert_dttm]) as insert_dttm\n FROM [BUSC].[LNS_EODACCTBAL_DELTA] DELTA\n LEFT JOIN [D360].[STG_LNS_EODACCTBAL] STG ON DELTA.ACID = STG.ACID AND DELTA.BANK_ID = STG.BANK_ID AND DELTA.EOD_DATE = STG.EOD_DATE\n where H = 'D'   AND DELTA.RECORD_STATUS = 'INSERT'\n",
