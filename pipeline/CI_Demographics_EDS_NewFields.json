					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT\r\n\tNULL\tAS\tAS_OF_DATE\r\n,\tCUST.ORGKEY\tAS\tCUSTOMER_ID\r\n,\tCUST.NAME\tAS\tCUSTOMER_NAME\r\n,\tCUST.CUSTOMER_NAME_ID\tAS\tCUSTOMER_NAME_ID\r\n,\tCUST.GENDER_DESCRIPTION\tAS\tGENDER\r\n,\tCUST.RELATIONSHIPOPENINGDATE\tAS\tCUSTOMER_SINCE\r\n,\tCUST.EMAIL_ADDRESS\tAS\tEMAIL\r\n,\tCUST.MOBILE_NUMBER\tAS\tMOBILE\r\n,\tCUST.ADDRESS\tAS\tADDRESS\r\n,\tCUST.ADDRESS_LINE1\tAS\tADDRESS_LINE_1\r\n,\tCUST.ADDRESS_LINE2\tAS\tADDRESS_LINE_2\r\n,\tMV_CITY.DESCRIPTION\tAS\tCITY\r\n,\tMV_STATE.DESCRIPTION\tAS\tPROVINCE\r\n,\tMV_COUNTRY.DESCRIPTION\tAS\tCOUNTRY\r\n,\tCUST.ZIP\tAS\tZIP\r\n,\tCUST.MARITAL_STATUS\tAS\tMARITAL_STATUS\r\n,\tCUST.OCCUPATION_DESCRIPTION\tAS\tOCCUPATION\r\n,\tCUST.CUST_DOB\tAS\tDATE_OF_BIRTH\r\n,\tCUST.LAST_KYC_DATE\tAS\tLAST_KYC_DATE\r\n,\tCUST.RISK_RATING_TYPE\tAS\tRISK_RATING_TYPE\r\n,\tCUST.RISK_RATING_NAME\tAS\tRISK_RATING_NAME\r\n,\tCUST.ATM_ENROLLMENT\tAS\tATM_ENROLLMENT\r\n,\tCUST.MOBILE_BANKING_ENROLLMENT\tAS\tMOBILE_BANKING_ENROLLMENT\r\n,\tCUST.ONLINE_BANKING_ENROLLMENT\tAS\tONLINE_BANKING_ENROLLMENT\r\n,\tCUST.DATA_PRIVACY_CONSENT\tAS\tDATA_PRIVACY_CONSENT\r\n,\tCUST.CUSTOMER_TYPE\tAS\tCUSTOMER_TYPE\r\n,\tCUST.CORE_CUST_ID\tAS\tCORE_CUSTOMER_ID\r\n,\tCUST.SCD_START_DATE\tAS\tVALIDITY_START_DATE\r\n,\tCUST.SCD_END_DATE\tAS\tVALIDITY_END_DATE\r\n,\tCUST.BANK_ID\tAS\tBANK_ID\r\n,\tCUST.SOURCE_CODE\tAS\tSOURCE_CODE\r\n,\tCUST.ORGKEY\tAS\tFCBS_CIF\r\n,\tAGG_BAL.TOTAL_DEPOSIT_OUTSTANDING_BALANCE_PHP\tAS\tTOTAL_DEPOSIT_BALANCE_PHP\r\n,\tAGG_BAL.TOTAL_DEPOSIT_YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP\tAS\tTOTAL_YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP\r\n,\tAGG_BAL.TOTAL_LOAN_RELATIONSHIP_EXPOSURE_PHP\tAS\tTOTAL_LOAN_RELATIONSHIP_EXPOSURE_PHP\r\n,\tAGG_BAL.TOTAL_LOAN_BILLED_AMOUNT_PHP\tAS\tTOTAL_LOAN_BILLED_AMOUNT_PHP\r\n,\tAGG_BAL.TOTAL_LOAN_CREDIT_LIMIT_PHP\tAS\tTOTAL_LOAN_CREDIT_LIMIT_PHP\r\n--,\tAGG_BAL.INSERT_DTTM\tAS\tINSERT_DTTM\r\nFROM eds.CUSTOMER_DIM CUST\r\n    INNER JOIN eds.EDS_CTL CTL\r\n        ON CTL.CRM_DATE BETWEEN CUST.SCD_START_DATE AND CUST.SCD_END_DATE\r\n    LEFT JOIN eds.MV_CITY_DIM AS MV_CITY\r\n        ON CUST.CITY = MV_CITY.VALUE\r\n        AND CUST.BANK_ID = MV_CITY.BANK_ID\r\n    LEFT JOIN eds.MV_STATE_DIM AS MV_STATE\r\n        ON CUST.STATE = MV_STATE.VALUE\r\n        AND CUST.BANK_ID = MV_STATE.BANK_ID\r\n    LEFT JOIN eds.MV_COUNTRY_DIM AS MV_COUNTRY\r\n        ON CUST.COUNTRY = MV_COUNTRY.VALUE\r\n        AND CUST.BANK_ID = MV_COUNTRY.BANK_ID\r\n    LEFT JOIN eds.CI_CUSTOMER_BALANCES AGG_BAL\r\n        ON CUST.ORGKEY = AGG_BAL.FCBS_CIF\r\n        AND CUST.BANK_ID = AGG_BAL.BANK_ID\r\nWHERE CUST.BANK_ID = 'CBC01'\r\nAND LEFT(CUST.ORGKEY, 1) = 'R'\r\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
