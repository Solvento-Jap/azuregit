						"ColumnSchema": "[{\"source\":{\"name\":\"H\",\"type\":\"String\"},\"sink\":{\"name\":\"H\",\"type\":\"String\"}},{\"source\":{\"name\":\"USERNAME\",\"type\":\"String\"},\"sink\":{\"name\":\"USERNAME\",\"type\":\"String\"}},{\"source\":{\"name\":\"ACCOUNT_NAME\",\"type\":\"String\"},\"sink\":{\"name\":\"ACCOUNT_NAME\",\"type\":\"String\"}},{\"source\":{\"name\":\"CHANNEL_ID\",\"type\":\"String\"},\"sink\":{\"name\":\"CHANNEL_ID\",\"type\":\"String\"}},{\"source\":{\"name\":\"TRANSACTION_DATE\",\"type\":\"Date\"},\"sink\":{\"name\":\"TRANSACTION_DATE\",\"type\":\"Date\"}},{\"source\":{\"name\":\"TRANSACTION_TIME\",\"type\":\"String\"},\"sink\":{\"name\":\"TRANSACTION_TIME\",\"type\":\"String\"}},{\"source\":{\"name\":\"ORIGINATOR_ACCOUNT\",\"type\":\"String\"},\"sink\":{\"name\":\"ORIGINATOR_ACCOUNT\",\"type\":\"String\"}},{\"source\":{\"name\":\"DEVICE_MODEL\",\"type\":\"String\"},\"sink\":{\"name\":\"DEVICE_MODEL\",\"type\":\"String\"}},{\"source\":{\"name\":\"STATUS\",\"type\":\"String\"},\"sink\":{\"name\":\"STATUS\",\"type\":\"String\"}},{\"source\":{\"name\":\"CIF_ID\",\"type\":\"String\"},\"sink\":{\"name\":\"CIF_ID\",\"type\":\"String\"}},{\"source\":{\"name\":\"FILE_NAME\",\"type\":\"String\"},\"sink\":{\"name\":\"FILE_NAME\",\"type\":\"String\"}}]",
						"HashLog_SQL": "INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT 'CBC01_D30_ENROLLMENT_001_20260101' AS FILE_NAME ,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime) AS DATE ,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime) AS insert_dttm ,'COUNT' METRICS ,'1' SRC ,'1' TGT",
