							"value": "DELETE FROM EDS.D30_ENROLLMENT WHERE CAST('@{pipeline().parameters.startDate}' AS DATE) IN ( SELECT AS_OF_DATE FROM [d360].[STG_EDS_D30_ENROLLMENT] ); INSERT INTO EDS.D30_ENROLLMENT ( AS_OF_DATE ,USERNAME ,ACCOUNT_NAME ,CHANNEL_ID ,TRANSACTION_DATE ,TRANSACTION_TIME ,ORIGINATOR_ACCOUNT ,DEVICE_MODEL ,STATUS ,CIF_ID ,FILE_NAME ) SELECT CAST('@{pipeline().parameters.startDate}' AS DATE) AS [AS_OF_DATE] ,USERNAME ,ACCOUNT_NAME ,CHANNEL_ID ,TRANSACTION_DATE ,TRANSACTION_TIME ,ORIGINATOR_ACCOUNT ,DEVICE_MODEL ,STATUS ,CIF_ID ,FILE_NAME FROM [d360].[STG_EDS_D30_ENROLLMENT] WHERE H = 'D'; ",
