{
	"name": "LNS_rep_archive",
	"properties": {
		"activities": [
			{
				"name": "LNS Filename",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": {
								"value": "@concat('dev/archive/LNS/',pipeline().parameters.processdate)",
								"type": "Expression"
							},
							"wildcardFileName": {
								"value": "@concat('*LNS_EODACCTBAL','*',pipeline().parameters.filedate,'*')",
								"type": "Expression"
							},
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "adls_src_archive_daily",
						"type": "DatasetReference",
						"parameters": {
							"archivepath": " "
						}
					}
				],
				"outputs": [
					{
						"referenceName": "adls_src_encrypt_archive",
						"type": "DatasetReference",
						"parameters": {
							"folderpath": "dev/encrypt",
							"filename": " "
						}
					}
				]
			}
		],
		"parameters": {
			"processdate": {
				"type": "string"
			},
			"filedate": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2023-08-24T06:41:33Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}