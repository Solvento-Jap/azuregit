										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": "DELETE FROM EDS.DEP_CUSTOMCHANNELTRANSTABLE WHERE AS_OF_DATE = (SELECT TOP 1 CONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) FROM D360.STG_EDS_DEP_CUSTOMCHANNELTRANSTABLE);\r\n\r\nINSERT INTO EDS.DEP_CUSTOMCHANNELTRANSTABLE\r\n(\r\n\t AS_OF_DATE\r\n,\t[ACCOUNT_NUMBER]\r\n,\t[TRAN_DATETIME]\r\n,\t[ATM_BANK_ID]\r\n,\t[ATM_TERMINAL_ID]\r\n,\t[COMMAND]\r\n,\t[STAN]\r\n,\t[TRAN_ID]\r\n,\t[TRAN_DATE]\r\n,\t[PARTTRAN_NUM]\r\n,\t[PARTTRAN_IND]\r\n,\t[PARTTRAN_REM]\r\n,\t[PARTTRAN_PART1]\r\n,\t[PARTTRAN_PART2]\r\n,\t[TRAN_AMT]\r\n,\t[SOURCE_APP_CODE]\r\n,\t[ATM_CRD_NUM]\r\n,\t[BILLER_CODE]\r\n,\t[BILR_SUBR_NUM1]\r\n,\t[BILR_SUBR_NUM2]\r\n,\t[FREE_TEXT1]\r\n,\t[FREE_TEXT2]\r\n,\t[FREE_TEXT3]\r\n,\t[FREE_TEXT4]\r\n,\t[FREE_TEXT5]\r\n,\t[TPS_USER]\r\n,\t[TPS_TRANREF]\r\n,\t[TPS_ACCNO]\r\n,\t[TPS_ACCNAME]\r\n,\t[TPS_TRAN_RMKS]\r\n,\t[TPS_TRAN_DESC]\r\n,\t[LCHG_TIME]\r\n,\t[LCHG_USER_ID]\r\n,\t[RCRE_TIME]\r\n,\t[RCRE_USER_ID]\r\n,\t[BANK_ID]\r\n,\t[LAST6_ACC_NUM]\r\n,\t[LAST6_ATM_CRD_NUM]\r\n,\t[ACCOUNT_NUMBER_UNMASKED]\r\n,\tisActive\r\n,\tisLatest\r\n,\tBNK_CODE\r\n,\tSOURCE_CODE\r\n,\tFILE_NAME\r\n,\tinsert_dttm\r\n)\r\n\r\nSELECT \r\nCONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) AS AS_OF_DATE\r\n,\t[ACCOUNT_NUMBER]\r\n,\t[TRAN_DATETIME]\r\n,\t[ATM_BANK_ID]\r\n,\t[ATM_TERMINAL_ID]\r\n,\t[COMMAND]\r\n,\t[STAN]\r\n,\t[TRAN_ID]\r\n,\t[TRAN_DATE]\r\n,\t[PARTTRAN_NUM]\r\n,\t[PARTTRAN_IND]\r\n,\t[PARTTRAN_REM]\r\n,\t[PARTTRAN_PART1]\r\n,\t[PARTTRAN_PART2]\r\n,\t[TRAN_AMT]\r\n,\t[SOURCE_APP_CODE]\r\n,\t[ATM_CRD_NUM]\r\n,\t[BILLER_CODE]\r\n,\t[BILR_SUBR_NUM1]\r\n,\t[BILR_SUBR_NUM2]\r\n,\t[FREE_TEXT1]\r\n,\t[FREE_TEXT2]\r\n,\t[FREE_TEXT3]\r\n,\t[FREE_TEXT4]\r\n,\t[FREE_TEXT5]\r\n,\t[TPS_USER]\r\n,\t[TPS_TRANREF]\r\n,\t[TPS_ACCNO]\r\n,\t[TPS_ACCNAME]\r\n,\t[TPS_TRAN_RMKS]\r\n,\t[TPS_TRAN_DESC]\r\n,\t[LCHG_TIME]\r\n,\t[LCHG_USER_ID]\r\n,\t[RCRE_TIME]\r\n,\t[RCRE_USER_ID]\r\n,\t[BANK_ID]\r\n,\t[LAST6_ACC_NUM]\r\n,\t[LAST6_ATM_CRD_NUM]\r\n,\t[ACCOUNT_NUMBER_UNMASKED]\r\n,\t1 as isActive\r\n,\t1 as isLatest\r\n,\tBANK_ID as BNK_CODE\r\n,\t'DEP' as SOURCE_CODE\r\n,\tFILE_NAME\r\n,\tconvert(datetime2,insert_dttm) as insert_dttm\r\nFROM D360.STG_EDS_DEP_CUSTOMCHANNELTRANSTABLE\r\nWHERE H = 'D'\r\nAND CAST(LEFT(RIGHT(FILE_NAME , 12), 8) AS DATE)>=CAST(RCRE_TIME AS DATE)\r\n"
												}
