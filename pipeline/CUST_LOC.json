				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "ALTER PROC [DW].[SP_DW_FACTAVERAGEDAILYBALANCEMTD]  AS\nBEGIN\n\n\nINSERT INTO DW.FactAverageDailyBalanceMTD\n(\n     BusinessDateSK\n    ,BranchSK\n    ,BankSK\n    ,AccountSK\n    ,AccountID\n    ,AverageDailBalanceAmountMTDFull\n    ,AverageDailBalanceAmountMTDProrated\n    ,SourceSystemCode\n    ,WorkFlowId\n    ,TaskRunId\n    ,InsertDttm\n)\n\nSELECT \nBusinessDateSK AS BusinessDateSK\n,BranchSK AS BranchSK\n,BankSK AS BankSK\n,AccountSK AS AccountSK\n,AccountId AS AccountId\n,(SUM(BalanceAmountFull) OVER (PARTITION BY AccountSK,MONTH,YEAR ORDER BY BusinessDateSK))/DAY AS AverageDailBalanceAmountMTDFull  --[20230831 - Karl]\n,(SUM(BalanceAmountProrated) OVER (PARTITION BY AccountSK,MONTH,YEAR ORDER BY BusinessDateSK))/DAY  AS AverageDailBalanceAmountMTDProrated\n,SourceSystemCode AS SourceSystemCode\n,0 AS WorkFlowId\n,0 AS TaskRunId\n,Getdate() AS InsertDttm\nFROM \ndw.FactDepositsOutstandingBalance A -- no enchancement yet\nLEFT JOIN DW.DIMDATE B ON B.DateSK = A.BusinessDateSK\nWHERE\nNOT EXISTS(\n    SELECT * FROM DW.FactAverageDailyBalanceMTD B\n    WHERE \n    A.BusinessDateSK = b.[BusinessDateSK]\n    and A.AccountId = b.AccountId \n)\n\nEND"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
