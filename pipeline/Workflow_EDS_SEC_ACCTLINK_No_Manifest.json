										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
											"type": "LinkedServiceReference",
											"parameters": {
												"DBName": "testSQLpool"
											}
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": "TRUNCATE TABLE d360.STG_EDS_SEC_ACCTLINK_SELECT_SRC;\r\n\r\nINSERT INTO d360.STG_EDS_SEC_ACCTLINK_SELECT_SRC\r\n(\r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,[FILE_NAME]\r\n\t\t\t\t,JSRC_FLG \r\n\t\t\t\t,JTAR_FLG \r\n)\r\nSELECT \r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,[FILE_NAME]\r\n\t\t\t\t,1 AS JSRC_FLG \r\n\t\t\t\t,0 AS JTAR_FLG \r\n\t\t\tFROM [d360].[STG_EDS_SEC_ACCTLINK]\r\n            WHERE H = 'D';\r\n\r\n\r\nINSERT INTO d360.STG_EDS_SEC_ACCTLINK_SELECT_SRC\r\n(\r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,[FILE_NAME]\r\n\t\t\t\t,JSRC_FLG \r\n\t\t\t\t,JTAR_FLG \r\n)\r\n\t\t\tSELECT \t\t\t\t\r\n\t\t\t\t CC.[ACCTKEY] \r\n\t\t\t\t,CC.[CLTCODE] \r\n\t\t\t\t,CC.[LINKCODE]\r\n\t\t\t\t,CC.[FILE_NAME]\r\n\t\t        ,0 AS JSRC_FLG \r\n\t\t\t\t,1 AS JTAR_FLG \r\n\t\t\tFROM EDS.SEC_ACCTLINK CC\r\n\t\t\tJOIN d360.STG_EDS_SEC_ACCTLINK B \r\n            ON CC.CLTCODE = B.CLTCODE\r\n\t\t\tAND CC.ACCTKEY = B.ACCTKEY\r\n\t\t\tWHERE CC.ISLATEST = '1';\r\n\t\r\n\r\n\r\nTRUNCATE TABLE d360.STG_EDS_SEC_ACCTLINK_GROUP_SRC;\r\n\r\nINSERT INTO d360.STG_EDS_SEC_ACCTLINK_GROUP_SRC\r\n(\r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,[FILE_NAME]\r\n\t\t\t\t,JSRC_FLG_CNT \r\n\t\t\t\t,JTAR_FLG_CNT \r\n\t\t\t\t,FILE_DATE\r\n)\r\n\r\nselect \r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,[FILE_NAME]\r\n\t\t\t\t,JSRC_FLG_CNT \r\n\t\t\t\t,JTAR_FLG_CNT\r\n\t\t\t\t,CAST(LEFT(RIGHT(FILE_NAME , 12), 8) AS DATE) FILE_DATE\r\nfrom \r\n(\r\n\tSELECT \t\t\t\t\r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,MAX(FILE_NAME) FILE_NAME \r\n\t\t\t\t,SUM(JSRC_FLG) AS JSRC_FLG_CNT \r\n\t\t\t\t,SUM(JTAR_FLG) AS JTAR_FLG_CNT\r\n\tFROM d360.STG_EDS_SEC_ACCTLINK_SELECT_SRC\r\n\tGROUP BY     [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\tHAVING ( SUM(JSRC_FLG) > 0 AND SUM(JTAR_FLG) = 0 ) OR ( SUM(JSRC_FLG) = 0 AND SUM(JTAR_FLG) = 1) \r\n) AS TEMP\r\n\r\n\r\nDECLARE @SEC_PREVIOUS_BUSINESS_DAY AS DATE\r\nSELECT @SEC_PREVIOUS_BUSINESS_DAY = SEC_PREVIOUS_BUSINESS_DAY FROM EDS.DATE_DIM \r\nINNER JOIN (SELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS INTEGER) MX_DT FROM [d360].[STG_EDS_SEC_ACCTLINK]) MX_DT_TBL\r\nON DATESK = MX_DT;\t\r\n\r\n\r\nUPDATE A\r\nSET\r\nSCD_END_DATE = @SEC_PREVIOUS_BUSINESS_DAY\r\n, ISLATEST = 0\r\nFROM EDS.SEC_ACCTLINK A \r\nINNER JOIN d360.STG_EDS_SEC_ACCTLINK_GROUP_SRC B \r\nON COALESCE(A.CLTCODE,'-1') = COALESCE(B.CLTCODE,'-1')\r\nAND COALESCE(A.ACCTKEY,'-1') = COALESCE(B.ACCTKEY,'-1')\r\nAND A.ISLATEST = 1\r\nAND B.JTAR_FLG_CNT = 1\r\n\r\n\r\n\r\n\r\nINSERT INTO EDS.SEC_ACCTLINK\r\n(\r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,SCD_START_DATE \r\n\t\t\t\t,SCD_END_DATE\r\n\t\t\t\t,ISACTIVE\r\n\t\t\t\t,ISLATEST\r\n\t\t\t\t,BNK_CODE\r\n\t\t\t\t,SOURCE_CODE \r\n\t\t\t\t,FILE_NAME \r\n\t\t\t\t,insert_dttm\r\n)\r\nSELECT\r\n\t\t\t\t [ACCTKEY] \r\n\t\t\t\t,[CLTCODE] \r\n\t\t\t\t,[LINKCODE]\r\n\t\t\t\t,FILE_DATE\r\n\t\t\t\t,'9999-12-31'\r\n\t\t\t\t,1\r\n\t\t\t\t,1\r\n\t\t\t\t,LEFT(SRC.FILE_NAME,5)\r\n\t\t\t\t,'SEC'\r\n\t\t\t\t,SRC.FILE_NAME\r\n\t\t\t\t,CURRENT_TIMESTAMP\r\nFROM d360.STG_EDS_SEC_ACCTLINK_GROUP_SRC SRC\r\nWHERE JSRC_FLG_CNT > 0\r\n\r\n"
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									}
								]
							}
						},
						{
