					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('WITH BASE AS ( SELECT ORGKEY ,PART_TRAN_TYPE ,SOURCE_APP_CODE_DERIVED ,FORMAT(DEP_HTD_TRAN_DATE, ''MMMM yyyy'') AS MONTH_END ,1 AS TRAN_CNT FROM ( SELECT ACID ,ORGKEY ,TRAN_ID ,PART_TRAN_SRL_NUM ,DEP_HTD_TRAN_DATE ,PART_TRAN_TYPE ,SOURCE_APP_CODE_DERIVED ,ROW_NUMBER() OVER ( PARTITION BY ACID ,TRAN_ID ,PART_TRAN_SRL_NUM ,DEP_HTD_TRAN_DATE ORDER BY DEP_HTD_FILE_NAME DESC ) RN FROM EDS.DEP_HTD_CHTR_REPRINT WHERE BANK_ID = ''',variables('v_bank_id'),''' AND DEL_FLG = ''N'' ) A WHERE RN = 1 AND LEFT(ORGKEY, 1) = ''R'' AND DEP_HTD_TRAN_DATE >= DATEFROMPARTS(YEAR(DATEADD(MONTH, - 2, CAST(''',variables('v_date'),''' AS DATE))), MONTH(DATEADD(MONTH, - 2, CAST(''',variables('v_date'),''' AS DATE))), 1) AND DEP_HTD_TRAN_DATE <= CAST(''',variables('v_date'),''' AS DATE) ) SELECT ORGKEY ,PART_TRAN_TYPE ,SOURCE_APP_CODE_DERIVED ,MONTH_END ,SUM(TRAN_CNT) AS MONTH_TRAN_CNT FROM BASE GROUP BY ORGKEY ,PART_TRAN_TYPE ,SOURCE_APP_CODE_DERIVED ,MONTH_END')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "SQLPool_EDS",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "-"
						}
					}
				],
				"outputs": [
