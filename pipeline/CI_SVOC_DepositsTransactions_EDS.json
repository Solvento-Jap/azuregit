						"referenceName": "CI_csv_gen_SVOC",
						"type": "DatasetReference",
						"parameters": {
							"Table": "SVOC_DepositsTransactions",
							"Source": "SVOC",
							"Types": "Retail"
						}
					}
				]
			},
