										"value": "SELECT DEPOSITS_DATE fulldate\nFROM EDS.EDS_CTL",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLPool_EDS",
									"type": "DatasetReference",
									"parameters": {
