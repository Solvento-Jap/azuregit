			{
				"name": "SVOC_PHASE_2_DEPOSITS_TRANSACTIONS",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SET_BANK_ID",
						"dependencyConditions": [
							"Succeeded"
						]
