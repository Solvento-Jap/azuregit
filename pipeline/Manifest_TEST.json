{
	"name": "Manifest_TEST",
	"properties": {
		"activities": [
			{
				"name": "Load_manifest_to_STG",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 5,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "INSERT_DTTM",
								"value": {
									"value": "@pipeline().TriggerTime",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "SqlDWSink",
						"preCopyScript": "DELETE FROM D360.MANIFEST_FILE WHERE SUBSTRING(FILENAME,7,3) = 'CRM'",
						"allowCopyCommand": true,
						"disableMetricsCollection": false
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
							"type": "LinkedServiceReference"
						},
						"path": "data360/dev/stg_synapse"
					}
				},
				"inputs": [
					{
						"referenceName": "decrypt_csv",
						"type": "DatasetReference",
						"parameters": {
							"Filename": "CBC01_CRM_MANIFEST_001_20230125.csv",
							"SourceCode": "dev/decrypted/MNF"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "MANIFEST_FILE"
						}
					}
				]
			},
			{
				"name": "Until1",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Load_manifest_to_STG",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(\n    equals(variables('HasPipelineSucceed'), true),\n    greaterOrEquals(\n        length(variables('RetryTracker')),\n        pipeline().parameters.MaxPipelineCalls\n    )\n)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Wait1",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Manifest_TEST_sub1",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@pipeline().parameters.RetryInterval",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Wait1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "RetryTracker",
								"value": "1"
							}
						},
						{
							"name": "Set variable1",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Manifest_TEST_sub1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "HasPipelineSucceed",
								"value": true
							}
						},
						{
							"name": "Manifest_TEST_sub1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Manifest_sub1",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			}
		],
		"parameters": {
			"MaxPipelineCalls": {
				"type": "int",
				"defaultValue": 5
			},
			"RetryInterval": {
				"type": "int",
				"defaultValue": 60
			}
		},
		"variables": {
			"HasPipelineSucceed": {
				"type": "Boolean",
				"defaultValue": false
			},
			"RetryTracker": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-05-02T05:42:32Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}