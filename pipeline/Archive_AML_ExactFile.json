{
	"name": "Archive_AML_ExactFile",
	"properties": {
		"description": "AML exact encrypted-original archive with independent existence/size verification and post-archive decrypted working-file cleanup. Encrypted landing copies are never deleted.",
		"activities": [
			{
				"name": "Require_Approved_Execution",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.ExecutionMode, 'ApprovedDateSliceReload')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Unapproved_Execution",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "ExecutionMode must be ApprovedDateSliceReload.",
								"errorCode": "AML_EXECUTION_NOT_APPROVED"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Execution_Approved",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			},
			{
				"name": "Require_Valid_DateToProcess",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Require_Approved_Execution",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(length(pipeline().parameters.DateToProcess), 8), not(equals(pipeline().parameters.DateToProcess, '')), not(contains(pipeline().parameters.DateToProcess, '''')), not(contains(pipeline().parameters.DateToProcess, '/')))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Invalid_DateToProcess",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "DateToProcess must be a non-empty yyyyMMdd value.",
								"errorCode": "AML_INVALID_DATE_TO_PROCESS"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "DateToProcess_Valid",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			},
			{
				"name": "Require_Valid_MissingFilePolicy",
