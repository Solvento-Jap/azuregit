					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \nBANK_ID\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([BASE_DAYS_IN_A_YEAR],' ',''),''),0)) as BASE_DAYS_IN_A_YEAR\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([BASE_RATE],' ',''),''),0)) as BASE_RATE\n,CRNCY_CODE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([DEF_APPL_INT_AMT],' ',''),''),0)) as DEF_APPL_INT_AMT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([DEF_APPL_INT_RATE],' ',''),''),0)) as DEF_APPL_INT_RATE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([DIFF_PRODUCT],' ',''),''),0)) as DIFF_PRODUCT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([DIFF_RATE],' ',''),''),0)) as DIFF_RATE\n,convert(date,[END_DATE]) AS END_DATE\n,ENTITY_CRE_FLG\n,ENTITY_ID\n,ENTITY_TYPE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([FIXED_INT_PER_ANNUM],' ',''),''),0)) as FIXED_INT_PER_ANNUM\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([FULL_RATE],' ',''),''),0)) as FULL_RATE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([INTEREST_AMOUNT],' ',''),''),0)) as INTEREST_AMOUNT\n\n,INTEREST_IND\n,INTEREST_TYPE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([INT_AMOUNT_MODIFIED],' ',''),''),0)) as INT_AMOUNT_MODIFIED\n,INT_APPL_FLG\n,INT_APPL_FLG_CR\n,INT_METHOD\n,INT_TABLE_CODE\n,INT_VERSION\n,ITAX_FOR_FLOOR_LIMIT_FLG\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LAST_COMP_AMOUNT],' ',''),''),0)) as LAST_COMP_AMOUNT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LAST_COMP_AMOUNT_CR],' ',''),''),0)) as LAST_COMP_AMOUNT_CR\n,convert(date,[LAST_COMP_DATE]) AS LAST_COMP_DATE\n,convert(date,[LAST_COMP_DATE_CR]) AS LAST_COMP_DATE_CR\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([LAST_COMP_TAX],' ',''),''),0)) as LAST_COMP_TAX\n,convert(datetime2, stuff(stuff(stuff(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n,LCHG_USER_ID\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PRODUCT],' ',''),''),0)) as PRODUCT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PRODUCT_FOR_INT_RATE],' ',''),''),0)) as PRODUCT_FOR_INT_RATE\n,PROD_CALC_METHOD\n,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n,RCRE_USER_ID\n,convert(date,[REF_DATE]) AS REF_DATE\n,SERIAL_NUM\n,convert(date,[START_DATE]) AS START_DATE\n,SUPERCEDE_FLG\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TAX_AMOUNT],' ',''),''),0)) as TAX_AMOUNT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n,WTAX_AMOUNT_SCOPE_FLG\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([WTAX_FLOOR_LIMIT],' ',''),''),0)) as WTAX_FLOOR_LIMIT\n,WTAX_FOR_CR_COMP\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([WTAX_PCNT],' ',''),''),0)) as WTAX_PCNT\n,1 AS isActive\n,1 AS isLatest\n\n\n\n,left(FILE_NAME, 5) as [BNK_CODE]\n\n,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n\n,[FILE_NAME]\n\n,convert(date,[insert_dttm]) as insert_dttm\n\nFROM [d360].[stg_lns_INTERESTDETAILS]\nWHERE H = 'D'\n",
