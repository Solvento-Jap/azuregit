					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('WITH MAIN AS ( SELECT DISTINCT ORGKEY AS CUSTOMER_ID ,FORACID ,FORACID_UNMASKED ,GAM_LAST6_ACC_NUM ,AAS.ACCT_POA_AS_REC_TYPE ,b.SOL_ID ,BR.SOL_DESC ,ACCT_CRNCY_CODE ,GAM_SCHM_CODE ,d.SCHM_DESC ,ACCT_OPN_DATE ,ACCT_CLS_DATE ,DEP_ACCOUNT_STATUS ,OUTSTANDING_BALANCE ,OUTSTANDING_BALANCE_PHP ,MTD_ADB_ORIG_CURR ,MTD_ADB_PHP ,YEAR_TO_DATE_AVERAGE_DAILY_BALANCE ,YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP ,b.AS_OF_DATE FROM eds.DEPOSIT_FACT b INNER JOIN eds.DEP_ACCOUNTRELATIONSHIP AS AAS ON b.GAM_ACID = AAS.ACID AND b.GAM_BANK_ID = AAS.BANK_ID AND AAS.DEL_FLG <> ''Y'' AND AAS.AS_OF_DATE = b.AS_OF_DATE LEFT JOIN [eds].[CUSTOMER_DIM] a ON a.core_cust_id = AAS.cust_id AND a.BANK_ID = b.gam_bank_id AND CAST(''',variables('v_date'),''' AS DATE) BETWEEN a.SCD_Start_Date AND a.SCD_End_Date LEFT JOIN [eds].[DEP_GENSCHMPARMTABLE] d ON b.GAM_SCHM_CODE = d.SCHM_CODE AND b.gam_bank_id = d.BANK_ID AND CAST(''',variables('v_date'),''' AS DATE)BETWEEN d.SCD_Start_Date AND d.SCD_End_Date AND d.DEL_FLG <> ''Y'' LEFT JOIN [eds].[BRANCH_DIM] BR ON b.SOL_ID = BR.SOL_ID AND b.gam_bank_id = BR.BANK_ID AND CAST(''',variables('v_date'),''' AS DATE) BETWEEN BR.SCD_Start_Date AND BR.SCD_End_Date AND BR.DEL_FLG <> ''Y'' WHERE b.gam_bank_id = ''',variables('v_bank_id'),''' AND SUBSTRING(b.GAM_SCHM_CODE, 1, 2) <> ''09'' AND b.DEL_FLG = ''N'' AND b.as_of_date = CAST(''',variables('v_date'),''' AS DATE) AND AAS.ACCT_POA_AS_REC_TYPE IN ( ''M'' ,''J'' ) AND a.CUSTOMER_TYPE = ''Retail'' ) SELECT CUSTOMER_ID ,FORACID ,FORACID_UNMASKED ,GAM_LAST6_ACC_NUM ,ACCT_POA_AS_REC_TYPE ,SOL_ID ,SOL_DESC ,ACCT_CRNCY_CODE ,GAM_SCHM_CODE ,SCHM_DESC ,ACCT_OPN_DATE ,ACCT_CLS_DATE ,DEP_ACCOUNT_STATUS ,OUTSTANDING_BALANCE ,OUTSTANDING_BALANCE_PHP ,MTD_ADB_ORIG_CURR ,MTD_ADB_PHP ,YEAR_TO_DATE_AVERAGE_DAILY_BALANCE ,YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP ,AS_OF_DATE FROM MAIN') ",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
