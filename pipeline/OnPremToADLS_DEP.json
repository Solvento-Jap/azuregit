							"wildcardFolderPath": "data360/uat/CBC02/DEP/encrypt",
							"wildcardFileName": {
								"value": "@concat(activity('Filter1').output.value,'*',variables('v_datetoprocessed'),'*')",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false,
							"disableChunking": false
