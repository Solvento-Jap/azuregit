						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_tables",
					"value": {
						"value": "@concat('*',pipeline().parameters.tables)",
