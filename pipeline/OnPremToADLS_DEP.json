						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('v_tables')",
						"type": "Expression"
					},
					"condition": {
						"value": "@or(not(contains(item().name,'EODACCOUNTBALANCE')),or(not(contains(item().name,'YTDDEPAGGRBALANCES')),not(contains(item().name,'GENERALACCOUNTMASTER'))))",
