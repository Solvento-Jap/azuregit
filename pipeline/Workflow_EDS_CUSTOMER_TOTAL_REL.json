			"tables": {
				"type": "string",
				"defaultValue": "CUSTOMER_TOTAL_REL"
			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "IF EXISTS(SELECT 1 CNT FROM OM.OM_TASK_RUN WHERE TASK_NAME='TSK_EDS_CUSTOMER_TOTAL_REL' AND PROCESS_DATE=CAST('${PROCESS_DATE}' AS DATE)) BEGIN DELETE FROM EDS.CUSTOMER_TOTAL_REL WHERE AS_OF_DATE = CAST('${PROCESS_DATE}' AS DATE); END; WITH CUST_TOT_REL AS ( SELECT EDA.AS_OF_DATE AS_OF_DATE ,EDA.BANK_ID BANK_ID ,ECD.ORGKEY CIF ,NULL TOTAL_RELATIONSHIP ,YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP TRB_DEPOSITS ,NULL\tTRB_TREASURY ,NULL\tTRB_TRUST ,NULL\tTRB_BANCA ,NULL\tTRB_SECURITIES ,NULL\tTRE_LOANS ,NULL\tTRE_CARDS FROM EDS.DEP_ACCOUNTRELATIONSHIP EDA LEFT JOIN EDS.DEPOSIT_FACT EDF ON EDA.ACID = EDF.GAM_ACID AND EDA.BANK_ID = EDF.GAM_BANK_ID AND EDA.AS_OF_DATE = EDF.AS_OF_DATE LEFT JOIN EDS.CUSTOMER_DIM ECD ON EDA.CUST_ID = ECD.CORE_CUST_ID AND EDA.BANK_ID = ECD.BANK_ID AND EDA.AS_OF_DATE BETWEEN ECD.SCD_START_DATE AND ECD.SCD_END_DATE WHERE EDA.ACCT_POA_AS_REC_TYPE IN  ('M', 'J') AND EDA.BANK_ID = 'CBC01' AND LEFT(EDF.GAM_SCHM_CODE,2)  <> '09' AND EDF.GAM_BANK_ID = 'CBC01' AND EDF.DEP_ACCOUNT_STATUS <> 'C' AND EDF.DEL_FLG = 'N' AND EDA.AS_OF_DATE = CAST('${PROCESS_DATE}' AS DATE) ) , AGG_TRB AS ( SELECT AS_OF_DATE ,BANK_ID ,CIF ,TOTAL_RELATIONSHIP ,SUM(COALESCE(TRB_DEPOSITS,0) + COALESCE(TRB_TREASURY,0) + COALESCE(TRB_TRUST,0) + COALESCE(TRB_BANCA,0)) TRB ,SUM(COALESCE(TRB_DEPOSITS,0)) TRB_DEPOSITS ,SUM(COALESCE(TRB_TREASURY,0) + COALESCE(TRB_TRUST,0))\tTRB_INVEST ,TRB_TRUST ,TRB_TREASURY ,TRB_BANCA ,TRB_SECURITIES ,SUM(COALESCE(TRE_LOANS,0) + COALESCE(TRE_CARDS,0)) TRE ,TRE_LOANS ,TRE_CARDS FROM CUST_TOT_REL GROUP BY AS_OF_DATE ,BANK_ID ,CIF ,TOTAL_RELATIONSHIP ,TRB_TREASURY ,TRB_TRUST ,TRB_BANCA ,TRB_SECURITIES ,TRE_LOANS ,TRE_CARDS ) INSERT INTO EDS.CUSTOMER_TOTAL_REL ( AS_OF_DATE ,BANK_ID ,CIF ,CUST_SEGMENT_ID ,TOTAL_RELATIONSHIP ,TRB ,TRB_DEPOSITS ,TRB_INVEST ,TRB_TRUST ,TRB_TREASURY ,TRB_BANCA ,TRB_SECURITIES ,TRE ,TRE_LOANS ,TRE_CARDS ) SELECT AGG_TRB.AS_OF_DATE AS AS_OF_DATE ,AGG_TRB.BANK_ID ,AGG_TRB.CIF ,CSP.PARAM_ID AS CUST_SEGMENT_ID ,AGG_TRB.TOTAL_RELATIONSHIP ,AGG_TRB.TRB ,AGG_TRB.TRB_DEPOSITS ,AGG_TRB.TRB_INVEST ,AGG_TRB.TRB_TRUST ,AGG_TRB.TRB_TREASURY ,AGG_TRB.TRB_BANCA ,AGG_TRB.TRB_SECURITIES ,AGG_TRB.TRE ,AGG_TRB.TRE_LOANS ,AGG_TRB.TRE_CARDS FROM AGG_TRB LEFT JOIN EDS.CUSTOMER_SEGMENT_PARAM CSP ON  CSP.BANK_ID = AGG_TRB.BANK_ID AND COALESCE(TRB,0) BETWEEN COALESCE(CAST(REPLACE(CSP.FROM_VALUE,',','') AS NUMERIC(38,6)),0) AND COALESCE(CAST(REPLACE(CSP.TO_VALUE,',','') AS NUMERIC(38,6)),0) AND AGG_TRB.AS_OF_DATE BETWEEN CSP.SCD_START_DATE AND CSP.SCD_END_DATE"
			}
		},
