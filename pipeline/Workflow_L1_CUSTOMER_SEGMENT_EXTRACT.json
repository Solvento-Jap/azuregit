								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "@concat('WITH CTL\nAS (\n\tSELECT \n\t\tMAX(FULLDATE) AS_OF_DATE\n\tFROM eds.DATE_DIM\n\tWHERE Business_Day_Flag = ''Y'' \n\t\tAND MONTH_END = ''Y'' \n\t\tAND FULLDATE <= CAST(''',variables('v_date'),''' AS DATE)\n\t)\n,MAIN\nAS (\nSELECT\nCIF AS [CIF ID]\n,CASE \n\tWHEN L1_SEGMENT_ID = ''001'' \n\tTHEN ''UHNW'' \n\tWHEN L1_SEGMENT_ID = ''002'' \n\tTHEN ''HNW'' \n\tWHEN L1_SEGMENT_ID = ''003'' \n\tTHEN ''MA'' \n\tWHEN L1_SEGMENT_ID = ''004'' \n\tTHEN ''EA'' \n\tWHEN L1_SEGMENT_ID = ''005'' \n\tTHEN ''UMR'' \n\tWHEN L1_SEGMENT_ID = ''006'' \n\tTHEN ''LMR'' \n\tEND AS [SEGMENT]\n,FORMAT(SCD_START_DATE, ''MM/dd/yyyy'') AS [SEGMENT AS OF DATE]\nFROM EDS.CUSTOMER_SEGMENT SEG\nINNER JOIN CTL ON CTL.AS_OF_DATE=SEG.SCD_START_DATE\nWHERE BANK_ID=''CBC01''\n)\nSELECT\n[CIF ID]\n,[SEGMENT]\n,[SEGMENT AS OF DATE]\nFROM MAIN\nWHERE [CIF ID] IS NOT NULL\nAND [SEGMENT] IS NOT NULL\n')",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"maxRowsPerFile": 200000,
										"fileNamePrefix": {
											"value": "@concat(pipeline().parameters.BankID,'_','SEGMENT','_',formatDateTime(variables('v_date'),'MMddyyyy'))",
											"type": "Expression"
										},
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
