										"value": "@concat('\nSELECT\nCIF AS [CIF ID]\n,CASE \n\tWHEN L1_SEGMENT_ID = ''001'' \n\tTHEN ''UHNW'' \n\tWHEN L1_SEGMENT_ID = ''002'' \n\tTHEN ''HNW'' \n\tWHEN L1_SEGMENT_ID = ''003'' \n\tTHEN '' MA'' \n\tWHEN L1_SEGMENT_ID = ''004'' \n\tTHEN ''EA'' \n\tWHEN L1_SEGMENT_ID = ''005'' \n\tTHEN ''UMR'' \n\tWHEN L1_SEGMENT_ID = ''006'' \n\tTHEN ''LMR'' \n\tEND AS [SEGMENT]\n,FORMAT(SCD_START_DATE, ''MM/dd/yyyy'') AS [SEGMENT AS OF DATE]\nFROM EDS.CUSTOMER_SEGMENT\nWHERE CIF IS NOT NULL\nAND L1_SEGMENT_ID IS NOT NULL\nAND BANK_ID=''CBC01''\n')",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"maxRowsPerFile": 200000,
										"fileNamePrefix": {
											"value": "@concat(pipeline().parameters.BankID,'_','SEGMENT','_',formatDateTime(variables('v_date'),'MMddyyyy'))",
											"type": "Expression"
										},
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "SQLPool_EDS",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "-"
									}
								}
