									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "@concat('select ',pipeline().parameters.ctl_src_sys,'_DATE fulldate\nfrom \n    eds.eds_ctl ect')",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLPool_EDS",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "EDS_CTL"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "SET_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
