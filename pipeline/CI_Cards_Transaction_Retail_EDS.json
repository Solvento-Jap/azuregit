{
	"name": "CI_Cards_Transaction_Retail_EDS",
	"properties": {
		"description": "Sources data from EDS tables",
		"activities": [
			{
				"name": "Cards Transaction Retail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT\n    TXN.*\n    ,CCD.CUST_CIF_NBR AS FCBSCIF\n    ,ROW_NUMBER() OVER(ORDER BY TXN_ACCT_NBR) SK\n\nFROM (\nSELECT\n    *\n    ,ROW_NUMBER() OVER(PARTITION BY TXN_ACCT_NBR, TXN_CARD_NBR, TXN_CODE, TXN_POSTING_DTE, TXN_AUTH_CODE, TXN_ACQ_REF, TXN_BATCH_SEQ\n        ORDER BY LEFT(RIGHT(FILE_NAME,12),8) DESC) RN\n    FROM eds.CCD_CBCEXCTDBP TXN\n    WHERE CAST(TXN_DTE AS date) >= ''2024-04-01'' AND CAST(TXN_DTE AS date) <= CAST(''',variables('v_date'),''' AS DATE)\n) TXN\n\nINNER JOIN\n    (SELECT AS_OF_DATE, CUST_CIF_NBR, CRDACCT_NBR, CARD_NBR FROM eds.CCD_CREDIT_CARDS_FACT GROUP BY AS_OF_DATE, CUST_CIF_NBR, CRDACCT_NBR, CARD_NBR) CCD\n    ON TXN.TXN_ACCT_NBR = CCD.CRDACCT_NBR\n    AND TXN.TXN_CARD_NBR = CCD.CARD_NBR\n    AND CAST(TXN_DTE AS date) = CAST(CCD.AS_OF_DATE AS DATE)\nWHERE RN = 1 AND CCD.CUST_CIF_NBR IS NOT NULL')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "SQLPool_EDS",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "-"
						}
					}
				],
				"outputs": [
