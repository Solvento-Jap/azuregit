							"userProperties": [],
							"typeProperties": {
								"variableName": "v_date",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						}
					]
				}
