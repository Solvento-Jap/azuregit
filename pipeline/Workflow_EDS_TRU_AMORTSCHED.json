			"HashLog_SQL": {
				"type": "string",
				"defaultValue": "WITH [METRIC_BASE] AS (     SELECT         [FILE_NAME],         [INSERT_DTTM],         TRY_CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) AS [DATE],         TRY_CAST(SUM(CASE WHEN H = 'D' THEN 1 ELSE 0 END) AS NUMERIC(25,5)) AS TGT_COUNT,         MAX(CASE WHEN H <> 'D' THEN TRY_CAST(REPLACE(H,'F-','') AS NUMERIC(25,5)) END) AS SRC_COUNT     FROM [D360].[STG_EDS_TRU_AMORTSCHED]     GROUP BY [FILE_NAME], [INSERT_DTTM] )  INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT     [FILE_NAME],     [DATE],     [INSERT_DTTM],     [METRIC_NAME],     [SRC_VALUE],     [TGT_VALUE] FROM [METRIC_BASE] CROSS APPLY (     SELECT 'COUNT' AS [METRIC_NAME], [SRC_COUNT] AS [SRC_VALUE], [TGT_COUNT] AS [TGT_VALUE] ) M"
			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "DELETE FROM EDS.TRU_AMORTSCHED WHERE AS_OF_DATE IN (SELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) FROM D360.STG_EDS_TRU_AMORTSCHED)  INSERT INTO [EDS].[TRU_AMORTSCHED] (     [AMORTISATION_DATE],     [AMORTISATION_PER],     [BR_CD],     [CASHFLOW_TYPE],     [FROMDATE],     [SEC_IDENTIFIER],     [TODATE],     [AS_OF_DATE],     [BNK_CODE],     [SOURCE_CODE],     [FILE_NAME],     [insert_dttm] )  SELECT     [AMORTISATION_DATE],     [AMORTISATION_PER],     [BR_CD],     [CASHFLOW_TYPE],     [FROMDATE],     [SEC_IDENTIFIER],     [TODATE],     CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) AS [AS_OF_DATE],     LEFT(FILE_NAME,5) AS [BNK_CODE],     'TRU' AS [SOURCE_CODE],     [FILE_NAME],     [insert_dttm] FROM [D360].[STG_EDS_TRU_AMORTSCHED] WHERE [H] = 'D'"
			},
