{
	"name": "dev_StgToTgt_CRM",
	"properties": {
		"activities": [
			{
				"name": "Lookup1",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlPoolSource",
						"sqlReaderQuery": "select\n\ndistinct TABLE_NAME from INFORMATION_SCHEMA.TABLES where TABLE_SCHEMA = 'd360' and TABLE_NAME like 'STG_CRM%'",
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "SqlPool_TableList",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup1').output.value",
						"type": "Expression"
					},
					"batchCount": 20,
					"activities": [
						{
							"name": "Data flow1",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "df_StgtoTgt",
									"type": "DataFlowReference",
									"datasetParameters": {
										"STG": {
											"table_name": {
												"value": "@item().TABLE_NAME",
												"type": "Expression"
											}
										},
										"TGT": {
											"table_name": {
												"value": "@replace(item().TABLE_NAME,'STG_','')",
												"type": "Expression"
											}
										}
									}
								},
								"staging": {
									"linkedService": {
										"referenceName": "cbcd360devsynpssg-WorkspaceDefaultStorage",
										"type": "LinkedServiceReference"
									},
									"folderPath": "data360/dev"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			}
		],
		"annotations": [],
