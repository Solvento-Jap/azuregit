								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_DatetoProcessed",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.PROCESS_DATE",
									"type": "Expression"
								}
							}
						}
					]
				}
