						{
							"name": "GET_PROCESS_DATE",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": "SELECT MIN(PROCESS_DATE) PROCESS_DATE FROM [OM].[OM_TASK_RUN] WHERE DATA_LAYER='BNKM' AND TASK_NAME LIKE '%CRM%' AND STATUS_ID = 3\nAND\nPROCESS_DATE NOT IN (SELECT DISTINCT PROCESS_DATE FROM [OM].[OM_TASK_RUN] WHERE DATA_LAYER='DW')",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLPool_STG",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "OM_TASK_RUN"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "SET_PROCESS_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
