			{
				"name": "CHECK PROCESS DATE PARAM",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(pipeline().parameters.startYear,'9999'),equals(pipeline().parameters.endYear,'9999'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FALSE",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "SET_START_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "SET_END_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						},
						{
							"name": "SET_START_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_startDate",
								"value": {
									"value": "@concat(pipeline().parameters.startYear,'-01-01')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_endDate",
								"value": {
									"value": "@concat(pipeline().parameters.endYear,'-12-31')",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "SET_START_DATE",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_startDate",
								"value": {
									"value": "@concat(substring(string(addHours(pipeline().TriggerTime,8)),0,4),'-01-01')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "SET_START_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
