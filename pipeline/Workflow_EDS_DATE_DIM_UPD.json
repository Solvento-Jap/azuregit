								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_endDate",
								"value": {
									"value": "@concat(substring(string(addHours(pipeline().TriggerTime,8)),0,4),'-12-31')",
									"type": "Expression"
								}
							}
						}
					]
				}
