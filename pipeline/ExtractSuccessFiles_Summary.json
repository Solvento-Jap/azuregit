{
	"name": "ExtractSuccessFiles_Summary",
	"properties": {
		"activities": [
			{
				"name": "List of Success File - TRY",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlPoolSource",
						"sqlReaderQuery": "WITH SUCCESS AS (\r\nSELECT DISTINCT\r\n    SUBSTRING(FILE_NAME,0,6) BANK_CODE\r\n    ,SUBSTRING(FILE_NAME,7,3) SOURCE_CODE\r\n    ,REVERSE(SUBSTRING(REVERSE(FILE_NAME),18,50)) FILE_NAME\r\n    ,Date as DATE\r\n    ,insert_dttm\r\n    ,Metrics\r\n    ,Source\r\n    ,Target\r\nFROM d360.HASH_LOG_TBL)\r\n\r\nSELECT\r\n    BANK_CODE\r\n    ,SOURCE_CODE\r\n    ,FILE_NAME\r\n    ,DATE\r\n    ,insert_dttm\r\n    ,Metrics\r\n    ,SUM(Source) Source_Total\r\n    ,SUM(Target) Target_Total\r\nFROM SUCCESS\r\nWHERE SOURCE_CODE = 'TRY'\r\nGROUP BY BANK_CODE\r\n    ,SOURCE_CODE\r\n    ,FILE_NAME\r\n    ,DATE\r\n    ,insert_dttm\r\n    ,Metrics",
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ExecutionLogTable",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ListOfFailedFile",
						"type": "DatasetReference",
						"parameters": {
							"folderpath": "dev/SUCCESS/TRY",
							"filelist": {
								"value": "@concat('SUMMARY_OF_SUCCESS_TRY_FILES_',substring(replace(replace(replace(addHours(utcnow(),+8),'-',''),'T','_'),':',''),0,15),'.csv')",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2023-01-26T02:02:47Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}