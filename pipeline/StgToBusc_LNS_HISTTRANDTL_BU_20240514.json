					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "UPDATE TGT\nSET ISLATEST = 0\nFROM BUSC.LNS_HISTTRANDTL TGT\nWHERE  ISLATEST = 1\n\nSELECT\nACID\n,AMT_RESERVATION_IND\n,BANK_CODE\n,BANK_ID\n,BKDT_TRAN_FLG\n,BR_CODE\n,COMB_TRAN_ID\n,CRNCY_CODE\n,CRNCY_HOL_CHK_DONE_FLG\n,CUST_ID\n,DEL_FLG\n,DEL_MEMO_PAD\n,DTH_INIT_SOL_ID\n,EABFAB_UPD_FLG\n,convert(date,[ENTRY_DATE]) AS ENTRY_DATE\n,ENTRY_USER_ID\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([FX_TRAN_AMT],' ',''),''),0)) as FX_TRAN_AMT\n,convert(date,[GL_DATE]) AS GL_DATE\n,GL_SEGMENT_STRING\n,GL_SUB_HEAD_CODE\n,GST_UPD_FLG\n,IMPL_CASH_PART_TRAN_FLG\n,INSTRMNT_ALPHA\n,convert(date,[INSTRMNT_DATE]) AS INSTRMNT_DATE\n,INSTRMNT_NUM\n,INSTRMNT_TYPE\n,ISO_FLG\n,convert(datetime2, stuff(stuff(stuff(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n,LCHG_USER_ID\n,LIFT_LIEN_FLG\n,MODULE_ID\n,MUD_POOL_BAL_BUILD_FLG\n,NAVIGATION_FLG\n,PARTY_CODE\n,PART_TRAN_SRL_NUM\n,PART_TRAN_TYPE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([PRINCIPAL_PORTION_AMT],' ',''),''),0)) as PRINCIPAL_PORTION_AMT\n,PRNT_ADVC_IND\n,PROXY_ACID\n,PROXY_POST_IND\n,PR_SRL_NUM\n,convert(date,[PSTD_DATE]) AS PSTD_DATE\n,PSTD_FLG\n,PSTD_USER_ID\n,PTRAN_CHRG_EXISTS_FLG\n,PTTM_EVENT_TYPE\n,PURPOSE_CODE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([RATE],' ',''),''),0)) as RATE\n,RATE_CODE\n,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n,RCRE_USER_ID\n,REFERRAL_ID\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([REF_AMT],' ',''),''),0)) as REF_AMT\n,REF_CRNCY_CODE\n,REF_NUM\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([REGULARIZATION_AMT],' ',''),''),0)) as REGULARIZATION_AMT\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([RESERVATION_AMT],' ',''),''),0)) as RESERVATION_AMT\n,RESP_ACCT_REF_NO\n,RESTRICT_MODIFY_IND\n,convert(date,[REVERSAL_DATE]) AS REVERSAL_DATE\n,convert(date,[REVERSAL_VALUE_DATE]) AS REVERSAL_VALUE_DATE\n,RPT_CODE\n,SERIAL_NUM\n,convert(date,[SI_ORG_EXEC_DATE]) AS SI_ORG_EXEC_DATE\n,SI_SRL_NUM\n,SOL_ID\n,SVS_TRAN_ID\n,SYS_PART_TRAN_CODE\n,TF_ENTITY_SOL_ID\n,TOD_ENTITY_ID\n,TOD_ENTITY_TYPE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TRAN_AMT],' ',''),''),0)) as TRAN_AMT\n,TRAN_CRNCY_CODE\n,convert(date,[TRAN_DATE]) AS TRAN_DATE\n,TRAN_FREE_CODE1\n,TRAN_FREE_CODE2\n,TRAN_ID\n,TRAN_PARTICULAR\n,TRAN_PARTICULAR_2\n,TRAN_PARTICULAR_CODE\n,TRAN_RMKS\n,TRAN_SUB_TYPE\n,TRAN_TYPE\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TREA_RATE],' ',''),''),0)) as TREA_RATE\n,TREA_REF_NUM\n,TR_STATUS\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n,UAD_MODULE_ID\n,UAD_MODULE_KEY\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([USED_CLEAN_EMER_ADVN],' ',''),''),0)) as USED_CLEAN_EMER_ADVN\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([USED_CLEAN_SINGLE_TRAN_LIM],' ',''),''),0)) as USED_CLEAN_SINGLE_TRAN_LIM\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([USED_EMER_ADVN],' ',''),''),0)) as USED_EMER_ADVN\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([USED_SINGLE_TRAN_LIM],' ',''),''),0)) as USED_SINGLE_TRAN_LIM\n,convert(numeric(22,0),ISNULL(NULLIF(REPLACE([USED_UN_CLR_OVER_DACC_AMT],' ',''),''),0)) as USED_UN_CLR_OVER_DACC_AMT\n,USER_PART_TRAN_CODE\n,convert(date,[VALUE_DATE]) AS VALUE_DATE\n,convert(date,[VFD_DATE]) AS VFD_DATE\n,VFD_USER_ID\n,VOUCHER_PRINT_FLG\n,1 AS isActive\n,1 AS isLatest\n,left(FILE_NAME, 5) as [BNK_CODE]\n,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n,[FILE_NAME]\n,convert(date,[insert_dttm]) as insert_dttm\n,CONVERT(INT, LEFT(RIGHT(FILE_NAME,12),8)) AS BUSINESSDATE\nFROM [D360].[STG_LNS_HISTTRANDTL]\nWHERE H = 'D'",
