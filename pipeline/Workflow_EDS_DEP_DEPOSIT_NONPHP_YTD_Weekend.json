																"type": "Expression"
															},
															"direction": "Input"
														}
													],
													"type": "NonQuery",
													"text": "DELETE FROM EDS.DEPOSIT_NONPHP_YTD WHERE FULLDATE = CAST(@process_date AS DATE);\r\n\r\nINSERT INTO\r\n\t EDS.DEPOSIT_NONPHP_YTD\r\n(      \r\n\t  FULLDATE\r\n    , PREVIOUS_BUSINESS_DAY\r\n    , CUST_ID\r\n    , GAM_ACID\r\n    , ACCT_CRNCY_CODE\r\n    , GAM_BANK_ID\r\n    , GAM_SCHM_TYPE\r\n    , CURRENT_OUTSTANDING_BALANCE\r\n    , CURRENT_OUTSTANDING_BALANCE_PHP\r\n    , PREVIOUS_OUTSTANDING_BALANCE --\r\n    , PREVIOUS_OUTSTANDING_BALANCE_PHP\r\n    , TOTAL_CURRENT_OUTSTANDING_BALANCE --\r\n    , TOTAL_CURRENT_OUTSTANDING_BALANCE_PHP\t\r\n    , DAYOFYEAR\r\n    , YTD_BALANCE  --\r\n\t, YTD_BALANCE_PHP\r\n\t, MONTH_END --\r\n)\r\n\r\n\r\nSELECT \r\n      TMP.FULLDATE\r\n    , TMP.PREVIOUS_BUSINESS_DAY\r\n    , TMP.CUST_ID\r\n    , TMP.GAM_ACID\r\n    , TMP.ACCT_CRNCY_CODE\r\n    , TMP.GAM_BANK_ID\r\n    , TMP.GAM_SCHM_TYPE\r\n    , (CASE WHEN Business_Day_Flag = 'Y' THEN CURRENT_BD.OUTSTANDING_BALANCE ELSE CURRENT_PBD.OUTSTANDING_BALANCE END) AS CURRENT_OUTSTANDING_BALANCE\r\n    , (CASE WHEN Business_Day_Flag = 'Y' THEN CURRENT_BD.OUTSTANDING_BALANCE_PHP ELSE CURRENT_PBD.OUTSTANDING_BALANCE_PHP END) AS CURRENT_OUTSTANDING_BALANCE_PHP\r\n    , CURRENT_PBD.OUTSTANDING_BALANCE AS PREVIOUS_OUTSTANDING_BALANCE\r\n    , CURRENT_PBD.OUTSTANDING_BALANCE_PHP AS PREVIOUS_OUTSTANDING_BALANCE_PHP\r\n    , COALESCE((CASE WHEN Business_Day_Flag = 'Y' THEN CURRENT_BD.OUTSTANDING_BALANCE ELSE CURRENT_PBD.OUTSTANDING_BALANCE END),0) \r\n    + COALESCE((CASE WHEN TMP.DAYOFYEAR = 1 THEN 0 ELSE P_RUNNINGBAL.TOTAL_CURRENT_OUTSTANDING_BALANCE END),0) AS TOTAL_CURRENT_OUTSTANDING_BALANCE\r\n    , COALESCE((CASE WHEN Business_Day_Flag = 'Y' THEN CURRENT_BD.OUTSTANDING_BALANCE_PHP ELSE CURRENT_PBD.OUTSTANDING_BALANCE_PHP END),0) \r\n    + COALESCE((CASE WHEN TMP.DAYOFYEAR = 1 THEN 0 ELSE P_RUNNINGBAL.TOTAL_CURRENT_OUTSTANDING_BALANCE_PHP END),0) AS TOTAL_CURRENT_OUTSTANDING_BALANCE_PHP\t\r\n    , TMP.DAYOFYEAR\r\n    , (COALESCE((CASE WHEN Business_Day_Flag = 'Y' THEN CURRENT_BD.OUTSTANDING_BALANCE ELSE CURRENT_PBD.OUTSTANDING_BALANCE END),0) \r\n    + COALESCE((CASE WHEN TMP.DAYOFYEAR = 1 THEN 0 ELSE P_RUNNINGBAL.TOTAL_CURRENT_OUTSTANDING_BALANCE END),0)) / TMP.DAYOFYEAR AS YTD_BALANCE\r\n\t, (COALESCE((CASE WHEN Business_Day_Flag = 'Y' THEN CURRENT_BD.OUTSTANDING_BALANCE_PHP ELSE CURRENT_PBD.OUTSTANDING_BALANCE_PHP END),0) \r\n    + COALESCE((CASE WHEN TMP.DAYOFYEAR = 1 THEN 0 ELSE P_RUNNINGBAL.TOTAL_CURRENT_OUTSTANDING_BALANCE_PHP END),0)) / TMP.DAYOFYEAR AS YTD_BALANCE_PHP\r\n\t, TMP.MONTH_END\r\nFROM\r\n    (\r\n \t\tSELECT \r\n              FULLDATE\r\n            , Previous_Business_Day\r\n            , Business_Day_Flag\r\n            , DAYOFYEAR\r\n            , YEAR\r\n            , CUST_ID\r\n            , GAM_ACID\r\n            , ACCT_CRNCY_CODE\r\n            , GAM_BANK_ID\r\n            , GAM_SCHM_TYPE\r\n\t\t\t, DATE_DIM.MONTH_END\r\n\t\t\t, DEP_ACCOUNT_STATUS\r\n          FROM EDS.DATE_DIM\r\n          JOIN EDS.DEPOSIT_FACT\r\n            ON 1 = 1\r\n            AND SUBSTRING(GAM_SCHM_CODE, 1, 2) <> '09'\r\n\t\t\tAND ACCT_CRNCY_CODE <> 'PHP'\r\n            JOIN (SELECT MAX(AS_OF_DATE) MAX_AS_OF_DATE FROM EDS.DEPOSIT_FACT WHERE AS_OF_DATE <= CAST(@process_date AS DATE)) MX\r\n            ON MX.MAX_AS_OF_DATE = AS_OF_DATE  OR (DEP_ACCOUNT_STATUS = 'C' AND CAST(@process_date AS DATE)>=AS_OF_DATE )\r\n        WHERE (FULLDATE =CAST(@process_date AS DATE) )  \r\n    ) TMP\r\nLEFT JOIN EDS.DEPOSIT_FACT CURRENT_BD\r\n    ON  TMP.FULLDATE = CURRENT_BD.AS_OF_DATE\r\n        AND TMP.GAM_ACID = CURRENT_BD.GAM_ACID\r\nLEFT JOIN EDS.DEPOSIT_FACT CURRENT_PBD\r\n    ON  TMP.Previous_Business_Day = CURRENT_PBD.AS_OF_DATE\r\n        AND TMP.GAM_ACID = CURRENT_PBD.GAM_ACID\r\nLEFT JOIN EDS.DEPOSIT_NONPHP_YTD P_RUNNINGBAL\r\n    ON  DATEADD(DD,-1,TMP.FULLDATE) = P_RUNNINGBAL.FULLDATE\r\n        AND TMP.GAM_ACID = P_RUNNINGBAL.GAM_ACID\r\n   "
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
