{
	"name": "Target_Folder_Directory_sample",
	"properties": {
		"description": "Create_Folder_Directory_sample",
		"activities": [
			{
				"name": "OM_VALIDATION",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "\nSELECT\n    OT.SOURCE_CODE,\n    OT.SCHEMA_NAME,\n    OTR.DATA_LAYER,\n    OTR.TASK_NAME,\n    OTD.DEPENDENT_TASK_NAME,\n    CAST(OTR.PROCESS_DATE AS DATE) PROCESS_DATE,\n    OS.STATUS,\n    OTR.START_DATETIME,\n    OTR.END_DATETIME\nFROM\n    OM.OM_TASK_RUN OTR\nLEFT JOIN\n    OM.OM_STATUS OS ON OTR.STATUS_ID = OS.STATUS_ID\nLEFT JOIN\n    OM.OM_TASK_DEPENDENCY OTD ON OTR.TASK_NAME = OTD.TASK_NAME\nLEFT JOIN\n    OM.OM_TASKS OT ON OTR.TASK_NAME = OT.TASK_NAME\nLEFT JOIN\n    EDS.DATE_DIM DD ON OTR.PROCESS_DATE = DD.FULLDATE\nWHERE\n    DD.BUSINESS_DAY_FLAG = 'Y'\n\tAND OTR.PROCESS_DATE IN (SELECT TOP 6 FullDate FROM EDS.DATE_DIM WHERE FULLDATE<CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime) AND BUSINESS_DAY_FLAG = 'Y' ORDER BY FULLDATE DESC )\nORDER BY\n    START_DATETIME DESC, PROCESS_DATE DESC, TASK_NAME;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
