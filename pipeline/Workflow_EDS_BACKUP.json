{
	"name": "Workflow_EDS_BACKUP",
	"properties": {
		"activities": [
			{
				"name": "GetMonth",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT DISTINCT FirstDayOfMonth AS FULLDATE\r\nFROM EDS.DATE_DIM \r\nWHERE FULLDATE > '2023-12-01' \r\n    AND FULLDATE < '2026-06-01' ",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLPool_EDS",
						"type": "DatasetReference",
						"parameters": {
							"table_name": " "
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set Date Range",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetMonth",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_datestoprocess_arr",
					"value": {
						"value": "@activity('GetMonth').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Iterate each date",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "CREATE_TABLE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('v_datestoprocess_arr')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "INSERT",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": "testsqlpool"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"parameters": [
											{
												"name": "DateToProcess ",
												"type": "String",
												"value": {
													"value": "@item().FULLDATE",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "NonQuery",
										"text": "-- DECLARE @MONTH date = @DateToProcess;\r\n\r\nDECLARE @FDM date;\r\nDECLARE @FDNM date;\r\n\r\nSELECT @FDM = FIRSTDAYOFMONTH FROM EDS.DATE_DIM WHERE FULLDATE = @DateToProcess\r\nSELECT @FDNM = FIRSTDAYOFNEXTMONTH FROM EDS.DATE_DIM WHERE FULLDATE = @DateToProcess\r\n\r\nDECLARE @sql nvarchar(max) = '\r\nINSERT INTO [D360].[DEPOSIT_FACT_BU_20260323]\r\nSELECT *\r\nFROM [EDS].[DEPOSIT_FACT]\r\nWHERE AS_OF_DATE >= ''' + CONVERT(varchar(10), @FDM, 120) + '''\r\n    AND AS_OF_DATE < ''' + CONVERT(varchar(10), @FDNM, 120) + '''';\r\n\r\nEXEC sp_executesql @sql;"
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "CREATE_TABLE",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Set Date Range",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "TestSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "IF EXISTS(SELECT table_name FROM INFORMATION_SCHEMA.tables where table_name = 'DEPOSIT_FACT_BU_20260323' and table_schema = 'D360')\r\nBEGIN\r\n   DROP TABLE D360.DEPOSIT_FACT_BU_20260323;\r\nEND;\r\n\r\n\r\nCREATE TABLE D360.DEPOSIT_FACT_BU_20260323\r\nWITH\r\n(\r\n   DISTRIBUTION = ROUND_ROBIN,\r\n   HEAP,\r\n   PARTITION\r\n\t(\r\n\t\t[AS_OF_DATE] RANGE RIGHT FOR VALUES (\r\n        '2023-12-01',\r\n\r\n        -- 2024\r\n        '2024-01-01','2024-02-01','2024-03-01','2024-04-01','2024-05-01','2024-06-01',\r\n        '2024-07-01','2024-08-01','2024-09-01','2024-10-01','2024-11-01','2024-12-01',\r\n\r\n        -- 2025\r\n        '2025-01-01','2025-02-01','2025-03-01','2025-04-01','2025-05-01','2025-06-01',\r\n        '2025-07-01','2025-08-01','2025-09-01','2025-10-01','2025-11-01','2025-12-01',\r\n\r\n        -- 2026\r\n        '2026-01-01','2026-02-01','2026-03-01','2026-04-01','2026-05-01','2026-06-01',\r\n        '2026-07-01','2026-08-01','2026-09-01','2026-10-01','2026-11-01','2026-12-01',\r\n\r\n        -- 2027\r\n        '2027-01-01','2027-02-01','2027-03-01','2027-04-01','2027-05-01','2027-06-01',\r\n        '2027-07-01','2027-08-01','2027-09-01','2027-10-01','2027-11-01','2027-12-01',\r\n\r\n        -- 2028\r\n        '2028-01-01','2028-02-01','2028-03-01','2028-04-01','2028-05-01','2028-06-01',\r\n        '2028-07-01','2028-08-01','2028-09-01','2028-10-01','2028-11-01','2028-12-01',\r\n\r\n        -- 2029\r\n        '2029-01-01','2029-02-01','2029-03-01','2029-04-01','2029-05-01','2029-06-01',\r\n        '2029-07-01','2029-08-01','2029-09-01','2029-10-01','2029-11-01','2029-12-01',\r\n\r\n        -- 2030\r\n        '2030-01-01','2030-02-01','2030-03-01','2030-04-01','2030-05-01','2030-06-01',\r\n        '2030-07-01','2030-08-01','2030-09-01','2030-10-01','2030-11-01','2030-12-01'\r\n        )\r\n\t)\r\n)\r\nAS\r\nSELECT TOP 1 *\r\nFROM EDS.DEPOSIT_FACT\r\nWHERE AS_OF_DATE < '2023-12-01' ;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"TICKET_NO": {
				"type": "string"
			},
