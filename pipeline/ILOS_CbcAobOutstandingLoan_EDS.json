{
	"name": "ILOS_CbcAobOutstandingLoan_EDS",
	"properties": {
		"description": "Sources data from EDS tables",
		"activities": [
			{
				"name": "ILOS_CBCAOBOUTSTANDINGLOAN",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SET_BANK_ID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('\nWITH Rolling_Window AS\n(\n    SELECT \n    fulldate,\n    LastDayOfMonth,\n    LOANS_DATE\n    FROM eds.DATE_DIM\n    INNER JOIN eds.EDS_CTL\n    ON LastDayOfMonth <= LOANS_DATE\n    where business_day_flag=''Y'' and month_end=''Y''\n\t--AND fulldate=''2024-08-30'' --2024-08-30\n    AND fulldate between CAST(''',variables('v_start_date'),''' AS DATE) and CAST(''',variables('v_end_date'),''' AS DATE)\n)\n,all_cif_ytd AS\n(\n\tSELECT\n\t\tCONCAT(CRM_ACCOUNTS.ORGKEY,format(RW.LastDayOfMonth,''MMddyyyy'')) AS Id\n\t\t--,EDF.CUST_ID\n\t\t,CRM_ACCOUNTS.ORGKEY\tAS\tCif\n\t\t,CRM_ACCOUNTS.BANK_ID\n\t\t--,coalesce(ELF.YTD_ADB_CURR_BAL_ORIG,0) AS YTD_ADB_CURR_BAL_ORIG\n        ,coalesce(ELF.YTD_ADB_CURR_BAL_PHP,0) AS YTD_ADB_CURR_BAL_PHP\n\t\t,format(RW.LastDayOfMonth,''MM/dd/yyyy'') Date\n\t\t--,EDF.ACCT_CRNCY_CODE\n\t    ,RW.FullDate\n\t\t,CRM_ACCOUNTS.STRUSERFIELD8\n\tFROM Rolling_Window AS RW\n\tINNER JOIN EDS.CUSTOMER_DIM AS CRM_ACCOUNTS\n\t\tON RW.FullDate BETWEEN CRM_ACCOUNTS.SCD_Start_Date AND CRM_ACCOUNTS.SCD_END_DATE\n\tINNER JOIN EDS.LOAN_FACT ELF\n\t\tON RW.FullDate = ELF.AS_OF_DATE\n\t\tAND ELF.del_flg=''N''\n\t\tAND ELF.GAM_BANK_ID=''',variables('v_bank_id'),'''\n\t\t--AND CRM_ACCOUNTS.ORGKEY = ELF.CIF_ID\n\t\tAND CRM_ACCOUNTS.CORE_CUST_ID = ELF.CUST_ID\n\t\tAND CRM_ACCOUNTS.BANK_ID = ELF.GAM_BANK_ID\n\n\t--WHERE ELF.ACCT_CRNCY_CODE <> ''PHP'' AND CRM_ACCOUNTS.STRUSERFIELD8 IS NOT NULL\n\n\tGROUP BY\n\t\tCONCAT(CRM_ACCOUNTS.ORGKEY,format(RW.LastDayOfMonth,''MMddyyyy''))\n\t\t,CRM_ACCOUNTS.ORGKEY\n\t\t,CRM_ACCOUNTS.BANK_ID \n        ,ELF.YTD_ADB_CURR_BAL_ORIG\n        ,ELF.YTD_ADB_CURR_BAL_PHP\n        ,format(RW.LastDayOfMonth,''MM/dd/yyyy'')\n\t\t--,EDF.ACCT_CRNCY_CODE\n\t\t,RW.FullDate\n\t\t,CRM_ACCOUNTS.STRUSERFIELD8\n),\nfinal_df As (\nSELECT\n\tACY.Id\n\t,ACY.Cif\n\t,SUM(coalesce(ACY.YTD_ADB_CURR_BAL_PHP,0)) AS LoanAdbCurrentYear\n\t,ACY.[Date]\n\t,1 ordr\nFROM all_cif_ytd ACY\nWHERE ACY.STRUSERFIELD8 IS NOT NULL\n\t--AND ACY.Cif IN (''R00021096'',''R00049970'',''R00138547'',''R00333237'',''C00000010'') \ngroup by ACY.Id, ACY.Cif,ACY.[Date]\n\nUNION ALL\n\nSELECT\n\t ''#~#''\n\t,null\n\t,null\n\t,null\n\t,2 ordr\n)\nSELECT\n\t Id\n\t,Cif\n\t,CAST(LoanAdbCurrentYear AS NUMERIC(38,2)) AS LoanAdbCurrentYear\n\t,[Date]\nFROM final_df\nORDER BY ordr,cast([Date] as date) ASC\n')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "SQLPool_EDS",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "-"
						}
					}
