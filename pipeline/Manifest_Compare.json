{
	"name": "Manifest_Compare",
	"properties": {
		"activities": [
			{
				"name": "Get FileName",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT FILENAME FROM D360.MANIFEST_FILE WHERE H = ''D'' AND SUBSTRING(FILENAME,1,9) = ''CBC01_',pipeline().parameters.src_sys,''' AND TABLENAME in (''',replace(pipeline().parameters.tables,'''',''),''') AND  REPLACE(REPLACE(FILENAME,RIGHT(FILENAME,21),''''),LEFT(FILENAME,6),'''') in (',pipeline().parameters.tables,')')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLPool_STG",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "MANIFEST_FILE"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "If Condition2",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get FileName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Get FileName').output.count,0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_not_listed",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('File not listed in Manifest File: ',pipeline().parameters.tables)",
									"type": "Expression"
								},
								"errorCode": "404"
							}
						}
					]
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "If Condition2",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get FileName').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Get Manifest CBC01",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "SFTP_OnPrem",
									"type": "DatasetReference",
									"parameters": {
										"Filepath": {
											"value": "@concat('data360/uat/CBC01/',replace(pipeline().parameters.src_sys,'RIB','EBK'),'/encrypt')",
											"type": "Expression"
										},
										"Filename": {
											"value": "@item().filename",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists"
								],
								"storeSettings": {
									"type": "SftpReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false,
									"disableChunking": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						},
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get Manifest CBC01",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@activity('Get Manifest CBC01').output.exists",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Fail1",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('File not found: ',item().filename)",
												"type": "Expression"
											},
											"errorCode": "404"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Wait2",
										"type": "Wait",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"waitTimeInSeconds": 1
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"src_sys": {
				"type": "string"
			},
			"tables": {
				"type": "string"
			}
		},
		"variables": {
			"CurrentTimestamp": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-05-28T00:39:58Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}