{
	"name": "Workflow_EDS_FMS",
	"properties": {
		"activities": [
			{
				"name": "CHECK PROCESS DATE PARAM",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(pipeline().parameters.startDate,'9999-12-31'),equals(pipeline().parameters.endDate,'9999-12-31'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FALSE",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "SET_START_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "SET_END_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						},
						{
							"name": "SET_START_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_startDate",
								"value": {
									"value": "@pipeline().parameters.startDate",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_endDate",
								"value": {
									"value": "@pipeline().parameters.endDate",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "GET_PROCESS_DATE",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "select fulldate\nfrom \n    eds.eds_ctl ect\ninner join \n    eds.date_dim dd\n    on \n    ect.FMS_Date=dd.previous_business_day and dd.business_day_flag='Y'\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLPool_EDS",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "eds_ctl"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "SET_START_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_startDate",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_endDate",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "DaysToIterate",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "CHECK PROCESS DATE PARAM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Cnt_DaystoIterate",
					"value": {
						"value": "@string(add(div(sub(ticks(variables('V_endDate')),ticks(variables('V_startDate'))),864000000000),1))\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Build Process Date Range",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "DaysToIterate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0,int(variables('Cnt_DaystoIterate')) )",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Append Process Date",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "AppendDays",
								"value": {
									"value": "@string(addDays(\n    variables('V_startDate'), \n    mul(\n        item(),\n       \n            1\n        \n    )\n))",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Iterate Execution of Process Date Range",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Build Process Date Range",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('AppendDays')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "OM_SP_UPDATE_PROCESS_DATE_FMS",
							"type": "SqlPoolStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"sqlPool": {
								"referenceName": "testSQLpool",
								"type": "SqlPoolReference"
							},
							"typeProperties": {
								"storedProcedureName": "[OM].[SP_UPDATE_PROCESS_DATE_FMS]"
							}
						},
						{
							"name": "Send_Email",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "OM_SP_UPDATE_PROCESS_DATE_FMS",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Send_Email",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"src_sys": {
										"value": "@pipeline().parameters.src_sys",
										"type": "Expression"
									},
									"PipelineName": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									},
									"ProcessDate": {
										"value": "@variables('V_startDate')",
										"type": "Expression"
									},
									"RunDateTime": {
										"value": "@addhours(pipeline().TriggerTime,8)",
										"type": "Expression"
									},
									"Eml_Sender": {
										"value": "@pipeline().parameters.eml_sender",
										"type": "Expression"
									},
									"Eml_Recipient": {
										"value": "@pipeline().parameters.eml_subject",
										"type": "Expression"
									},
									"Eml_Subject": {
										"value": "@pipeline().parameters.eml_subject",
										"type": "Expression"
									},
									"EndDateTime": {
										"value": "@addhours(utcNow(),8)",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "All pipelines success",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Send_Email",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						},
						{
							"name": "Pipeline fail",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "All pipelines success",
									"dependencyConditions": [
										"Skipped"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "One or more pipelines failed",
								"errorCode": "2001"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"startDate": {
				"type": "string",
				"defaultValue": "9999-12-31"
			},
			"endDate": {
				"type": "string",
				"defaultValue": "9999-12-31"
			},
			"src_sys": {
				"type": "string",
				"defaultValue": "FMS"
			},
			"eml_sender": {
				"type": "string"
			},
			"eml_recipient": {
				"type": "string"
			},
			"eml_subject": {
				"type": "string"
			}
		},
		"variables": {
			"V_startDate": {
				"type": "String"
			},
			"V_endDate": {
				"type": "String"
			},
			"Cnt_DaystoIterate": {
				"type": "String"
			},
			"AppendDays": {
				"type": "Array"
			},
			"CheckFEstatus": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-08-12T09:51:06Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}