						"PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"RunDate": {
							"value": {
								"value": "@addHours(pipeline().TriggerTime,+8)",
								"type": "Expression"
							},
							"type": "Datetime"
						},
						"SuccessRowCount": {
							"value": null,
							"type": "String"
						},
						"FailedRowCount": {
							"value": null,
							"type": "String"
						},
						"FileName": {
							"value": null,
							"type": "String"
						},
						"StatusDescription": {
							"value": {
								"value": "SUCCESS",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				}
			},
