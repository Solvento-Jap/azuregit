							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"sqlPool": {
					"referenceName": "testSQLpool",
					"type": "SqlPoolReference"
				},
				"typeProperties": {
					"storedProcedureName": "[d360].[StatusExecutionLog]",
					"storedProcedureParameters": {
						"RunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"RunDate": {
							"value": {
								"value": "@pipeline().TriggerTime",
								"type": "Expression"
							},
							"type": "Datetime"
						},
						"SuccessRowCount": {
							"value": null,
							"type": "String"
						},
						"FailedRowCount": {
							"value": null,
							"type": "String"
						},
						"FileName": {
							"value": null,
							"type": "String"
						},
						"StatusDescription": {
							"value": {
								"value": "@concat('FAILED - ',activity('SED').error.message)",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				}
			},
			{
				"name": "SuccessExecutionLog",
				"type": "SqlPoolStoredProcedure",
