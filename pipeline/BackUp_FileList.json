						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"parameters": {
			"src_sys": {
				"type": "string",
				"defaultValue": "CRM"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-09-20T02:08:16Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
