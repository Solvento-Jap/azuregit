{
	"name": "Workflow_EDS_LNS_DAILYTRANDETAIL_No_Manifest",
	"properties": {
		"activities": [
			{
				"name": "DaysToIterate",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "CHECK PROCESS DATE PARAM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Cnt_DaystoIterate",
					"value": {
						"value": "@string(add(div(sub(ticks(pipeline().parameters.endDate),ticks(pipeline().parameters.startDate)),864000000000),1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Build Process Date Range",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "DaysToIterate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0,int(variables('Cnt_DaystoIterate')) )",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "AppendDays",
								"value": {
									"value": "@string(addDays(\n    variables('V_startDate'), \n    mul(\n        item(),\n       \n            1\n        \n    )\n))",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
