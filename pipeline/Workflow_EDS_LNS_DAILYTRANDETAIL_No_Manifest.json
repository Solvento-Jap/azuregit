							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "select fulldate\nfrom \n    eds.eds_ctl ect\ninner join \n    eds.date_dim dd\n    on \n    ect.LOANS_Date=dd.previous_business_day and dd.business_day_flag='Y'\n",
										"type": "Expression"
