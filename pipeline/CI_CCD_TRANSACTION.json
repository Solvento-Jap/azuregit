{
	"name": "CI_CCD_TRANSACTION",
	"properties": {
		"description": "Sources data from EDS tables",
		"activities": [
			{
				"name": "Card Transaction",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI_EDS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "\r\nDECLARE @LATEST_DATE DATE;\r\n\r\nSELECT  @LATEST_DATE = MAX(AS_OF_DATE) FROM EDS.CCD_CBCEXCTDBP;\r\nSELECT \r\nROW_NUMBER() OVER(PARTITION BY RN ORDER BY (SELECT NULL)) TRAN_SK\r\n,TXN_BANK_NBR\r\n,TXN_PDT_NBR\r\n,TXN_ACCT_NBR\r\n,TXN_CARD_NBR\r\n,TXN_BATCH_NBR\r\n,TXN_DMS_CASE_NBR\r\n,TXN_MECH_BANK_NBR\r\n,TXN_MECH_NBR\r\nFROM (\r\nSELECT ROW_NUMBER() OVER(PARTITION BY TXN_ACCT_NBR,TXN_CARD_NBR,TXN_CODE,TXN_POSTING_DTE,TXN_AUTH_CODE,TXN_BATCH_SEQ ORDER BY (SELECT NULL)) RN\r\n,TXN_BANK_NBR\r\n,TXN_PDT_NBR\r\n,TXN_ACCT_NBR\r\n,TXN_CARD_NBR\r\n,TXN_BATCH_NBR\r\n,TXN_DMS_CASE_NBR\r\n,TXN_MECH_BANK_NBR\r\n,TXN_MECH_NBR\r\nFROM EDS.CCD_CBCEXCTDBP\r\nWHERE AS_OF_DATE = @LATEST_DATE\r\n\r\n) A\r\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "SQLPool_EDS",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "-"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ci_csv_gen_v2",
						"type": "DatasetReference",
						"parameters": {
							"Filename": {
								"value": "@variables('Filename')",
