{
	"name": "Workflow_EDS_LNS_SCD_TYPE_2_TEST",
	"properties": {
		"activities": [
			{
				"name": "DaysToIterate",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "SET_END_DATE_PARAM",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "SET_START_DATE_PARAM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Cnt_DaystoIterate",
					"value": {
						"value": "@string(add(div(sub(ticks(pipeline().parameters.endDate),ticks(pipeline().parameters.startDate)),864000000000),1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Build Process Date Range",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "DaysToIterate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0,int(variables('Cnt_DaystoIterate')) )",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "AppendDays",
								"value": {
									"value": "@string(addDays(\n    variables('V_startDate'), \n    mul(\n        item(),\n       \n            1\n        \n    )\n))",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Iterate Execution of Process Date Range",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Build Process Date Range",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('AppendDays')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "Script1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(greater(activity('Script1').output.resultSets[0].rows[0].cnt,0),equals(variables('isError'),0))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Set variable1",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "test",
											"value": {
												"value": "@item()",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Fail1",
										"type": "Fail",
										"dependsOn": [
											{
												"activity": "Set variable1",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"message": "111",
											"errorCode": "111"
										}
									}
								]
							}
						},
						{
							"name": "Script1",
							"type": "Script",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": "testsqlpool"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"parameters": [
											{
												"name": "datetoprocess",
												"type": "Datetime",
												"value": {
													"value": "@item()",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": "SELECT COUNT(1) CNT FROM EDS.DATE_DIM WHERE FULLDATE = @datetoprocess AND Business_Day_Flag = 'Y'"
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Set variable2",
							"type": "SetVariable",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "If Condition1",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "isError",
								"value": 1
							}
						}
					]
				}
			},
			{
				"name": "SET_START_DATE_PARAM",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "V_startDate",
					"value": {
						"value": "@pipeline().parameters.startDate",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SET_END_DATE_PARAM",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "V_endDate",
					"value": {
						"value": "@pipeline().parameters.endDate",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"startDate": {
				"type": "string",
				"defaultValue": "9999-12-31"
			},
			"endDate": {
				"type": "string",
				"defaultValue": "9999-12-31"
			}
		},
		"variables": {
			"Cnt_DaystoIterate": {
				"type": "String"
			},
			"AppendDays": {
				"type": "Array"
			},
			"V_startDate": {
				"type": "String"
			},
			"V_endDate": {
				"type": "String"
			},
			"isError": {
				"type": "Integer",
				"defaultValue": 0
			},
			"test": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-09-23T07:23:43Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}