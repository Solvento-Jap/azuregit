{
	"name": "Workflow_GLD_Manifest_Orchestra",
	"properties": {
		"activities": [
			{
				"name": "CHECK PROCESS DATE PARAM",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(pipeline().parameters.startDate,'9999-12-31'),equals(pipeline().parameters.endDate,'9999-12-31'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FALSE",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "SET_START_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "SET_END_DATE_PARAM",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						},
						{
							"name": "SET_START_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_startDate",
								"value": {
									"value": "@pipeline().parameters.startDate",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE_PARAM",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_endDate",
								"value": {
									"value": "@pipeline().parameters.endDate",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "GET_PROCESS_DATE",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "@concat('select fulldate\nfrom \n    eds.eds_ctl_test ect\ninner join \n    eds.date_dim dd\n    on \n    ect.',pipeline().parameters.src_sys,'_Date=dd.previous_business_day')\n\n\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLPool_EDS",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "EDS_CTL_TEST"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "SET_START_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_startDate",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_endDate",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "DaysToIterate",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "CHECK PROCESS DATE PARAM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Cnt_DaystoIterate",
					"value": {
						"value": "@string(add(div(sub(ticks(variables('V_endDate')),ticks(variables('V_startDate'))),864000000000),1))\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Build Process Date Range",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "DaysToIterate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0,int(variables('Cnt_DaystoIterate')) )",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Append Process Date",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "AppendDays",
								"value": {
									"value": "@string(addDays(\n    variables('V_startDate'), \n    mul(\n        item(),\n       \n            1\n        \n    )\n))",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Iterate Execution of Process Date Range",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Build Process Date Range",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('AppendDays')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
