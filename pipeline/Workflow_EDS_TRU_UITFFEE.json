String\" }, \"sink\": { \"name\": \"NAV_INT_ACCRUED\", \"type\": \"String\" } } , { \"source\": { \"name\": \"FILE_NAME\", \"type\": \"String\" }, \"sink\": { \"name\": \"FILE_NAME\", \"type\": \"String\" } } , { \"source\": { \"name\": \"insert_dttm\", \"type\": \"DateTime\", \"format\": \"yyyyMMddHHmmss\" }, \"sink\": { \"name\": \"insert_dttm\", \"type\": \"DateTime\" } } ] }",
						"HashLog_SQL": "WITH [METRIC_BASE] AS ( SELECT [FILE_NAME] ,[INSERT_DTTM] ,TRY_CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE) AS [DATE] ,TRY_CAST(SUM(CASE WHEN H = 'D' THEN 1 ELSE 0 END) AS NUMERIC(25, 5)) AS TGT_COUNT ,MAX(CASE WHEN H <> 'D' THEN TRY_CAST(REPLACE(H, 'F-', '') AS NUMERIC(25, 5)) END) AS SRC_COUNT FROM [D360].[STG_EDS_TRU_UITFFEE] GROUP BY [FILE_NAME] ,[INSERT_DTTM] ) INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT [FILE_NAME] ,[DATE] ,[INSERT_DTTM] ,[METRIC_NAME] ,[SRC_VALUE] ,[TGT_VALUE] FROM [METRIC_BASE] CROSS APPLY ( SELECT 'COUNT' AS [METRIC_NAME] ,[SRC_COUNT] AS [SRC_VALUE] ,[TGT_COUNT] AS [TGT_VALUE] ) M ",
						"EDS_SQL": "DELETE FROM EDS.TRU_UITFFEE WHERE AS_OF_DATE = CAST('${PROCESS_DATE}' AS DATE) INSERT INTO [EDS].[TRU_UITFFEE] ( AS_OF_DATE ,BRANCH_CODE ,ENTITY_CODE ,NAV_SCHEME ,NAV_DATE ,NAV_NET_ASSETS ,NAV_MGMT_FEES ,NAV_TRUST_FEES ,NAV_ACC_FEES ,NAV_OTHER_FEES ,NET_ASSETS_FINAL ,NET_SCHCLASS ,NET_UNITS_OUTS ,NET_PRFT_LOSS ,NET_RATIO ,NET_APPRE_DEPRE ,NET_EXPENSE ,NET_INCOME ,NET_MARKET_LOSS ,NET_NAV ,NAV_METHOD ,NAV_NET_UNITS_OUTSAMC ,NAV_NET_UNITS_OUTSOMF ,NAV_PROJ_EOD_FLG ,NAV_DEPOSIT_BAL ,NAV_DEF_REVENUE ,NAV_INTERSCH_INVESTMENT ,NAV_AMC_INVESTMENT ,NAV_INT_ACCRUED ,[BNK_CODE] ,[SOURCE_CODE] ,[FILE_NAME] ,[INSERT_DTTM] ) SELECT CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE) AS [AS_OF_DATE] ,BRANCH_CODE ,ENTITY_CODE ,NAV_SCHEME ,NAV_DATE ,NAV_NET_ASSETS ,NAV_MGMT_FEES ,NAV_TRUST_FEES ,NAV_ACC_FEES ,NAV_OTHER_FEES ,NET_ASSETS_FINAL ,NET_SCHCLASS ,NET_UNITS_OUTS ,NET_PRFT_LOSS ,NET_RATIO ,NET_APPRE_DEPRE ,NET_EXPENSE ,NET_INCOME ,NET_MARKET_LOSS ,NET_NAV ,NAV_METHOD ,NAV_NET_UNITS_OUTSAMC ,NAV_NET_UNITS_OUTSOMF ,NAV_PROJ_EOD_FLG ,NAV_DEPOSIT_BAL ,NAV_DEF_REVENUE ,NAV_INTERSCH_INVESTMENT ,NAV_AMC_INVESTMENT ,NAV_INT_ACCRUED ,LEFT(FILE_NAME, 5) AS [BNK_CODE] ,'TRU' AS [SOURCE_CODE] ,[FILE_NAME] ,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS DATETIME) AS INSERT_DTTM FROM [D360].[STG_EDS_TRU_UITFFEE] WHERE [H] = 'D' ",
