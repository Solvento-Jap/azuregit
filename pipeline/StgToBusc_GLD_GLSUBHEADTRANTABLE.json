								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": "SELECT\nSTG.[SOL_ID]\n,convert(date, STG.[BAL_DATE]) as BAL_DATE\n,STG.[GL_SUB_HEAD_CODE]\n,STG.[CRNCY_CODE]\n,STG.[BANK_ID]\n,STG.[DEL_FLG]\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_CASH_DR_PART_TRAN],' ',''),''),0)) as NUM_OF_CASH_DR_PART_TRAN\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_CASH_DR_AMT],' ',''),''),0)) as TOT_CASH_DR_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_CLG_DR_PART_TRAN],' ',''),''),0)) as NUM_OF_CLG_DR_PART_TRAN\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_CLG_DR_AMT],' ',''),''),0)) as TOT_CLG_DR_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_XFER_DR_PART_TRAN],' ',''),''),0)) as NUM_OF_XFER_DR_PART_TRAN\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_XFER_DR_AMT],' ',''),''),0)) as TOT_XFER_DR_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_CASH_CR_PART_TRAN],' ',''),''),0)) as NUM_OF_CASH_CR_PART_TRAN\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_CASH_CR_AMT],' ',''),''),0)) as TOT_CASH_CR_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_CLG_CR_PART_TRAN],' ',''),''),0)) as NUM_OF_CLG_CR_PART_TRAN\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_CLG_CR_AMT],' ',''),''),0)) as TOT_CLG_CR_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_XFER_CR_PART_TRAN],' ',''),''),0)) as NUM_OF_XFER_CR_PART_TRAN\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_XFER_CR_AMT],' ',''),''),0)) as TOT_XFER_CR_AMT\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_DR_BAL],' ',''),''),0)) as TOT_DR_BAL\n,convert(numeric(25,4),ISNULL(NULLIF(REPLACE([TOT_CR_BAL],' ',''),''),0)) as TOT_CR_BAL\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_ACCT_OPN],' ',''),''),0)) as NUM_OF_ACCT_OPN\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([NUM_OF_ACCT_CLS],' ',''),''),0)) as NUM_OF_ACCT_CLS\n,[LCHG_USER_ID]\n,convert(datetime2, stuff(stuff(stuff(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n,[RCRE_USER_ID]\n,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n,convert(numeric(5,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n,convert(date, STG.[END_BAL_DATE]) as END_BAL_DATE\n,1 as isActive\n,1 as isLatest\n,left(FILE_NAME, 5) as [BNK_CODE]\n,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n,[FILE_NAME]\n,convert(date,[insert_dttm]) as insert_dttm\n FROM [BUSC].[GLD_GLSUBHEADTRANTABLE_DELTA] DELTA\n LEFT JOIN [d360].[STG_GLD_GLSUBHEADTRANTABLE] STG ON DELTA.SOL_ID = STG.SOL_ID AND DELTA.BANK_ID = STG.BANK_ID AND DELTA.GL_SUB_HEAD_CODE = STG.GL_SUB_HEAD_CODE AND DELTA.CRNCY_CODE = STG.CRNCY_CODE\n AND DELTA.BAL_DATE = STG.BAL_DATE AND DELTA.END_BAL_DATE = STG.END_BAL_DATE\nWhere H='D'",
