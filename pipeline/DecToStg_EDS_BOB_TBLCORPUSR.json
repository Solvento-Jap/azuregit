									"sqlReaderQuery": "\r\nSELECT\r\nH\r\n,ALERTS_BLOB\r\n,ALERTS_CLOB\r\n,ALT_PSWD\r\n,CASE\r\n    WHEN ISNUMERIC(BDAY) = 1 THEN CAST(BDAY AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(BDAY,'')), '####-##-## ##:##:##')\r\nEND AS BDAY\r\n,CD\r\n,CORP_GRP_ID\r\n,CORP_ID\r\n,COUNTRY_CD\r\n,CASE\r\n    WHEN ISNUMERIC(CREATE_DT) = 1 THEN CAST(CREATE_DT AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(CREATE_DT,'')), '####-##-## ##:##:##')\r\nEND AS CREATE_DT\r\n,CUMM_CNT\r\n,DAYS_BEFORE_PSWD_EXP\r\n,DEL\r\n,EMAIL\r\n,EXTERNAL_REMARKS\r\n,FIRST_NM\r\n,GENERATED_LINK\r\n,ID\r\n,IMAGE\r\n,INTERNAL_REMARKS\r\n,IS_2FA_ENROLLED\r\n,IS_MIGRATED\r\n,IS_PRIMARY\r\n,IS_REGISTERED\r\n,IS_SMS_BINDED\r\n,IS_WITH_MOBILE_APP\r\n,LANDLINE_NO\r\n,CASE\r\n    WHEN ISNUMERIC(LAST_LOGIN_DT) = 1 THEN CAST(LAST_LOGIN_DT AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(LAST_LOGIN_DT,'')), '####-##-## ##:##:##')\r\nEND AS LAST_LOGIN_DT\r\n,LAST_NM\r\n,CASE\r\n    WHEN ISNUMERIC(LAST_PSWD_UPDATE_DT) = 1 THEN CAST(LAST_PSWD_UPDATE_DT AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(LAST_PSWD_UPDATE_DT,'')), '####-##-## ##:##:##')\r\nEND AS LAST_PSWD_UPDATE_DT\r\n,LOGIN_STATUS\r\n,MIDDLE_NM\r\n,MOBILE_NO\r\n,MOTHER_MAIDEN_NM\r\n,NP_CLOB\r\n,OTP_TYPE\r\n,PSWD\r\n,PSWD_EXP_DAYS\r\n,CASE\r\n    WHEN ISNUMERIC(PSWD_EXP_DT) = 1 THEN CAST(PSWD_EXP_DT AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(PSWD_EXP_DT,'')), '####-##-## ##:##:##')\r\nEND AS PSWD_EXP_DT\r\n,REF_NO\r\n,RESEND_GENERATED_LINK\r\n,RETRY_CNT\r\n,ROLE\r\n,SECONDARY_2FA_COUNT\r\n,SERIAL_NO\r\n,SESSION_ID\r\n,SMS_NO\r\n,SSS\r\n,STATUS\r\n,CASE\r\n    WHEN ISNUMERIC(SUSPEND_DT_FROM) = 1 THEN CAST(SUSPEND_DT_FROM AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(SUSPEND_DT_FROM,'')), '####-##-## ##:##:##')\r\nEND AS SUSPEND_DT_FROM\r\n,CASE\r\n    WHEN ISNUMERIC(SUSPEND_DT_TO) = 1 THEN CAST(SUSPEND_DT_TO AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(SUSPEND_DT_TO,'')), '####-##-## ##:##:##')\r\nEND AS SUSPEND_DT_TO\r\n,TIN\r\n,TITLE\r\n,TOKEN_TYPE\r\n,CASE\r\n    WHEN ISNUMERIC(UPDATE_DT) = 1 THEN CAST(UPDATE_DT AS DATE)\r\n    ELSE FORMAT( CONVERT(BIGINT,NULLIF(UPDATE_DT,'')), '####-##-## ##:##:##')\r\nEND AS UPDATE_DT\r\n,VERSION\r\n,WITH_2FA\r\n,FILE_NAME\r\n,insert_dttm\r\nFROM D360.pre_STG_EDS_BOB_TBLCORPUSR",
