															},
															"direction": "Input"
														}
													],
													"type": "Query",
													"text": "DELETE FROM EDS.DEP_TBLDEPAGGRBALANCES WHERE AS_OF_DATE = CAST(@DatetoProcessed AS DATE);\r\n\r\nINSERT INTO EDS.DEP_TBLDEPAGGRBALANCES\r\n(\r\n\t\t\t\t [AS_OF_DATE]\r\n\t\t\t\t,[BANK_ID]\r\n\t\t\t\t,[ACID]\r\n\t\t\t\t,[PREVIOUS_CURRBAL]\r\n\t\t\t\t,[PREVIOUS_CLEARBAL]\r\n\t\t\t\t,[CURRENT_EOD_DATE]\r\n\t\t\t\t,[ACCUMULATED_CURRBAL]\r\n\t\t\t\t,[ACCUMULATED_CLEARBAL]\r\n\t\t\t\t,BNK_CODE\r\n\t\t\t\t,SOURCE_CODE\r\n\t\t\t\t,FILE_NAME\r\n\t\t\t\t,insert_dttm\r\n\r\n)\r\n\r\n\r\nSELECT \r\n\t\t\t\t CONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) AS AS_OF_DATE\r\n\t\t\t\t,[BANK_ID]\r\n\t\t\t\t,[ACID]\r\n\t\t\t\t,[PREVIOUS_CURRBAL]\r\n\t\t\t\t,[PREVIOUS_CLEARBAL]\r\n\t\t\t\t,[CURRENT_EOD_DATE]\r\n\t\t\t\t,[ACCUMULATED_CURRBAL]\r\n\t\t\t\t,[ACCUMULATED_CLEARBAL]\r\n\t\t\t\t,LEFT(FILE_NAME, 5) AS BNK_CODE\r\n\t\t\t\t,SUBSTRING(FILE_NAME,7,3) AS SOURCE_CODE\r\n\t\t\t\t,FILE_NAME\r\n\t\t\t\t,INSERT_DTTM\r\nFROM D360.STG_EDS_DEP_TBLDEPAGGRBALANCES\r\nWHERE H = 'D'\r\n\tAND CAST(LEFT(RIGHT(FILE_NAME, 12), 8 )AS DATE) >= CAST(CURRENT_EOD_DATE AS DATE)\r\n"
												}
											],
