															"type": "Datetime",
															"value": {
																"value": "@substring(item(),0,10)",
																"type": "Expression"
															},
															"direction": "Input"
														}
													],
													"type": "NonQuery",
													"text": "\r\nINSERT INTO EDS.DIGITAL_ENROLLMENTS_FACT\r\n(\r\n     BANK_ID\r\n    ,SOURCE_CODE\r\n    ,CIF_ID\r\n    ,RELATIONSHIPOPENINGDATE\r\n    ,USER_NAME\r\n    ,STATUS\r\n    ,STD_STATUS\r\n    ,STATUS_DATE\r\n    ,ENROLLMENT_DATE\r\n    ,SCD_START_DATE\r\n    ,SCD_END_DATE\r\n    ,INSERT_DTTM\r\n)\r\nSELECT MBK_RTBKCUSTOMERMTB.BNK_CODE AS BANK_ID\r\n\t, MBK_RTBKCUSTOMERMTB.SOURCE_CODE\r\n\t, MBK_RTBKCUSTOMERMTB.CIF_NO AS CIF_ID\r\n\t, CUSTOMER_DIM.RELATIONSHIPOPENINGDATE AS RELATIONSHIPOPENINGDATE\r\n\t, MBK_RTBKCUSTOMERMTB.USER_ID AS USER_NAME\r\n\t, CAST(MBK_RTBKCUSTOMERMTB.STATUS AS CHAR(1)) AS STATUS\r\n\t, ENROLLMENT_STATUS_DIM.STD_STATUS\r\n\t, MBK_RTBKCUSTOMERMTB.STATUS_CHANGE_DT AS STATUS_DATE\r\n\t, MBK_RTBKCUSTOMERMTB.CREATED_DATE AS ENROLLMENT_DATE\r\n\t, MBK_RTBKCUSTOMERMTB.SCD_START_DATE\r\n\t, MBK_RTBKCUSTOMERMTB.SCD_END_DATE\r\n\t, MBK_RTBKCUSTOMERMTB.INSERT_DTTM\r\nFROM EDS.MBK_RTBKCUSTOMERMTB\r\nJOIN EDS.ENROLLMENT_STATUS_DIM\r\nON ENROLLMENT_STATUS_DIM.STATUS_ID = CAST(MBK_RTBKCUSTOMERMTB.STATUS AS CHAR(1))\r\nLEFT JOIN EDS.CUSTOMER_DIM ON MBK_RTBKCUSTOMERMTB.CIF_NO = CUSTOMER_DIM.ORGKEY \r\nAND CUSTOMER_DIM.ISACTIVE = 1 AND CUSTOMER_DIM.ISLATEST = 1 AND CUSTOMER_DIM.BNK_CODE = 'CBC01'\r\nWHERE MBK_RTBKCUSTOMERMTB.BNK_CODE = 'CBC01'\r\nUNION ALL\r\nSELECT RIB_CUSTOMERLOCATION.BANK_ID\r\n\t, RIB_CUSTOMERLOCATION.SOURCE_CODE\r\n\t, RIB_CUSTOMERLOCATION.CUST_ID\r\n\t, CUSTOMER_DIM.RELATIONSHIPOPENINGDATE AS RELATIONSHIPOPENINGDATE\r\n\t, RIB_CUSTOMERLOCATION.CORP_USER\r\n\t, RIB_CUSTOMERLOCATION.DEL_FLG\r\n\t, ENROLLMENT_STATUS_DIM.STD_STATUS\r\n\t, CASE WHEN RIB_CUSTOMERLOCATION.DEL_FLG = 'Y' THEN CAST(RIB_CUSTOMERLOCATION.R_MOD_TIME AS DATE) ELSE CAST(RIB_CUSTOMERLOCATION.R_CRE_TIME AS DATE) END STATUS_DATE\r\n\t, CAST(RIB_CUSTOMERLOCATION.R_CRE_TIME AS DATE) R_CRE_TIME\r\n\t, RIB_CUSTOMERLOCATION.SCD_START_DATE\r\n\t, RIB_CUSTOMERLOCATION.SCD_END_DATE\r\n\t, RIB_CUSTOMERLOCATION.INSERT_DTTM\r\nFROM EDS.RIB_CUSTOMERLOCATION\r\nJOIN EDS.ENROLLMENT_STATUS_DIM\r\nON ENROLLMENT_STATUS_DIM.STATUS_ID = RIB_CUSTOMERLOCATION.DEL_FLG\r\nLEFT JOIN EDS.CUSTOMER_DIM ON RIB_CUSTOMERLOCATION.CUST_ID = CUSTOMER_DIM.ORGKEY \r\nAND CUSTOMER_DIM.ISACTIVE = 1 AND CUSTOMER_DIM.ISLATEST = 1 AND CUSTOMER_DIM.BNK_CODE = 'CBC01'\r\nWHERE RIB_CUSTOMERLOCATION.BANK_ID = 'CBC01'\r\nUNION ALL\r\nSELECT 'CBC01' AS BANK_ID\r\n\t, 'D30' AS SOURCE_CODE\r\n\t, D30_CUSTOMER.CIF_ID\r\n\t, CUSTOMER_DIM.RELATIONSHIPOPENINGDATE AS RELATIONSHIPOPENINGDATE\r\n\t, D30_CUSTOMER.USERNAME\r\n\t, D30_CUSTOMER.STATUS\r\n\t, ENROLLMENT_STATUS_DIM.STD_STATUS\r\n\t, D30_CUSTOMER.ENROLLMENT_DATE\r\n\t, D30_CUSTOMER.ENROLLMENT_DATE\t\r\n\t, NULL SCD_START_DATE\r\n\t, NULL SCD_END_DATE\r\n\t, NULL INSERT_DTTM\r\nFROM EDS.D30_CUSTOMER\r\nJOIN EDS.ENROLLMENT_STATUS_DIM\r\nON ENROLLMENT_STATUS_DIM.STATUS_ID = D30_CUSTOMER.STATUS\r\nLEFT JOIN EDS.CUSTOMER_DIM ON D30_CUSTOMER.CIF_ID = CUSTOMER_DIM.ORGKEY\r\nAND CUSTOMER_DIM.ISACTIVE = 1 AND CUSTOMER_DIM.ISLATEST = 1 AND CUSTOMER_DIM.BNK_CODE = 'CBC01';"
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
