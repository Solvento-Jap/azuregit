\"String\" } }, { \"source\": { \"name\": \"TPS_TRAN_DESC\", \"type\": \"String\" }, \"sink\": { \"name\": \"TPS_TRAN_DESC\", \"type\": \"String\" } }, { \"source\": { \"name\": \"LCHG_TIME\", \"type\": \"String\" }, \"sink\": { \"name\": \"LCHG_TIME\", \"type\": \"String\" } }, { \"source\": { \"name\": \"LCHG_USER_ID\", \"type\": \"String\" }, \"sink\": { \"name\": \"LCHG_USER_ID\", \"type\": \"String\" } }, { \"source\": { \"name\": \"RCRE_TIME\", \"type\": \"String\" }, \"sink\": { \"name\": \"RCRE_TIME\", \"type\": \"String\" } }, { \"source\": { \"name\": \"RCRE_USER_ID\", \"type\": \"String\" }, \"sink\": { \"name\": \"RCRE_USER_ID\", \"type\": \"String\" } }, { \"source\": { \"name\": \"BANK_ID\", \"type\": \"String\" }, \"sink\": { \"name\": \"BANK_ID\", \"type\": \"String\" } }, { \"source\": { \"name\": \"LAST6_ACC_NUM\", \"type\": \"String\" }, \"sink\": { \"name\": \"LAST6_ACC_NUM\", \"type\": \"String\" } }, { \"source\": { \"name\": \"LAST6_ATM_CRD_NUM\", \"type\": \"String\" }, \"sink\": { \"name\": \"LAST6_ATM_CRD_NUM\", \"type\": \"String\" } }, { \"source\": { \"name\": \"ACCOUNT_NUMBER_UNMASKED\", \"type\": \"String\" }, \"sink\": { \"name\": \"ACCOUNT_NUMBER_UNMASKED\", \"type\": \"String\" } }, { \"source\": { \"name\": \"FILE_NAME\", \"type\": \"String\" }, \"sink\": { \"name\": \"FILE_NAME\", \"type\": \"String\" } }, { \"source\": { \"name\": \"insert_dttm\", \"type\": \"String\" }, \"sink\": { \"name\": \"INSERT_DTTM\", \"type\": \"DateTime\" } } ]",
						"HashLog_SQL": "WITH CTE1 AS( SELECT TRY_CAST(COUNT(*) as numeric(25,5)) COUNT_tgt , isnull(sum(TRY_CAST(TRAN_AMT as numeric(25,5))),0) TRAN_AMT_tgt , FILE_NAME, INSERT_DTTM FROM d360.STG_EDS_CBC01_DEP_CUSTOMCHANNELTRANSTABLE WHERE H = 'D' GROUP BY FILE_NAME, INSERT_DTTM ) , CTE2 AS ( SELECT TRY_CAST(REPLACE(H,'F-','') as numeric(25,5)) COUNT_src , TRY_CAST(TRAN_AMT as numeric(25,5))  TRAN_AMT_src , FILE_NAME, INSERT_DTTM FROM d360.STG_EDS_CBC01_DEP_CUSTOMCHANNELTRANSTABLE WHERE H <> 'D' ) , CTE12 as ( SELECT COUNT_SRC, COUNT_TGT , TRAN_AMT_tgt , TRAN_AMT_src , A.FILE_NAME, A.INSERT_DTTM, TRY_CAST((left(right(A.FILE_NAME, 12),8)) as DATE) DATE FROM CTE1 A JOIN CTE2 B ON A.FILE_NAME = B.FILE_NAME AND A.INSERT_DTTM = B.INSERT_DTTM ) INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT FILE_NAME ,DATE ,insert_dttm ,REPLACE(METRICS,'_SRC','') METRICS ,SRC ,TGT FROM ( SELECT TRY_CAST(COUNT_SRC AS NUMERIC(25,5)) COUNT_SRC ,TRY_CAST(COUNT_TGT AS NUMERIC(25,5)) COUNT_TGT ,TRY_CAST(TRAN_AMT_tgt AS NUMERIC(25,5)) TRAN_AMT_tgt ,TRY_CAST(TRAN_AMT_src AS NUMERIC(25,5)) TRAN_AMT_src ,FILE_NAME ,INSERT_DTTM ,[DATE] FROM CTE12 ) pvt UNPIVOT ( SRC FOR METRICS IN (COUNT_SRC , TRAN_AMT_src ) ) pvt1 UNPIVOT ( TGT For METRICS2 IN (COUNT_TGT , TRAN_AMT_tgt ) ) pvt2 WHERE REPLACE(METRICS,'_SRC','') = REPLACE(METRICS2,'_TGT','');",
						"EDS_SQL": "BEGIN TRY DELETE FROM EDS.DEP_CUSTOMCHANNELTRANSTABLE WHERE AS_OF_DATE = (SELECT TOP 1 CONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) FROM D360.STG_EDS_CBC01_DEP_CUSTOMCHANNELTRANSTABLE); INSERT INTO EDS.DEP_CUSTOMCHANNELTRANSTABLE ( AS_OF_DATE ,\t[ACCOUNT_NUMBER] ,\t[TRAN_DATETIME] ,\t[ATM_BANK_ID] ,\t[ATM_TERMINAL_ID] ,\t[COMMAND] ,\t[STAN] ,\t[TRAN_ID] ,\t[TRAN_DATE] ,\t[PARTTRAN_NUM] ,\t[PARTTRAN_IND] ,\t[PARTTRAN_REM] ,\t[PARTTRAN_PART1] ,\t[PARTTRAN_PART2] ,\t[TRAN_AMT] ,\t[SOURCE_APP_CODE] ,\t[ATM_CRD_NUM] ,\t[BILLER_CODE] ,\t[BILR_SUBR_NUM1] ,\t[BILR_SUBR_NUM2] ,\t[FREE_TEXT1] ,\t[FREE_TEXT2] ,\t[FREE_TEXT3] ,\t[FREE_TEXT4] ,\t[FREE_TEXT5] ,\t[TPS_USER] ,\t[TPS_TRANREF] ,\t[TPS_ACCNO] ,\t[TPS_ACCNAME] ,\t[TPS_TRAN_RMKS] ,\t[TPS_TRAN_DESC] ,\t[LCHG_TIME] ,\t[LCHG_USER_ID] ,\t[RCRE_TIME] ,\t[RCRE_USER_ID] ,\t[BANK_ID] ,\t[LAST6_ACC_NUM] ,\t[LAST6_ATM_CRD_NUM] ,\t[ACCOUNT_NUMBER_UNMASKED] ,\tisActive ,\tisLatest ,\tBNK_CODE ,\tSOURCE_CODE ,\tFILE_NAME ,\tinsert_dttm ) SELECT CONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) AS AS_OF_DATE ,\t[ACCOUNT_NUMBER] ,\t[TRAN_DATETIME] ,\t[ATM_BANK_ID] ,\t[ATM_TERMINAL_ID] ,\t[COMMAND] ,\t[STAN] ,\t[TRAN_ID] ,\t[TRAN_DATE] ,\t[PARTTRAN_NUM] ,\t[PARTTRAN_IND] ,\t[PARTTRAN_REM] ,\t[PARTTRAN_PART1] ,\t[PARTTRAN_PART2] ,\t[TRAN_AMT] ,\t[SOURCE_APP_CODE] ,\t[ATM_CRD_NUM] ,\t[BILLER_CODE] ,\t[BILR_SUBR_NUM1] ,\t[BILR_SUBR_NUM2] ,\t[FREE_TEXT1] ,\t[FREE_TEXT2] ,\t[FREE_TEXT3] ,\t[FREE_TEXT4] ,\t[FREE_TEXT5] ,\t[TPS_USER] ,\t[TPS_TRANREF] ,\t[TPS_ACCNO] ,\t[TPS_ACCNAME] ,\t[TPS_TRAN_RMKS] ,\t[TPS_TRAN_DESC] , CAST(STUFF( STUFF( STUFF(LCHG_TIME, 13, 0, ':'), 11, 0, ':'), 9, 0, ' ') AS DATETIME)\t[LCHG_TIME] ,\t[LCHG_USER_ID] ,\t CAST(STUFF( STUFF( STUFF(RCRE_TIME, 13, 0, ':'), 11, 0, ':'), 9, 0, ' ') AS DATETIME) [RCRE_TIME] ,\t[RCRE_USER_ID] ,\t[BANK_ID] ,\t[LAST6_ACC_NUM] ,\t[LAST6_ATM_CRD_NUM] ,\t[ACCOUNT_NUMBER_UNMASKED] ,\t1 as isActive ,\t1 as isLatest ,\tBANK_ID as BNK_CODE ,\t'DEP' as SOURCE_CODE ,\tFILE_NAME ,\tconvert(datetime2,insert_dttm) as insert_dttm FROM D360.STG_EDS_CBC01_DEP_CUSTOMCHANNELTRANSTABLE WHERE H = 'D' AND CAST(LEFT(RIGHT(FILE_NAME , 12), 8) AS DATE)>=CAST(STUFF( STUFF( STUFF(RCRE_TIME, 13, 0, ':'), 11, 0, ':'), 9, 0, ' ') AS DATE); END TRY BEGIN CATCH DECLARE @msg NVARCHAR(2048) = ERROR_MESSAGE(); THROW 51000 ,@msg ,1; END CATCH "
