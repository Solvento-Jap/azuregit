						"ColumnSchema": "[ { \"source\": { \"name\": \"H\", \"type\": \"String\" }, \"sink\": { \"name\": \"H\", \"type\": \"String\" } }, { \"source\": { \"name\": \"ACCOUNT_NUMBER\", \"type\": \"String\" }, \"sink\": { \"name\": \"ACCOUNT_NUMBER\", \"type\": \"String\" } }, { \"source\": { \"name\": \"TRAN_DATETIME\", \"type\": \"String\" }, \"sink\": { \"name\": \"TRAN_DATETIME\", \"type\": \"String\" } }, { \"source\": { \"name\": \"ATM_BANK_ID\", \"type\": \"String\" }, \"sink\": { \"name\": \"ATM_BANK_ID\", \"type\": \"String\" } }, { \"source\": { \"name\": \"ATM_TERMINAL_ID\", \"type\": \"String\" }, \"sink\": { \"name\": \"ATM_TERMINAL_ID\", \"type\": \"String\" } }, { \"source\": { \"name\": \"COMMAND\", \"type\": \"String\" }, \"sink\": { \"name\": \"COMMAND\", \"type\": \"String\" } }, { \"source\": { \"name\": \"STAN\", \"type\": \"String\" }, \"sink\": { \"name\": \"STAN\", \"type\": \"String\" } }, { \"source\": { \"name\": \"TRAN_ID\", \"type\": \"String\" }, \"sink\": { \"name\": \"TRAN_ID\", \"type\": \"String\" } }, { \"source\": { \"name\": \"TRAN_DATE\", \"type\": \"DateTime\", \"format\": \"yyyyMMdd\", \"culture\": \"\" }, \"sink\": { \"name\": \"TRAN_DATE\", \"type\": \"DateTime\" } }, { \"source\": { \"name\": \"PARTTRAN_NUM\", \"type\": \"String\" }, \"sink\": { \"name\": \"PARTTRAN_NUM\", \"type\": \"String\" } }, { \"source\": { \"name\": \"PARTTRAN_IND\", \"type\": \"String\" }, \"sink\": { \"name\": \"PARTTRAN_IND\", \"type\": \"String\" } }, { \"source\": { \"name\": \"PARTTRAN_REM\", \"type\": \"String\" }, \"sink\": { \"name\": \"PARTTRAN_REM\", \"type\": \"String\" } }, { \"source\": { \"name\": \"PARTTRAN_PART1\", \"type\": \"String\" }, \"sink\": { \"name\": \"PARTTRAN_PART1\", \"type\": \"String\" } }, { \"source\": { \"name\": \"PARTTRAN_PART2\", \"type\": \"String\" }, \"sink\": { \"name\": \"PARTTRAN_PART2\", \"type\": \"String\" } }, { \"source\": { \"name\": \"TRAN_AMT\", \"type\": \"Decimal\" }, \"sink\": { \"name\": \"TRAN_AM