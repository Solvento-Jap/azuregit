{
	"name": "ADLS_TO_SFTP_NONTRAN",
	"properties": {
		"activities": [
			{
				"name": "CopyFile",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": "dev/prod_backupall",
							"wildcardFileName": {
								"value": "@concat('*',pipeline().parameters.Month,'*')",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "SftpWriteSettings",
							"copyBehavior": "PreserveHierarchy",
							"operationTimeout": "01:00:00",
							"useTempFileRename": true
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ADLS_prodbackupall",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SFTP_OnPrem_fromADLS",
						"type": "DatasetReference",
						"parameters": {
							"Filepath": "data360/uat",
							"Filename": "(empty, use default)"
						}
					}
				]
			}
		],
		"parameters": {
			"Month": {
				"type": "string",
				"defaultValue": "202309"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-04-12T06:18:28Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}