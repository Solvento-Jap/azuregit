			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "BEGIN TRY     UPDATE TGT     SET         [ISLATEST] = 0,         [SCD_END_DATE] = (             SELECT PREVIOUS_BUSINESS_DAY \t\t\tFROM EDS.DATE_DIM \t\t\tINNER JOIN ( \t\t\t\tSELECT MAX(SCD_START_DATE) MX_DT \t\t\t\tFROM EDS.TRY_LEGALENTITY \t\t\t\t) MX_DT_TBL ON FULLDATE = MX_DT         )     FROM EDS.DID_LEGALENTITYEXCLUSION TGT     LEFT JOIN EDS.TRY_LEGALENTITY SRC         ON TGT.[ID] = SRC.[ID]     WHERE         TGT.ISLATEST = 1         AND HASHBYTES('SHA2_256', CONCAT_WS(             N'|',             ,SRC.[LEGAL_ENTITY]             ,SRC.[ROLES]             ,SRC.[FULL_NAME]             ,SRC.[SHORT_NAME]             ,SRC.[COUNTRY]             ,SRC.[PARENT]             ,SRC.[PARENT_SHORT_NAME]             ,SRC.[COMMENT]             ,SRC.[STATUS]             ,SRC.[EXTERNAL_REF]         )) <> HASHBYTES('SHA2_256', CONCAT_WS(             N'|',             ,TGT.[LEGAL_ENTITY]             ,TGT.[ROLES]             ,TGT.[FULL_NAME]             ,TGT.[SHORT_NAME]             ,TGT.[COUNTRY]             ,TGT.[PARENT]             ,TGT.[PARENT_SHORT_NAME]             ,TGT.[COMMENT]             ,TGT.[STATUS]             ,TGT.[EXTERNAL_REF]         ))          INSERT INTO EDS.DID_LEGALENTITYEXCLUSION (         [ID],         [LEGAL_ENTITY],         [ROLES],         [FULL_NAME],         [SHORT_NAME],         [COUNTRY],         [PARENT],         [PARENT_SHORT_NAME],         [COMMENT],         [STATUS],         [EXTERNAL_REF],         [SCD_START_DATE],         [SCD_END_DATE],         [ISACTIVE],         [ISLATEST],         [BNK_CODE],         [SOURCE_CODE],         [FILE_NAME],         [INSERT_DTTM]     )      SELECT         [ID],         [LEGAL_ENTITY],         [ROLES],         [FULL_NAME],         [SHORT_NAME],         [COUNTRY],         [PARENT],         [PARENT_SHORT_NAME],         [COMMENT],         [STATUS],         [EXTERNAL_REF],         [SCD_START_DATE],         CAST('9999-12-31' AS DATE) AS [SCD_END_DATE],         1 AS [ISACTIVE],         1 AS [ISLATEST],         LEFT(FILE_NAME, 5) AS [BNK_CODE],         'TRU' AS [SOURCE_CODE],         [FILE_NAME],         CURRENT_TIMESTAMP     FROM EDS.TRY_LEGALENTITY SRC     WHERE         [ISLATEST] = 1         AND NOT EXISTS (             SELECT 1             FROM EDS.DID_LEGALENTITYEXCLUSION TGT             WHERE                 TGT.[ID] = SRC.[ID]                 AND TGT.ISLATEST = 1                 AND HASHBYTES('SHA2_256', CONCAT_WS(                     N'|',                     ,SRC.[LEGAL_ENTITY]                     ,SRC.[ROLES]                     ,SRC.[FULL_NAME]                     ,SRC.[SHORT_NAME]                     ,SRC.[COUNTRY]                     ,SRC.[PARENT]                     ,SRC.[PARENT_SHORT_NAME]                     ,SRC.[COMMENT]                     ,SRC.[STATUS]                     ,SRC.[EXTERNAL_REF]                 )) = HASHBYTES('SHA2_256', CONCAT_WS(                     N'|',                     ,TGT.[LEGAL_ENTITY]                     ,TGT.[ROLES]                     ,TGT.[FULL_NAME]                     ,TGT.[SHORT_NAME]                     ,TGT.[COUNTRY]                     ,TGT.[PARENT]                     ,TGT.[PARENT_SHORT_NAME]                     ,TGT.[COMMENT]                     ,TGT.[STATUS]                     ,TGT.[EXTERNAL_REF]                 ))             AND (                 [STATUS] = 'Disabled' OR                 [ROLES] LIKE '%Agent%' OR                 [ROLES] LIKE '%Broker%' OR                 [ROLES] LIKE '%ProcessingOrg%' OR                 [ROLES] LIKE '%MarketPlace%' OR                 [ROLES] LIKE '%Guarantor%' OR                 [ROLES] LIKE '%IPA%' OR                 [ROLES] = 'Issuer' OR                 [FULL_NAME] LIKE 'GROUP-%' OR                 [FULL_NAME] LIKE 'SETTLEMENT BANK%'             )         ) END TRY BEGIN CATCH     DECLARE @msg NVARCHAR(2048) = ERROR_MESSAGE(); \tTHROW         51000 \t\t,@msg \t\t,1; END CATCH;"
			}
