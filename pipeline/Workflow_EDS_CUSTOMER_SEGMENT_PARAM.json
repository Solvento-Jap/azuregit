			"EDS_SQL": {
				"type": "string",
				"defaultValue": "BEGIN TRY UPDATE EDS.CUSTOMER_SEGMENT_PARAM SET [ISLATEST] = 0 ,[SCD_END_DATE] = ( SELECT PREVIOUS_BUSINESS_DAY FROM EDS.DATE_DIM INNER JOIN ( SELECT TOP 1 AS_OF_DATE MX_DT FROM D360.L1_CUSTOMER_SEGMENT_PARAM ) MX_DT_TBL ON FULLDATE = MX_DT ) FROM EDS.CUSTOMER_SEGMENT_PARAM tgt LEFT JOIN D360.L1_CUSTOMER_SEGMENT_PARAM src ON src.[BANK_ID] = tgt.[BANK_ID] AND src.[PARAM_ID] = tgt.[PARAM_ID] WHERE tgt.[ISLATEST] = 1 AND HASHBYTES('SHA2_256', CONCAT_WS(N'|', src.[PARAM_DESC], src.[FROM_VALUE], src.[TO_VALUE])) <> HASHBYTES('SHA2_256', CONCAT_WS(N'|', tgt.[PARAM_DESC], tgt.[FROM_VALUE], tgt.[TO_VALUE])); INSERT INTO EDS.CUSTOMER_SEGMENT_PARAM ( AS_OF_DATE, BANK_ID, PARAM_TYPE, PARAM_ID, PARAM_DESC, FROM_VALUE, TO_VALUE, LAST_UPDATED_DATE, LAST_UPDATE_BY, ISLATEST, ISACTIVE, SCD_START_DATE, SCD_END_DATE ) SELECT DISTINCT AS_OF_DATE, BANK_ID, PARAM_TYPE, PARAM_ID, PARAM_DESC, FROM_VALUE, TO_VALUE, CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS Date) AS LAST_UPDATED_DATE, 'EDS_ETLUSER' AS LAST_UPDATE_BY, 1 AS [ISLATEST], 1 AS [ISACTIVE], AS_OF_DATE AS SCD_START_DATE, CAST('9999-12-31' AS DATE) AS [SCD_END_DATE] FROM D360.L1_CUSTOMER_SEGMENT_PARAM src WHERE NOT EXISTS ( SELECT 1 FROM EDS.CUSTOMER_SEGMENT_PARAM tgt WHERE src.[BANK_ID] = tgt.[BANK_ID] AND src.[PARAM_ID] = tgt.[PARAM_ID] AND HASHBYTES('SHA2_256', CONCAT_WS(N'|', src.[PARAM_DESC], src.[FROM_VALUE], src.[TO_VALUE])) = HASHBYTES('SHA2_256', CONCAT_WS(N'|', tgt.[PARAM_DESC], tgt.[FROM_VALUE], tgt.[TO_VALUE])) AND tgt.[ISLATEST] = 1 ); END TRY BEGIN CATCH DECLARE @msg NVARCHAR(2048) = ERROR_MESSAGE(); THROW 51000 ,@msg ,1; END CATCH "
			}
