									"sourcefile": "TRY_FITRADESUNTGDTRXNS",
									"tables": "TRY_FITRADES_UNTGD",
									"src_sys": "TRY",
									"ColumnSchema": "{\n    \"type\": \"TabularTranslator\",\n    \"mappings\": [\n        { \"source\": { \"name\": \"H\", \"type\": \"String\"}, \"sink\": { \"name\": \"H\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"CIF_ID\", \"type\": \"String\"}, \"sink\": { \"name\": \"CIF_ID\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Counterparty_ID\", \"type\": \"String\"}, \"sink\": { \"name\": \"COUNTERPARTY_ID\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"CounterParty_Name\", \"type\": \"String\"}, \"sink\": { \"name\": \"COUNTERPARTY_NAME\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Product_Description\", \"type\": \"String\"}, \"sink\": { \"name\": \"PRODUCT_DESCRIPTION\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Reference_No\", \"type\": \"String\"}, \"sink\": { \"name\": \"REFERENCE_NO\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Settlement_Date\", \"type\": \"DATE\",\"format\": \"yyyyMMdd\"}, \"sink\": { \"name\": \"SETTLEMENT_DATE\", \"type\": \"DATE\" } },\n        { \"source\": { \"name\": \"Face_Value\", \"type\": \"String\"}, \"sink\": { \"name\": \"FACE_VALUE\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Interest_Rate\", \"type\": \"String\"}, \"sink\": { \"name\": \"INTEREST_RATE\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Maturity_Date\", \"type\": \"DATE\",\"format\": \"yyyyMMdd\"}, \"sink\": { \"name\": \"MATURITY_DATE\", \"type\": \"DATE\" } },\n        { \"source\": { \"name\": \"Next_Coupon_Date\", \"type\": \"DATE\",\"format\": \"yyyyMMdd\"}, \"sink\": { \"name\": \"NEXT_COUPON_DATE\", \"type\": \"DATE\" } },\n        { \"source\": { \"name\": \"Cost_Price\", \"type\": \"String\"}, \"sink\": { \"name\": \"COST_PRICE\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Principal_Amount\", \"type\": \"String\"}, \"sink\": { \"name\": \"PRINCIPAL_AMOUNT\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Market_Price\", \"type\": \"String\"}, \"sink\": { \"name\": \"MARKET_PRICE\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Accrued_Interest\", \"type\": \"String\"}, \"sink\": { \"name\": \"ACCRUED_INTEREST\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Market_Value\", \"type\": \"String\"}, \"sink\": { \"name\": \"MARKET_VALUE\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"Currency\", \"type\": \"String\"}, \"sink\": { \"name\": \"CURRENCY\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"FILE_NAME\", \"type\": \"String\"}, \"sink\": { \"name\": \"FILE_NAME\", \"type\": \"String\" } },\n        { \"source\": { \"name\": \"insert_dttm\", \"type\": \"DateTime\"}, \"sink\": { \"name\": \"insert_dttm\", \"type\": \"DateTime\" } }\n    ]\n}",
									"HashLog_SQL": "WITH [METRIC_BASE] AS (\n    SELECT\n        [FILE_NAME],\n        [INSERT_DTTM],\n        TRY_CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) AS [DATE],\n        TRY_CAST(SUM(CASE WHEN H = 'D' THEN 1 ELSE 0 END) AS NUMERIC(25,5)) AS TGT_COUNT,\n        MAX(CASE WHEN H <> 'D' THEN TRY_CAST(REPLACE(H,'F-','') AS NUMERIC(25,5)) END) AS SRC_COUNT\n    FROM [D360].[STG_EDS_TRY_FITRADES_UNTGD]\n    GROUP BY [FILE_NAME], [INSERT_DTTM]\n)\n \nINSERT INTO [EDS].[EDS_HASH_LOG_TBL]\n(\n    [FILE_NAME],\n    [DATE],\n    [INSERT_DTTM],\n    [METRICS],\n    [SOURCE],\n    [TARGET]\n)\nSELECT\n    [FILE_NAME],\n    [DATE],\n    [INSERT_DTTM],\n    [METRIC_NAME],\n    [SRC_VALUE],\n    [TGT_VALUE]\nFROM [METRIC_BASE]\nCROSS APPLY (\n    SELECT 'COUNT' AS [METRIC_NAME], [SRC_COUNT] AS [SRC_VALUE], [TGT_COUNT] AS [TGT_VALUE]\n) M"
								}
