									"type": "SqlDWSource",
									"sqlReaderQuery": "SELECT\n    STG.[ACID]\n    ,STG.[EOD_DATE]\n    ,STG.[BANK_ID]\n    ,[TRAN_DATE_BAL]\n    ,[TRAN_DATE_TOT_TRAN]\n    ,[VALUE_DATE_BAL]\n    ,[VALUE_DATE_TOT_TRAN]\n    ,STG.[END_EOD_DATE]\n    ,[LCHG_USER_ID]\n    ,convert(datetime2, stuff(stuff(stuff(LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n    ,[RCRE_USER_ID]\n    ,convert(datetime2, stuff(stuff(stuff(RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n    ,convert(numeric(5,0),ISNULL(NULLIF(REPLACE([TS_CNT],' ',''),''),0)) as TS_CNT\n    ,[EAB_CRNCY_CODE]\n    ,1 as isActive\n    ,CASE WHEN STG.[END_EOD_DATE] = 20991231 THEN 1 ELSE 0 END  as isLatest\n    ,left(FILE_NAME, 5) as [BNK_CODE]\n    ,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n    ,[FILE_NAME]\n    ,convert(date,[insert_dttm]) as insert_dttm\nFROM [BUSC].[GLD_EODACCTBALTABLE_DELTA] DELTA\nLEFT JOIN [d360].[STG_GLD_EODACCTBALTABLE] STG \n    ON DELTA.ACID = STG.ACID \n    AND DELTA.BANK_ID = STG.BANK_ID\n    AND DELTA.EOD_DATE = STG.EOD_DATE\n    AND DELTA.END_EOD_DATE = STG.END_EOD_DATE\nWhere H = 'D' AND DELTA.RECORD_STATUS = 'INSERT'",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
