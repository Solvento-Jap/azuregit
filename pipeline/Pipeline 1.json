					{
						"activity": "ATM_ACCOUNT",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"sqlPool": {
					"referenceName": "testSQLpool",
					"type": "SqlPoolReference"
				},
				"typeProperties": {
					"storedProcedureName": "[d360].[StatusExecutionLog]",
					"storedProcedureParameters": {
						"RunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"RunDate": {
							"value": {
								"value": "@pipeline().TriggerTime",
								"type": "Expression"
							},
							"type": "Datetime"
						},
						"SuccessRowCount": {
							"value": {
								"value": "@activity('ATM_ACCOUNT').error.message",
								"type": "Expression"
							},
							"type": "String"
						},
						"FailedRowCount": {
							"value": {
								"value": "@activity('ATM_ACCOUNT').error.message",
								"type": "Expression"
							},
							"type": "String"
						},
						"FileName": {
							"value": null,
							"type": "String"
						},
						"StatusDescription": {
							"value": {
								"value": "@concat('FAILED - ',activity('ATM_ACCOUNT').error.message)",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				}
			},
			{
				"name": "SuccessExecutionLog",
				"type": "SqlPoolStoredProcedure",
				"dependsOn": [
					{
						"activity": "ATM_ACCOUNT",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"sqlPool": {
					"referenceName": "testSQLpool",
					"type": "SqlPoolReference"
				},
				"typeProperties": {
					"storedProcedureName": "[d360].[StatusExecutionLog]",
					"storedProcedureParameters": {
						"RunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"RunDate": {
							"value": {
								"value": "@addHours(pipeline().TriggerTime,+8)",
								"type": "Expression"
							},
							"type": "Datetime"
						},
						"SuccessRowCount": {
							"value": null,
							"type": "String"
						},
						"FailedRowCount": {
							"value": null,
							"type": "String"
						},
						"FileName": {
							"value": null,
							"type": "String"
						},
						"StatusDescription": {
							"value": {
								"value": "SUCCESS",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2022-11-29T01:43:29Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}