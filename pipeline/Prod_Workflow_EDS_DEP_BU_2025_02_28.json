				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "\t\tDECLARE @NEXT_PROCESS_DATE [datetime]\r\n\r\n\t\tSELECT \t\t\r\n\t\t\t@NEXT_PROCESS_DATE=MAX(DD.FULLDATE)\t\t\r\n\t\tFROM \r\n\t\t\tEDS.EDS_CTL EC\r\n\t\tINNER JOIN\r\n\t\t\tEDS.DATE_DIM DD\r\n\t\t\tON\r\n\t\t\tEC.DEPOSITS_DATE=DD.PREVIOUS_BUSINESS_DAY\r\n\t\t\tAND \r\n            DD.business_day_flag = 'Y'\r\n\t\tINNER JOIN\r\n\t\t\tOM.OM_TASK_RUN OTR\r\n\t\t\tON\r\n\t\t\tDD.FULLDATE=OTR.PROCESS_DATE\r\n\t\tINNER JOIN\r\n\t\t\tOM.OM_TASKS OT\r\n\t\t\tON\r\n\t\t\tOT.TASK_NAME=OTR.TASK_NAME\r\n\t\t\tAND OT.SOURCE_CODE='DEP'\r\n\t\t\tAND OT.TASK_NAME = 'TSK_EDS_DEPOSIT_FACT'\r\n\t\tINNER JOIN\r\n\t\t\tOM.OM_STATUS OS\r\n\t\t\tON\r\n\t\t\tOS.STATUS_ID=OTR.STATUS_ID\r\n\t\tWHERE\r\n\t\t\tOS.STATUS='SUCCESSFUL'\r\n\r\n\t\tUPDATE [EDS].[EDS_CTL] SET DEPOSITS_DATE=@NEXT_PROCESS_DATE, DID_DATE=@NEXT_PROCESS_DATE WHERE  @NEXT_PROCESS_DATE IS NOT NULL;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
