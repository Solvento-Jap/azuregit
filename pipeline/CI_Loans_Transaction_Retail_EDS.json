{
	"name": "CI_Loans_Transaction_Retail_EDS",
	"properties": {
		"description": "Sources data from EDS tables",
		"activities": [
			{
				"name": "temp_LNSAAS_CUSTDIM",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Initial set end date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testsqlpool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "IF NOT EXISTS(SELECT TOP 1 * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'D360' AND TABLE_NAME = 'LNS_AAS_CUSTDIM_hash')\r\n    BEGIN\r\n\t\tCREATE TABLE D360.LNS_AAS_CUSTDIM_hash\r\n\t\tWITH\r\n\t\t(\r\n\t\t\tDISTRIBUTION = HASH(ACID)\r\n\t\t\t,HEAP--CLUSTERED COLUMNSTORE INDEX\r\n\t\t)\r\n\t\tAS\r\n\t\tSELECT \r\n\t\t\tAAS.AS_OF_DATE\r\n\t\t\t,AAS.ACID\r\n\t\t\t,AAS.BANK_ID\r\n\t\t\t,CUST.ORGKEY\r\n\t\tFROM EDS.LNS_ACCTAUTHSIGN AAS\r\n\t\tINNER JOIN EDS.CUSTOMER_DIM CUST\r\n\t\t\tON AAS.AS_OF_DATE BETWEEN CUST.SCD_START_DATE AND CUST.SCD_END_DATE\r\n\t\t\tAND AAS.CUST_ID = CUST.CORE_CUST_ID\r\n\t\t\tAND CUSTOMER_TYPE = 'Retail'\r\n\t\tWHERE AAS.DEL_FLG <> 'Y'\r\n    END\r\n\r\nELSE\r\n    BEGIN\r\n        TRUNCATE TABLE D360.LNS_AAS_CUSTDIM_hash;\r\n\r\n        INSERT INTO D360.LNS_AAS_CUSTDIM_hash (AS_OF_DATE,ACID,BANK_ID,ORGKEY)\r\n        SELECT \r\n             AAS.AS_OF_DATE\r\n            ,AAS.ACID\r\n            ,AAS.BANK_ID\r\n            ,CUST.ORGKEY\r\n        FROM EDS.LNS_ACCTAUTHSIGN AAS\r\n        INNER JOIN EDS.CUSTOMER_DIM CUST\r\n            ON AAS.AS_OF_DATE BETWEEN CUST.SCD_START_DATE AND CUST.SCD_END_DATE\r\n            AND AAS.CUST_ID = CUST.CORE_CUST_ID\r\n            AND CUSTOMER_TYPE = 'Retail'\r\n        WHERE AAS.DEL_FLG <> 'Y';\r\n    END"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "truncate_STG_table",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "temp_LNSAAS_CUSTDIM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testsqlpool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "\r\nIF NOT EXISTS(SELECT TOP 1 * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'D360' AND TABLE_NAME = 'LNS_HISTTRANDTLTABLE_CI_LOAD')\r\n   CREATE TABLE [d360].[LNS_HISTTRANDTLTABLE_CI_LOAD]\r\n( \r\n\t[ACID] [varchar](30)  NULL,\r\n\t[TRANSACTION_ID] [varchar](9)  NULL,\r\n\t[TRANSACTION_SERIAL_NUMBER] [varchar](4)  NULL,\r\n\t[TRANSACTION_DATE] [date]  NULL,\r\n\t[TRANSACTION_CURRENCY_CODE] [varchar](3)  NULL,\r\n\t[TRANSACTION_AMOUNT] [numeric](20,4)  NULL,\r\n\t[TRANSACTION_AMOUNT_PHP] [numeric](20,4)  NULL,\r\n\t[INITIALIZING_BRANCH_CODE] [varchar](8)  NULL,\r\n\t[TRANSACTION_TYPE] [char](1)  NULL,\r\n\t[BRANCH_CODE] [varchar](8)  NULL,\r\n\t[SOURCE_CODE] [varchar](20)  NULL,\r\n\t[TRANSACTION_PARTICULAR] [varchar](50)  NULL,\r\n\t[TRANSACTION_REMARKS] [varchar](30)  NULL,\r\n\t[CHANGED_TIME] [datetime2](7)  NULL,\r\n\t[CREATED_TIME] [datetime2](7)  NULL,\r\n\t[POSTED_DATE] [datetime2](7)  NULL,\r\n\t[BANK_ID] [varchar](8)  NULL,\r\n\t[FCBSCIF] [varchar](50)  NULL,\r\n\t[SK] [bigint] IDENTITY \r\n)\r\nWITH\r\n(\r\n\tDISTRIBUTION = ROUND_ROBIN,\r\n\tHEAP\r\n);\r\n\r\nTRUNCATE TABLE [d360].[LNS_HISTTRANDTLTABLE_CI_LOAD];\r\n\r\n"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Until1",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Initial set currdate variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(formatDateTime(variables('curr_date')),formatDateTime(variables('end_date')) )",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "add month",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Load_process",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": "testsqlpool"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"parameters": [
											{
												"name": "curr_date",
												"type": "Datetime",
												"value": {
													"value": "@variables('curr_date')",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": "select dateadd(mm,1,@curr_date) months"
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Set curr date",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "add month",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "curr_date",
								"value": {
									"value": "@activity('add month').output.resultSets[0].rows[0]['months']",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Wait1",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Set curr date",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
