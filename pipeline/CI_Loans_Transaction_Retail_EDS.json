								"waitTimeInSeconds": 5
							}
						},
						{
							"name": "Load_process",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": "testsqlpool"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"parameters": [
											{
												"name": "curr_date",
												"type": "Datetime",
												"value": {
													"value": "@variables('curr_date')",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": "\r\nINSERT INTO [d360].[LNS_HISTTRANDTLTABLE_CI_LOAD] (ACID,TRANSACTION_ID,TRANSACTION_SERIAL_NUMBER,TRANSACTION_DATE,TRANSACTION_CURRENCY_CODE,TRANSACTION_AMOUNT,TRANSACTION_AMOUNT_PHP,INITIALIZING_BRANCH_CODE,TRANSACTION_TYPE,BRANCH_CODE,SOURCE_CODE,TRANSACTION_PARTICULAR,TRANSACTION_REMARKS,CHANGED_TIME,CREATED_TIME,POSTED_DATE,BANK_ID,FCBSCIF)\r\n\r\nSELECT\r\n     HTD.ACID\r\n    ,HTD.TRAN_ID\r\n    ,HTD.PART_TRAN_SRL_NUM\r\n    ,HTD.TRAN_DATE\r\n    ,HTD.TRAN_CRNCY_CODE\r\n    ,HTD.TRAN_AMT\r\n    ,HTD.TRANSACTION_AMOUNT_PHP \r\n    ,HTD.DTH_INIT_SOL_ID\r\n    ,HTD.PART_TRAN_TYPE\r\n    ,HTD.SOL_ID\r\n    ,HTD.SOURCE_CODE\r\n    ,HTD.TRAN_PARTICULAR\r\n    ,HTD.TRAN_RMKS\r\n    ,HTD.LCHG_TIME\r\n    ,HTD.RCRE_TIME\r\n    ,HTD.PSTD_DATE\r\n    ,HTD.BANK_ID\r\n    ,DAC.ORGKEY AS FCBSCIF\r\n    FROM (\r\n        SELECT\r\n         HTD.ACID\r\n        ,HTD.TRAN_ID\r\n        ,HTD.PART_TRAN_SRL_NUM\r\n        ,HTD.TRAN_DATE\r\n        ,HTD.TRAN_CRNCY_CODE\r\n        ,HTD.TRAN_AMT\r\n        ,CASE WHEN HTD.TRAN_CRNCY_CODE = 'PHP' THEN HTD.TRAN_AMT \r\n            ELSE HTD.TRAN_AMT * CC.ConversionRate END AS TRANSACTION_AMOUNT_PHP\r\n        ,HTD.DTH_INIT_SOL_ID\r\n        ,HTD.PART_TRAN_TYPE\r\n        ,HTD.SOL_ID\r\n        ,HTD.SOURCE_CODE\r\n        ,HTD.TRAN_PARTICULAR\r\n        ,HTD.TRAN_RMKS\r\n        ,HTD.LCHG_TIME\r\n        ,HTD.RCRE_TIME\r\n        ,HTD.PSTD_DATE\r\n        ,HTD.BANK_ID\r\n        ,ROW_NUMBER() OVER(PARTITION BY HTD.ACID, HTD.TRAN_ID, HTD.PART_TRAN_SRL_NUM, HTD.TRAN_DATE  ORDER BY HTD.[FILE_NAME] DESC, HTD.INSERT_DTTM DESC ) RN\r\n        FROM [EDS].[LNS_HISTTRANDTL] HTD\r\n        LEFT JOIN  (SELECT * FROM bnkm.CurrencyConversion where ConvertToCurrencyId = 'PHP' AND RateId = 'REV') CC\r\n            ON HTD.BANK_ID = CC.FinancialInstitutionId\r\n            AND HTD.TRAN_CRNCY_CODE = CC.ConvertFromCurrencyId\r\n            AND HTD.TRAN_DATE = CC.CurrencyConversionTimestamp\r\n        WHERE BANK_ID = 'CBC01' AND DEL_FLG <> 'Y'\r\n        AND concat(right('0000'+convert(varchar,year(tran_date)),4), right('00'+convert(varchar,month(tran_date)),2) ) = concat(right('0000'+convert(varchar,year(@curr_date)),4), right('00'+convert(varchar,month(@curr_date)),2) )\r\n    ) HTD\r\nJOIN D360.LNS_AAS_CUSTDIM_hash DAC\r\n    ON HTD.ACID = DAC.ACID\r\n    AND HTD.TRAN_DATE = DAC.AS_OF_DATE\r\n    AND HTD.BANK_ID = DAC.BANK_ID\r\nWHERE HTD.RN = 1"
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
