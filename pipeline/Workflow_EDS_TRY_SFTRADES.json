			"HashLog_SQL": {
				"type": "string",
				"defaultValue": "WITH [METRIC_BASE] AS (     SELECT         [FILE_NAME],         [INSERT_DTTM],         TRY_CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) AS [DATE],         TRY_CAST(SUM(CASE WHEN H = 'D' THEN 1 ELSE 0 END) AS NUMERIC(25,5)) AS TGT_COUNT,         MAX(CASE WHEN H <> 'D' THEN TRY_CAST(REPLACE(H,'F-','') AS NUMERIC(25,5)) END) AS SRC_COUNT     FROM [D360].[STG_EDS_TRY_SFTRADES]     GROUP BY [FILE_NAME], [INSERT_DTTM] )   INSERT INTO [EDS].[EDS_HASH_LOG_TBL] (     [FILE_NAME],     [DATE],     [INSERT_DTTM],     [METRICS],     [SOURCE],     [TARGET] ) SELECT     [FILE_NAME],     [DATE],     [INSERT_DTTM],     [METRIC_NAME],     [SRC_VALUE],     [TGT_VALUE] FROM [METRIC_BASE] CROSS APPLY (     SELECT 'COUNT' AS [METRIC_NAME], [SRC_COUNT] AS [SRC_VALUE], [TGT_COUNT] AS [TGT_VALUE] ) M"
			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "DELETE FROM EDS.TRY_SFTRADES WHERE AS_OF_DATE IN (SELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) FROM D360.STG_EDS_TRY_SFTRADES)  INSERT INTO [EDS].[TRY_SFTRADES] (     [CIF_ID],     [COUNTERPARTY_ID],     [COUNTERPARTY_FULL_NAME],     [TRADE_DATE],     [MATURITY_DATE],     [CBCSOAREFNO],     [PRODUCT_TYPE],     [TRADE_ID],     [CBCSOAPRINCIPALCURRENCY],     [CBCSOAPRINCIPAL],     [CBCSOARATE],     [WEALTH_TAGGING],     [ASSIGNED_RM], \t[AS_OF_DATE], \t[BNK_CODE], \t[SOURCE_CODE], \t[FILE_NAME], \t[insert_dttm] )  SELECT     [CIF_ID],     [COUNTERPARTY_ID],     [COUNTERPARTY_FULL_NAME],     [TRADE_DATE],     [MATURITY_DATE],     [CBCSOAREFNO],     [PRODUCT_TYPE],     [TRADE_ID],     [CBCSOAPRINCIPALCURRENCY],     [CBCSOAPRINCIPAL],     [CBCSOARATE],     [WEALTH_TAGGING],     [ASSIGNED_RM], \tCAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE) [AS_OF_DATE], \tLEFT(FILE_NAME,5) [BNK_CODE], \t'TRY', \t[FILE_NAME], \tCURRENT_TIMESTAMP FROM [D360].[STG_EDS_TRY_SFTRADES] WHERE [H] = 'D'"
			},
