				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT CONVERT(VARCHAR,FULLDATE) FULLDATE FROM EDS.DATE_DIM EDD\r\nWHERE EDD.MONTH_END = 'Y' AND EDD.YEAR IN (2024,2025) AND FULLDATE <='2025-04-30' ORDER BY 1\r\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
