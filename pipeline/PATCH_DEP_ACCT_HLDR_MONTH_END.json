									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": "testsqlpool"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"parameters": [
											{
												"name": "datetoprocess",
												"type": "String",
												"value": {
													"value": "@variables('v_datestoprocess')",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "NonQuery",
										"text": "WITH DEPOSIT_FACT AS (\r\n    SELECT * FROM EDS.DEPOSIT_FACT WHERE AS_OF_DATE = CAST(@Datetoprocess AS DATE)\r\n)\r\n\r\n\r\nUPDATE DAH\r\nSET\r\n MTD_AGG_BAL_ORIG_CURR = EDF.MTD_AGG_BAL_ORIG_CURR\r\n,MTD_AGG_BAL_PHP = EDF.MTD_AGG_BAL_PHP\r\n,MTD_ADB_ORIG_CURR = EDF.MTD_ADB_ORIG_CURR\r\n,MTD_ADB_PHP = EDF.MTD_ADB_PHP\r\n,ACCUMULATED_CURRBAL_PHP = EDF.ACCUMULATED_CURRBAL_PHP\r\n,YEAR_TO_DATE_AVERAGE_DAILY_BALANCE = EDF.YEAR_TO_DATE_AVERAGE_DAILY_BALANCE\r\n,YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP = EDF.YEAR_TO_DATE_AVERAGE_DAILY_BALANCE_PHP\r\nFROM EDS.DEPOSITS_ACCOUNT_HOLDER DAH\r\nLEFT JOIN DEPOSIT_FACT EDF\r\n    ON DAH.GAM_ACID = EDF.GAM_ACID\r\n    AND DAH.GAM_BANK_ID = EDF.GAM_BANK_ID\r\n    AND DAH.AAS_AS_OF_DATE = EDF.AS_OF_DATE\r\nWHERE DAH.AAS_AS_OF_DATE = CAST(@Datetoprocess AS DATE)"
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"variables": {
