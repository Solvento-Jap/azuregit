{
	"name": "Send_Email_20250305",
	"properties": {
		"activities": [
			{
				"name": "Get Error List",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@concat('select \noted.* \nfrom \nom.om_task_error_dtl oted\nleft join\nom.om_tasks ot\non\noted.task_name=ot.task_name\nwhere \not.source_code=''',pipeline().parameters.src_sys,''' \nand oted.data_layer in (',pipeline().parameters.data_layer,') \nand oted.process_date=''',pipeline().parameters.process_date,'''  \nand oted.create_datetime >= ''',pipeline().parameters.run_datetime,'''\norder by oted.create_datetime desc')",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Set Error List",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get Error List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "error_list",
					"value": {
						"value": "@concat('Lis of Job execution errors: ', activity('Get Error List').output.resultSets)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"src_sys": {
				"type": "string",
				"defaultValue": "DEP"
			},
			"process_date": {
				"type": "string",
				"defaultValue": "2025-01-08"
			},
			"data_layer": {
				"type": "string",
				"defaultValue": "'EDS','EDS_STG'"
			},
			"run_datetime": {
				"type": "string",
				"defaultValue": "2024-01-08"
			}
		},
		"variables": {
			"error_list": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-03-04T23:19:23Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}