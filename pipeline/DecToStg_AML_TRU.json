{
	"name": "DecToStg_AML_TRU",
	"properties": {
		"description": "AML DecToStg pipeline for TRU; covers 1 approved manifest table(s).",
		"activities": [
			{
				"name": "Require_Approved_Execution",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.ExecutionMode, 'ApprovedDateSliceReload')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Unapproved_Execution",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "ExecutionMode must be ApprovedDateSliceReload.",
								"errorCode": "AML_EXECUTION_NOT_APPROVED"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Execution_Approved",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			},
			{
				"name": "Require_Valid_MissingFilePolicy",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Require_Approved_Execution",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(pipeline().parameters.MissingFilePolicy, 'Fail'), equals(pipeline().parameters.MissingFilePolicy, 'Skip'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Invalid_MissingFilePolicy",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "MissingFilePolicy must be Fail or Skip.",
								"errorCode": "AML_INVALID_MISSING_FILE_POLICY"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "MissingFilePolicy_Valid",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			},
			{
				"name": "GetFile_TRU_TRANSACTIONS",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Require_Valid_MissingFilePolicy",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "decrypt_csv_AML",
						"type": "DatasetReference",
						"parameters": {
							"Filename": {
								"value": "@concat('*TRUCBC_TXN_', pipeline().parameters.DateToProcess, '*')",
								"type": "Expression"
							},
							"SourceCode": "dev/decrypted/TRU",
							"ColumnDelimiter": ",",
							"FirstRowAsHeader": true,
							"RowDelimiter": "\r\n",
							"EncodingName": "UTF-8"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "RequireFileOrSkip_TRU_TRANSACTIONS",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "GetFile_TRU_TRANSACTIONS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(not(empty(activity('GetFile_TRU_TRANSACTIONS').output.childItems)), equals(pipeline().parameters.MissingFilePolicy, 'Skip'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_TRU_TRANSACTIONS_MissingFile",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "No source file matched @concat('*TRUCBC_TXN_', pipeline().parameters.DateToProcess, '*') under dev/decrypted/TRU, and MissingFilePolicy is Fail.",
								"errorCode": "AML_SOURCE_FILE_MISSING"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Accept_TRU_TRANSACTIONS_FilePolicy",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			},
			{
				"name": "IfFile_TRU_TRANSACTIONS",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "RequireFileOrSkip_TRU_TRANSACTIONS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(empty(activity('GetFile_TRU_TRANSACTIONS').output.childItems))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Skip_TRU_TRANSACTIONS_NoFile",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					],
