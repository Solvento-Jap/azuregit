								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": "SELECT \n    convert(date,GRH.RTLIST_DATE) AS RTLIST_DATE\n\t,GRH.RTLIST_NUM\n    ,GRH.FXD_CRNCY_CODE\n    ,GRH.VAR_CRNCY_CODE\n\t,GRH.RATECODE\n    ,GRH.BANK_ID\t\n\t,NULL AS SRL_NUM\n\t,GRH.DEL_FLG\n    ,convert(numeric(21,10),ISNULL(NULLIF(REPLACE(GRH.FXD_CRNCY_UNITS,' ',''),''),0)) AS FXD_CRNCY_UNITS\n    ,convert(numeric(21,10),ISNULL(NULLIF(REPLACE(GRH.VAR_CRNCY_UNITS,' ',''),''),0)) AS VAR_CRNCY_UNITS\n    ,GRH.LCHG_USER_ID\n    ,convert(datetime2, stuff(stuff(stuff(GRH.LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n    ,GRH.RCRE_USER_ID\n    ,convert(datetime2, stuff(stuff(stuff(GRH.RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n\t,NULL AS CUST_VAR_CRNCY_UNITS\n\t,NULL AS TS_CNT\n\t,convert(numeric(20,4),ISNULL(NULLIF(REPLACE(NULL,' ',''),''),0)) AS LOW_SLAB_AMT\n\t,convert(numeric(20,4),ISNULL(NULLIF(REPLACE(NULL,' ',''),''),0)) AS HIGH_SLAB_AMT\n\t,NULL AS SLAB_CRNCY_CODE\n\t,1 as isActive\n\t,1 as isLatest\n\t,left(FILE_NAME, 5) as [BNK_CODE]\n\t,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n\t,[FILE_NAME]\n\t,convert(date,[insert_dttm]) as insert_dttm\nFROM BUSC.GLD_RATELIST_HIST_TABLE_DELTA GRHD\nLEFT JOIN d360.STG_GLD_RATELIST_HIST_TABLE GRH\n    ON GRHD.RTLIST_DATE = GRH.RTLIST_DATE\n    AND GRHD.RTLIST_NUM = GRH.RTLIST_NUM\n    AND GRHD.FXD_CRNCY_CODE = GRH.FXD_CRNCY_CODE\n    AND GRHD.VAR_CRNCY_CODE = GRH.VAR_CRNCY_CODE\n    AND GRHD.RATECODE = GRH.RATECODE\n    AND GRHD.BANK_ID = GRH.BANK_ID\nWHERE H = 'D'",
									"queryTimeout": "02:00:00",
