			"HashLog_SQL": {
				"type": "string",
				"defaultValue": "WITH CTE1 AS (     SELECT         TRY_CAST(COUNT(*) AS NUMERIC(25, 5)) COUNT_tgt          ,FILE_NAME         ,INSERT_DTTM     FROM D360.CAI.LEADS_CBCWEBSITE     WHERE H = 'D'     GROUP BY          FILE_NAME         ,INSERT_DTTM ), CTE2 AS (     SELECT         TRY_CAST(REPLACE(H, 'F-', '') AS NUMERIC(25, 5)) COUNT_src,          ,FILE_NAME         ,INSERT_DTTM     FROM D360.CAI.LEADS_CBCWEBSITE     WHERE H <> 'D' ), CTE12 AS (     SELECT         COUNT_SRC         ,COUNT_TGT          ,A.FILE_NAME         ,A.INSERT_DTTM         ,TRY_CAST((left(right(A.FILE_NAME, 12), 8)) AS DATE) DATE     FROM CTE1 A     JOIN CTE2 B ON A.FILE_NAME = B.FILE_NAME     AND A.INSERT_DTTM = B.INSERT_DTTM ) INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT     FILE_NAME     ,DATE     ,INSERT_DTTM     ,REPLACE(METRICS, '_SRC', '') METRICS     ,SRC     ,TGT FROM (     SELECT         TRY_CAST(COUNT_SRC AS NUMERIC(25, 5)) COUNT_SRC         ,TRY_CAST(COUNT_TGT AS NUMERIC(25, 5)) COUNT_TGT          ,FILE_NAME         ,INSERT_DTTM         ,[DATE]     FROM CTE12 ) pvt UNPIVOT(     SRC FOR METRICS IN(         COUNT_SRC      ) ) pvt1 UNPIVOT(     SRC FOR METRICS2 IN(         COUNT_TGT      ) ) pvt2 WHERE REPLACE(METRICS, '_SRC', '') = REPLACE(METRICS2, '_TGT', '');"
			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "DELETE FROM EDS.CAI_LEADS_CBCWEBSITE WHERE AS_OF_DATE IN (SELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) FROM D360.STG_EDS_CAI_LEADS_CBCWEBSITE)  INSERT INTO [EDS].[CAI_LEADS_CBCWEBSITE] (     [REQUESTED DETAILS],     [FIRST NAME],     [LAST NAME],     [LEAD SOURCE],     [LEAD TYPE],     [MOBILE PHONE],     [MODE],     [SOL ID],     [PRODUCT CODE],     [PRODUCT NAME],     [EMAIL ADDRESS],     [LEAD ID],     [LEAD CREATION TIME],     [PREFERRED BRANCH],     [PRODUCT TAG] )  SELECT     [REQUESTED DETAILS],     [FIRST NAME],     [LAST NAME],     [LEAD SOURCE],     [LEAD TYPE],     [MOBILE PHONE],     [MODE],     [SOL ID],     [PRODUCT CODE],     [PRODUCT NAME],     [EMAIL ADDRESS],     [LEAD ID],     [LEAD CREATION TIME],     [PREFERRED BRANCH],     [PRODUCT TAG] FROM [D360].[STG_EDS_CAI_LEADS_CBCWEBSITE] WHERE [H] = 'D'"
