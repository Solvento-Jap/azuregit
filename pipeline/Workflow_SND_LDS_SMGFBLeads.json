			"SND_SQL": {
				"type": "string",
				"defaultValue": "DELETE FROM EDS.LDS_SMGFBLEADS WHERE AS_OF_DATE IN (     SELECT TOP 1            CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE)     FROM D360.STG_SND_LDS_SMGFBLEADS );  INSERT INTO EDS.LDS_SMGFBLEADS (       AS_OF_DATE     , [ID]     , [Created]     , [Name]     , [Email]     , [Source]     , [Form]     , [Channel]     , [Stage]     , [Owner]     , [Labels]     , [Phone]     , [Matched_email]     , [Matched_phone]     , [Matched_at_least_1]     , [Secondary_phone_number]     , [Whatsapp_number]     , [Which_of_the_following_chinabank_products_are_you_interested_in?]     , [When_is_the_best_time_to_call_you?]     , [Employment_status]     , [City]     , [Job_title]     , [Company_name]     , BNK_CODE     , SOURCE_CODE     , FILE_NAME     , insert_dttm ) SELECT       CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE) AS AS_OF_DATE     , [ID]     , [Created]     , [Name]     , [Email]     , [Source]     , [Form]     , [Channel]     , [Stage]     , [Owner]     , [Labels]     , [Phone]     , [Matched_email]     , [Matched_phone]     , [Matched_at_least_1]     , [Secondary_phone_number]     , [Whatsapp_number]     , [Which_of_the_following_chinabank_products_are_you_interested_in?]     , [When_is_the_best_time_to_call_you?]     , [Employment_status]     , [City]     , [Job_title]     , [Company_name]     , LEFT(FILE_NAME, 5) AS BNK_CODE     , 'LDS' AS SOURCE_CODE     , FILE_NAME     , insert_dttm FROM D360.STG_SND_LDS_SMGFBLEADS"
