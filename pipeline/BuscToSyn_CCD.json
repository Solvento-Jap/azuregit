						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT DISTINCT\r\nCUST_NBR\r\n,ISNULL(CUST_CIF_NBR,'') AS CUST_CIF_NBR\r\n,CUST_LOCAL_NAME\r\n,CUST_ENG_NAME\r\n,CUST_ADDR1\r\n,CUST_ADDR2\r\n,CUST_ADD_CITY\r\n,CUST_ADD_PROVINCE\r\n,CUST_ADD_ZIPCODE\r\n,CUST_PHONE\r\n,LEFT(CONVERT(VARCHAR,CUST_DTE_BIRTH),6) AS CUST_DTE_BIRTH\r\n,CUST_MADDR1\r\n,CUST_MADDR2\r\n,CUST_MADD_CITY\r\n,CUST_MADD_PROVINCE\r\n,CUST_MADD_ZIPCODE\r\n,CUST_CNAME\r\n,CUST_CPHONE\r\n,CUST_ADDR3\r\n,CUST_ADDR4\r\n,CUST_MADDR3\r\n,CUST_MADDR4\r\n,CUST_EMAIL_ADDR\r\n,CUST_MOBILE_PHONE\r\n,CUST_FIRST_NAME\r\n,CUST_MIDDLE_NAME\r\n,CUST_LAST_NAME\r\n,CUST_EMAIL_ADDR2\r\n,CUST_EMAIL_ADDR3\r\n,CUST_PHONE_CTY\r\n,CUST_PHONE_AREA\r\n,CUST_MOBILE_CTY\r\n,CUST_MOBILE_AREA\r\n,CUST_OFFICE_CTY\r\n,CUST_OFFICE_AREA\r\n,CUST_TITLE\r\n,CUST_DATE_MAINT\r\n,BNK_CODE AS BANK_CODE\r\n,SOURCE_CODE\r\n,NULL AS TABLE_NAME\r\n,FILE_NAME\r\n,insert_dttm\r\nFROM BUSC.CCD_DCUSTOMER A\r\nLEFT JOIN (SELECT CRDACCT_CUST_NBR,CRDACCT_APPL_SRC_CODE FROM BUSC.CCD_CBCEXCACCP WHERE ISLATEST = 1 ) B ON A.CUST_NBR = B.CRDACCT_CUST_NBR\r\nWHERE A.ISLATEST = 1 \r\n    AND A.CUST_LOCAL_NAME NOT LIKE '%TEST%'\r\n    AND A.CUST_FIRST_NAME NOT LIKE '%TEST%'\r\n    AND A.CUST_MIDDLE_NAME NOT LIKE '%TEST%'\r\n    AND A.CUST_LAST_NAME NOT LIKE '%TEST%'\r\n    AND ((B.CRDACCT_APPL_SRC_CODE NOT LIKE 'TES%' \r\n    AND B.CRDACCT_APPL_SRC_CODE NOT LIKE 'TST%' \r\n    AND B.CRDACCT_APPL_SRC_CODE NOT LIKE 'XXX%') OR B.CRDACCT_CUST_NBR IS NULL)\r\n",
