							"text": "DECLARE @tr_style varchar(max)\r\nDECLARE @header varchar(max)\r\nDECLARE @body varchar(max)\r\nset @tr_style = '<style>table {border-collapse: collapse;width: 100%;}th, td {text-align: left;padding: 8px;} tr:nth-child(even) {background-color: #D6EEEE;}</style>';\r\n\r\nSELECT @header = CONCAT(@tr_style,'<table>','<tr><th>SOURCE_CODE</th>',STRING_AGG('<th>'+COLUMN_NAME+'</th>',''),'</tr>')\r\nFROM INFORMATION_SCHEMA.COLUMNS \r\nWHERE TABLE_NAME = 'OM_TASK_ERROR_DTL';\r\n\r\nSELECT @body = STRING_AGG('<tr>'+'<td>'+'DEP'+'</td><td>'+ISNULL(PIPELINE_RUNID,'')+'</td><td>'+TASK_NAME+'</td><td>'+DATA_LAYER+'</td><td>'+CONVERT(VARCHAR,PROCESS_DATE,126)+'</td><td>'+ERROR_DESC+'</td><td>'+CONVERT(VARCHAR,CREATE_DATETIME,126)+'</td>'+'</tr>','')\r\nFROM OM.OM_TASK_ERROR_DTL WHERE PROCESS_DATE = '2023-09-01' and TASK_NAME like '%DEP%'\r\n\r\nSELECT CONCAT(@header,@body,'</table>') as body\r\n"
