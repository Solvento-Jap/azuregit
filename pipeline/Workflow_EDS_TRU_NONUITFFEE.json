						"HashLog_SQL": "WITH [METRIC_BASE] AS ( SELECT [FILE_NAME] ,[INSERT_DTTM] ,TRY_CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE) AS [DATE] ,TRY_CAST(SUM(CASE WHEN H = 'D' THEN 1 ELSE 0 END) AS NUMERIC(25, 5)) AS TGT_COUNT ,MAX(CASE WHEN H <> 'D' THEN TRY_CAST(REPLACE(H, 'F-', '') AS NUMERIC(25, 5)) END) AS SRC_COUNT FROM [D360].[STG_EDS_TRU_NONUITFFEE] GROUP BY [FILE_NAME] ,[INSERT_DTTM] ) INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT [FILE_NAME] ,[DATE] ,[INSERT_DTTM] ,[METRIC_NAME] ,[SRC_VALUE] ,[TGT_VALUE] FROM [METRIC_BASE] CROSS APPLY ( SELECT 'COUNT' AS [METRIC_NAME] ,[SRC_COUNT] AS [SRC_VALUE] ,[TGT_COUNT] AS [TGT_VALUE] ) M ",
