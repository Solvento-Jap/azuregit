LUATION_MTD ,UNMASKED_BASE_NO ,UNMASKED_PORTFOLIO_NO ,UNMASKED_ACC_NO ,LEFT(FILE_NAME, 5) AS [BNK_CODE] ,'TRU' AS [SOURCE_CODE] ,[FILE_NAME] ,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS DATETIME) AS INSERT_DTTM FROM [D360].[STG_EDS_TRU_NONUITFFEE] WHERE [H] = 'D' ",
