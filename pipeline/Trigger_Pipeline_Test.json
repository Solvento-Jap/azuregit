					"ifTrueActivities": [
						{
							"name": "GET_PROCESS_DATE",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": {
										"value": "select fulldate\nfrom \n    eds.eds_ctl ect\ninner join \n    eds.date_dim dd\n    on \n    ect.ATM_Date=dd.previous_business_day and dd.business_day_flag='Y'\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLPool_EDS",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "eds_ctl"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "SET_START_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "V_startDate",
								"value": {
									"value": "@activity('GET_PROCESS_DATE').output.firstRow.fulldate\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SET_END_DATE",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GET_PROCESS_DATE",
