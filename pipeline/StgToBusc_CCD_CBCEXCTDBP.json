								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": "UPDATE TGT\nSET ISLATEST = 0\nFROM BUSC.CCD_CBCEXCTDBP TGT\nWHERE  ISLATEST = 1\n\nSELECT\nconvert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_BANK_NBR],' ',''),''),0)) as TXN_BANK_NBR\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_PDT_NBR],' ',''),''),0)) as TXN_PDT_NBR\n,TXN_ACCT_NBR\n,TXN_CARD_NBR\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_DTE],' ',''),''),0)) as TXN_DTE\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_CODE],' ',''),''),0)) as TXN_CODE\n,FLAG_TXN_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_AMT],' ',''),''),0)) as TXN_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_POSTING_DTE],' ',''),''),0)) as TXN_POSTING_DTE\n,TXN_CURR_CODE\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_SOURCE],' ',''),''),0)) as TXN_SOURCE\n,TXN_AUTH_CODE\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_JUL_DTE],' ',''),''),0)) as TXN_JUL_DTE\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_BATCH_NBR],' ',''),''),0)) as TXN_BATCH_NBR\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_BATCH_SEQ],' ',''),''),0)) as TXN_BATCH_SEQ\n,TXN_DESC\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_ZIP_CODE],' ',''),''),0)) as TXN_ZIP_CODE\n,TXN_STATE\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_MCC_CODE],' ',''),''),0)) as TXN_MCC_CODE\n,TXN_ACQ_REF\n,TXN_PRE_CURR_CODE\n,FLAG_TXN_PRE_ORG_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_PRE_ORG_AMT],' ',''),''),0)) as TXN_PRE_ORG_AMT\n,TXN_ORG_CURR_CODE\n,FLAG_TXN_ORG_AMT\n,convert(numeric(9,0),ISNULL(NULLIF(REPLACE([TXN_ORG_AMT],' ',''),''),0)) as TXN_ORG_AMT\n,TXN_SETL_CURR_CODE\n,FLAG_TXN_SETL_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_SETL_AMT],' ',''),''),0)) as TXN_SETL_AMT\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_SETL_FLAG],' ',''),''),0)) as TXN_SETL_FLAG\n,TXN_REIM_ATTR\n,TXN_IFI_IND\n,TXN_PSI_IND\n,TXN_MAIL_TEL_IND\n,TXN_OTH_PROC_IND\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_POS_ENTRY_MODE],' ',''),''),0)) as TXN_POS_ENTRY_MODE\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_DMS_CASE_NBR],' ',''),''),0)) as TXN_DMS_CASE_NBR\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([TXN_MECH_BANK_NBR],' ',''),''),0)) as TXN_MECH_BANK_NBR\n,convert(numeric(11,0),ISNULL(NULLIF(REPLACE([TXN_MECH_NBR],' ',''),''),0)) as TXN_MECH_NBR\n,TXN_NODE_ID\n,TXN_ROOT_NODE_ID\n,TXN_ADDN_REF\n,TXN_FILE_BUFFER\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([MARKUP_FEE],' ',''),''),0)) as MARKUP_FEE\n,convert(numeric(8,0),ISNULL(NULLIF(REPLACE([LAST6_TXN_ACCT_NBR],' ',''),''),0)) as LAST6_TXN_ACCT_NBR\n,1 AS isActive\n,1 AS isLatest\n,left(FILE_NAME,5) as [BNK_CODE]\n,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n,[FILE_NAME]\n--,CONVERT(DATETIME2, STUFF(STUFF(STUFF(INSERT_DTTM, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS INSERT_DTTM\n,CONVERT(DATE,INSERT_DTTM) AS INSERT_DTTM\n,CONVERT(INT, LEFT(RIGHT(FILE_NAME,12),8)) AS BUSINESSDATE\nFROM [D360].[STG_CCD_CBCEXCTDBP]\nWHERE H = 'D'",
									"queryTimeout": "02:00:00",
