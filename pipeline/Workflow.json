				}
			},
			{
				"name": "END_WORKFLOW",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "ForEach3",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "pipeline_runid",
									"type": "String",
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "Query",
							"text": "UPDATE [OM].[OM_WORKFLOW_RUN] SET STATUS_ID = (SELECT STATUS_ID FROM OM.OM_STATUS WHERE STATUS = 'SUCCESSFUL'), END_DATETIME = CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime) WHERE PIPELINE_RUNID = @pipeline_runid;"
						}
					]
				}
			}
		],
		"parameters": {
			"startDate": {
				"type": "string",
				"defaultValue": "2023-01-19T00:00:00Z"
			},
			"endDate": {
				"type": "string",
				"defaultValue": "2023-01-25T00:00:00Z"
			}
		},
		"variables": {
			"Cnt_DaystoIterate": {
				"type": "String"
			},
			"AppendDays": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2023-01-20T09:38:44Z"
	},
