								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "StgToBusc",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "DecToStg",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "StgToBusc",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "Failed_Workflow4",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "StgToBusc",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Failed_Workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "BuscToSyn",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "StgToBusc",
									"dependencyConditions": [
