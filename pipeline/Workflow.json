{
	"name": "Workflow",
	"properties": {
		"activities": [
			{
				"name": "START_WORKFLOW",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "pipeline_runid",
									"type": "String",
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "Query",
							"text": "SET IDENTITY_INSERT  [OM].[OM_WORKFLOW_RUN] ON;\r\n\r\nINSERT INTO [OM].[OM_WORKFLOW_RUN] (WORKFLOW_RUN_ID,PIPELINE_RUNID,START_DATETIME,END_DATETIME,STATUS_ID,CREATE_DATETIME)\r\nSELECT  ROW_NUMBER() OVER(ORDER BY (SELECT NULL))+ (SELECT ISNULL(MAX(WORKFLOW_RUN_ID),0) FROM [OM].[OM_WORKFLOW_RUN]) \r\n,@pipeline_runid\r\n,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime)\r\n,NULL\r\n,(SELECT STATUS_ID FROM OM.OM_STATUS WHERE STATUS = 'RUNNING')\r\n,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime)\r\n\r\nSET IDENTITY_INSERT  [OM].[OM_WORKFLOW_RUN] OFF;"
						}
					]
				}
			},
			{
				"name": "DaysToIterate",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "START_WORKFLOW",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Cnt_DaystoIterate",
					"value": {
						"value": "@string(add(div(sub(ticks(pipeline().parameters.endDate),ticks(pipeline().parameters.startDate)),864000000000),1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach2",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "DaysToIterate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0,int(variables('Cnt_DaystoIterate')) )",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "AppendDays",
								"value": {
									"value": "@string(addDays(\n    pipeline().parameters.startDate, \n    mul(\n        item(),\n       \n            1\n        \n    )\n))",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ForEach3",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ForEach2",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('AppendDays')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "OnPremToADLS",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "OnPremToADLS",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"DatetoProcessed": {
										"value": "@replace(substring(item(),0,10),'-','')",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "PGPDecrypt",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "OnPremToADLS",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PGPDecrypt_AllSourceCode",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "DecToStg",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "PGPDecrypt",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "DecToStg",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "Failed_Workflow1",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "OnPremToADLS",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Failed_Workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "Failed_Workflow2",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "PGPDecrypt",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Failed_Workflow",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "Failed_Workflow3",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "DecToStg",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Failed_Workflow",
