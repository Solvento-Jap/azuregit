{
	"name": "OnPremToADLS_MANIFEST_v2",
	"properties": {
		"activities": [
			{
				"name": "COPY_DATA",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "SftpReadSettings",
							"recursive": false,
							"wildcardFolderPath": {
								"value": "@concat('data360/uat/',pipeline().parameters.Bank_ID,'/',replace(pipeline().parameters.src_sys,'RIB','EBK'),'/encrypt')",
								"type": "Expression"
							},
							"wildcardFileName": {
								"value": "@concat(pipeline().parameters.Bank_ID,'_',pipeline().parameters.src_sys,'_MANIFEST','*',variables('v_datetoprocessed'),'*')",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false,
							"disableChunking": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "SFTP_OnPrem",
						"type": "DatasetReference",
						"parameters": {
							"Filepath": " ",
							"Filename": " "
						}
					}
				],
				"outputs": [
					{
						"referenceName": "SFTP_ADLS",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_datetoprocessed",
					"value": {
						"value": "@pipeline().parameters.DatetoProcessed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_tables",
					"value": {
						"value": "@concat('*',pipeline().parameters.tables)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"DatetoProcessed": {
				"type": "string"
			},
			"tables": {
				"type": "string"
			},
			"src_sys": {
				"type": "string"
			},
			"Bank_ID": {
				"type": "string"
			}
		},
		"variables": {
			"v_datetoprocessed": {
				"type": "String"
			},
			"v_tables": {
				"type": "String"
			},
			"CurrentTimestamp": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-06-10T07:18:09Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}