									"type": "String",
									"value": {
										"value": "@pipeline().parameters.src_sys",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
									"name": "pipelinename",
									"type": "String",
									"value": {
										"value": "@pipeline().parameters.PipelineName",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
									"name": "end_datetime",
									"type": "Datetime",
									"value": {
										"value": "@pipeline().parameters.EndDateTime",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
									"name": "syn_workspace",
									"type": "String",
									"value": {
										"value": "@pipeline().DataFactory",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
									"name": "ENV",
									"type": "String",
									"value": {
										"value": "@variables('V_ENV_set')",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
									"name": "BatchNo",
									"type": "Int32",
									"value": {
										"value": "@pipeline().parameters.BatchNo",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "Query",
							"text": "\nDECLARE @intro nvarchar(max)\nDECLARE @tr_style nvarchar(max)\nDECLARE @header nvarchar(max)\nDECLARE @body nvarchar(max)\nDECLARE @err_header nvarchar(max)\nDECLARE @err_body nvarchar(max)\nDECLARE @err_hash_header nvarchar(max)\nDECLARE @err_hash_body nvarchar(max)\nDECLARE @err_rw_header nvarchar(max)\nDECLARE @err_rw_body nvarchar(max)\n\nset @intro = (SELECT CONCAT('<p><b>Environment: ',@ENV,' - [',@syn_workspace,']','</b></p><p><b>Workflow Name: ',@pipelinename,'</b></p><p><b>Process Date: ',CONVERT(VARCHAR,@datetoprocess,23),'</b></p><p><b>Start DateTime: ',CONVERT(VARCHAR,@run_datetime,120),'</b></p><p><b>End DateTime: ',CONVERT(VARCHAR,@end_datetime,120),'</b></p>'))\n\nset @tr_style = '<style>table {border-collapse: collapse;width: 100%; font-family: Aptos; font-size: 11pt;}th, td {text-align: left;padding: 2px;border: 1px solid #BFBFBF;} tr:nth-child(2n) {background-color: #D6EEEE;}  .failed { background-color: #F8CBAD; }  .notexecuted { background-color: #F8CBAD; } .disabled { background-color: #DDEBF7; }  .successful { background-color: #C6E0B4; } .running { background-color: #FFE699; }</style>'\n\n/***Error Details***/\nSET @err_header = '<p><b>Execution Error Details:</b></p><table><tr><th>Task Name</th><th>Error Description</th><th>Run DateTime</th></tr>'\n\nSET @err_body = (SELECT CONCAT(STRING_AGG('<tr><td>'+CAST(OTED.TASK_NAME AS NVARCHAR(MAX))+'</td><td>'+CAST(REPLACE(REPLACE(REPLACE(REPLACE(ERROR_DESC,'[',''),']',''),',',' '),'\"','')  AS NVARCHAR(MAX))+'</td><td>'+CAST(REPLACE(CONVERT(VARCHAR,OTED.CREATE_DATETIME,126),'T',' ') AS NVARCHAR(MAX))+'</td></tr>','') WITHIN GROUP (ORDER BY OTED.CREATE_DATETIME),'</table>')\nFROM OM.OM_TASK_ERROR_DTL OTED\nWHERE PROCESS_DATE = @datetoprocess\n     AND OTED.CREATE_DATETIME >= @run_datetime\n\t AND OTED.TASK_NAME LIKE '%_EDS_FMS_%')\n\nSELECT CONCAT(@intro,@tr_style,@err_header,@err_body) as body;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
