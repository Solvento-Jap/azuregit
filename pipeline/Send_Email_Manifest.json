					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "run_datetime",
									"type": "Datetime",
									"value": {
										"value": "@pipeline().parameters.RunDateTime",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
									"name": "datetoprocess",
									"type": "Datetime",
									"value": {
										"value": "@pipeline().parameters.ProcessDate",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
