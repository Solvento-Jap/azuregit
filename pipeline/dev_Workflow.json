				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "cbcd360devsynpssg-WorkspaceDefaultSqlServer",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "testSQLPool"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "pipeline_runid",
									"type": "String",
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "Query",
							"text": "SET IDENTITY_INSERT  [OM].[OM_WORKFLOW_RUN] ON;\r\n\r\nINSERT INTO [OM].[OM_WORKFLOW_RUN] (WORKFLOW_RUN_ID,PIPELINE_RUNID,START_DATETIME,END_DATETIME,STATUS_ID,CREATE_DATETIME)\r\nSELECT  ROW_NUMBER() OVER(ORDER BY (SELECT NULL))+ (SELECT ISNULL(MAX(WORKFLOW_RUN_ID),0) FROM [OM].[OM_WORKFLOW_RUN]) \r\n,@pipeline_runid\r\n,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime)\r\n,NULL\r\n,(SELECT STATUS_ID FROM OM.OM_STATUS WHERE STATUS = 'RUNNING')\r\n,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS datetime)\r\n\r\nSET IDENTITY_INSERT  [OM].[OM_WORKFLOW_RUN] OFF;"
						}
					]
				}
			},
			{
				"name": "END_WORKFLOW",
				"type": "Script",
