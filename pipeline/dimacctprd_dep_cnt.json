							"text": "SELECT CustomerAccountId,ProductID,SourceSystemCode,FinancialInstitutionId FROM BNKM.CustomerAccountFinancialProduct \nWHERE SourceSystemCode = 'DEP' \nAND (PERIODENDDATE IS NULL OR  PERIODENDDATE = '1900-01-01') AND ProductId NOT LIKE ('09%') \nGROUP BY CustomerAccountId,ProductID,SourceSystemCode,FinancialInstitutionId\nHAVING COUNT(1) > 1\n"
