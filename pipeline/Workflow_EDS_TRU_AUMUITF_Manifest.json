			"HashLog_SQL": {
				"type": "string",
				"defaultValue": "WITH CTE1 AS ( \tSELECT TRY_CAST(COUNT(*) AS NUMERIC(25, 5)) COUNT_tgt \t\t,ISNULL(SUM(BALANCE_UNITS),0)BALANCE_UNITS_tgt \t\t,ISNULL(SUM(NAV),0)NAV_tgt \t\t,ISNULL(SUM(MARKET_VALUE),0)MARKET_VALUE_tgt \t\t,ISNULL(SUM(INVESTMENT_VALUE),0)INVESTMENT_VALUE_tgt \t\t,ISNULL(SUM(GAIN_LOSS),0)GAIN_LOSS_tgt \t\t,ISNULL(SUM(ROI),0)ROI_tgt \t\t,FILE_NAME \t\t,INSERT_DTTM \tFROM d360.STG_EDS_TRU_AUMUITF \tWHERE H = 'D' \tGROUP BY FILE_NAME \t\t,INSERT_DTTM \t) \t,CTE2 AS ( \tSELECT TRY_CAST(REPLACE(H, 'F-', '') AS NUMERIC(25, 5)) COUNT_src \t\t,TRY_CAST(BALANCE_UNITS AS NUMERIC(25,5))BALANCE_UNITS_src \t\t,TRY_CAST(NAV AS NUMERIC(25,5))NAV_src \t\t,TRY_CAST(MARKET_VALUE AS NUMERIC(25,5))MARKET_VALUE_src \t\t,TRY_CAST(INVESTMENT_VALUE AS NUMERIC(25,5))INVESTMENT_VALUE_src \t\t,TRY_CAST(GAIN_LOSS AS NUMERIC(25,5))GAIN_LOSS_src \t\t,TRY_CAST(ROI AS NUMERIC(25,5))ROI_src \t\t,FILE_NAME \t\t,INSERT_DTTM \tFROM d360.STG_EDS_TRU_AUMUITF \tWHERE H <> 'D' \t)  \t,CTE12 AS ( \tSELECT COUNT_SRC \t\t,COUNT_TGT \t\t,BALANCE_UNITS_tgt \t\t,NAV_tgt \t\t,MARKET_VALUE_tgt \t\t,INVESTMENT_VALUE_tgt \t\t,GAIN_LOSS_tgt \t\t,ROI_tgt \t\t,BALANCE_UNITS_src \t\t,NAV_src \t\t,MARKET_VALUE_src \t\t,INVESTMENT_VALUE_src \t\t,GAIN_LOSS_src \t\t,ROI_src \t\t,A.FILE_NAME \t\t,A.INSERT_DTTM \t\t,TRY_CAST((left(right(A.FILE_NAME, 12), 8)) AS DATE) DATE \tFROM CTE1 A \tJOIN CTE2 B ON A.FILE_NAME = B.FILE_NAME \t\tAND A.INSERT_DTTM = B.INSERT_DTTM \t) INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT FILE_NAME \t,DATE \t,insert_dttm \t,REPLACE(METRICS, '_SRC', '') METRICS \t,SRC \t,TGT FROM ( \tSELECT TRY_CAST(COUNT_SRC AS NUMERIC(25, 5)) COUNT_SRC \t\t,TRY_CAST(COUNT_TGT AS NUMERIC(25, 5)) COUNT_TGT \t\t,TRY_CAST(BALANCE_UNITS_tgt AS NUMERIC(25,5))BALANCE_UNITS_tgt \t\t,TRY_CAST(NAV_tgt AS NUMERIC(25,5))NAV_tgt \t\t,TRY_CAST(MARKET_VALUE_tgt AS NUMERIC(25,5))MARKET_VALUE_tgt \t\t,TRY_CAST(INVESTMENT_VALUE_tgt AS NUMERIC(25,5))INVESTMENT_VALUE_tgt \t\t,TRY_CAST(GAIN_LOSS_tgt AS NUMERIC(25,5))GAIN_LOSS_tgt \t\t,TRY_CAST(ROI_tgt AS NUMERIC(25,5))ROI_tgt \t\t,TRY_CAST(BALANCE_UNITS_src AS NUMERIC(25,5))BALANCE_UNITS_src \t\t,TRY_CAST(NAV_src AS NUMERIC(25,5))NAV_src \t\t,TRY_CAST(MARKET_VALUE_src AS NUMERIC(25,5))MARKET_VALUE_src \t\t,TRY_CAST(INVESTMENT_VALUE_src AS NUMERIC(25,5))INVESTMENT_VALUE_src \t\t,TRY_CAST(GAIN_LOSS_src AS NUMERIC(25,5))GAIN_LOSS_src \t\t,TRY_CAST(ROI_src AS NUMERIC(25,5))ROI_src \t\t,FILE_NAME \t\t,INSERT_DTTM \t\t,[DATE] \tFROM CTE12 \t) pvt UNPIVOT(SRC FOR METRICS IN ( \t\tCOUNT_SRC ,BALANCE_UNITS_src ,NAV_src ,MARKET_VALUE_src ,INVESTMENT_VALUE_src ,GAIN_LOSS_src ,ROI_src \t\t\t)) pvt1 UNPIVOT(TGT FOR METRICS2 IN ( \t\tCOUNT_TGT \t\t,BALANCE_UNITS_tgt \t\t,NAV_tgt \t\t,MARKET_VALUE_tgt \t\t,INVESTMENT_VALUE_tgt \t\t,GAIN_LOSS_tgt \t\t,ROI_tgt \t\t\t)) pvt2 WHERE REPLACE(METRICS, '_SRC', '') = REPLACE(METRICS2, '_TGT', '');"
			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "DELETE FROM EDS.TRU_AUMUITF WHERE AS_OF_DATE IN (         SELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE)         FROM D360.STG_EDS_TRU_AUMUITF     )  INSERT INTO EDS.TRU_AUMUITF(         AS_OF_DATE,         BASE_NO,         LAST6_BASE_NO,         BASE_NO_UNMASKED,         PORTFOLIO_NO,         LAST6_PORTFOLIO_NO,         PORTFOLIO_NO_UNMASKED,         BRANCH,         CUSTOMER_NAME,         CUSTOMER_TYPE,         FUND_CODE,         FUND_NAME,         FUND_CURRENCY_CODE,         BALANCE_UNITS,         NAV,         NAV_DATE,         MARKET_VALUE,         INVESTMENT_VALUE,         GAIN_LOSS,         ROI,         AC_STATUS,         VALUE_DATE,         BNK_CODE,         SOURCE_CODE,         FILE_NAME,         insert_dttm     )  SELECT CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE) AS AS_OF_DATE,     BASE_NO,     LAST6_BASE_NO,     BASE_NO_UNMASKED,     PORTFOLIO_NO,     LAST6_PORTFOLIO_NO,     PORTFOLIO_NO_UNMASKED,     BRANCH,     CUSTOMER_NAME,     CUSTOMER_TYPE,     FUND_CODE,     FUND_NAME,     FUND_CURRENCY_CODE,     BALANCE_UNITS,     NAV,     NAV_DATE,     MARKET_VALUE,     INVESTMENT_VALUE,     GAIN_LOSS,     ROI,     AC_STATUS,     VALUE_DATE,     LEFT(FILE_NAME, 5) AS BNK_CODE,     'TRU' AS SOURCE_CODE,     FILE_NAME,     insert_dttm FROM D360.STG_EDS_TRU_AUMUITF WHERE H = 'D'; --AND CAST(NAV_DATE AS DATE) = CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE)  \t--First ingestion must remove this filter this will only applied moving forward"
