							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false,
						"disableChunking": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "ForEachFile",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "LIST ALL STFP_ONPREM FILES",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LIST ALL STFP_ONPREM FILES').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "LIST STFP_ONPREM PER FILE",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "SFTP_OnPrem",
									"type": "DatasetReference",
									"parameters": {
										"Filepath": {
											"value": "@concat('data360/uat/CBC01/',substring(item().Name,6 ,8),'/encrypt')",
											"type": "Expression"
										},
										"Filename": {
											"value": "@item().Name",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"itemName",
									"itemType",
									"lastModified",
									"size"
								],
								"storeSettings": {
									"type": "SftpReadSettings",
									"recursive": true,
									"modifiedDatetimeStart": {
										"value": "@concat(pipeline().parameters.Processdate,' 00:00:00')",
										"type": "Expression"
									},
									"modifiedDatetimeEnd": {
										"value": "@concat(pipeline().parameters.Processdate,' 23:59:59')",
										"type": "Expression"
									},
									"enablePartitionDiscovery": false,
									"disableChunking": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"Processdate": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-09-11T05:50:52Z"
	},
