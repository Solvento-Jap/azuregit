{
	"name": "Get_SFTP_File_list",
	"properties": {
		"activities": [
			{
				"name": "LIST ALL STFP_ONPREM FILES",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "SFTP_OnPrem",
						"type": "DatasetReference",
						"parameters": {
							"Filepath": {
								"value": "data360/prod/CBC01/MBK/encrypt",
