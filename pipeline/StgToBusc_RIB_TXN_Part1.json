				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n    convert(numeric(10,0),ISNULL(NULLIF(REPLACE(STG.[PAYEE_LIST_ID],' ',''),''),0)) as PAYEE_LIST_ID\n    ,STG.[BANK_ID]\n    ,[USER_ID]\n    ,[DB_TS]\n    ,[CORP_ID]\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([BNF_ID],' ',''),''),0)) as BNF_ID\n    ,[BNF_NIC_NAME]\n    ,[FREE_FIELD_1]\n    ,[FREE_FIELD_2]\n    ,[FREE_FIELD_3]\n    ,[FREE_FLG1]\n    ,[FREE_FLG2]\n    ,STG.[DEL_FLG]\n    ,[R_MOD_ID]\n    ,CONVERT(DATETIME2, STUFF(STUFF(STUFF([R_MOD_TIME], 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS R_MOD_TIME\n    ,[R_CRE_ID]\n    ,CONVERT(DATETIME2, STUFF(STUFF(STUFF([R_CRE_TIME], 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS R_CRE_TIME\n    ,[CONSUMER_CD]\n    ,[RECEIVE_BILLS_FLG]\n    ,[AUTOPAY_FLG]\n    ,convert(numeric(18,3),ISNULL(NULLIF(REPLACE([AUTOPAY_AMT],' ',''),''),0)) as AUTOPAY_AMT\n    ,[AUTOPAY_CRN]\n    ,[AUTOPAY_ACID]\n    ,[AUTOPAY_BRCH_ID]\n    ,[AUTOPAY_MODE]\n    ,CONVERT(DATETIME2, STUFF(STUFF(STUFF([SUBSCRIPTION_START_DATE], 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS SUBSCRIPTION_START_DATE\n    ,[ADHOC_PAYEE]\n    ,[NICKNAME_CRE_ID]\n    ,[BNF_PYMT_DETAILS_1]\n    ,[BNF_PYMT_DETAILS_2]\n    ,[BNF_PYMT_DETAILS_3]\n    ,[BNF_PYMT_DETAILS_4]\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([NOTIFICATION_REF_NO],' ',''),''),0)) as NOTIFICATION_REF_NO\n    ,convert(numeric(18,3),ISNULL(NULLIF(REPLACE([MAX_AMT_IN_HOMECRN],' ',''),''),0)) as MAX_AMT_IN_HOMECRN\n    ,1 AS isActive\n    ,1 AS isLatest\n    ,left(FILE_NAME, 5) as [BNK_CODE]\n    ,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n    ,[FILE_NAME]\n    ,convert(date,[insert_dttm]) as insert_dttm\nFROM [BUSC].[RIB_CUSTOMERPAYEE_DELTA] DELTA\nLEFT JOIN [d360].[STG_RIB_CUSTOMERPAYEE] STG ON DELTA.PAYEE_LIST_ID = STG.PAYEE_LIST_ID AND DELTA.BANK_ID = STG.BANK_ID\nWHERE H='D' ",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
