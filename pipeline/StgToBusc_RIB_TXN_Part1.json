				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n    [BANK_ID]\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([TXN_ID],' ',''),''),0)) as TXN_ID\n    ,convert(numeric(5,0),ISNULL(NULLIF(REPLACE([DB_TS],' ',''),''),0)) as DB_TS\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([REQ_ID],' ',''),''),0)) as REQ_ID\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([PARENT_REQ_ID],' ',''),''),0)) as PARENT_REQ_ID\n    ,[CORP_ID]\n    ,[CORP_USER]\n    ,[TXN_TYPE]\n    ,CONVERT(DATE,[REQUEST_DATE]) AS REQUEST_DATE\n    ,CONVERT(DATE,[TXN_DATE]) AS TXN_DATE\n    ,[TXN_CRN]\n    ,convert(numeric(18,3),ISNULL(NULLIF(REPLACE([TOTAL_TXN_AMT],' ',''),''),0)) as TOTAL_TXN_AMT\n    ,convert(numeric(18,3),ISNULL(NULLIF(REPLACE([TOTAL_TXN_AMT_IN_HOMECRN],' ',''),''),0)) as TOTAL_TXN_AMT_IN_HOMECRN\n    ,convert(numeric(18,3),ISNULL(NULLIF(REPLACE([TOTAL_CHARGE_AMT],' ',''),''),0)) as TOTAL_CHARGE_AMT\n    ,convert(numeric(18,3),ISNULL(NULLIF(REPLACE([TOTAL_AMT],' ',''),''),0)) as TOTAL_AMT\n    ,[FREQ_TYPE]\n    ,[TXN_REF_NAME]\n    ,[PMT_FREQ]\n    ,convert(numeric(5,0),ISNULL(NULLIF(REPLACE([TOT_NO_OF_INSTANCES],' ',''),''),0)) as TOT_NO_OF_INSTANCES\n    ,[VALIDITY_INDICATOR]\n    ,convert(numeric(5,0),ISNULL(NULLIF(REPLACE([NO_OF_INSTANCES_PROCESSED],' ',''),''),0)) as NO_OF_INSTANCES_PROCESSED\n    ,[FILE_GEN_NUM]\n    ,[FILE_UPLOAD_NUM]\n    ,[BATCH_TYPE]\n    ,[HOLD_FLG]\n    ,convert(numeric(5,0),ISNULL(NULLIF(REPLACE([TOTAL_NO_OF_ENTRIES],' ',''),''),0)) as TOTAL_NO_OF_ENTRIES\n    ,convert(numeric(18,3),ISNULL(NULLIF(REPLACE([HIGHEST_ENTRY_AMOUNT],' ',''),''),0)) as HIGHEST_ENTRY_AMOUNT\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([HIGHEST_ENTRY_SRL_NO],' ',''),''),0)) as HIGHEST_ENTRY_SRL_NO\n    ,[DRCR_FLG]\n    ,[TXN_STATUS]\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([TMPL_ID],' ',''),''),0)) as TMPL_ID\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([TMPL_DISPLAY_ID],' ',''),''),0)) as TMPL_DISPLAY_ID\n    ,[USER_ACTION_REMRAKS]\n    ,[ENTERER_ID]\n    ,[APPROVAL_HISTORY]\n    ,[ACCOUNTS_USED]\n    ,[DEL_FLG]\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([BULK_PMT_REF_NUM],' ',''),''),0)) as BULK_PMT_REF_NUM\n    ,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([FU_REC_NUM],' ',''),''),0)) as FU_REC_NUM\n    ,[R_CRE_ID]\n    ,CONVERT(DATETIME2, STUFF(STUFF(STUFF([R_CRE_TIME], 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS R_CRE_TIME\n    ,[R_MOD_ID]\n    ,CONVERT(DATETIME2, STUFF(STUFF(STUFF([R_MOD_TIME], 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) AS R_MOD_TIME\n    ,1 AS isActive\n    ,1 AS isLatest\n    ,left(FILE_NAME, 5) as [BNK_CODE]\n    ,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n    ,[FILE_NAME]\n    ,convert(date,[insert_dttm]) as insert_dttm\nFROM [d360].[STG_RIB_TRANSACTIONHEADER]\nWHERE H = 'D'        \n",
