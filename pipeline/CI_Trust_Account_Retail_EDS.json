				"name": "TrustRetail",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "START_TASK_CI",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@concat('select      PORT.PORTFOLIO_NO as AccountID\n        ,   CUST.UNIQUE_ID as CustomerID\n        ,   concat(''Entity_CIF_CRM_'', CUST.UNIQUE_ID) as EntityCIF\n        ,   CUST.UNIQUE_ID as FCBSCIF\n        ,   UITF.BNK_CODE as Bank_Code\n        ,   UITF.BRANCH as Branch_Code\n        ,   BR.SOL_DESC as BranchName\n        ,   BR.AREA as Area\n        ,   BR.REGION as Region\n        ,   UITF.SOURCE_CODE as Source\n        ,   ''UITF'' as ProductGrouping\n        ,   PORT.PROD_CODE as ProductType\n        ,   concat(''UITF-'', PORT.PROD_CODE) as ProductDetails\n        ,   PFSUB.INCEPTION_DATE as OpenedDate\n        ,   UITF.CUSTOMER_FUND_VALUE_IN_PHP as AssetsUnderManagementBalance_Full\n        ,   null as AssetsUnderManagementBalance_Prorated\n        ,   CAST(''',variables('V_date'),''' AS DATE) as BusinessDate\n        ,   CAST(''',variables('V_date'),''' AS DATE) as LastUpdatedDate\n        ,   concat(PORT.PORTFOLIO_NO, CUST.UNIQUE_ID, UITF.BNK_CODE, UITF.SOURCE_CODE) as AccountKey\nfrom eds.TRU_CUST CUST\nleft join eds.TRU_BASELINK BASE \non CUST.CUST_NO = BASE.CIF_NO \nand CUST.BNK_CODE = BASE.BNK_CODE\nand CAST(''',variables('V_date'),''' AS DATE) between BASE.SCD_START_DATE and BASE.SCD_END_DATE\nleft join eds.TRU_PORTFOLIO PORT \non BASE.CUST_NO = PORT.BASE_NO \nand BASE.BNK_CODE = PORT.BNK_CODE\nand CAST(''',variables('V_date'),''' AS DATE) between PORT.SCD_START_DATE and PORT.SCD_END_DATE\nleft join eds.TRU_PFSUBSCRIPTION PFSUB\non PORT.SUBSCRIPTION_ID = PFSUB.SUBSCRIPTION_ID\nand PORT.BASE_NO = PFSUB.BASE_NO\nand PORT.BNK_CODE = PFSUB.BNK_CODE\nand CAST(''',variables('V_date'),''' AS DATE) between PFSUB.SCD_START_DATE and PFSUB.SCD_END_DATE\ninner join eds.TRU_AUMUITF UITF\non UITF.BASE_NO = PORT.BASE_NO\nand UITF.PORTFOLIO_NO = PORT.PORTFOLIO_NO\nand PORT.BNK_CODE = UITF.BNK_CODE\nand UITF.ASOFDATE = CAST(''',variables('V_date'),''' AS DATE) \nleft join eds.BRANCH_DIM BR \non UITF.BRANCH = BR.SOL_ID \nand UITF.BNK_CODE = BR.BNK_CODE\nand CAST(''',variables('V_date'),''' AS DATE) between BR.SCD_START_DATE and BR.SCD_END_DATE\nwhere CAST(''',variables('V_date'),''' AS DATE) between CUST.SCD_START_DATE and CUST.SCD_END_DATE\nand left(CUST.UNIQUE_ID, 1) = ''R''\ngroup by    PORT.PORTFOLIO_NO\n        ,   CUST.UNIQUE_ID\n        ,   concat(''Entity_CIF_CRM_'', CUST.UNIQUE_ID)\n        ,   CUST.UNIQUE_ID\n        ,   UITF.BNK_CODE\n        ,   UITF.BRANCH\n        ,   BR.SOL_DESC\n        ,   BR.AREA\n        ,   BR.REGION\n        ,   UITF.SOURCE_CODE\n        ,   PORT.PROD_CODE\n        ,   concat(''UITF-'', PORT.PROD_CODE)\n        ,   PFSUB.INCEPTION_DATE\n        ,   UITF.CUSTOMER_FUND_VALUE_IN_PHP\n        ,   concat(PORT.PORTFOLIO_NO, CUST.UNIQUE_ID, UITF.BNK_CODE, UITF.SOURCE_CODE)\n\nunion all\n\nselect      PORT.PORTFOLIO_NO as AccountID\n        ,   CUST.UNIQUE_ID as CustomerID\n        ,   concat(''Entity_CIF_CRM_'', CUST.UNIQUE_ID) as EntityCIF\n        ,   CUST.UNIQUE_ID as FCBSCIF\n        ,   NONUITF.BNK_CODE as Bank_Code\n        ,   null as Branch_Code\n        ,   null as BranchName\n        ,   null as Area\n        ,   null as Region\n        ,    NONUITF.SOURCE_CODE as Source\n        ,   ''NON-UITF'' as ProductGrouping\n        ,   PORT.PROD_CODE as ProductType\n        ,   concat(''NON-UITF-'', PORT.PROD_CODE) as ProductDetails\n        ,   PFSUB.INCEPTION_DATE as OpenedDate\n        ,   NONUITF.AUM_IN_ORIG_CURR as AssetsUnderManagementBalance_Full\n        ,   null as AssetsUnderManagementBalance_Prorated\n        ,   CAST(''',variables('V_date'),''' AS DATE) as BusinessDate\n        ,   CAST(''',variables('V_date'),''' AS DATE) as LastUpdatedDate\n        ,   concat(PORT.PORTFOLIO_NO, CUST.UNIQUE_ID, NONUITF.BNK_CODE, NONUITF.SOURCE_CODE) as AccountKey\nfrom eds.TRU_CUST CUST\nleft join eds.TRU_BASELINK BASE \non CUST.CUST_NO = BASE.CIF_NO \nand CUST.BNK_CODE = BASE.BNK_CODE\nand CAST(''',variables('V_date'),''' AS DATE) between BASE.SCD_START_DATE and BASE.SCD_END_DATE\nleft join eds.TRU_PORTFOLIO PORT \non BASE.CUST_NO = PORT.BASE_NO \nand BASE.BNK_CODE = PORT.BNK_CODE\nand CAST(''',variables('V_date'),''' AS DATE) between PORT.SCD_START_DATE and PORT.SCD_END_DATE\nleft join eds.TRU_PFSUBSCRIPTION PFSUB\non PORT.SUBSCRIPTION_ID = PFSUB.SUBSCRIPTION_ID\nand PORT.BASE_NO = PFSUB.BASE_NO\nand PORT.BNK_CODE = PFSUB.BNK_CODE\nand CAST(''',variables('V_date'),''' AS DATE) between PFSUB.SCD_START_DATE and PFSUB.SCD_END_DATE\ninner join eds.TRU_AUMNONUITF NONUITF\non NONUITF.BASE_NO = PORT.BASE_NO\nand NONUITF.PF_NO = PORT.PORTFOLIO_NO\nand NONUITF.BNK_CODE = PORT.BNK_CODE\nand NONUITF.ASOFDATE = CAST(''',variables('V_date'),''' AS DATE) \nwhere CAST(''',variables('V_date'),''' AS DATE) between CUST.SCD_START_DATE and CUST.SCD_END_DATE\nand left(CUST.UNIQUE_ID, 1) = ''R''\ngroup by    PORT.PORTFOLIO_NO\n        ,   CUST.UNIQUE_ID\n        ,   concat(''Entity_CIF_CRM_'', CUST.UNIQUE_ID)\n        ,   CUST.UNIQUE_ID\n        ,   NONUITF.BNK_CODE\n        ,   NONUITF.SOURCE_CODE\n        ,   PORT.PROD_CODE\n        ,   concat(''NON-UITF-'', PORT.PROD_CODE)\n        ,   PFSUB.INCEPTION_DATE\n        ,   NONUITF.AUM_IN_ORIG_CURR\n        ,   concat(PORT.PORTFOLIO_NO, CUST.UNIQUE_ID, NONUITF.BNK_CODE, NONUITF.SOURCE_CODE)')",
							"type": "Expression"
						},
