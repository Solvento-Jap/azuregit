{
	"name": "Decrypt_ArchiveToADLS",
	"properties": {
		"description": "Retrieve files archive",
		"activities": [
			{
				"name": "List All Encrypted Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "adls_src_archive_daily",
						"type": "DatasetReference",
						"parameters": {
							"archivepath": {
								"value": "@concat('dev/archive/',pipeline().parameters.src_sys,'/',pipeline().parameters.rundate)",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Decrypt Multiple Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get File name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get File name').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "PGP Decrypt",
							"type": "AzureFunctionActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"functionName": "PGPDecrypt",
								"body": {
									"value": "{\nfilePath: \"data360/dev/archive/@{pipeline().parameters.src_sys}/@{pipeline().parameters.rundate}/@{item().name}\",\noutputPath: \"data360/dev/archive_decrypted/@{pipeline().parameters.src_sys}/@{replace(item().name,'.gpg','')}\",\nkvsecpass: \"cbcpassp\",\nkvsecpriv: \"cbcprivkey\"\n}",
									"type": "Expression"
								},
								"method": "POST"
							},
							"linkedServiceName": {
								"referenceName": "PGPFunction",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Get File name",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "List All Encrypted Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List All Encrypted Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(contains(item().name,pipeline().parameters.filetables),contains(item().name,pipeline().parameters.businessdate))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"filetables": {
				"type": "string"
			},
			"src_sys": {
				"type": "string"
			},
			"rundate": {
				"type": "string"
			},
			"businessdate": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-05-31T03:35:42Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}