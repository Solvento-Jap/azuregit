										"type": "NonQuery",
										"text": "DELETE FROM EDS.DID_WMGLIST WHERE AS_OF_DATE = (SELECT TOP 1 CONVERT(DATE,LEFT(RIGHT(FILE_NAME, 12), 8)) FROM D360.STG_EDS_DID_WMGLIST);\n\nINSERT INTO EDS.DID_WMGLIST(\n     AS_OF_DATE\n    ,ACCOUNT_NUMBER\n    ,RM\n    ,CLUSTER\n    ,FCBS_CUSTOMER_ID\n    ,BNK_CODE\n    ,SOURCE_CODE\n    ,ACCOUNT_NUMBER_UNMASKED\n    ,FILE_NAME\n    ,INSERT_DTTM\n)\nSELECT\n    CAST(LEFT(RIGHT(FILE_NAME,12),8) AS DATE) AS AS_OF_DATE\n    ,ACCOUNT_NUMBER\n    ,RM\n    ,CLUSTER\n    ,FCBS_CUSTOMER_ID\n    ,left(FILE_NAME, 5) as BNK_CODE\n    ,substring(FILE_NAME,7,3) as SOURCE_CODE\n    ,ACCOUNT_NUMBER_UNMASKED\n    ,FILE_NAME\n    ,CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'Singapore Standard Time' AS DATETIME) as insert_dttm\nFROM D360.STG_EDS_DID_WMGLIST\nWHERE H = 'D';"
