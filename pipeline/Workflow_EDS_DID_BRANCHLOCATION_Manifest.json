			"HashLog_SQL": {
				"type": "string",
				"defaultValue": "WITH CTE1 AS ( \tSELECT TRY_CAST(COUNT(*) AS NUMERIC(25, 5)) COUNT_tgt \t\t,isnull(sum(LATITUDE),0)LATITUDE_tgt \t\t,isnull(sum(LONGITUDE),0)LONGITUDE_tgt \t\t,FILE_NAME \t\t,INSERT_DTTM \tFROM d360.STG_EDS_DID_BRANCHLOCATION \tWHERE H = 'D' \tGROUP BY FILE_NAME \t\t,INSERT_DTTM \t) \t,CTE2 AS ( \tSELECT TRY_CAST(REPLACE(H, 'F-', '') AS NUMERIC(25, 5)) COUNT_src \t\t,TRY_CAST(LATITUDE AS NUMERIC(25,5))LATITUDE_src \t\t,TRY_CAST(LONGITUDE AS NUMERIC(25,5))LONGITUDE_src \t\t,FILE_NAME \t\t,INSERT_DTTM \tFROM d360.STG_EDS_DID_BRANCHLOCATION \tWHERE H <> 'D' \t)  \t,CTE12 AS ( \tSELECT COUNT_SRC \t\t,COUNT_TGT \t\t,LATITUDE_tgt \t\t,LONGITUDE_tgt \t\t,LATITUDE_src \t\t,LONGITUDE_src \t\t,A.FILE_NAME \t\t,A.INSERT_DTTM \t\t,TRY_CAST((left(right(A.FILE_NAME, 12), 8)) AS DATE) DATE \tFROM CTE1 A \tJOIN CTE2 B ON A.FILE_NAME = B.FILE_NAME \t\tAND A.INSERT_DTTM = B.INSERT_DTTM \t) INSERT INTO [EDS].[EDS_HASH_LOG_TBL] SELECT FILE_NAME \t,DATE \t,insert_dttm \t,REPLACE(METRICS, '_SRC', '') METRICS \t,SRC \t,TGT FROM ( \tSELECT TRY_CAST(COUNT_SRC AS NUMERIC(25, 5)) COUNT_SRC \t\t,TRY_CAST(COUNT_TGT AS NUMERIC(25, 5)) COUNT_TGT \t\t,TRY_CAST(LATITUDE_tgt AS NUMERIC(25,5))LATITUDE_tgt \t\t,TRY_CAST(LONGITUDE_tgt AS NUMERIC(25,5))LONGITUDE_tgt \t\t,TRY_CAST(LATITUDE_src AS NUMERIC(25,5))LATITUDE_src \t\t,TRY_CAST(LONGITUDE_src AS NUMERIC(25,5))LONGITUDE_src \t\t,FILE_NAME \t\t,INSERT_DTTM \t\t,[DATE] \tFROM CTE12 \t) pvt UNPIVOT(SRC FOR METRICS IN ( \t\tCOUNT_SRC \t\t,LATITUDE_src \t\t,LONGITUDE_src \t\t\t)) pvt1 UNPIVOT(TGT FOR METRICS2 IN ( \t\tCOUNT_TGT \t\t,LATITUDE_tgt \t\t,LONGITUDE_tgt \t\t\t)) pvt2 WHERE REPLACE(METRICS, '_SRC', '') = REPLACE(METRICS2, '_TGT', '');"
			},
			"EDS_SQL": {
				"type": "string",
				"defaultValue": "BEGIN TRY \tUPDATE EDS.DID_BRANCHLOCATION \tSET [ISLATEST] = 0 \t\t,[SCD_END_DATE] = ( \t\t\tSELECT PREVIOUS_BUSINESS_DAY \t\t\tFROM EDS.DATE_DIM \t\t\tINNER JOIN ( \t\t\t\tSELECT TOP 1 CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS INTEGER) MX_DT \t\t\t\tFROM D360.STG_EDS_DID_BRANCHLOCATION \t\t\t\t) MX_DT_TBL ON DATESK = MX_DT \t\t\t) \tFROM EDS.DID_BRANCHLOCATION tgt \tLEFT JOIN D360.STG_EDS_DID_BRANCHLOCATION src  \t\tON src.[SOL_ID] = tgt.[SOL_ID] \t\tAND src.[H] = 'D' \tWHERE tgt.[ISLATEST] = 1 \t\tAND HASHBYTES('SHA2_256', CONCAT_WS(N'|', \t\tSRC.[SOL_ID], \t\tSRC.[SOL_DESC], \t\tSRC.[LATITUDE], \t\tSRC.[LONGITUDE])) \t\t<>  \t\tHASHBYTES('SHA2_256', CONCAT_WS(N'|', \t\tTGT.[SOL_ID], \t\tTGT.[SOL_DESC], \t\tTGT.[LATITUDE], \t\tTGT.[LONGITUDE])); \t\t \tINSERT INTO EDS.DID_BRANCHLOCATION( \t\t [SOL_ID] \t\t,[SOL_DESC] \t\t,[LATITUDE] \t\t,[LONGITUDE] \t\t,[SCD_START_DATE] \t\t,[SCD_END_DATE] \t\t,[ISACTIVE] \t\t,[ISLATEST] \t\t,[BNK_CODE] \t\t,[SOURCE_CODE] \t\t,[FILE_NAME] \t\t,[INSERT_DTTM] \t) \tSELECT DISTINCT  \t\t [SOL_ID] \t\t,[SOL_DESC] \t\t,[LATITUDE] \t\t,[LONGITUDE] \t\t,CAST(LEFT(RIGHT(FILE_NAME, 12), 8) AS DATE) AS [SCD_START_DATE] \t\t,CAST('9999-12-31' AS DATE) AS [SCD_END_DATE] \t\t,1 AS [ISACTIVE] \t\t,1 AS [ISLATEST] \t\t,LEFT(FILE_NAME, 5) AS [BNK_CODE] \t\t,'DID' AS [SOURCE_CODE] \t\t,[FILE_NAME] \t\t,CURRENT_TIMESTAMP \tFROM D360.STG_EDS_DID_BRANCHLOCATION src \tWHERE src.[H] = 'D' \t\tAND NOT EXISTS ( \t\t\tSELECT 1 \t\t\tFROM EDS.DID_BRANCHLOCATION tgt \t\t\tWHERE src.[SOL_ID] = tgt.[SOL_ID] \t\t\t\tAND HASHBYTES('SHA2_256', CONCAT_WS(N'|', \t\t\t\tSRC.[SOL_ID], \t\t\t\tSRC.[SOL_DESC], \t\t\t\tSRC.[LATITUDE], \t\t\t\tSRC.[LONGITUDE]))  \t\t\t\t=  \t\t\t\tHASHBYTES('SHA2_256', CONCAT_WS(N'|', \t\t\t\tTGT.[SOL_ID], \t\t\t\tTGT.[SOL_DESC], \t\t\t\tTGT.[LATITUDE], \t\t\t\tTGT.[LONGITUDE])) \t\t\t\tAND tgt.[ISLATEST] = 1 \t\t\t); END TRY  BEGIN CATCH \t\t\t  \tDECLARE @msg NVARCHAR(2048) = ERROR_MESSAGE();  \t\t\t THROW 51000 \t\t,@msg \t\t,1; END CATCH"
			}
		},
