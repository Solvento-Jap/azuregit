						"activity": "Require_Approved_Execution",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(pipeline().parameters.MissingFilePolicy, 'Fail'), equals(pipeline().parameters.MissingFilePolicy, 'Skip'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Invalid_MissingFilePolicy",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "MissingFilePolicy must be Fail or Skip.",
								"errorCode": "AML_INVALID_MISSING_FILE_POLICY"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "MissingFilePolicy_Valid",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
