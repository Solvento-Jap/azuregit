							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": "SELECT\nconvert(numeric(38,0),ISNULL(NULLIF(REPLACE(STG.[CUST_ACCT_ENROLLMENT_ID],' ',''),''),0)) as CUST_ACCT_ENROLLMENT_ID\n,convert(numeric(10,0),ISNULL(NULLIF(REPLACE([VERSION],' ',''),''),0)) as VERSION\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([CUST_ID],' ',''),''),0)) as CUST_ID\n,[ACCT_NO]\n,STG.[CIF_NO]\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([ACCT_TYPE_ID],' ',''),''),0)) as ACCT_TYPE_ID\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([CURRENCY_ID],' ',''),''),0)) as CURRENCY_ID\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([ACCT_STATUS_ID],' ',''),''),0)) as ACCT_STATUS_ID\n,convert(date,[ACCT_STATUS_DT]) as ACCT_STATUS_DT\n,[ACCT_NM]\n,[ACCT_ALIAS]\n,convert(int,ISNULL(NULLIF(REPLACE(STG.[STATUS],' ',''),''),0)) as [STATUS]\n,convert(date,[STATUS_CHANGE_DT]) as STATUS_CHANGE_DT\n,[ATM_CARD_NO]\n,[REMARKS]\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([ACCT_PROD_ID],' ',''),''),0)) as ACCT_PROD_ID\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([RELATION_ID],' ',''),''),0)) as RELATION_ID\n,[UNENROLLMENT_REF_NO]\n,convert(int,ISNULL(NULLIF(REPLACE([TXN_CHANNEL],' ',''),''),0)) as [TXN_CHANNEL]\n,[LAST6_ACCT_NUM]\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([BRANCH_ID],' ',''),''),0)) as BRANCH_ID\n,[LOC_REF_NO]\n,convert(int,ISNULL(NULLIF(REPLACE([IS_PRIMARY_ACCT],' ',''),''),0)) as [IS_PRIMARY_ACCT]\n,[ACCT_TYPE_IND]\n,[SECONDARY_FIELD1]\n,[SECONDARY_FIELD2]\n,[SECONDARY_FIELD3]\n,[SECONDARY_FIELD4]\n,[CREATED_BY]\n,[UPDATED_BY]\n,convert(date,[CREATED_DATE]) as CREATED_DATE\n,convert(date,[UPDATED_DATE]) as UPDATED_DATE\n,convert(numeric(38,0),ISNULL(NULLIF(REPLACE([FLAGS],' ',''),''),0)) as FLAGS\n,convert(numeric(1,0),ISNULL(NULLIF(REPLACE([DISPLAY_CHANNEL],' ',''),''),0)) as DISPLAY_CHANNEL\n,convert(int,ISNULL(NULLIF(REPLACE([ALLOW_VIEW],' ',''),''),0)) as [ALLOW_VIEW]\n,convert(int,ISNULL(NULLIF(REPLACE([ALLOW_DEBIT],' ',''),''),0)) as [ALLOW_DEBIT]\n,convert(int,ISNULL(NULLIF(REPLACE([ALLOW_CREDIT],' ',''),''),0)) as [ALLOW_CREDIT]\n,convert(int,ISNULL(NULLIF(REPLACE([ALLOW_PEEKBALANCE],' ',''),''),0)) as [ALLOW_PEEKBALANCE]\n,1 as isActive\n,1 as isLatest\n,left(FILE_NAME, 5) as [BNK_CODE]\n,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n,[FILE_NAME]\n,convert(date,[insert_dttm]) as insert_dttm\nFROM [BUSC].[MBK_RTBKCUSTENROLLMENTMTB_DELTA] DELTA\nLEFT JOIN [d360].[STG_MBK_RTBKCUSTENROLLMENTMTB] STG ON DELTA.CUST_ACCT_ENROLLMENT_ID = STG.CUST_ACCT_ENROLLMENT_ID AND DELTA.CIF_NO = STG.CIF_NO\nWHERE H = 'D'",
