						"sqlReaderQuery": "WITH SUCCESS AS (\r\nSELECT DISTINCT\r\n    SUBSTRING(FILE_NAME,0,6) BANK_CODE\r\n    ,SUBSTRING(FILE_NAME,7,3) SOURCE_CODE\r\n    ,REVERSE(SUBSTRING(REVERSE(FILE_NAME),18,50)) FILE_NAME\r\n    ,Date as DATE\r\n    ,insert_dttm\r\n    ,Metrics\r\n    ,Source\r\n    ,Target\r\nFROM d360.HASH_LOG_TBL)\r\n\r\nSELECT\r\n    BANK_CODE\r\n    ,SOURCE_CODE\r\n    ,FILE_NAME\r\n    ,DATE\r\n    ,insert_dttm\r\n    ,Metrics\r\n    ,SUM(Source) Source_Total\r\n    ,SUM(Target) Target_Total\r\nFROM SUCCESS\r\nWHERE SOURCE_CODE = 'LNS'\r\nGROUP BY BANK_CODE\r\n    ,SOURCE_CODE\r\n    ,FILE_NAME\r\n    ,DATE\r\n    ,insert_dttm\r\n    ,Metrics",
						"queryTimeout": "02:00:00"
