				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n    convert(date,STG.RTLIST_DATE) AS RTLIST_DATE\n\t,STG.RTLIST_NUM\n    ,STG.FXD_CRNCY_CODE\n    ,STG.VAR_CRNCY_CODE\n\t,STG.RATECODE\n    ,STG.BANK_ID\t\n\t,NULL AS SRL_NUM\n\t,STG.DEL_FLG\n    ,convert(numeric(21,10),ISNULL(NULLIF(REPLACE(STG.FXD_CRNCY_UNITS,' ',''),''),0)) AS FXD_CRNCY_UNITS\n    ,convert(numeric(21,10),ISNULL(NULLIF(REPLACE(STG.VAR_CRNCY_UNITS,' ',''),''),0)) AS VAR_CRNCY_UNITS\n    ,STG.LCHG_USER_ID\n    ,convert(datetime2, stuff(stuff(stuff(STG.LCHG_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as LCHG_TIME\n    ,STG.RCRE_USER_ID\n    ,convert(datetime2, stuff(stuff(stuff(STG.RCRE_TIME, 9, 0, ' '), 12, 0, ':'), 15, 0, ':')) as RCRE_TIME\n\t,NULL AS CUST_VAR_CRNCY_UNITS\n\t,NULL AS TS_CNT\n\t,convert(numeric(20,4),ISNULL(NULLIF(REPLACE(NULL,' ',''),''),0)) AS LOW_SLAB_AMT\n\t,convert(numeric(20,4),ISNULL(NULLIF(REPLACE(NULL,' ',''),''),0)) AS HIGH_SLAB_AMT\n\t,NULL AS SLAB_CRNCY_CODE\n\t,1 as isActive\n\t,1 as isLatest\n\t,left(FILE_NAME, 5) as [BNK_CODE]\n\t,substring(FILE_NAME,7,3) as [SOURCE_CODE]\n\t,[FILE_NAME]\n\t,convert(date,[insert_dttm]) as insert_dttm\nFROM BUSC.GLD_RATELIST_HIST_TABLE_DELTA DELTA\nLEFT JOIN d360.STG_GLD_RATELIST_HIST_TABLE STG\n    ON DELTA.RTLIST_DATE = STG.RTLIST_DATE\n    AND DELTA.RTLIST_NUM = STG.RTLIST_NUM\n    AND DELTA.FXD_CRNCY_CODE = STG.FXD_CRNCY_CODE\n    AND DELTA.VAR_CRNCY_CODE = STG.VAR_CRNCY_CODE\n    AND DELTA.RATECODE = STG.RATECODE\n    AND DELTA.BANK_ID = STG.BANK_ID",
						"queryTimeout": "02:00:00",
