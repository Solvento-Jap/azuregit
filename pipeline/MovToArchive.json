{
	"name": "MovToArchive",
	"properties": {
		"activities": [
			{
				"name": "Get Filenames",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "adls_src_encrypt_bin",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Filenames",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Filenames').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Filename",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Filename",
								"value": {
									"value": "@item().name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Source Code",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Filename",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Source Code",
								"value": {
									"value": "@substring(variables('Filename'),6,3)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Move to Archive",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Source Code",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"wildcardFolderPath": "dev/encrypt",
										"wildcardFileName": {
											"value": "@variables('Filename')",
											"type": "Expression"
										},
										"deleteFilesAfterCompletion": false
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "adls_src_encrypt_bin",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "adls_src_archive_bin",
									"type": "DatasetReference",
									"parameters": {
										"source": {
											"value": "@concat('dev/archive/',variables('Source Code'),'/',substring(replace(utcnow(),'-',''),0,8))",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"Filename": {
				"type": "String"
			},
			"Source Code": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2022-12-07T09:23:09Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}